  isOverride     Boolean     @default(false)
  updatedBy      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([zoneId])
}

model TierPrice {
  id                      String      @id @default(uuid())
  tierId                  String
  tier                    PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  countryCode             String?
  currencyCode            String
  amountMonthlyMinor      Int
  amountAnnualMinor       Int
  overageStaffPriceMinor  Int         @default(0)
  // Price per EXTRA branch beyond PricingTier.includedBranches (currency-scoped,
  // like overageStaffPriceMinor). 0 = extra branches not sold self-serve here.
  overageBranchPriceMinor Int         @default(0)
  isOverride              Boolean     @default(false)
  paddlePriceIdMonthly    String?
  paddlePriceIdAnnual     String?
  // Stripe (NZD) + Razorpay (INR) price/plan refs, populated by the per-gateway
  // catalog scripts. Null where that gateway doesn't sell this tier/country.
  stripePriceIdMonthly    String?
  stripePriceIdAnnual     String?
  razorpayPlanIdMonthly   String?
  razorpayPlanIdAnnual    String?
  lastSyncedToPaddleAt    DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([tierId, countryCode])
  @@index([countryCode])
}

model TierFeature {
