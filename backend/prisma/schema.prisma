  CLEARANCE
  ASSET_RETURN
  FNF
  EXIT_DOCS
  POST_EXIT
}

enum TaskOwner {
  NEW_HIRE
  EMPLOYEE
  MANAGER
  HR
  IT
  FINANCE
  ADMIN
}

enum DueAnchor {
  OFFER_ACCEPT
  JOIN_DATE
  NOTICE_START
