model Subscription {
  id                        String             @id @default(uuid())
  businessId                String             @unique
  business                  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tierId                    String
  tier                      PricingTier        @relation(fields: [tierId], references: [id])
  status                    SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd          DateTime?
  seatsUsed                 Int                @default(1)
  billingCycle              BillingCycle       @default(MONTHLY)
  theme                     String             @default("default")
  // Three-dimensional theme system (Phase 1 roll-out, April 2026).
  //   theme         → profession key (dental / barber / legal / …)
  //   themeStyle    → visual variant (light / dark / elegant / matte / …)
  //   themeColors   → optional JSON overrides { primary, accent, surface }
  // Legacy tenants keep working: themeStyle defaults to 'light',
  // themeColors stays null meaning "use the profession+style defaults".
  themeStyle                String             @default("light")
  themeColors               String? // JSON blob — primary/accent/surface hex
  // Four-dimensional storefront identity (April 2026).
  //   theme         → profession key (dental / barber / legal / …)
  //   themeStyle    → visual variant (light / dark / elegant / matte / …)
  //   themeColors   → JSON colour overrides
  //   designPreset  → page LAYOUT (which section variants render & in what
  //                    composition). 15 curated presets — "classic",
  //                    "magazine", "minimal-mono", "bold-split", etc. NULL
  //                    means "Classic" — the default layout, identical to
  //                    pre-layout-system rendering. Existing tenants stay
  //                    on Classic until they explicitly pick a new layout.
  //   sectionVariants → JSON override map { hero: 'split-image', services:
  //                    'masonry', … }. Lets advanced tenants mix and match
  //                    on top of a preset. NULL means "use the preset's
  //                    defaults verbatim".
  designPreset              String? // null = "classic"
  sectionVariants           String? // JSON: { sectionKey: variantKey }
  // Paddle billing identifiers. Columns were added in an earlier migration
  // that survived the Apr-2026 Paddle revert; we're redeclaring them here
  // so the Prisma client recognises them again after Paddle was re-added.
  paddleCustomerId          String?
  paddleSubscriptionId      String?            @unique
  paddleTransactionId       String?
  // Multi-gateway billing (Stripe NZ / Razorpay IN / Paddle RoW). `gateway` is
  // the active processor for THIS subscription; a tenant is only ever on one.
  // Stripe ids live alongside the Paddle ones. See core/lib/billing/gatewayRouter.js.
  // lastPaddleEventAt/Id double as the generic "last gateway event" markers.
  gateway                   String             @default("PADDLE")
  stripeCustomerId          String?
  stripeSubscriptionId      String?            @unique
  razorpayCustomerId        String?
  razorpaySubscriptionId    String?            @unique
  // Charge-at-will model (Razorpay token/mandate, self-billed). Distinct from
  // the legacy Razorpay Subscriptions path: a TOKEN sub registers a UPI/card
  // mandate ONCE with a high max_amount, then OUR cron charges the exact amount
  // each cycle (so plan changes are just an amount change — no re-mandate). NULL
  // for Paddle/Stripe/legacy-Razorpay-Subscriptions tenants. See
  // billing/gateways/razorpayGateway.js + the chargeDueTokenSubscriptions cron.
  billingModel              String             @default("SUBSCRIPTION") // SUBSCRIPTION | TOKEN
  razorpayTokenId           String?            @unique
  mandateMaxAmount          Int? // max_amount registered on the mandate (minor units)
  mandateStatus             String? // confirmed | rejected | cancelled | paused | initiated
  mandateMethod             String? // upi | card | emandate
  nextChargeAt              DateTime? // OUR billing clock for TOKEN subs
  preDebitNotifiedAt        DateTime? // UPI Autopay pre-debit notice sent for the upcoming charge
  lastChargeAttemptAt       DateTime?
  pendingTierSlug           String?
  pendingBillingCycle       BillingCycle?
  pendingChangeEffectiveAt  DateTime?
  pendingVertical           String?
  customDomain              String?            @unique
  customDomainVerified      Boolean            @default(false)
  // Cloudflare for SaaS — Custom Hostname object ID, returned by their
  // POST /custom_hostnames API at registration time. We hold it so we
  // can poll status (without paginating the full list) and DELETE the
  // record on disconnect. NULL until the tenant first sets a custom
  // domain through the new flow (legacy customDomain rows from the
  // pre-CF-for-SaaS era will have NULL here too — we treat those as
  // "needs re-registration").
  customHostnameId          String?
  // DIY custom-domain pipeline (replaces Cloudflare for SaaS for both root
  // and subdomain custom domains). State machine values:
  //   NONE         — no domain set
  //   PENDING_DNS  — saved, waiting for customer DNS to point at our GA IPs
  //   PENDING_SSL  — DNS resolved, Let's Encrypt cert provisioning in flight
  //   ACTIVE       — cert issued, nginx serving the domain
  //   FAILED       — last provisioning attempt failed; statusMessage has detail
  customDomainStatus        String?            @default("NONE")
  customDomainStatusMessage String?
  customDomainCheckedAt     DateTime?
  // Card-required plan trial state. Trial access is mirrored only after the
  // active billing gateway confirms the subscription lifecycle via webhook/API.
  //
  // trialPlanSlug = the tier they're trialing (e.g., 'professional'). DB-wise
  // their actual `tierId` may stay on the internal fallback until Paddle
  // confirms a valid trialing/active paid subscription.
  //
  // trialStartedAt = analytics + dunning email scheduling
  // trialEndsAt    = when the trial expires; cron checks daily for expired trials
  // trialConvertedAt = set when they add payment + officially upgrade (one-way; once a
  //   user has converted, we don't let them re-trial).
  trialPlanSlug             String?
  trialStartedAt            DateTime?
  trialEndsAt               DateTime?
  trialConvertedAt          DateTime?
  // Set the FIRST time a tenant reaches an entitling paid/trial state; NEVER
  // cleared (survives a downgrade-to-free). It lets the billing state machine
  // tell a never-paid ONBOARDING placeholder apart from a lapsed EXPIRED tenant
  // (both end up on the free tier, so tier alone can't distinguish them).
  activatedAt               DateTime?
  lastPaddleEventAt         DateTime?
  lastPaddleEventId         String?
  pastDueSince              DateTime?
  accessGraceUntil          DateTime?
  // Archetype switch rate-limiting (Phase 0, May 2026).
  // Signup month allows 2 switches; every subsequent calendar month allows 1.
  // themeChangedAt tracks when the last switch happened so the counter can
  // reset automatically when the calendar month rolls over.
  themeChangedAt            DateTime?
  themeChangeMonthCount     Int                @default(0)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model PaddleWebhookEvent {
  id             String    @id @default(uuid())
  eventId        String    @unique
  eventType      String
  status         String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  businessId     String?
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  objectId       String?
  notificationId String?
  occurredAt     DateTime?
  processedAt    DateTime?
  failedAt       DateTime?
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  payload        Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
  @@index([objectId, eventType])
}

// Stripe webhook ledger — mirrors PaddleWebhookEvent (exact-once dedup on the
// Stripe event id, async/retryable processing). businessId is a plain column
// (no relation) to keep the migration additive and off the Business model.
model StripeWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  businessId  String?
  objectId    String?
  occurredAt  DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  payload     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
}

// Razorpay subscription webhook ledger — mirrors StripeWebhookEvent.
model RazorpayWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  businessId  String?
  objectId    String?
  occurredAt  DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  payload     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
}

model PaddleBillingSubscription {
  id                    String    @id @default(uuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productKind           String // PLAN | MAILBOX | DOMAIN | OTHER
  productRef            String?
  status                String
  billingCycle          String?
  quantity              Int       @default(1)
  currencyCode          String?
  unitAmountMinor       Int?
  paddleCustomerId      String?
  paddleSubscriptionId  String?   @unique
  paddleTransactionId   String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  nextBilledAt          DateTime?
  scheduledChangeAction String?
  lastPaddleEventAt     DateTime?
  lastPaddleEventId     String?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([businessId, productKind, productRef])
  @@index([businessId, productKind])
  @@index([paddleCustomerId])
  @@index([paddleTransactionId])
  @@index([status, updatedAt])
}

model BillingPurchase {
  id                   String   @id @default(uuid())
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productKind          String // PLAN | DOMAIN | MAILBOX | SMS | OTHER
  checkoutKind         String?
  status               String   @default("CHECKOUT_CREATED")
  expectedPriceId      String?
  expectedCurrencyCode String?
  expectedAmountMinor  Int?
  actualCurrencyCode   String?
  actualSubtotalMinor  Int?
  actualTaxMinor       Int?
  actualTotalMinor     Int?
  paddleCustomerId     String?
  paddleTransactionId  String?  @unique
  paddleSubscriptionId String?
  invoiceId            String?
  invoiceNumber        String?
  invoiceUrl           String?  @db.Text
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  paymentAttempts      PaymentAttempt[]
  adjustments          AdjustmentLedger[]
  messagingTopupGrants MessagingTopupGrant[]

  @@index([businessId, createdAt])
  @@index([productKind, status])
  @@index([paddleSubscriptionId])
}

model MessagingTopupGrant {
  id                  String           @id @default(uuid())
  businessId          String
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId          String?
  purchase            BillingPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  cycle               String
  amountUsd           Decimal          @db.Decimal(10, 2)
  currencyCode        String           @default("USD")
  paddleTransactionId String           @unique
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([businessId, cycle])
  @@index([purchaseId])
}

model PaymentAttempt {
  id                  String           @id @default(uuid())
  businessId          String
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId          String?
  purchase            BillingPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  provider            String           @default("paddle")
  status              String
  amountMinor         Int?
  currencyCode        String?
  paddleTransactionId String?
  // Our own sequential GST tax-invoice number, assigned once when the buyer
  // first opens the invoice for a self-billed (Razorpay/India) charge. Paddle
  // and Stripe carry the gateway's own invoice number instead. Unique keeps the
  // audit trail gapless.
  invoiceNumber       String?          @unique
  failureCode         String?
  failureMessage      String?          @db.Text
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // One ledger row per (business, gateway txn id, status) so a webhook retry /
  // reconcile / gateway redelivery can't create a duplicate payment-history row.
  // Postgres treats NULLs as distinct, so rows with a null txn id are unaffected. (B18)
  @@unique([businessId, paddleTransactionId, status])
  @@index([businessId, createdAt])
  @@index([purchaseId])
  @@index([paddleTransactionId])
}

// Atomic per-series counter for our own sequential invoice numbers (GST
// requires a gapless series). One row per series (e.g. an Indian financial
// year), incremented inside a transaction when a number is assigned.
model InvoiceCounter {
  series    String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AdjustmentLedger {
  id                   String           @id @default(uuid())
  businessId           String
  business             Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId           String?
  purchase             BillingPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paddleAdjustmentId   String?          @unique
  paddleTransactionId  String?
  paddleSubscriptionId String?
  action               String
  status               String
  reason               String?
  currencyCode         String?
  amountMinor          Int?
  raw                  Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([businessId, createdAt])
  @@index([purchaseId])
  @@index([paddleTransactionId])
  @@index([paddleSubscriptionId])
}

model Service {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  duration           Int
  price              Float?
  imageUrl           String?  @db.Text
  // Bullet list shown in the service card on the public site. Stored as
  // JSON array of strings so each bullet can be edited independently.
  features           String? // JSON: ["Feature 1", "Feature 2"]
  // When true, the card gets a "Most popular" badge and accent styling.
  highlighted        Boolean  @default(false)
  // Virtual / online consultation. When true, the booking flow tells
  // the customer the appointment is online + the confirmation/reminder
  // emails include the meeting link below. Provider-agnostic — works
  // with Google Meet, Zoom, MS Teams, Whereby, Jitsi, etc.
  isVirtual          Boolean  @default(false)
  // Default meeting URL for every booking of this service. Admin
  // pastes once per service (e.g. their permanent Zoom personal-room
  // link). A per-appointment override on Appointment.meetingUrl
  // takes precedence so admins can swap in a generated link for
  // specific bookings without breaking the default.
  virtualMeetingUrl  String?  @db.Text
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isActive           Boolean  @default(true)
  // Doctor v2 — collect the consult fee online at booking time
  requiresPrepayment Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Sprint 1.3 — optional advanced intake form to collect required info
  // before/at booking time (e.g. medical history, signature, photo of
  // insurance card). NULL = no form. The form definition lives in
  // IntakeForm; this is just a per-service association so different
  // services can require different forms.
  intakeFormId String?
  intakeForm   IntakeForm? @relation(fields: [intakeFormId], references: [id], onDelete: SetNull)

  appointments Appointment[]
  waitlist     Waitlist[]
}

model StaffSchedule {
  id         String            @id @default(uuid())
  staffId    String
  staff      User              @relation(fields: [staffId], references: [id])
  dayOfWeek  Int
  startTime  String
  endTime    String
  // Optional lunch / mid-day break that's excluded from bookable slots.
  // null on either side = no break for this day. Supports per-day
  // flexibility (Mon lunch 1–2, Wed 12:30–1:30, Fri no lunch).
  lunchStart String?
  lunchEnd   String?
  // Doctor v2 — per-branch schedule (a provider can work different hours per location)
  locationId String?
  location   BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([locationId])
}

// Capture demand when a customer wants a slot we can't currently fill.
// When an appointment is cancelled / no-shows / is rescheduled away,
// the auto-notify cron looks for Waitlist rows that match the freed
// slot and emails the customer with a deep-link to book it.
//
// Customers can join either logged-in (customerId set) or as guests
// (name + email + phone, customerId null). Either way, we use email
// as the contact channel for the slot-open notification.
//
// status PENDING  → still waiting; auto-notify will email on a match
// status NOTIFIED → an open-slot email was sent; the entry stays
//                    eligible for further matches until expiresAt
// status CONVERTED → the customer used the email to book; row kept
//                     for analytics + repeat-offender detection
// status DISMISSED → admin or customer removed it
model Waitlist {
  id                 String         @id @default(uuid())
  businessId         String
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Logged-in customer if available; otherwise guest contact fields below.
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  name               String
  email              String
  phone              String?
  // Service the customer wants. Null = "any service".
  serviceId          String?
  service            Service?       @relation(fields: [serviceId], references: [id])
  // Specific staff. Null = "anyone".
  staffId            String?
  staff              User?          @relation("StaffWaitlist", fields: [staffId], references: [id])
  // Preferred date (single day) and an optional time window. The
  // auto-notify matcher only fires for cancelled appointments whose
  // date matches and whose start falls within [preferredStartTime,
  // preferredEndTime]. Either time bound being null means "any time".
  preferredDate      DateTime
  preferredStartTime String? // "HH:MM" or null
  preferredEndTime   String? // "HH:MM" or null
  notes              String?
  status             WaitlistStatus @default(PENDING)
  // 30-day default expiry — set by the controller so admins can also
  // bulk-extend if needed. Past expiresAt rows are filtered out by the
  // matcher and surfaced in the "expired" tab in the admin UI.
  expiresAt          DateTime
  notifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, status, preferredDate])
  @@index([customerId])
}

enum WaitlistStatus {
  PENDING
  NOTIFIED
  CONVERTED
  DISMISSED
  EXPIRED
}

model Appointment {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId           String
  service             Service           @relation(fields: [serviceId], references: [id])
  staffId             String
  staff               User              @relation("StaffAppointments", fields: [staffId], references: [id])
  userId              String?
  user                User?             @relation("UserAppointments", fields: [userId], references: [id])
  customerId          String?
  customer            Customer?         @relation("CustomerAppointments", fields: [customerId], references: [id])
  date                DateTime
  startTime           String
  endTime             String
  status              AppointmentStatus @default(PENDING)
  notes               String?
  originalPrice       Float? // service price at time of booking
  discountAmount      Float? // how much was discounted
  finalPrice          Float? // what the customer pays
  couponCode          String? // coupon code used (if any)
  // Universal front-desk workflow. ONLINE is the normal customer booking
  // flow; WALK_IN rows are created by staff/admin for people who arrive
  // or call without using the storefront.
  bookingChannel      String            @default("ONLINE") // 'ONLINE' | 'WALK_IN'
  paymentStatus       String            @default("UNPAID") // 'UNPAID' | 'PARTIAL' | 'PAID'
  paymentMethod       String? // 'CASH' | 'UPI' | 'CARD' | 'BANK' | 'OTHER'
  paidAmount          Float?            @default(0)
  paidAt              DateTime?
  paymentReference    String?
  paymentReceivedById String?
  // Doctor v2 — online prepay at booking (gateway order created at booking; webhook marks PAID)
  paymentGateway      String?
  gatewayOrderId      String?
  // Per-appointment meeting URL override for virtual services. Admin
  // sets this from the appointment detail drawer when they want a
  // specific link different from Service.virtualMeetingUrl (e.g. a
  // freshly-generated Meet/Zoom link for this one booking). Falls
  // back to the service-level link when null.
  meetingUrl          String?           @db.Text
  // Sprint 1.5b — which physical branch this booking belongs to. NULL =
  // legacy single-location business OR booking pre-dates multi-location.
  locationId          String?
  location            BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  notifications         InboxNotification[]
  prescription          AppointmentPrescription?
  invoice               AppointmentInvoice?
  documents             AppointmentDocument[]
  restaurantReservation RestaurantReservation?
  lawFirmIntake         LawFirmIntake?
  matterOrigin          Matter?                  @relation("MatterOriginAppointment")
  installedUnitOrigin   InstalledUnit?           @relation("InstalledUnitOriginAppointment")
  amcContractOrigin     AmcContract?             @relation("AmcContractOriginAppointment")
  serviceVisit          ServiceVisit?            @relation("ServiceVisitAppointment")
  reminders             AppointmentReminder[]
  review                Review?

  @@index([locationId])
  @@index([businessId, bookingChannel, date])
  @@index([businessId, paymentStatus, date])
}

// ── Doctor product v2 (2026-06) ──────────────────────────────────────────────
// Structured specialty / department. Replaces the free-text User.speciality so
// patients can browse + book by specialty and clinics group doctors by department.
model Specialty {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String // "Cardiology", "Dermatology"
  slug        String // url/filter key, unique per business
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors User[] @relation("DoctorSpecialty")

  @@unique([businessId, slug])
  @@index([businessId, isActive, sortOrder])
}

// Scheduled appointment reminders across WhatsApp / SMS / email. A cron picks
// PENDING rows whose scheduledFor <= now and dispatches them, reusing the same
// channel plumbing that already delivers prescriptions.
model AppointmentReminder {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId    String
  kind          String      @default("DAY_BEFORE") // 'DAY_BEFORE' | 'HOUR_OF' — one send per (appt, kind)
  channel       String // 'WHATSAPP' | 'SMS' | 'EMAIL' | 'AUTO'
  scheduledFor  DateTime
  sentAt        DateTime?
  status        String      @default("PENDING") // 'PENDING' | 'SENT' | 'FAILED' | 'CANCELLED'
  error         String?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, kind])
  @@index([status, scheduledFor])
  @@index([appointmentId])
}

// DPDP Act (India) — per-purpose patient consent: explicit, purpose-scoped,
// withdrawable. Drives data-rights handling for the clinic vertical.
model ConsentRecord {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose     String // 'TREATMENT' | 'REMINDERS' | 'MARKETING' | 'DATA_PROCESSING'
  granted     Boolean   @default(true)
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?
  source      String? // 'BOOKING' | 'PORTAL' | 'ADMIN'
  createdAt   DateTime  @default(now())

  @@unique([businessId, customerId, purpose])
}

// Verified patient reviews tied to a completed appointment (genuine, unlike CMS
// testimonials). Surfaced on the clinic's own branded site.
model Review {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId       String?
  staff         User?        @relation("DoctorReviews", fields: [staffId], references: [id], onDelete: SetNull)
  rating        Int // 1-5
  body          String?
  status        String       @default("PENDING") // 'PENDING' | 'PUBLISHED' | 'HIDDEN'
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, status, createdAt])
  @@index([staffId])
}

model AppointmentPrescription {
  id                 String      @id @default(uuid())
  appointmentId      String      @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById        String?
  createdBy          User?       @relation("PrescriptionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  patientName        String?
  patientContact     String?
  clinicalJson       String      @db.Text
  medicinesJson      String      @db.Text
  letterheadJson     String?     @db.Text // DEPRECATED — replaced by doctorSnapshotJson
  // Immutable snapshot of the prescribing doctor's identity at issue time
  // (name, qualification, registrationNumber, speciality, signatureUrl) so the
  // Rx stays legally consistent even if the provider profile later changes.
  doctorSnapshotJson String?     @db.Text
  // DRAFT while being written; ISSUED is final (delivered to patient, immutable).
  status             String      @default("DRAFT")
  issuedAt           DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([businessId, issuedAt])
  @@index([createdById])
}

// Consultation invoice / receipt issued when a doctor closes a visit. Delivered
// to the patient alongside the Rx. Float amounts to match Appointment pricing.
model AppointmentInvoice {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId     String
  invoiceNumber  String // per-business human sequence, e.g. "INV-000123"
  currency       String?
  lineItemsJson  String      @db.Text // [{ label, qty, unitAmount, amount }]
  subtotal       Float       @default(0)
