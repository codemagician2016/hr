enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
  WORK_FROM_HOME
  ON_DUTY
  HOLIDAY_WORKED
