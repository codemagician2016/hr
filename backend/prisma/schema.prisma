model MessagingTopupGrant {
  id                  String           @id @default(uuid())
  businessId          String
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId          String?
  purchase            BillingPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  cycle               String
  amountUsd           Decimal          @db.Decimal(10, 2)
  currencyCode        String           @default("USD")
  paddleTransactionId String           @unique
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([businessId, cycle])
  @@index([purchaseId])
