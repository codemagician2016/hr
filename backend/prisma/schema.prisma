  AT_RISK
  OFF_TRACK
}

enum GoalVisibility {
  PUBLIC
  MANAGER_CHAIN
  PRIVATE
}

enum ReviewPerspective {
  SELF
  MANAGER
  PEER
  SKIP_LEVEL
  PRIOR_MANAGER
}

enum ResponseVisibility {
  SHARED
  MANAGER_ONLY
  HR_ONLY
}

enum FeedbackStatus {
  REQUESTED
  DECLINED
  SUBMITTED
  EXPIRED
}

enum CalibrationStatus {
  OPEN
  LOCKED
  CLOSED
}

enum MeritStatus {
  PENDING
