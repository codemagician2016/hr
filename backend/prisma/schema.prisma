model Subscription {
  id                        String             @id @default(uuid())
  businessId                String             @unique
  business                  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tierId                    String
  tier                      PricingTier        @relation(fields: [tierId], references: [id])
  status                    SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd          DateTime?
  seatsUsed                 Int                @default(1)
  billingCycle              BillingCycle       @default(MONTHLY)
  theme                     String             @default("default")
  // Three-dimensional theme system (Phase 1 roll-out, April 2026).
  //   theme         → profession key (dental / barber / legal / …)
  //   themeStyle    → visual variant (light / dark / elegant / matte / …)
  //   themeColors   → optional JSON overrides { primary, accent, surface }
  // Legacy tenants keep working: themeStyle defaults to 'light',
  // themeColors stays null meaning "use the profession+style defaults".
  themeStyle                String             @default("light")
  themeColors               String? // JSON blob — primary/accent/surface hex
  // Four-dimensional storefront identity (April 2026).
  //   theme         → profession key (dental / barber / legal / …)
  //   themeStyle    → visual variant (light / dark / elegant / matte / …)
  //   themeColors   → JSON colour overrides
  //   designPreset  → page LAYOUT (which section variants render & in what
  //                    composition). 15 curated presets — "classic",
  //                    "magazine", "minimal-mono", "bold-split", etc. NULL
  //                    means "Classic" — the default layout, identical to
  //                    pre-layout-system rendering. Existing tenants stay
  //                    on Classic until they explicitly pick a new layout.
  //   sectionVariants → JSON override map { hero: 'split-image', services:
  //                    'masonry', … }. Lets advanced tenants mix and match
  //                    on top of a preset. NULL means "use the preset's
  //                    defaults verbatim".
  designPreset              String? // null = "classic"
  sectionVariants           String? // JSON: { sectionKey: variantKey }
  // Paddle billing identifiers. Columns were added in an earlier migration
  // that survived the Apr-2026 Paddle revert; we're redeclaring them here
  // so the Prisma client recognises them again after Paddle was re-added.
  paddleCustomerId          String?
  paddleSubscriptionId      String?            @unique
  paddleTransactionId       String?
  // Multi-gateway billing (Stripe NZ / Razorpay IN / Paddle RoW). `gateway` is
  // the active processor for THIS subscription; a tenant is only ever on one.
  // Stripe ids live alongside the Paddle ones. See core/lib/billing/gatewayRouter.js.
  // lastPaddleEventAt/Id double as the generic "last gateway event" markers.
  gateway                   String             @default("PADDLE")
  stripeCustomerId          String?
  stripeSubscriptionId      String?            @unique
  razorpayCustomerId        String?
  razorpaySubscriptionId    String?            @unique
  // Charge-at-will model (Razorpay token/mandate, self-billed). Distinct from
  // the legacy Razorpay Subscriptions path: a TOKEN sub registers a UPI/card
  // mandate ONCE with a high max_amount, then OUR cron charges the exact amount
  // each cycle (so plan changes are just an amount change — no re-mandate). NULL
  // for Paddle/Stripe/legacy-Razorpay-Subscriptions tenants. See
  // billing/gateways/razorpayGateway.js + the chargeDueTokenSubscriptions cron.
  billingModel              String             @default("SUBSCRIPTION") // SUBSCRIPTION | TOKEN
  razorpayTokenId           String?            @unique
  mandateMaxAmount          Int?               // max_amount registered on the mandate (minor units)
  mandateStatus             String?            // confirmed | rejected | cancelled | paused | initiated
  mandateMethod             String?            // upi | card | emandate
  nextChargeAt              DateTime?          // OUR billing clock for TOKEN subs
  preDebitNotifiedAt        DateTime?          // UPI Autopay pre-debit notice sent for the upcoming charge
  lastChargeAttemptAt       DateTime?
  pendingTierSlug           String?
  pendingBillingCycle       BillingCycle?
  pendingChangeEffectiveAt  DateTime?
  pendingVertical           String?
  customDomain              String?
  customDomainVerified      Boolean            @default(false)
  // Cloudflare for SaaS — Custom Hostname object ID, returned by their
  // POST /custom_hostnames API at registration time. We hold it so we
  // can poll status (without paginating the full list) and DELETE the
  // record on disconnect. NULL until the tenant first sets a custom
  // domain through the new flow (legacy customDomain rows from the
  // pre-CF-for-SaaS era will have NULL here too — we treat those as
  // "needs re-registration").
  customHostnameId          String?
  // DIY custom-domain pipeline (replaces Cloudflare for SaaS for both root
  // and subdomain custom domains). State machine values:
  //   NONE         — no domain set
  //   PENDING_DNS  — saved, waiting for customer DNS to point at our GA IPs
  //   PENDING_SSL  — DNS resolved, Let's Encrypt cert provisioning in flight
  //   ACTIVE       — cert issued, nginx serving the domain
  //   FAILED       — last provisioning attempt failed; statusMessage has detail
  customDomainStatus        String?            @default("NONE")
  customDomainStatusMessage String?
  customDomainCheckedAt     DateTime?
  // Card-required plan trial state. Trial access is mirrored only after the
  // active billing gateway confirms the subscription lifecycle via webhook/API.
  //
  // trialPlanSlug = the tier they're trialing (e.g., 'professional'). DB-wise
  // their actual `tierId` may stay on the internal fallback until Paddle
  // confirms a valid trialing/active paid subscription.
  //
  // trialStartedAt = analytics + dunning email scheduling
  // trialEndsAt    = when the trial expires; cron checks daily for expired trials
  // trialConvertedAt = set when they add payment + officially upgrade (one-way; once a
  //   user has converted, we don't let them re-trial).
  trialPlanSlug             String?
  trialStartedAt            DateTime?
  trialEndsAt               DateTime?
  trialConvertedAt          DateTime?
  // Set the FIRST time a tenant reaches an entitling paid/trial state; NEVER
  // cleared (survives a downgrade-to-free). It lets the billing state machine
  // tell a never-paid ONBOARDING placeholder apart from a lapsed EXPIRED tenant
  // (both end up on the free tier, so tier alone can't distinguish them).
  activatedAt               DateTime?
  lastPaddleEventAt         DateTime?
  lastPaddleEventId         String?
  pastDueSince              DateTime?
  accessGraceUntil          DateTime?
  // Archetype switch rate-limiting (Phase 0, May 2026).
  // Signup month allows 2 switches; every subsequent calendar month allows 1.
  // themeChangedAt tracks when the last switch happened so the counter can
  // reset automatically when the calendar month rolls over.
  themeChangedAt            DateTime?
  themeChangeMonthCount     Int                @default(0)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model PaddleWebhookEvent {
  id             String    @id @default(uuid())
  eventId        String    @unique
  eventType      String
  status         String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  businessId     String?
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  objectId       String?
  notificationId String?
  occurredAt     DateTime?
  processedAt    DateTime?
  failedAt       DateTime?
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  payload        Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
  @@index([objectId, eventType])
}

// Stripe webhook ledger — mirrors PaddleWebhookEvent (exact-once dedup on the
// Stripe event id, async/retryable processing). businessId is a plain column
// (no relation) to keep the migration additive and off the Business model.
model StripeWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  businessId  String?
  objectId    String?
  occurredAt  DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  payload     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
}

// Razorpay subscription webhook ledger — mirrors StripeWebhookEvent.
model RazorpayWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  businessId  String?
  objectId    String?
  occurredAt  DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  payload     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
}

model Domain {
  id                 String       @id @default(cuid())
  businessId         String
  business           Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  tld                String
  registrar          Registrar
  registrarRef       String?
  status             DomainStatus
  statusMessage      String?      @db.Text
  registeredAt       DateTime?
  expiresAt          DateTime?
  autoRenew          Boolean      @default(true)
  privacyEnabled     Boolean      @default(false)
  trusteeEnabled     Boolean      @default(false)
  wholesaleMinor     Int
  retailMinor        Int
  renewalRetailMinor Int?
  currency           String       @default("INR")
  customHostnameId   String?
  registrationPaddleTransactionId String? @unique
  renewalPaddleTransactionId String? @unique
