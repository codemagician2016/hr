model Customer {
  id                String    @id @default(uuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email             String
  password          String
  name              String
  phone             String? // optional, customer-editable from portal Settings
  dateOfBirth       DateTime? // optional, customer-editable from portal Settings
  googleId          String?
  isActive          Boolean   @default(true)
  // GDPR Article 17 — soft-delete with 30-day grace. When the cron
  // purges, name/email/phone are nulled but Booking/Enquiry rows stay
  // (anonymised) so the business keeps revenue stats. AuditLog row
  // retains identity proof for legal/subpoena lookups.
  pendingDeletionAt DateTime?
  anonymisedAt      DateTime?
  // Email verification via OTP at signup. Customers created via Google OAuth
  // are marked verified immediately (Google already verified the email).
  emailVerified     Boolean   @default(false)
  emailOtp          String?
  emailOtpExpiry    DateTime?
  // See User.passwordChangedAt — revokes pre-change sessions on reset/change.
  passwordChangedAt DateTime?
  otpAttempts       Int       @default(0) // per-account failed-OTP counter
  // false = social-only (random password); don't demand a "current password"
  // they never set on password-change / account-delete.
  hasPassword       Boolean   @default(true)
  // Legal consent (GDPR / NZ Privacy Act evidence of acceptance)
  termsAcceptedAt   DateTime?
  termsVersion      String?
  calendarFeedToken String?   @unique
  avatarUrl         String?   @db.Text
  // BCP-47 locale code (en, hi, es, fr, de, it, pt-BR, …). Drives the
  // language of the customer portal + emails. NULL = "follow cookie /
  // browser preference" — set only when the customer explicitly picks
  // from the language selector.
  preferredLanguage String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // F3 customer notification preferences. Free-form JSON keyed by
  // category ('order_updates', 'promotions', 'restock_alerts'), each value
  // is an object of channel→bool ({ email, sms, whatsapp }). NULL means
  // "use defaults" — order_updates always on, marketing on by default
  // unless the customer opts out via CustomerMarketingOptOut.
  notificationPrefs Json?

  appointments          Appointment[]             @relation("CustomerAppointments")
  consentRecords        ConsentRecord[]
  reviews               Review[]
  notifications         InboxNotification[]
  supportConversations  SupportConversation[]
  supportMessages       SupportMessage[]          @relation("SupportCustomerMessages")
  waitlist              Waitlist[]
  marketingOptOuts      CustomerMarketingOptOut[]
  automationEnrollments AutomationEnrollment[]
  // Sprint 1.4 — CRM tags + segments (Pro tier)
  tagAssignments        CustomerTagAssignment[]
  // Sprint 3.2b — Blog comments + likes (registered customers can post,
  // like, etc.). Customer self-deletion nullifies authorship on comments
  // (history preserved with stored authorName) and cascades likes away.
  blogComments          BlogComment[]
  blogLikes             BlogLike[]
  wishlists             Wishlist[]
  addresses             CustomerAddress[]
  loyaltyLedger         EcomLoyaltyLedger[]
  // Multi-provider social logins (Google now; Apple / Microsoft / etc.
  // later). The (businessId, email) pair below stays the primary tenant
  // identity key — this just records which external providers are linked.
  identities            CustomerIdentity[]
  matters               Matter[]                  @relation("CustomerMatters")
  installedUnits        InstalledUnit[]           @relation("CustomerInstalledUnits")
  amcContracts          AmcContract[]             @relation("CustomerAmcContracts")

  @@unique([businessId, email])
}

// One row per (customer, provider). Lets ANY OIDC provider attach to a
// customer without schema changes — add a provider module on the backend
// and the only new value here is the `provider` string. `Customer.googleId`
// is kept for backward compatibility and is backfilled into this table.
model CustomerIdentity {
  id          String    @id @default(uuid())
  // Denormalised tenant scope — matches the repo-wide convention that
  // every customer-owned row carries businessId for fast tenant queries.
  businessId  String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider    String // 'google' | 'apple' | 'microsoft' | ...
  subject     String // the provider's stable user id (the OIDC "sub" claim)
  email       String? // email asserted by the provider at link time (informational)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  // Within a business, a given provider identity maps to exactly one
  // customer; and a customer has at most one identity per provider.
  @@unique([businessId, provider, subject])
  @@unique([customerId, provider])
  @@index([customerId])
  @@index([businessId])
}

// ECOMMERCE address book — saved shipping addresses per customer.
// Snapshotted into Order.shippingAddress at checkout (orders never reference
// this row directly, so editing/deleting an address never mutates history).
// Only one isDefault per customer; controller enforces.
model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String? // e.g. "Home", "Work" — optional friendly tag
  fullName   String // recipient — defaults to customer.name on create
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String // ISO 3166-1 alpha-2 (uppercase, validated by Zod)
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isDefault])
}

