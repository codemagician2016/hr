generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Key-value settings store (managed by SUPER_ADMIN)
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  password           String
  name               String
  role               Role          @default(USER)
  businessId         String?
  business           Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resetToken         String?
  resetTokenExpiry   DateTime?
  emailVerified      Boolean       @default(false)
  emailOtp           String?
  emailOtpExpiry     DateTime?
  // Set whenever the password changes (reset/change). Sessions whose JWT was
  // issued before this instant are rejected by the auth middleware, so a
  // password reset actually revokes stolen access/refresh tokens.
  passwordChangedAt  DateTime?
  otpAttempts        Int           @default(0) // per-account failed-OTP counter
  avatarUrl          String?       @db.Text
  signatureUrl       String?       @db.Text
  stampUrl           String?       @db.Text
  // GDPR account deletion (Article 17). Soft-delete pattern with 30-day
  // grace period: pendingDeletionAt set when user requests deletion;
  // user can undo within the window. After 30 days, a cron purges PII
  // and sets anonymisedAt — AuditLog row preserves identity proof for
  // legal-claims defence + law-enforcement subpoenas.
  pendingDeletionAt  DateTime?
  anonymisedAt       DateTime?
  // Short role shown on storefront team cards (e.g. "Senior Dentist")
  subtitle           String?
  // Longer personal bio shown on the team card (short paragraph)
  bio                String?
  // ── Clinical provider profile (doctor_clinic theme) ──
  // One-time professional identity, auto-stamped (read-only) onto every Rx and
  // surfaced on the storefront doctor card. Registration number on every Rx is
  // effectively a legal requirement (e.g. NMC India). NULL for non-clinical staff.
  registrationNumber String? // medical registration / licence no.
  qualification      String? // e.g. "MBBS, MD (Internal Medicine)"
  speciality         String? // e.g. "Cardiologist"
  languages          String? // comma-separated, e.g. "English, Hindi"
  experienceYears    Int?
  consultationFee    Float? // default fee shown + pre-filled at consultation
  isActive           Boolean       @default(true)
  // Controls whether this staff member is featured on the public website's
  // Team section. Independent of isActive (which governs booking/login).
  // Lets business owners hide temp staff or those who decline a public profile.
  showOnWebsite      Boolean       @default(true)
  // Controls whether this person takes bookings. Separate from showOnWebsite
  // (marketing presence) and isActive (login). Lets an owner step away from
  // personally serving customers once they have staff, while still appearing
  // on the site. Receptionists/non-clinical staff can have this off too.
  isServiceProvider  Boolean       @default(true)
  // Legal consent (GDPR / NZ Privacy Act evidence of acceptance)
  termsAcceptedAt    DateTime?
  termsVersion       String?
  calendarFeedToken  String?       @unique
  // BCP-47 locale code (en, hi, es, fr, de, it, pt-BR, …). Drives the
  // language of the admin/staff UI + outbound email. NULL = "follow
  // cookie / browser preference" — set only when the user explicitly
  // picks from the language selector.
  preferredLanguage  String?
  // Sprint 1.6b — optional per-staff custom role. NULL = fall back to the
  // legacy `role` enum's implicit permission set (BUSINESS_ADMIN ≈ Owner,
  // STAFF ≈ FrontDesk).
  businessRoleId     String?
  businessRole       BusinessRole? @relation(fields: [businessRoleId], references: [id], onDelete: SetNull)
  // Doctor v2 — structured specialty/department (replaces free-text speciality for filtering)
  specialtyId        String?
  specialty          Specialty?    @relation("DoctorSpecialty", fields: [specialtyId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  staffSchedules          StaffSchedule[]
  staffAppointments       Appointment[]             @relation("StaffAppointments")
  userAppointments        Appointment[]             @relation("UserAppointments")
  createdPrescriptions    AppointmentPrescription[] @relation("PrescriptionAuthor")
  createdDocuments        AppointmentDocument[]     @relation("AppointmentDocumentAuthor")
  leaveRequests           StaffLeave[]
  notifications           InboxNotification[]
  supportMessages         SupportMessage[]          @relation("SupportUserMessages")
  staffWaitlist           Waitlist[]                @relation("StaffWaitlist")
  mattersResponsible      Matter[]                  @relation("LawyerMatters")
  amcContractsResponsible AmcContract[]             @relation("TechnicianAmcContracts")
  serviceVisitsAssigned   ServiceVisit[]            @relation("TechnicianServiceVisits")
  doctorReviews           Review[]                  @relation("DoctorReviews")
  // HR fork — optional ESS portal identity link. An Employee.userId points
  // here only when the person has portal login (not every employee logs in).
  hrEmployee              Employee?
  // Feature 10 §4.3 — approval delegation back-relations (out-of-office).
  delegationsFrom         ApprovalDelegation[]      @relation("DelegationFrom")
  delegationsTo           ApprovalDelegation[]      @relation("DelegationTo")

  @@index([businessRoleId])
  @@index([specialtyId])
}

model Business {
  id                        String    @id @default(uuid())
  name                      String
  slug                      String    @unique
  slugLastChangedAt         DateTime?
  // Human-friendly 8-digit code (vs the uuid). Easy to read out / type into
  // admin tools like coupon business-restrictions. Nullable so the column adds
  // cleanly; backfilled + assigned on create. See lib/businessShortId.js.
  shortId                   String?   @unique
  description               String?
  address                   String? // storefront address line 1 (public-facing)
  addressLine2              String? // storefront address line 2 (suite/unit/floor)
  city                      String? // storefront city
  postalCode                String? // storefront postal/PIN/ZIP code
  state                     String?
  country                   String? // ISO-3166-1 alpha-2 (e.g. "IN", "US")
  // HR fork — founder decision #6. The deployment region / market this
  // tenant root belongs to. Drives statutory-module loading defaults,
  // data-residency, and which compliance rule sets seed by default.
  // A tenant is SINGLE-COUNTRY: every Entity's `countryCode` must equal the
  // tenant's `hrCountry` (enforced by tenant/countryContext.assertCountry) — a
  // tenant is not IN+NZ mixed. Values: "IN" | "NZ" (extensible). NULL = inherit
  // from `country` / first Entity. See docs/03-data-model.md.
  region                    String?
  timezone                  String? // IANA zone (e.g. "Pacific/Auckland")
  phone                     String?
  email                     String?
  category                  String?
  bookingType               String    @default("POSTPAID") // 'PREPAID' | 'POSTPAID'
  // ECOMMERCE multi-store / multi-region mode (2026-05-12).
  // Controls whether the storefront prompts the shopper for a delivery
  // location before browsing AND how the resolution flows behave.
  //
  //   OFF      — single-location tenant. No LocationPrompt, no cart.locationId.
  //              The default for legacy + APPOINTMENT / STATIC verticals.
  //   CHAIN    — Pak'nSave-style. N physical stores under one tenant, each
  //              with its own catalog + pricing + slots. Shopper picks a
  //              STORE; cart scopes to it. (Phases 1-7 already wired this.)
  //   FULFILLMENT — Shopify-style. Shopper sees one storefront, while
  //              admin fulfils from the primary active BusinessLocation.
  //   REGIONAL — Shopify-Markets-style. Stores are pooled by region; the
  //              shopper picks a REGION (EcomServiceCity) and the system
  //              resolves which store fulfils within that region pool.
  //              Used when assortment is uniform but currency / pricing /
  //              language varies by country or state.
  //   BOTH     — two-step: region first, then store within region. For a
  //              tenant operating chains across multiple countries.
  multiStoreMode            String    @default("OFF") // 'OFF' | 'FULFILLMENT' | 'CHAIN' | 'REGIONAL' | 'BOTH'
  // Max nesting depth for ProductCategory tree. 1 = flat (no nesting),
  // 2 = parent + child (current default), 3 = parent + child + sub-child.
  // Tier-gated in `apps/shop/admin` Settings panel — Phase E. Backend
  // enforces this via lib/categoryDepth.js on every create + parent move.
  categoryMaxDepth          Int       @default(2)
  // Per-tenant feature flag overrides. Admin can OPT OUT of features their
  // plan tier already enables (turn them off). They CANNOT opt in to
  // features their tier doesn't include — the TierFeature row is the
  // entitlement ceiling, this column is the floor adjustment. Shape:
  //   { "buyAgain": false, "walletCredit": true, ... }
  // See core/lib/featuresCatalog.js for the catalog + per-feature defaults
  // and core/controllers/tenant.controller.js#resolveFeatures for merge.
  featureFlags              Json?
  // Doctor v2 — reminder config, e.g. { "channels": ["WHATSAPP","EMAIL"], "offsets": [1440, 120] } (minutes before)
  appointmentReminderConfig Json?
  isActive                  Boolean   @default(true)
  suspendedReason           String?
  suspendedAt               DateTime?
  // GDPR Article 17 — soft-delete with 30-day grace period. See User
  // model for the same pattern. Subscription/Paddle is cancelled at
  // request time; tenant data is purged when the cron sweeps after 30d.
  pendingDeletionAt         DateTime?
  anonymisedAt              DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  users                          User[]
  services                       Service[]
  appointments                   Appointment[]
  specialties                    Specialty[]
  consentRecords                 ConsentRecord[]
  reviews                        Review[]
  prescriptions                  AppointmentPrescription[]
  appointmentDocuments           AppointmentDocument[]
  lawFirmIntakes                 LawFirmIntake[]
  subscription                   Subscription?
  content                        BusinessContent?
  seoSettings                    BusinessSeoSettings?
  seoPageOverrides               SeoPageOverride[]
  redirects                      Redirect[]
  customers                      Customer[]
  hours                          BusinessHours[]
  holidays                       BusinessHoliday[]
  leaveRequests                  StaffLeave[]
  waitlist                       Waitlist[]
  autoApproveLeave               Boolean                      @default(false)
  // When true, every new customer booking lands as CONFIRMED instead
  // of PENDING — saves admins from manually approving each one. Off
  // by default so the existing flow (admin reviews + confirms) stays
  // the safe path; admins opt in from Settings → Bookings when they
  // want hands-off booking. The auto-cancel-stale-pending cron only
  // touches PENDING rows, so flipping this on also short-circuits
  // that risk.
  autoConfirmBookings            Boolean                      @default(false)
  // Review-request email sent ~24h after a COMPLETED appointment. When
  // reviewRequestEnabled is true AND reviewRequestLink is set, the
  // customer gets a "How was your visit?" email with a 1-click CTA to
  // the business's Google / Yelp / internal review page.
  reviewRequestEnabled           Boolean                      @default(true)
  reviewRequestLink              String?
  // Tenant's "house language" — used as the fallback when a visitor
  // hasn't picked a language yet (no NEXT_LOCALE cookie, no
  // Customer.preferredLanguage). Doesn't override an individual's
  // explicit pick. NULL = no preference set; existing customer/cookie
  // logic applies. BCP-47 codes matching i18n SUPPORTED_LOCALES
  // (en, hi, es, fr, de, it, pt-BR).
  defaultLanguage                String?
  coupons                        Coupon[]
  enquiries                      Enquiry[]
  notifications                  InboxNotification[]
  supportConversations           SupportConversation[]
  supportMessages                SupportMessage[]
  integrations                   BusinessIntegration[]
  // Vertical the business is configured for. Drives storefront layout +
  // admin nav. APPOINTMENT is the existing product (booking-first).
  // STATIC = marketing-only site (no booking, no shop).
  // ECOMMERCE = product catalog + cart + checkout (grocery launch theme).
  // Default APPOINTMENT for backward compat with all existing tenants.
  vertical                       String                       @default("APPOINTMENT") // 'STATIC' | 'APPOINTMENT' | 'ECOMMERCE'
  // Default currency the admin's new-product form pre-fills with. ISO
  // 4217 (e.g. "USD", "INR", "EUR"). Null = fall back to "INR" in UI for
  // back-compat. Existing per-product currencies are NOT touched when
  // this changes — products keep their own currency snapshot.
  defaultCurrency                String?
  currencyChangedAt              DateTime? // rate-limit guard — updated on every manual currency change
  // ── F14 — HR single-country mode (the AUTHORITATIVE selector) ──────────────
  // The ONE country a tenant operates HR/payroll in. Set ONCE at HR setup
  // (POST /api/hr/setup/country) and then immutable. Distinct from `country`
  // (storefront/billing, ISO-2, L129) and the soft `region` hint (L136). Every
  // payroll/tax/leave/statutory/letter/currency/UI decision routes off THIS
  // field via hr/tenant/countryContext.js. NULL = HR not yet set up.
  hrCountry                      String?                      @db.Char(2) // 'IN' (v1). 'NZ' added in roadmap §12.
  // Locked pay/display currency derived from hrCountry at setup. Denormalized so
  // reads never re-derive. INR for IN.
  hrCurrency                     String?                      @db.Char(3) // 'INR' (v1)
  // Audit + lock guard. Once set, hrCountrySetAt is non-null and the setup
  // endpoint refuses to change hrCountry (409). Mirrors currencyChangedAt above.
  hrCountrySetAt                 DateTime?
  // Backfill quarantine: TRUE when the migration found >1 distinct entity
  // country (a legacy mixed tenant) and could not auto-stamp. Such tenants are
  // BLOCKED from HR writes until a super-admin resolves them. Expected: 0 in prod.
  hrCountryAmbiguous             Boolean                      @default(false)
  // Subscription billing profile. Separate from storefront contact/address:
  // a customer may buy Sitepresso for a registered company while the public
  // site shows a clinic/shop/location address.
  billingPurchaserType           String                       @default("INDIVIDUAL") // 'INDIVIDUAL' | 'BUSINESS'
  billingBusinessName            String?
  billingContactName             String?
  billingEmail                   String?
  billingTaxId                   String?
  billingAddressLine1            String?
  billingAddressLine2            String?
  billingCity                    String?
  billingState                   String?
  billingPostalCode              String?
  billingCountry                 String?
  paddleBillingAddressId         String?
  paddleBillingBusinessId        String?
  pages                          BusinessPage[]
  products                       Product[]
  productCategories              ProductCategory[]
  carts                          Cart[]
  orders                         Order[]
  // Sprint 1.1 — multi-channel notifications (SMS + WhatsApp + Email + budget engine)
  notificationConfig             NotificationConfig?
  messageDeliveries              MessageDelivery[]
  hrNotifyDedupes                HrNotifyDedupe[]
  budgetUsages                   BudgetUsage[]
  // Sprint 1.2 — marketing automation (Pro tier)
  automationCampaigns            AutomationCampaign[]
  automationEnrollments          AutomationEnrollment[]
  customerMarketingOptOuts       CustomerMarketingOptOut[]
  // Sprint 1.3 — advanced intake forms (Pro tier)
  intakeForms                    IntakeForm[]
  intakeSubmissions              IntakeSubmission[]
  // Sprint 1.4 — CRM tags & segments (Pro tier)
  customerTags                   CustomerTag[]
  customerSegments               CustomerSegment[]
  // Sprint 1.5 — multi-location (Business tier)
  locations                      BusinessLocation[]
  // Restaurant Reservations theme — dining rooms, service periods, tables
  // and reservation-to-table assignments. APPOINTMENT tenants outside the
  // restaurant theme ignore these tables completely.
  restaurantSettings             RestaurantSettings?
  restaurantDiningAreas          RestaurantDiningArea[]
  restaurantTables               RestaurantTable[]
  restaurantServicePeriods       RestaurantServicePeriod[]
  restaurantReservations         RestaurantReservation[]
  // Sprint 1.6 — RBAC (Business tier)
  businessRoles                  BusinessRole[]
  // Sprint 1.7 — Public API + webhooks (Business tier)
  apiKeys                        ApiKey[]
  // SSO (SAML/OIDC) + SCIM provisioning (v1) — one connection per tenant.
  ssoConnection                  SsoConnection?
  scimTokens                     ScimToken[]
  webhookSubscriptions           WebhookSubscription[]
  webhookDeliveries              WebhookDelivery[]
  paddleWebhookEvents            PaddleWebhookEvent[]
  paddleBillingSubscriptions     PaddleBillingSubscription[]
  billingPurchases               BillingPurchase[]
  paymentAttempts                PaymentAttempt[]
  adjustmentLedger               AdjustmentLedger[]
  messagingTopupGrants           MessagingTopupGrant[]
  // Sprint 2.1 / 2.2 — payment provider linked accounts (ECOMMERCE)
  paymentAccounts                BusinessPaymentAccount[]
  // Sprint 2.5 — WhatsApp ordering (ECOMMERCE Pro tier)
  // E.164 number including country code; buyers tap "Order on WhatsApp" on
  // product page and a wa.me deep-link opens with the product pre-filled.
  whatsappOrderNumber            String?
  whatsappOrdersEnabled          Boolean                      @default(false)
  // Sprint 2.6 — Multi-currency (ECOMMERCE Pro tier)
  // JSON array of ISO-4217 codes the storefront accepts at checkout. Empty
  // = single-currency (defaultCurrency only). Conversions use FX_TO_USD
  // table in budgetEngine; product prices stay in defaultCurrency in the
  // DB and convert at render time. Future: per-currency product overrides.
  supportedCurrencies            String[]                     @default([])
  // Sprint 2.7 — Multi-store (ECOMMERCE Business tier)
  storeBrands                    StoreBrand[]
  // Sprint 2.8 — POS sync (ECOMMERCE Business tier)
  posIntegrations                PosIntegration[]
  // Sprint 3.2 — Blog engine (STATIC Pro tier)
  blogPosts                      BlogPost[]
  // Sprint 3.2b — Blog comments + likes + per-tenant settings
  blogComments                   BlogComment[]
  blogLikes                      BlogLike[]
  blogSettings                   BlogSettings?
  // Sprint 3.2c — Blog categories (top-level groupings, distinct from
  // tagsCsv keyword tags — categories drive the storefront filter UI).
  blogCategories                 BlogCategory[]
  // Sprint 3.3 — Pages CMS v2 (drag-to-nest navbar)
  // Stores the admin's site-nav tree: ordered top-level entries, each
  // pointing to a system-page key (e.g. "home") or a custom BusinessPage
  // by id, plus an optional `children` array of the same shape. Empty /
  // null = fall back to the default order computed from system pages
  // + each BusinessPage row's parentNav. Schema:
  //   [{ kind:"system"|"custom", key?:string, pageId?:string,
  //      children?: [...] }]
  siteNav                        Json?
  // ── ECOMMERCE Path B Phase 2a (2026-05-01) ──
  // Relational entities for the full grocery-operations console. Optional —
  // STATIC + APPOINTMENT tenants ignore these entirely.
  inventoryStocks                InventoryStock[]
  inventoryAdjustments           InventoryAdjustment[]
  ecomRiders                     EcomRider[]
  ecomDeliveryRequests           EcomDeliveryRequest[]
  ecomDeliveryRequestEvents      EcomDeliveryRequestEvent[]
  ecomDeliveryLocationPings      EcomDeliveryLocationPing[]
  ecomDeliveryCashSettlements    EcomDeliveryCashSettlement[]
  ecomRiderShifts                EcomRiderShift[]
  ecomDeliveryRoutes             EcomDeliveryRoute[]
  ecomDeliverySlots              EcomDeliverySlot[]
  ecomDeliverySlotBookings       EcomDeliverySlotBooking[]
  ecomRolePermissionGrants       EcomRolePermissionGrant[]
  // ── ECOMMERCE Path B Phase 2b (2026-05-01) ──
  ecomReturns                    EcomReturn[]
  ecomReviews                    EcomReview[]
  ecomBanners                    EcomBanner[]
  ecomCmsBlocks                  EcomCmsBlock[]
  storePolicies                  StorePolicy[]
  ecomOrderEvents                EcomOrderEvent[]
  // ── ECOMMERCE Path B Phase 2c (2026-05-01) ──
  ecomServiceCities              EcomServiceCity[]
  ecomDeliveryZones              EcomDeliveryZone[]
  ecomSuppliers                  EcomSupplier[]
  ecomGoodsReceiptNotes          EcomGoodsReceiptNote[]
  ecomInventoryTransfers         EcomInventoryTransfer[]
  ecomActivityEvents             EcomActivityEvent[]
  // F3 — customer-facing loyalty ledger (one row per earn/redeem event).
  ecomLoyaltyLedger              EcomLoyaltyLedger[]
  // ── ECOMMERCE Storefront UX (2026-05-02) ──
  wishlists                      Wishlist[]
  // Storefront announcement bar — admin sets text + colours; shown above the
  // main nav when enabled. Replaces the hardcoded "Track order / My account"
  // strip with a configurable promo/info strip.
  announcementBarEnabled         Boolean                      @default(false)
  announcementBarText            String?
  announcementBarBgColor         String                       @default("#146A39")
  announcementBarTextColor       String                       @default("#ffffff")
  // Wishlist icon type shown on product cards. "bookmark" | "heart"
  wishlistEnabled                Boolean                      @default(true)
  wishlistIconType               String                       @default("bookmark")
  // Controls which category depth the storefront homepage grid shows.
  // 'main' = top-level only (default), 'sub' = second level, 'leaf' = deepest.
  categoryGridDisplay            String                       @default("main")
  // Brand catalog — Unilever/ITC/etc. (family) + Surf/Dove/etc. (brand).
  // Two-level hierarchy: brand belongs to a family, product picks a brand.
  // Drives the storefront brand picker + per-brand sales analytics.
  productBrandFamilies           ProductBrandFamily[]
  productBrands                  ProductBrand[]
  // Storefront checkout payment-mode policy (admin-controlled). The
  // /payment-providers endpoint reads this and the storefront only renders
  // the allowed methods. 'BOTH' = customer chooses, 'COD_ONLY' = no online
  // gateway shown, 'PREPAID_ONLY' = no Cash-on-Delivery shown. Default
  // BOTH so existing tenants keep current behaviour.
  paymentMode                    String                       @default("BOTH") // 'BOTH' | 'COD_ONLY' | 'PREPAID_ONLY'
  // Click & Collect (in-store pickup). When true, checkout shows a
  // Delivery vs Pickup toggle and the admin's pickupLocations are
  // listed for the buyer to choose from. Off by default — opt-in feature.
  pickupEnabled                  Boolean                      @default(false)
  // Home-delivery model (2026-06-06). Independent of pickupEnabled (Click &
  // Collect), this controls HOW home delivery works and drives the Store
  // Setup window + storefront checkout slot picker.
  //   SCHEDULED = customer picks a delivery time window (uses EcomDeliverySlot)
  //   ASAP      = delivered as soon as possible, no time windows shown
  //   NONE      = no home delivery (pickup-only; requires pickupEnabled=true)
  // Default ASAP so new/no-slot tenants never show an empty "pick a slot"
  // picker; the migration backfills SCHEDULED for tenants that already have
  // active slots, preserving their current checkout.
  deliveryMode                   String                       @default("ASAP") // 'SCHEDULED' | 'ASAP' | 'NONE'
  // Store-level FLAT delivery (2026-06-09). The deliver-anywhere baseline: used
  // when the shopper's address matches no EcomDeliveryZone, so a store with no
  // zones (or addresses outside its zones) still gets a SERVER-computed delivery
  // charge + ETA instead of trusting a client-sent shipping value. A matching
  // zone overrides these. flatDeliveryFeeMinor=0 = free flat delivery.
  flatDeliveryFeeMinor           Int                          @default(0)
  flatFreeDeliveryThresholdMinor Int                          @default(0)
  deliveryEtaMinutes             Int?
  pickupLocations                EcomPickupLocation[]
  ProductLocationOverride        ProductLocationOverride[]
  matters                        Matter[]
  trustTransactions              TrustTransaction[]
  installedUnits                 InstalledUnit[]
  amcContracts                   AmcContract[]
  serviceVisits                  ServiceVisit[]
  amcInvoices                    AmcInvoice[]

  // ════════════════════════════════════════════════════════════════════
  // HR DOMAIN back-relations (see "===== HR DOMAIN =====" section below).
  // Every HR aggregate is tenant-scoped via businessId → Business; these
  // are the inverse sides of those relations. Grouped by subsystem.
  // ════════════════════════════════════════════════════════════════════
  // Org
  hrEntities                   Entity[]
  hrLocations                  Location[]
  hrDepartments                Department[]
  hrDesignations               Designation[]
  hrGrades                     Grade[]
  hrBands                      Band[]
  // People
  employees                    Employee[]
  employeeInvites              EmployeeInvite[]
  employmentRecords            EmploymentRecord[]
  bankAccounts                 BankAccount[]
  emergencyContacts            EmergencyContact[]
  dependants                   Dependant[]
  employeeEducations           EmployeeEducation[]
  employeeAddresses            EmployeeAddress[]
  statutoryProfiles            StatutoryProfile[]
  statutoryRegistrations       StatutoryRegistration[]
  // Compensation
  salaryComponents             SalaryComponent[]
  salaryStructures             SalaryStructure[]
  salaryComponentLines         SalaryComponentLine[]
  compensationRevisions        CompensationRevision[]
  // Feature 17 — friendly CTC-policy templates (rules-only; compile to structures)
  ctcPolicies                  CtcPolicy[]
  ctcPolicyLines               CtcPolicyLine[]
  // Feature 5 — increment cycles
  incrementCycles              IncrementCycle[]
  incrementProposals           IncrementProposal[]
  // Payroll
  payCalendars                 PayCalendar[]
  payRuns                      PayRun[]
  payRunLines                  PayRunLine[]
  payRunLineComponents         PayRunLineComponent[]
  bonusCycles                  BonusCycle[]
  bonusAwards                  BonusAward[]
  arrearCycles                 ArrearCycle[]
  variablePaySchemes           VariablePayScheme[]
  variablePayCycles            VariablePayCycle[]
  variablePayAwards            VariablePayAward[]
  attendancePayInputs          AttendancePayInput[]
  payslips                     Payslip[]
  statutoryRemittances         StatutoryRemittance[]
  complianceObligations        ComplianceObligation[]
  // Feature 32 — statutory register definitions + generated-artefact log.
  registerDefinitions          RegisterDefinition[]
  registerExports              RegisterExport[]
  payRunInputItems             PayRunInputItem[]
  varianceThreshold            VarianceThreshold?
  // India salary disbursement — bank salary-advice batches + their per-employee lines.
  payoutBatches                PayoutBatch[]
  payoutLines                  PayoutLine[]
  anomalyAcks                  AnomalyAcknowledgement[]
  // Leave
  leaveTypes                   LeaveType[]
  leavePolicies                LeavePolicy[]
  leavePolicyAssignments       LeavePolicyAssignment[]
  leaveBalances                LeaveBalance[]
  leaveTransactions            LeaveTransaction[]
  leaveEncashmentRequests      LeaveEncashmentRequest[] // Feature 31 — in-service encashment
  compOffCredits               CompOffCredit[] // Feature 30 — comp-off expiry lots
  compOffConsumptions          CompOffConsumption[] // Feature 30 — per-application lot allocations
  // Attendance / time
  shiftPatterns                ShiftPattern[]
  shiftAssignments             ShiftAssignment[]
  rosterDays                   RosterDay[] // Feature 29 — roster cells
  rotationTemplates            RotationTemplate[] // Feature 29 — rotation rings
  shiftSwapRequests            ShiftSwapRequest[] // Feature 29 — shift swaps
  openShifts                   OpenShift[] // Open shifts — unassigned shifts published to a claim pool
  openShiftClaims              OpenShiftClaim[] // Open-shift claims (ride the F10 OPEN_SHIFT_CLAIM engine)
  hrHolidays                   Holiday[]
  attendancePunches            AttendancePunch[]
  attendances                  Attendance[]
  overtimeRules                OvertimeRule[]
  overtimeRequests             OvertimeRequest[] // OT pre-approval requests
  timesheets                   Timesheet[]
  // Expense / loan
