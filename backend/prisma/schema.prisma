  LIFETIME_FREE
  PERCENT_OFF
  FIXED_OFF
}

enum AdminCouponBenefitUnit {
  DAYS
  MONTHS
  CYCLES
}

// ============================================================
// Pricing admin (Layer 1 — our subscription revenue via Paddle)
// Merchant of Record = Paddle. DB is source of truth; we push
// prices to Paddle. Merchant-side booking payments (Layer 2)
// are intentionally NOT modeled here.
// ============================================================

model PricingTier {
  id                        String   @id @default(uuid())
  slug                      String   @unique
  // Which product vertical this tier belongs to. Drives the per-vertical
  // pricing pages + filters which tiers a customer can subscribe to based
  // on their Business.vertical. Default APPOINTMENT for backward compat —
  // every existing tier (free / starter / professional / business) was
  // created for the appointment-only product, so they all stay in that
  // bucket. New e-commerce + static tiers get vertical='ECOMMERCE' or
  // 'STATIC' on insert.
  vertical                  String   @default("APPOINTMENT") // 'STATIC' | 'APPOINTMENT' | 'ECOMMERCE'
  name                      String
  description               String?
  badge                     String?
  // Marketing-card content (editable in super-admin so the landing page stays
  // in sync with what admin has configured). `features` is a plain string[]
  // of bullet points shown on the card; TierFeature (structured) is a future
  // extension for entitlement checks — not needed for card rendering today.
  tagline                   String?
  features                  String[] @default([])
  ctaLabel                  String?
  ctaHref                   String?
  highlighted               Boolean  @default(false)
  includedStaff             Int?
  // Branch/location-based pricing. includedBranches = how many branches the flat
  // tier price covers (e.g. 3 on Business). contactSalesAboveBranches = the count
  // above which checkout routes to Contact Sales (the Custom/quote tier). Null =
  // not branch-gated. Per-extra-branch price lives on TierPrice.overageBranchPriceMinor.
  includedBranches          Int?
  contactSalesAboveBranches Int?
  sortOrder                 Int      @default(0)
  isCustomPriced            Boolean  @default(false)
  isActive                  Boolean  @default(true)
  trialDays                 Int?

  // Sprint 1.1 (2026-04-29): per-tier messaging budget allocation.
  // The customer's monthly SMS+WhatsApp slot count is computed at render
  // time as `(plan_price_in_local_currency × messagingBudgetPercent / 100)
  // / per_country_provider_cost`. Solo tier defaults to 0% (email only);
  // Starter+ default to 20%. Super-admin tunes this single number per tier
  // to control the SMS/WA generosity globally — no per-country tuning needed
  // because actual provider rates come from ProviderPriceCache.
  messagingBudgetPercent Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices        TierPrice[]
  tierFeatures  TierFeature[]
  subscriptions Subscription[]
}

model PricingZone {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  multiplier  Decimal  @db.Decimal(5, 4)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
