// ── §14.2 Talent depth (Feature 34): competency framework + 9-box + succession ──
// A thin layer over a CLOSED F8 review cycle. Tenant-scoped on businessId; mutable
// models carry `version` for optimistic concurrency; the append-only NineBoxMove
// ledger carries none (mirrors the CalibrationAdjustment convention). NOTHING here
// re-rates performance — the perf axis is DERIVED from the F8 calibrated/final rating.

model Competency {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code        String // stable key, unique per tenant
  name        String // "Stakeholder Management"
  category    CompetencyCategory @default(BEHAVIOURAL)
  description String?
  scaleId     String? // RatingScale used to rate this competency (else cycle default)
  isActive    Boolean            @default(true)
  version     Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  roleMaps    RoleCompetency[]

  @@unique([businessId, code])
  @@index([businessId, category, isActive])
}

enum CompetencyCategory {
  CORE // org-wide values, everyone
  LEADERSHIP // people-manager competencies
  FUNCTIONAL // role/skill specific
  BEHAVIOURAL // soft skills
  TECHNICAL
}

// Maps a competency to a designation (and optional level/grade). The "role" is the
// existing Designation/grade on Employee — we key on a free `roleKey` (designation id
// or grade code, or 'ALL' for org-wide) for v1 to avoid coupling to a specific org
// model; expectedLevel is the target proficiency on the competency's scale.
model RoleCompetency {
  id            String     @id @default(cuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  competencyId  String
  competency    Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  roleKey       String // designationId | grade code | 'ALL' for org-wide
  expectedLevel Decimal    @db.Decimal(4, 2) // target proficiency on the scale
  weight        Decimal?   @db.Decimal(5, 2) // optional weighting within the role's competency set
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([businessId, competencyId, roleKey])
  @@index([businessId, roleKey])
}

// ── 9-box placement: ONE per (cycle, employee). Performance axis DERIVED from the
// F8 review instance (never re-rated); potential axis authored + calibrated. ──
model NineBoxPlacement {
  id                String             @id @default(cuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycleId           String
  cycle             ReviewCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee           @relation("NineBoxSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewInstanceId  String? // FK to the PerformanceReview the perf axis was read from
  reviewInstance    PerformanceReview? @relation(fields: [reviewInstanceId], references: [id], onDelete: SetNull)
  // Axes (1..3). performanceBand is DERIVED (snapshot at placement create / recompute);
  // potentialRating is AUTHORED on a RatingScale, potentialBand is its banding.
  performanceBand   Int // 1..3 (low/med/high) banded from calibrated/final rating
  potentialRating   Decimal?           @db.Decimal(4, 2) // raw, on the potential scale
  potentialBand     Int? // 1..3 banded
  box               Int? // 1..9 = (potentialBand-1)*3 + performanceBand (null until both set)
  status            PlacementStatus    @default(DRAFT)
  potentialScaleId  String? // which RatingScale the potential was rated on
  idpNote           String? // free-text development plan (manager-authored)
  sharedWithSubject Boolean            @default(false) // gates the ESS gap/IDP view
  version           Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  moves             NineBoxMove[]

  @@unique([businessId, cycleId, employeeId])
  @@index([businessId, cycleId, box])
  @@index([businessId, cycleId, status])
}

enum PlacementStatus {
  DRAFT // perf axis seeded, potential not yet authored
  PROPOSED // manager authored potential → box set
  CALIBRATED // adjusted inside a NINE_BOX calibration session
  FINALIZED // locked; succession/talent decisions act on it
}

// Append-only ledger of every box move (mirrors CalibrationAdjustment).
model NineBoxMove {
  id            String           @id @default(cuid())
  businessId    String
  placementId   String
  placement     NineBoxPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  sessionId     String? // set when the move happened inside a calibration session
  fromBox       Int?
  toBox         Int
  fromPotential Decimal?         @db.Decimal(4, 2)
  toPotential   Decimal?         @db.Decimal(4, 2)
  reason        String
  byEmployeeId  String
  createdAt     DateTime         @default(now())

  @@index([businessId, placementId])
  @@index([businessId, sessionId])
}

// Talent pool / succession tag on an employee. Many tags per employee allowed
// (HIPO + FLIGHT_RISK can coexist). SUCCESSOR carries a positionRef + readiness.
model TalentTag {
  id                  String        @id @default(cuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee      @relation("TalentTagSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  kind                TalentTagKind
  positionRef         String? // for SUCCESSOR: target designation/position (free string v1)
  readiness           Readiness? // for SUCCESSOR / PROMOTION_READY
  note                String?
  cycleId             String? // optional provenance: which talent review created it
  isActive            Boolean       @default(true)
  createdByEmployeeId String?
  version             Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([businessId, employeeId, kind, isActive])
  @@index([businessId, kind, isActive])
}

enum TalentTagKind {
  HIPO // high potential
  FLIGHT_RISK
  PROMOTION_READY
  SUCCESSOR // successor FOR a position (positionRef)
  KEY_PERSON // critical / single point of failure
}

enum Readiness {
  READY_NOW
  READY_1_2_YR
  READY_3_PLUS_YR
}

// CalibrationSession discriminator (Feature 34 §4.3): one session can host the
// rating histogram, the 9-box grid, or both. Default RATING keeps every existing
// row's behaviour unchanged (calibration.controller.js untouched on the rating path).
enum CalibrationKind {
  RATING
  NINE_BOX
  BOTH
}

// ── §15 Recruitment (ATS) ──
model Job {
  id                         String              @id @default(uuid())
  businessId                 String
  business                   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId                   String?
  code                       String // JOB-000012
  title                      String
  departmentId               String?
  designationId              String?
  locationId                 String?
  countryCode                String              @db.Char(2)
  employmentType             EmploymentType
  openings                   Int                 @default(1)
  description                String?             @db.Text
  minSalary                  Decimal?            @db.Decimal(15, 2)
  maxSalary                  Decimal?            @db.Decimal(15, 2)
  currencyCode               String?             @db.Char(3)
  hiringManagerId            String?
  status                     JobStatus           @default(DRAFT)
  publishedAt                DateTime?
  closedAt                   DateTime?
  closeReason                String?             @db.Text // Feature 12 — why the requisition was closed (audited)
  // Feature 12 — public posting + configurable merit-blend + scoring config.
  publicSlug                 String? // careers URL token (unique per business when set)
  isPublic                   Boolean             @default(false) // appears on the public careers board
  applicationWeightPct       Decimal             @default(40) @db.Decimal(5, 2)
  interviewWeightPct         Decimal             @default(60) @db.Decimal(5, 2) // app% + interview% must sum to 100 (validated)
  scorecardTemplateId        String? // default interview scorecard for this job
  hideCandidatePiiUntilStage StageKind? // optional blind-screening mask point
  // Feature 36 — per-requisition candidate-comms overrides. JSON keeps it
  // migration-free + inheritable: job overrides ?? Business.candidateCommsConfig.
  //   { autoSend: { applied, shortlisted, interview_invite, offer, rejected }: bool,
  //     templateKeys: { <stage>: '<MessageTemplate.key>' } }
  commsConfig                Json?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  deletedAt                  DateTime?
  version                    Int                 @default(0)
  stages                     JobStage[]
  applications               Application[]
  screeningQuestions         ScreeningQuestion[]

  @@unique([businessId, code])
  @@unique([businessId, publicSlug])
  @@index([businessId, status])
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
  FILLED
}

model JobStage {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name       String
  kind       StageKind
  sortOrder  Int
  createdAt  DateTime  @default(now())

  @@unique([businessId, jobId, sortOrder])
  @@index([businessId, jobId])
}

enum StageKind {
  SOURCED
  SCREENING
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

// ── Recruitment pipeline templates (Phase 4) ─────────────────────────────────
// A reusable, named set of pipeline stages that can be materialised onto a Job's
// JobStage rows in one shot (instead of adding stages one-by-one). At most one
// template per tenant may be the default; createJob can auto-apply the default.
model PipelineTemplate {
  id          String                  @id @default(uuid())
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?
  stages      PipelineTemplateStage[]

  @@unique([businessId, name])
  @@index([businessId, isDefault])
}

model PipelineTemplateStage {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  templateId String
  template   PipelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  kind       StageKind
  sortOrder  Int
  createdAt  DateTime         @default(now())

  @@unique([templateId, sortOrder])
  @@index([businessId, templateId])
}

model Candidate {
  id                    String                @id @default(uuid())
  businessId            String
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName             String // @pii:identity
  lastName              String
  email                 String // @pii:contact
  phone                 String?
  resumeUrl             String?               @db.Text
  source                String? // referral/job-board/agency
  linkedinUrl           String?
  consentAt             DateTime? // candidate data-processing consent
  consentExpiresAt      DateTime? // auto-purge after retention window
  // Feature 38 — candidate PORTAL account (passwordless magic-link) + rich profile.
  emailVerifiedAt       DateTime? // set when they first click a magic link
  lastLoginAt           DateTime?
  headline              String? // "Senior Backend Engineer"
  location              String?
  totalExperienceMonths Int? // self-reported summary
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  applications          Application[]
  educations            CandidateEducation[]
  experiences           CandidateExperience[]
  skills                CandidateSkill[]
  // Feature 36 — one live public access token (status page + slot confirm).
  accessToken           CandidateAccessToken?

  @@unique([businessId, email])
  @@index([businessId, email])
}

// Candidate education (mirrors EmployeeEducation shape) — level/institution/field/
// year/grade. `grade` holds a GPA / % / class, matching the "grade percentage" ask.
model CandidateEducation {
  id           String    @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  level        String // "Bachelor's" / "Master's" / "Diploma" / "12th" …
  institution  String
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String? // GPA / % / class
  isHighest    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
}

// Candidate work experience — previous companies, title, from–to, current (net-new;
// no employee precedent existed).
model CandidateExperience {
  id             String    @id @default(uuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company        String
  title          String
  employmentType String? // FULL_TIME / CONTRACT / INTERN …
  location       String?
  startDate      DateTime?
  endDate        DateTime? // null when isCurrent
  isCurrent      Boolean   @default(false)
  description    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateSkill {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  level       String? // Beginner / Intermediate / Advanced / Expert
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model Application {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId               String
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  currentStageId      String?
  status              ApplicationStatus @default(APPLIED)
  rating              Decimal?          @db.Decimal(4, 2)
  rejectReason        String?
  convertedEmployeeId String? // set on hire -> onboarding
  // Feature 12 — the three score components + explainable snapshot (audit).
  screeningScore      Decimal?          @db.Decimal(7, 2) // auto from screening answers
  screeningMaxScore   Decimal?          @db.Decimal(7, 2) // denominator for the % display
  knockedOut          Boolean           @default(false) // failed a knockout question -> auto-REJECTED
  interviewScore      Decimal?          @db.Decimal(7, 2) // aggregated weighted interview total (0–100)
  meritScore          Decimal?          @db.Decimal(7, 2) // blended rank score (the merit-list sort key)
  scoreSnapshot       Json? // frozen breakdown for the "Why this rank?" panel
  appliedSource       ApplicationSource @default(MANUAL) // PUBLIC | REFERRAL | AGENCY | MANUAL | IMPORT | CAREER_PORTAL
  resumeUrl           String?           @db.Text // per-application resume snapshot (Feature 38 — swap per job)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  version             Int               @default(0)
  interviews          Interview[]
  offers              Offer[]
  screeningAnswers    ScreeningAnswer[]

  @@unique([businessId, jobId, candidateId])
  @@index([businessId, status])
  @@index([businessId, jobId, meritScore])
}

enum ApplicationSource {
  PUBLIC
  REFERRAL
  AGENCY
  MANUAL
  IMPORT
  CAREER_PORTAL
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  ASSESSMENT
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

model Interview {
  id                    String                   @id @default(uuid())
  businessId            String
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applicationId         String
  application           Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round                 Int
  scheduledAt           DateTime?
  mode                  InterviewMode
  interviewerIds        String // CSV employee ids
  feedbackJson          Json?
  recommendation        InterviewRecommendation?
  status                InterviewStatus          @default(SCHEDULED)
  // Feature 12 — scorecard template + slot/invitation details.
  scorecardTemplateId   String? // which skill set this round uses
  durationMins          Int?                     @default(45)
  locationText          String? // room / address (ONSITE)
  videoUrl              String?                  @db.Text // meeting link (VIDEO)
  candidateInviteSentAt DateTime?
  panelInviteSentAt     DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  scorecards            Scorecard[]
  // Feature 36 — interview slot-proposal handshake (propose → candidate confirms).
  slotProposals         InterviewSlotProposal[]

  @@index([businessId, applicationId])
}

enum InterviewMode {
  ONSITE
  VIDEO
  PHONE
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

model Offer {
  id                  String      @id @default(uuid())
  businessId          String
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applicationId       String
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ctcAnnual           Decimal?    @db.Decimal(15, 2)
  grossMonthly        Decimal?    @db.Decimal(15, 2)
  currencyCode        String      @db.Char(3)
  joiningDate         DateTime?   @db.Date
  structureId         String? // proposed SalaryStructure
  status              OfferStatus @default(DRAFT)
  letterUrl           String?     @db.Text
  sentAt              DateTime?
  respondedAt         DateTime?
  expiresAt           DateTime?
  approvalRequestId   String?
  // Feature 12 — optional offer-letter e-signature (built-in e-sign provider).
  signatureEnvelopeId String? // FK-by-id to SignatureEnvelope
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  version             Int         @default(0)

  @@index([businessId, applicationId, status])
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// ── §36 Candidate Communication (ATS polish) — Feature 36 ────────────────────
// Two additive models: a per-candidate public access token (status page +
// slot-confirm, since a Candidate is NOT an Employee/User and cannot use a
// session) and an interview slot-proposal handshake (HR proposes N slots → the
// candidate confirms ONE on the tokenised public link). Both tenant-scoped.

model CandidateAccessToken {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  candidateId String    @unique // one live token per candidate
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  token       String    @unique // crypto.randomBytes(24).hex — the URL secret
  expiresAt   DateTime? // null = lives with the candidate; rotated on purge
  createdAt   DateTime  @default(now())

  @@index([businessId, candidateId])
}

model InterviewSlotProposal {
  id            String             @id @default(uuid())
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  interviewId   String
  interview     Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  slots         Json // [{ id, startAt, endAt }] — proposed options
  status        SlotProposalStatus @default(PROPOSED) // PROPOSED|CONFIRMED|EXPIRED|WITHDRAWN
  confirmedSlot Json? // the chosen { id, startAt, endAt }
  proposedById  String? // actor Employee/User id (audit)
  expiresAt     DateTime? // auto-EXPIRE sweep (scheduler)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([businessId, interviewId])
  @@index([businessId, status])
}

enum SlotProposalStatus {
  PROPOSED
  CONFIRMED
  EXPIRED
  WITHDRAWN
}

// ── §15.1 Recruitment / ATS — Feature 12 (configurable scoring + merit list) ──
// Three-part scoring engine: (1) screening questions that auto-score on apply
// (knockout + qualification points), (2) interview scorecards (HR-defined N
// weighted skills rated 1–10; one card per interviewer), (3) a merit list that
// auto-ranks by a transparent blend of application + interview score. Child
// answer/rating models are APPEND-ONLY ledgers (no version). All tenant-scoped
// on businessId.

model ScreeningQuestion {
  id            String            @id @default(uuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  prompt        String // "Do you have a CS engineering degree?"
  kind          ScreeningKind // BOOLEAN | SINGLE_CHOICE | MULTI_CHOICE | NUMBER | TEXT | QUALIFICATION
  required      Boolean           @default(true)
  isKnockout    Boolean           @default(false) // a failing answer auto-rejects
  knockoutValue Json? // the value(s) that PASS (knockout fails if not matched)
  maxPoints     Decimal?          @db.Decimal(7, 2) // cap for NUMBER / QUALIFICATION
  sortOrder     Int
  options       ScreeningOption[] // for *_CHOICE / QUALIFICATION (degree levels)
  createdAt     DateTime          @default(now())
  deletedAt     DateTime?

  @@unique([businessId, jobId, sortOrder])
  @@index([businessId, jobId])
}

enum ScreeningKind {
  BOOLEAN
  SINGLE_CHOICE
  MULTI_CHOICE
  NUMBER
  TEXT
  QUALIFICATION
}

model ScreeningOption {
  id         String            @id @default(uuid())
  businessId String
  questionId String
  question   ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String // "Master's degree" / "Yes" / "B.Tech CS"
  value      String // canonical value matched against answers / knockoutValue
  points     Decimal           @default(0) @db.Decimal(7, 2) // Master=6, Bachelor=4, "CS engineering"=20
  sortOrder  Int

  @@index([businessId, questionId])
}

model ScreeningAnswer {
  id             String      @id @default(uuid())
  businessId     String
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId     String
  questionPrompt String // snapshot (the question may be edited later)
  answerValue    Json // bool / chosen value(s) / number / text
  pointsAwarded  Decimal     @default(0) @db.Decimal(7, 2)
  knockoutFailed Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([businessId, applicationId])
}

model ScorecardTemplate {
  id          String               @id @default(uuid())
  businessId  String
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String // "Backend Engineer — Tech Round"
  description String?
  aggregation ScorecardAggregation @default(MEAN) // how multi-interviewer rows combine
  isActive    Boolean              @default(true)
  skills      ScorecardSkill[]
  createdAt   DateTime             @default(now())
  deletedAt   DateTime?
  version     Int                  @default(0)

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

enum ScorecardAggregation {
  MEAN
  TRIMMED_MEAN
  MAX
  MEDIAN
}

model ScorecardSkill {
  id          String            @id @default(uuid())
  businessId  String
  templateId  String
  template    ScorecardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String // "Data Structures", "System Design"
  description String?
  weight      Decimal           @default(1) @db.Decimal(5, 2) // relative weight; Σ normalised at compute time
  scaleMin    Int               @default(1)
  scaleMax    Int               @default(10)
  sortOrder   Int

  @@unique([businessId, templateId, sortOrder])
  @@index([businessId, templateId])
}

model Scorecard {
  id                    String                   @id @default(uuid())
  businessId            String
  interviewId           String
  interview             Interview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerEmployeeId String // bound to the caller's own Employee (SoD)
  templateId            String // snapshot of which template was used
  status                ScorecardStatus          @default(DRAFT) // DRAFT | SUBMITTED
  weightedTotal         Decimal?                 @db.Decimal(7, 2) // this interviewer's normalised 0–100
  recommendation        InterviewRecommendation? // reuse the existing enum
  notes                 String?                  @db.Text
  submittedAt           DateTime?
  ratings               ScorecardRating[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  version               Int                      @default(0)

  @@unique([businessId, interviewId, interviewerEmployeeId]) // one card per interviewer per interview
  @@index([businessId, interviewId])
}

enum ScorecardStatus {
  DRAFT
  SUBMITTED
}

model ScorecardRating {
  id          String    @id @default(uuid())
  businessId  String
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  skillId     String // FK-by-id to ScorecardSkill (snapshot below)
  skillName   String // snapshot
  weight      Decimal   @db.Decimal(5, 2) // snapshot of the skill weight at submit
  score       Int // the 1–10 mark
  comment     String?

  @@unique([businessId, scorecardId, skillId])
  @@index([businessId, scorecardId])
}

// ── §16 Helpdesk (HR case management) ──
model HelpdeskCategory {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  slaHours          Int?
  defaultAssigneeId String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  tickets           HelpdeskTicket[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model HelpdeskTicket {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code                String // HD-000219
  employeeId          String // raiser
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            HelpdeskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subject             String
  description         String?           @db.Text
  priority            TicketPriority    @default(NORMAL)
  status              TicketStatus      @default(OPEN)
  assigneeId          String?
  slaDueAt            DateTime?
  // Cycle-1 Helpdesk additive: real SLA first-response stamp (set on the first
  // employee-visible HR reply) so a breach can be measured against response, not
  // just resolution; the satisfaction free-text accompanies the 1–5 rating on close.
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  satisfactionRating  Int?
  satisfactionComment String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  version             Int               @default(0)
  messages            HelpdeskMessage[]

  @@unique([businessId, code])
  @@index([businessId, status, priority])
  @@index([businessId, assigneeId, status])
  // ESS "My tickets" — the employee's own queue, filtered by status.
  @@index([businessId, employeeId, status])
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_EMPLOYEE
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model HelpdeskMessage {
  id              String         @id @default(uuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ticketId        String
  ticket          HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId    String
  body            String         @db.Text
  isInternal      Boolean        @default(false) // internal HR note vs employee-visible
  attachmentsJson Json?
  createdAt       DateTime       @default(now())

  @@index([businessId, ticketId])
}

// ── §18 Workflow & approval ──
model WorkflowDefinition {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code        String
  name        String
  module      WorkflowModule
  entityId    String?
  // Feature 10 §4.1 — additive selector + draft/publish refinements. NULL scopeJson
  // = the module-wide default; multiple defs disambiguated by priority + specificity
  // (workflowResolver.js §5.1). Only isPublished defs route real requests.
  description String?
  scopeJson   Json? // {"departmentIds":[...],"employeeLevels":["IC","M1"],"locationIds":[...]}
  priority    Int            @default(100) // lower = evaluated first when multiple match
  isPublished Boolean        @default(false) // draft vs live
  createdBy   String?
  updatedBy   String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  version     Int            @default(0)
  steps       WorkflowStep[]

  @@unique([businessId, code])
  @@index([businessId, module, isActive])
  @@index([businessId, module, isActive, isPublished])
}

enum WorkflowModule {
  LEAVE
  EXPENSE
  TRAVEL
  LOAN
  COMPENSATION
  OFFER
  PROFILE_CHANGE
  TIMESHEET
  ATTENDANCE_REGULARIZATION
  SEPARATION
  ASSET
  DOCUMENT_SIGN
  PAYRUN
  COMP_OFF // Feature 30 — comp-off EARN approval (manager green-lights a credit)
  SHIFT_SWAP // Feature 29 — shift-swap approval (manager green-lights a roster-cell trade)
  LEAVE_ENCASHMENT // Feature 31 — in-service leave encashment request approval
  FACE_ENROLLMENT // Feature 39 — HR approves an employee's face reference before face punching
  RECOGNITION // Feature 35 — over-budget / high-value peer recognition → manager approval
  AWARD // Feature 35 — nomination committee review/approve
  REDEMPTION // Feature 35 — catalog redemption fulfilment approval
  OVERTIME // OT pre-approval — the reporting manager authorizes overtime minutes
  OPEN_SHIFT_CLAIM // Open shifts — the roster manager confirms an employee's claim on an unassigned shift
}

model WorkflowStep {
  id                   String             @id @default(uuid())
  businessId           String
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  workflow             WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  stepOrder            Int
  name                 String
  approverType         ApproverType
  approverRefId        String? // role id / employee id (for SPECIFIC)
  conditionJson        Json? // e.g. {"amount":{">":50000}} amount-tiered routing
  isParallel           Boolean            @default(false) // all approvers at this level
  minApprovals         Int                @default(1)
  slaHours             Int?
  onTimeoutAction      TimeoutAction      @default(ESCALATE)
  createdAt            DateTime           @default(now())

  // Feature 10 §4.2 — steps sharing a stepOrder form ONE parallel level. The strict
  // unique([businessId, workflowDefinitionId, stepOrder]) is replaced (in the F10
  // migration) by a PARTIAL unique that only fires for NON-parallel steps, so two
  // parallel steps may share an order while a sequential step's order stays unique.
  // Prisma cannot express a WHERE-filtered unique, so the partial index lives in raw
  // SQL (uniq_workflowstep_seq); we keep the plain index here for lookups.
  @@index([businessId, workflowDefinitionId])
  @@index([businessId, workflowDefinitionId, stepOrder])
}

enum ApproverType {
  REPORTING_MANAGER
  DEPARTMENT_HEAD
  HR
  PAYROLL_MANAGER
  SPECIFIC_ROLE
  SPECIFIC_EMPLOYEE
  AUTO_APPROVE
}

enum TimeoutAction {
  ESCALATE
  AUTO_APPROVE
  AUTO_REJECT
  REMIND
}

model ApprovalRequest {
  id                   String           @id @default(uuid())
  businessId           String
  business             Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflowDefinitionId String?
  module               WorkflowModule
  entityType           String // "LeaveTransaction","ExpenseClaim"...
  entityId             String // the row under approval
  requesterEmployeeId  String?
  requester            Employee?        @relation("RequesterApprovals", fields: [requesterEmployeeId], references: [id], onDelete: SetNull)
  currentStepOrder     Int              @default(1)
  status               ApprovalStatus   @default(PENDING)
  payloadJson          Json? // snapshot of request for approver view
  slaDueAt             DateTime?
  decidedBy            String?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  version              Int              @default(0)
  actions              ApprovalAction[]

  @@index([businessId, module, status])
  @@index([businessId, entityType, entityId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ESCALATED
  EXPIRED
  WITHDRAWN
}

model ApprovalAction {
  id                  String           @id @default(uuid())
  businessId          String
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  approvalRequestId   String
  approvalRequest     ApprovalRequest  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stepOrder           Int
  approverUserId      String
  decision            ApprovalDecision
  comment             String?
  actedAt             DateTime         @default(now())
  createdAt           DateTime         @default(now())
  delegatedFromUserId String? // approval delegation

  @@index([businessId, approvalRequestId])
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REQUESTED_CHANGES
  DELEGATED
  ABSTAINED
}

// Feature 10 §4.3 — out-of-office "approve on my behalf". A delegation ADDS toUser
// to the approver set for the window (it does not remove fromUser); either may act,
// and a stand-in's ApprovalAction stamps delegatedFromUserId for the audit. SoD still
// excludes the original requester even via a delegation loophole (§9.2).
model ApprovalDelegation {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User             @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User             @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  modules    WorkflowModule[] @default([]) // NULL/empty = all modules
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  isActive   Boolean          @default(true) // can be revoked early
  createdBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([businessId, fromUserId, isActive])
  @@index([businessId, toUserId, isActive])
  @@index([businessId, startsAt, endsAt])
}

// ── §19.2 Notification ──
model Notification {
  id              String              @id @default(uuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipientUserId String
  type            NotificationType
  channel         NotificationChannel
  title           String
  body            String?             @db.Text
  dataJson        Json?
  entityType      String?
  entityId        String?
  readAt          DateTime?
  sentAt          DateTime?
  status          DeliveryStatus      @default(QUEUED)
  createdAt       DateTime            @default(now())

  @@index([businessId, recipientUserId, readAt])
  @@index([businessId, type, createdAt])
}

enum NotificationType {
  PAYSLIP_PUBLISHED
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  LOAN_APPROVED
  APPROVAL_PENDING
  DOC_EXPIRING
  BIRTHDAY
  ANNIVERSARY
  REVIEW_DUE
  TIMESHEET_DUE
  STATUTORY_DUE
  ONBOARDING_TASK
  OFFBOARDING_TASK
  ASSET_RETURN_DUE
  // Feed social layer (additive) — @mention, comment-on-your-post, reaction.
  FEED_MENTION
  FEED_COMMENT
  FEED_REACTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

// ── §19.3 NumberSequence — tenant-safe human codes ──
model NumberSequence {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId   String?
  scope      String // "EMPLOYEE","PAYRUN","EXPENSE","LOAN"...
  prefix     String // "EMP-","PR-"
  nextValue  Int      @default(1)
  padding    Int      @default(6)
  periodKey  String? // optional yearly reset "2026-27"
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([businessId, entityId, scope, periodKey])
  @@index([businessId, scope])
}

// ── Company document vault (Company Profile, optional) ───────────────────────
// Business-level document storage (NOT per-employee — that is EmployeeDocument).
// A tenant MAY (optionally) keep their business licences, income-tax reports,
// financial statements, registration + GST certificates here. Tenant-scoped,
// soft-deletable, integrity-anchored by a server-computed SHA-256. Mirrors the
// EmployeeDocument storage pattern (≤10 MB, PDF/PNG/JPG, S3 or inline fallback).
model BusinessDocument {
  id         String                   @id @default(uuid())
  businessId String
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   BusinessDocumentCategory
  name       String
  fileUrl    String                   @db.Text // object-storage URL (S3/R2) or inline data URL
  fileHash   String? // SHA-256 of the decoded bytes (integrity)
  mimeType   String?
  sizeBytes  Int?
  uploadedBy String? // User.id of the uploader
  expiresAt  DateTime?                @db.Date // licence/certificate expiry → reminder badge
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  deletedAt  DateTime?

  @@index([businessId, category])
  @@index([businessId, expiresAt])
}

enum BusinessDocumentCategory {
  BUSINESS_LICENSE
  INCOME_TAX_REPORT
  FINANCIAL_STATEMENT
  REGISTRATION_CERTIFICATE
  GST_CERTIFICATE
  OTHER
}

// ── Tenant branding (referenced by Business.tenantBrands; backs DocumentTemplate / ESS theming) ──
model TenantBrand {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId       String? // NULL = tenant-wide default brand
  code           String
  name           String
  logoUrl        String?   @db.Text
  faviconUrl     String?   @db.Text
  primaryColor   String? // hex, e.g. "#1A73E8"
  secondaryColor String?
  accentColor    String?
  emailFromName  String?
  emailFooter    String?   @db.Text
  supportEmail   String?
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  version        Int       @default(0)

  @@unique([businessId, code])
  @@index([businessId, entityId, isActive])
}

// ── Careers CMS — editable public careers page (one row per tenant) ──
// Backs the operator-authored content shown on the UNAUTH public careers board
// (headline/about/culture/perks/social + a hero image). Draft-safe: only rows
// with isPublished=true are ever surfaced on the public endpoint (the frontend
// falls back to today's hard-coded copy when the page is absent/unpublished).
// Rich-text fields (aboutHtml/cultureHtml/customSectionsJson[].bodyHtml) are
// SANITISED on write (script/iframe/on*/javascript: stripped) so the public
// render is safe. brandId is an OPTIONAL soft reference to a TenantBrand row
// (logo/colors/footer are re-read live from the active brand at read time — no
// hard FK, so deleting a brand never orphans the page).
model CareersPage {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  headline           String?
  subheadline        String?
  aboutHtml          String?  @db.Text
  cultureHtml        String?  @db.Text
  heroImageUrl       String?  @db.Text
  brandId            String? // soft ref to TenantBrand.id (no hard FK)
  customSectionsJson Json? // [{ title, bodyHtml, order }]
  socialLinksJson    Json? // { linkedin?, twitter?, website?, ... }
  perksJson          Json? // [{ icon?, label }]
  isPublished        Boolean  @default(false)
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId, isPublished])
}

// ── HR relational RBAC grant (HR analog of EcomRolePermissionGrant) ──
model HrRolePermissionGrant {
  id            String       @id @default(uuid())
  businessId    String // denormalised for fast tenant-scoped queries
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roleId        String
  role          BusinessRole @relation("HrRoleGrants", fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String // fixed HR permission catalog key, e.g. "PAYRUN_APPROVE"
  entityId      String? // optional entity scope (NULL = all entities)
  grantedAt     DateTime     @default(now())
  expiresAt     DateTime? // optional time-bound grant
  createdAt     DateTime     @default(now())

  @@unique([roleId, permissionKey, entityId])
  @@index([businessId])
  @@index([businessId, roleId])
}

// ===========================================================================
//  Feature 18 — Data Migration / Bulk Import (CSV-Excel) + back-dated autogen
//
//  A tenant-scoped, idempotent, dry-runnable import subsystem. ImportJob is one
//  upload + its lifecycle; ImportRow is one staged source row (the unit of
//  idempotency + the per-row audit trail). The import layer NEVER writes the
//  payroll math models (PayRunLine/Payslip) directly — it stages validated facts
//  and drives the existing engines (computeRun / deriveBreakup / createClaim /
//  freezeAttendance) so a migrated employee's history is engine-true.
// ===========================================================================

enum ImportKind {
  EMPLOYEE
  COMPENSATION
  ATTENDANCE
  PAYROLL_HISTORY
  REIMBURSEMENT
  BIOMETRIC // Feature 28 — device punch logs (eSSL/ZKTeco/Matrix/...) → AttendancePunch
  LEAVE_BALANCE // Feature 44 — opening leave balances (client migration)
}

enum ImportStatus {
  UPLOADED
  PARSED
  VALIDATED
  DRY_RUN_OK
  COMMITTING
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PARSED
  PASS
  WARN
  ERROR // validation error — excluded from commit
  COMMITTED
  SKIPPED // idempotent no-op (already committed for this natural key)
  FAILED // commit-time failure (engine threw) — row-isolated
}

/// One bulk-import upload + its lifecycle. Tenant-scoped, admin-driven, audited.
model ImportJob {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Optional scoping: an import can be pinned to one entity (its country drives
  // validators + the payroll engine). NULL = tenant default entity resolved at commit.
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  kind           ImportKind
  status         ImportStatus @default(UPLOADED)
  // Source file (logical storage key; never the bytes in the DB). hash = idempotency.
  fileName       String
  fileKey        String // logical storage key (namespaced per tenant)
  fileHash       String // sha256(bytes) — exactly-once guard per (businessId, kind)
  mimeType       String?
  rowCount       Int          @default(0)
  mappingJson    Json? // { sourceHeader -> canonicalField }
  optionsJson    Json? // kind options: e.g. { autoGenerate, autoApproveClaims, attendanceMode, payrollMode, tolerance }
  // Rollups (filled by validate/commit)
  passCount      Int          @default(0)
  warnCount      Int          @default(0)
  errorCount     Int          @default(0)
  committedCount Int          @default(0)
  skippedCount   Int          @default(0)
  previewJson    Json? // dry-run preview (e.g. per-employee net pay)
  // Actor + SoD: the maker who uploads ≠ the (optional) approver who commits.
  uploadedBy     String
  committedBy    String?
  // Lifecycle stamps
  uploadedAt     DateTime     @default(now())
  validatedAt    DateTime?
  committedAt    DateTime?
  failedReason   String?
  rows           ImportRow[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  version        Int          @default(0)

  // Exactly-once: a re-upload of identical bytes for the same kind returns the
  // existing job rather than a second one.
  @@unique([businessId, kind, fileHash])
  @@index([businessId, kind, status])
  @@index([businessId, status])
}

/// One staged source row. The unit of idempotency + the per-row audit trail.
model ImportRow {
  id           String          @id @default(uuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  importJobId  String
  importJob    ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber    Int // 1-based source row (for the error report)
  rawJson      Json // original parsed cells (pre-mapping)
  parsedJson   Json // canonical fields (post-mapping, pre-coercion)
  naturalKey   String? // e.g. "EMP-000142" | "EMP-000142|2025-12" | "EMP|2025-12-04"
  status       ImportRowStatus @default(PARSED)
  findingsJson Json? // [{ code, severity, field?, message }]
  resultJson   Json? // { action: created|updated|skipped, targetType, targetId }
  // Provenance of what this row produced (for unwind / report). e.g. payRunId.
  targetType   String?
  targetId     String?
  createdAt    DateTime        @default(now())

  // Idempotency within a job: one row per natural key (a re-parse replaces).
  @@unique([importJobId, naturalKey])
  @@index([businessId, importJobId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Engagement (Cycle 1) — Announcements / company news feed
// ─────────────────────────────────────────────────────────────────────────────
// A net-new, fully-additive model (no existing table touched). One row = one
// company announcement authored by an operator (HR-Admin/Owner — canManageAnnouncements)
// and surfaced on the employee (ESS) news feed when PUBLISHED + in-audience + not
// expired. Tenant-isolated by businessId on every row + index.
//
// Audience scoping (tenant + Feature-1-aware): the author targets ALL employees, or
// narrows to one-or-more entities / departments / a specific employee set. An ESS
// reader sees an announcement only when their CURRENT EmploymentRecord (entity/
// department) intersects the target — or they are individually named — so a
// company-wide note reaches everyone while a department note never leaks outside it.
// Scope is stored as denormalised id arrays (audienceEntityIds/audienceDeptIds/
// audienceEmployeeIds) so the membership test is a single in-memory intersection
// against the reader's current segment (no join fan-out per render).
model Announcement {
  id                  String                    @id @default(uuid())
  businessId          String
  business            Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Authoring operator (User.id). Kept as a bare id (no FK) so an author offboard
  // never cascades-away the announcement; the name is denormalised for display.
  authorUserId        String
  authorName          String?
  // Content
  title               String
  bodyRichText        String                    @db.Text // sanitised rich text / markdown (rendered client-side)
  category            AnnouncementCategory      @default(NEWS)
  // Audience — ALL | ENTITY | DEPARTMENT | SPECIFIC. The id arrays are honoured only
  // for the matching scope (e.g. DEPARTMENT reads audienceDeptIds). ALL ignores them.
  audienceScope       AnnouncementAudienceScope @default(ALL)
  audienceEntityIds   String[]                  @default([])
  audienceDeptIds     String[]                  @default([])
  audienceEmployeeIds String[]                  @default([])
  // Presentation + lifecycle
  pinned              Boolean                   @default(false)
  status              AnnouncementStatus        @default(DRAFT)
  // Schedule — publishedAt may be a FUTURE timestamp (scheduled go-live); the feed
  // filters publishedAt <= now(). expiresAt (NULL = never) drops it from the feed.
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  archivedAt          DateTime?
  version             Int                       @default(0)
  // Idempotency stamp for the notification fan-out. Set the FIRST time an
  // announcement goes live (DRAFT/ARCHIVED → PUBLISHED while live). A re-save or
  // re-publish of an already-notified announcement must NOT re-blast its audience,
  // so the fan-out is guarded on this being null. (NULL = never fanned out.)
  notifiedAt          DateTime?

  reads         AnnouncementRead[]
  // Feed social layer — reactions + threaded comments on this post.
  feedReactions FeedReaction[]
  feedComments  FeedComment[]

  // Feed hot-path: tenant + status + publishedAt window, pinned-first.
  @@index([businessId, status, publishedAt])
  @@index([businessId, status, pinned, publishedAt])
}

enum AnnouncementCategory {
  NEWS
  POLICY
  EVENT
  HOLIDAY
  CELEBRATION
  GENERAL
}

enum AnnouncementAudienceScope {
  ALL // every active employee in the tenant
  ENTITY // employees whose current entity ∈ audienceEntityIds
  DEPARTMENT // employees whose current department ∈ audienceDeptIds
  SPECIFIC // explicitly-named employees (audienceEmployeeIds)
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Per-employee read receipt for an announcement (powers mark-as-read + the unread
// badge). Keyed by (announcementId, employeeId) so each employee marks each note
// once; tenant-stamped for isolation. The receipt row's existence == "read".
model AnnouncementRead {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, employeeId])
  @@index([businessId, employeeId])
}

// ════════════════════════════════════════════════════════════════════════════
// Feed social layer — reactions + comments (+ @mentions) on the ESS news feed.
// The feed IS the Announcement table, so the social layer hangs off Announcement:
// a recognition projected as a CELEBRATION announcement (feedProjector.js) gets
// reactions/comments for free. Tenant-isolated by businessId on every row + index.
// ════════════════════════════════════════════════════════════════════════════

// One employee's reaction to one feed post. DESIGN DECISION — SINGLE reaction per
// person per post (@@unique([announcementId, employeeId])). Reacting again REPLACES
// the stored `kind` (an upsert), matching how most social feeds behave (LinkedIn/
// Teams "one reaction, switchable") and keeping the summary a simple per-kind tally.
// A multi-reaction model (one row per kind) was rejected: it complicates "myReaction"
// (becomes a set), the toggle UX, and the aggregate. `kind` is a free-form String
// (LIKE/CELEBRATE/SUPPORT/INSIGHTFUL/LOVE today) so new reactions need no migration.
model FeedReaction {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           String // reaction key: LIKE | CELEBRATE | SUPPORT | INSIGHTFUL | LOVE (extensible)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // ONE reaction per person per post (react-again replaces the kind, never stacks).
  @@unique([announcementId, employeeId])
  @@index([businessId, announcementId])
  @@index([businessId, employeeId])
}

// A threaded comment on a feed post. One level of replies (parentId self-relation;
// parent.parent is always null — enforced in the service). Soft-deletable for
// moderation (deletedAt): a deleted comment is filtered out unless it still has live
// replies, in which case it renders as a "[deleted]" placeholder so the thread keeps
// its shape. @mentions parsed from the body are resolved to employee ids at write
// time and denormalised into mentionedEmployeeIds (drives the FEED_MENTION fan-out).
model FeedComment {
  id                   String        @id @default(uuid())
  businessId           String
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  announcementId       String
  announcement         Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorEmployeeId     String
  author               Employee      @relation("FeedCommentAuthor", fields: [authorEmployeeId], references: [id], onDelete: Cascade)
  body                 String        @db.Text
  // Threading — one level deep. parentId null = top-level; a reply points at a
  // top-level comment. onDelete: NoAction avoids a multi-cascade-path conflict on
  // Announcement delete (the announcement cascade already removes every row).
  parentId             String?
  parent               FeedComment?  @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies              FeedComment[] @relation("FeedCommentReplies")
  // Resolved @mention targets (employee ids), denormalised for the notification fan-out.
  mentionedEmployeeIds String[]      @default([])
  editedAt             DateTime? // set on an author edit (renders an "edited" hint)
  deletedAt            DateTime? // soft-delete (author or operator moderation)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([businessId, announcementId, createdAt])
  @@index([businessId, authorEmployeeId])
  @@index([parentId])
}

// ════════════════════════════════════════════════════════════════════════════
// Feature 33 — Pulse Surveys + eNPS (employee listening)
// Orchestration layer over the engagement engine: the Survey carries the IDENTICAL
// audience + lifecycle columns as Announcement so engagement/audience.js is reused
// verbatim. The one net-new idea is the ANONYMITY FIREWALL: anonymous responses
// carry NO employeeId (no FK to join back); the "who already answered" fact lives
// in a SEPARATE participation ledger that holds zero answer data; k-anonymity
// suppression + the coarse single-dimension segmentLabel snapshot guard the output.
// ════════════════════════════════════════════════════════════════════════════

// The survey template + audience + schedule (mirrors Announcement).
// ── Phase 5b — Custom Fields (tenant-defined, typed fields on Employee) ──────────
// Tenant admins define their own typed fields on the Employee entity; values are
// stored per-employee (one typed column per kind, the other three NULL) and surfaced
// to admin + ESS. Modelled on the Survey/SurveyQuestion/SurveyAnswer definition+value
// precedent: a pure validator/normaliser lives in hr/customfields/customFields.service.js.
// Definitions are soft-archived (isActive=false + deletedAt) so historical values keep
// their def; key + fieldType are IMMUTABLE after create (the value columns depend on them).
model CustomFieldDefinition {
  id          String               @id @default(cuid())
  businessId  String
  entityType  CustomFieldEntity    @default(EMPLOYEE)
  fieldType   CustomFieldType
  key         String // slug, lowercase, unique per (businessId, entityType)
  label       String
  description String?
  options     Json? // SELECT only: [{ value, label }]
  required    Boolean              @default(false)
  essVisible  Boolean              @default(false)
  essPolicy   CustomFieldEssPolicy @default(READ_ONLY)
  section     String?
  orderIndex  Int                  @default(0)
  isActive    Boolean              @default(true)
  version     Int                  @default(1)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]

  @@unique([businessId, entityType, key])
  @@index([businessId, entityType, isActive])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  businessId   String
  definitionId String
  employeeId   String
  textValue    String? // TEXT + SELECT (stores chosen option value)
  numberValue  Float?
  dateValue    DateTime?
  boolValue    Boolean?
  updatedById  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([definitionId, employeeId])
  @@index([businessId, employeeId])
}

enum CustomFieldEntity {
  EMPLOYEE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum CustomFieldEssPolicy {
  HIDDEN
  READ_ONLY
  SELF_EDIT
}

model Survey {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorUserId String // operator; bare id (no FK) — survives author offboard
  authorName   String?

  title              String
  description        String?    @db.Text
  type               SurveyType @default(PULSE) // PULSE | ENPS | CUSTOM
  // ANONYMITY — the hard guarantee. Immutable once a response exists (§5.1).
  anonymous          Boolean    @default(true)
  // k-anonymity floor: smallest segment/total that may be shown. Default 5 (industry norm).
  minResponsesToShow Int        @default(5)

  // Audience — IDENTICAL columns to Announcement so engagement/audience.js is reused as-is.
  audienceScope       SurveyAudienceScope @default(ALL)
  audienceEntityIds   String[]            @default([])
  audienceDeptIds     String[]            @default([])
  audienceEmployeeIds String[]            @default([])

  // Lifecycle (mirrors Announcement) + a response window close.
  status      SurveyStatus @default(DRAFT) // DRAFT | PUBLISHED | CLOSED | ARCHIVED
  publishedAt DateTime? // go-live; feed filters publishedAt <= now (no cron to OPEN)
  closesAt    DateTime? // response window end; runner flips PUBLISHED→CLOSED at closesAt
  notifiedAt  DateTime? // idempotent invite fan-out stamp (NULL = never blasted)

  // Recurrence — NULL cadence = one-shot. A recurring Survey is the *template*; each run
  // is a SurveyOccurrence so anonymous responses are bucketed per occurrence.
  cadence          SurveyCadence? // WEEKLY | FORTNIGHTLY | MONTHLY | QUARTERLY
  cadenceAnchorDay Int? // day-of-week (1–7) or day-of-month per cadence
  windowDays       Int            @default(7) // each occurrence stays open this many days
  recurrenceEndsAt DateTime? // stop spawning occurrences after this (NULL = until paused)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  version    Int       @default(0) // optimistic lock (mirrors Announcement)

  questions   SurveyQuestion[]
  occurrences SurveyOccurrence[]

  @@index([businessId, status, publishedAt])
  @@index([businessId, type, status])
}

enum SurveyType {
  PULSE
  ENPS
  CUSTOM
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SurveyAudienceScope {
  ALL // every active employee in the tenant
  ENTITY // employees whose current entity ∈ audienceEntityIds
  DEPARTMENT // employees whose current department ∈ audienceDeptIds
  SPECIFIC // explicitly-named employees (audienceEmployeeIds)
}

enum SurveyCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
}

// Typed questions + sections.
model SurveyQuestion {
  id         String @id @default(uuid())
  businessId String // denormalised for tenant-scoped reads
  surveyId   String
  survey     Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  section    String? // group label (e.g. "Wellbeing"); null = ungrouped
  orderIndex Int                @default(0)
  type       SurveyQuestionType // SCALE | LIKERT | NPS | SINGLE | MULTI | TEXT
  prompt     String             @db.Text
  required   Boolean            @default(true)

  // Type-specific config (kept as columns + one JSON for options — no per-type tables).
  scaleMin      Int? // SCALE/LIKERT/NPS bounds (NPS pins 0..10 in service)
  scaleMax      Int?
  scaleMinLabel String? // e.g. "Strongly disagree"
  scaleMaxLabel String?
  options       Json? // SINGLE/MULTI: [{ value, label }] (stable values for aggregation)
  allowOther    Boolean @default(false) // MULTI/SINGLE "Other" free-text
  // ENPS computation only runs on questions flagged the eNPS driver (exactly one per ENPS survey).
  isEnpsDriver  Boolean @default(false)

  answers SurveyAnswer[]

  @@index([surveyId, orderIndex])
}

enum SurveyQuestionType {
  SCALE
  LIKERT
  NPS
  SINGLE
  MULTI
  TEXT
}

// One submission (a "ballot") — THE ANONYMITY FIREWALL. For an ANONYMOUS survey this
// row carries NO employeeId — there is structurally no column to join back to a
// person. The only retained slice is a COARSE, k-checked segment label captured AT
// SUBMIT TIME (e.g. "Engineering") for the breakdown — never the raw entity/dept
// ids, never tenure/manager/location combos that could re-identify. For a
// NON-anonymous (attributed) survey, employeeId IS stored.
model SurveyResponse {
  id           String           @id @default(uuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  surveyId     String
  occurrenceId String // every response belongs to a SurveyOccurrence (one-shot has one)
  occurrence   SurveyOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  // ── identity firewall ──
  // anonymous == true  → employeeId is ALWAYS null (enforced in service)
  // anonymous == false → employeeId set (attributed survey, e.g. manager-effectiveness)
  employeeId   String? // intentionally nullable; NO @relation — no FK to join back
  // Coarse segment label snapshot for the breakdown. A SINGLE bucket name only (dept
  // OR entity, the survey's breakdown dimension), never a tuple. Suppressed in output
  // when its group < minResponsesToShow (k-anonymity).
  segmentLabel String?

  submittedAt  DateTime @default(now())
  // Anti-tamper: random per-response token shown to ESS as a receipt; NOT a person link.
  receiptToken String   @default(uuid())

  answers SurveyAnswer[]

  // NOTE: deliberately NO @@index on (occurrenceId, employeeId) — we never query
  // "this person's response". Double-submit is blocked by SurveyParticipation, a
  // SEPARATE table, so content and identity never share a row or an index.
  @@index([surveyId, occurrenceId])
  @@index([businessId, surveyId])
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Exactly one of these is populated per the question type:
  numericValue Int? // SCALE | LIKERT | NPS (0..10)
  choiceValues String[] @default([]) // SINGLE (len 1) | MULTI (len ≥0) — stores option `value`s
  textValue    String?  @db.Text // TEXT, or "Other" free-text (a re-id risk → gated verbatims)

  @@index([questionId])
  @@index([responseId])
}

// One run of a (possibly recurring) survey. A one-shot survey has exactly ONE
// occurrence (created at publish). A recurring survey spawns one per cadence tick
// (pulseScheduleRunner). eNPS trend = score per occurrence over time. Anonymous
// responses bucket per occurrence so "this month's pulse" is a clean cohort.
model SurveyOccurrence {
  id         String @id @default(uuid())
  businessId String
  surveyId   String
  survey     Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  seq          Int // 1,2,3… for display ("Pulse #4")
  opensAt      DateTime // publishedAt of this run
  closesAt     DateTime // opensAt + windowDays
  status       OccurrenceStatus @default(OPEN) // OPEN | CLOSED
  // Denormalised audience size at open (the invite count) — the response-rate denominator.
  invitedCount Int              @default(0)
  notifiedAt   DateTime? // per-occurrence idempotent invite stamp

  responses      SurveyResponse[]
  participations SurveyParticipation[]

  @@unique([surveyId, seq])
  @@index([businessId, status, closesAt])
}

enum OccurrenceStatus {
  OPEN
  CLOSED
}

// Double-submit guard WITHOUT linking content. Records THAT an employee submitted to
// an occurrence — never WHAT. This is the *only* place an employeeId touches an
// anonymous survey, and it holds ZERO answer data. The split is the whole trick:
// content lives in SurveyResponse (no employeeId), the "already done" flag lives here
// (employeeId, no content). Nothing joins the two. Powers: block double-submit, the
// ESS "Done ✓ / Pending" badge, response rate, and reminders to non-responders.
model SurveyParticipation {
  id           String             @id @default(uuid())
  businessId   String
  occurrenceId String
  occurrence   SurveyOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Status lets us count "invited but skipped" for reminders without storing a response.
  state        ParticipationState @default(PENDING) // PENDING | SUBMITTED | DISMISSED
  submittedAt  DateTime?

  @@unique([occurrenceId, employeeId]) // one ballot per person per occurrence (the guard)
  @@index([businessId, employeeId, state])
}

enum ParticipationState {
  PENDING
  SUBMITTED
  DISMISSED
}

// ════════════════════════════════════════════════════════════════════════════
// Feature 37 — LMS (Learning Management System)
// India-first compliance training (POSH annual + new-joiner-30-day, safety, ISMS,
// code-of-conduct). Content tree (Course → Module → Lesson → Quiz → Question);
// assignment (audience rule, reuses engagement/audience.js targeting + a ROLE
// scope); learner records (Enrollment → LessonProgress + QuizAttempt). The
// completion CERTIFICATE is the existing F9 IssuedLetter (no new PDF path); a thin
// LearningCertificate index row points at it for fast lookups.
//
// Conventions mirror schema.prisma house style: businessId FK Cascade, version Int,
// timestamps. CONFIG models (Course/Module/Lesson/Quiz/Question/Assignment) carry
// deletedAt (soft-delete + versioned). LEARNER records (Enrollment/LessonProgress/
// QuizAttempt) are append-mostly "records of fact" (never hard-deleted), mirroring
// the IssuedLetter legal-record stance.
// ════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────  CONTENT (config)  ──────────────────────────
model Course {
  id                    String           @id @default(uuid())
  businessId            String
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId              String? // null = tenant-wide catalog item
  code                  String // "POSH-2026", "ISMS-101" (human; per-tenant unique)
  title                 String
  description           String?          @db.Text
  category              LearningCategory @default(GENERAL)
  thumbnailUrl          String?          @db.Text
  estMinutes            Int? // est. duration for the calendar/UX
  passThreshold         Int?             @default(70) // % across graded quizzes (course-level default)
  completionRule        CompletionRule   @default(ALL_LESSONS) // ALL_LESSONS | QUIZ_PASS | BOTH
  certificateEnabled    Boolean          @default(true)
  certificateTemplateId String? // -> LetterTemplate (LMS_CERTIFICATE); null = tenant default
  status                CourseStatus     @default(DRAFT)
  publishedAt           DateTime?
  publishedBy           String?
  version               Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  modules     CourseModule[]
  assignments CourseAssignment[]
  enrollments Enrollment[]

  @@unique([businessId, code])
  @@index([businessId, status, category])
}

enum LearningCategory {
  POSH
  SAFETY
  COMPLIANCE
  ONBOARDING
  SKILL
  CODE_OF_CONDUCT
  GENERAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompletionRule {
  ALL_LESSONS
  QUIZ_PASS
  BOTH
}

model CourseModule {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int       @default(0)
  version    Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  lessons Lesson[]

  @@index([businessId, courseId, orderIndex])
}

model Lesson {
  id          String       @id @default(uuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId    String // denormalised for cheap course-level progress queries
  title       String
  kind        LessonKind // VIDEO | DOCUMENT | LINK | QUIZ | SCORM
  orderIndex  Int          @default(0)
  isRequired  Boolean      @default(true) // optional lessons don't gate completion
  contentUrl  String?      @db.Text // VIDEO/DOCUMENT file (S3) or LINK/SCORM external URL
  contentText String?      @db.Text // inline DOCUMENT (markdown) alternative
  durationSec Int? // VIDEO length (for minWatchPct)
  minWatchPct Int?         @default(90) // VIDEO completion gate
  estMinutes  Int?
  version     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  quiz     Quiz?
  progress LessonProgress[]

  @@index([businessId, courseId, orderIndex])
  @@index([businessId, moduleId, orderIndex])
}

enum LessonKind {
  VIDEO
  DOCUMENT
  LINK
  QUIZ
  SCORM
}

model Quiz {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lessonId      String    @unique
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passThreshold Int       @default(70) // % to pass this quiz
  maxAttempts   Int?      @default(3) // null = unlimited
  shuffle       Boolean   @default(true)
  version       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([businessId, lessonId])
}

model QuizQuestion {
  id               String       @id @default(uuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quizId           String
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  orderIndex       Int          @default(0)
  prompt           String       @db.Text
  kind             QuestionKind @default(SINGLE) // SINGLE | MULTI | TRUE_FALSE
  // options as JSON: [{ id, text }]; correctOptionIds = string[] of option ids.
  // correctOptionIds is NEVER serialized to the ESS learner runtime (answer-key leak guard).
  optionsJson      Json
  correctOptionIds String[]
  points           Int          @default(1)
  version          Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@index([businessId, quizId, orderIndex])
}

enum QuestionKind {
  SINGLE
  MULTI
  TRUE_FALSE
}

// ──────────────────────────  ASSIGNMENT (audience rule)  ──────────────────────
model CourseAssignment {
  id                  String                @id @default(uuid())
  businessId          String
  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // audience — mirrors engagement Announcement (audience.js SCOPE), + ROLE.
  audienceScope       LearningAudienceScope @default(ALL) // ALL | ENTITY | DEPARTMENT | ROLE | SPECIFIC
  audienceEntityIds   String[]              @default([])
  audienceDeptIds     String[]              @default([])
  audienceRoleIds     String[]              @default([]) // BusinessRole ids
  audienceEmployeeIds String[]              @default([])
  isMandatory         Boolean               @default(true)
  dueInDays           Int? // due = assignedAt + dueInDays (relative; good for new-joiner)
  dueOn               DateTime?             @db.Date // OR an absolute due date (campaign style)
  recurrence          RecurrenceRule        @default(NONE) // NONE | ANNUAL | HALF_YEARLY | QUARTERLY
  newJoinerRule       Boolean               @default(false) // auto-assign to anyone who joins after this assignment
  newJoinerWithinDays Int?                  @default(30) // POSH: 30-day onboarding window
  active              Boolean               @default(true)
  createdBy           String
  version             Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?

  enrollments Enrollment[]

  @@index([businessId, courseId, active])
  @@index([businessId, newJoinerRule, active])
}

enum LearningAudienceScope {
  ALL
  ENTITY
  DEPARTMENT
  ROLE
  SPECIFIC
}

enum RecurrenceRule {
  NONE
  ANNUAL
  HALF_YEARLY
  QUARTERLY
}

// ──────────────────────────  LEARNER RECORDS (per employee)  ──────────────────
model Enrollment {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId        String? // null = self-enrolled (optional catalog course)
  assignment          CourseAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  employeeId          String
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  isMandatory         Boolean           @default(false)
  status              EnrollmentStatus  @default(ASSIGNED)
  assignedAt          DateTime          @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  dueAt               DateTime? // resolved from assignment.dueInDays/dueOn at fan-out
  cycleKey            String // recurrence cycle, e.g. "2026" (annual) | "once" (self/one-off) — uniqueness axis
  progressPct         Int               @default(0) // denormalised 0..100 for cheap dashboards
  certificateLetterId String? // -> IssuedLetter (F9). Set on completion when certificateEnabled
  waivedReason        String? // HR exemption/waiver audit
  waivedBy            String?
  // reminder dedup cursor (mirrors proof-window/compliance last-sent guard) — avoids a storm.
  lastReminderStage   String? // null | DUE_T7 | DUE_T1 | OVERDUE
  lastReminderAt      DateTime?
  version             Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificate    LearningCertificate?

  // one live enrollment per (employee, course, recurrence cycle) — re-assign next year mints a new cycleKey.
  @@unique([businessId, employeeId, courseId, cycleKey])
  @@index([businessId, employeeId, status])
  @@index([businessId, courseId, status])
  @@index([businessId, status, dueAt]) // overdue/due-soon sweeps
}

enum EnrollmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  WAIVED
  EXPIRED
}

model LessonProgress {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollmentId    String
  enrollment      Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status          LessonProgressStatus @default(NOT_STARTED)
  lastPositionSec Int                  @default(0) // VIDEO resume point
  watchedPct      Int                  @default(0)
  completedAt     DateTime?
  version         Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([businessId, enrollmentId, lessonId])
  @@index([businessId, enrollmentId, status])
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model QuizAttempt {
  id           String     @id @default(uuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quizId       String
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptNo    Int        @default(1)
  answersJson  Json // { [questionId]: string[] (chosen option ids) }
  scorePct     Int        @default(0)
  passed       Boolean    @default(false)
  submittedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@unique([businessId, enrollmentId, quizId, attemptNo])
  @@index([businessId, enrollmentId, quizId])
}

// Thin index row for fast cert lookups (the source of truth is IssuedLetter/F9).
model LearningCertificate {
  id                 String     @id @default(uuid())
  businessId         String
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollmentId       String     @unique
  enrollment         Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  employeeId         String
  courseId           String
  issuedLetterId     String // -> IssuedLetter (the real artifact + register)
  employeeDocumentId String? // -> EmployeeDocument (vault copy)
  referenceNo        String
  cycleKey           String?
  issuedAt           DateTime   @default(now())

  @@index([businessId, employeeId])
  @@index([businessId, courseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INDIA SALARY DISBURSEMENT (NET-NEW)
//
// Converts a computed/approved PayRun into a bank-uploadable salary-advice file
// (+ an optional payout-gateway path) with status reconciliation. A PayoutBatch
// is the unit of disbursement for one run on one bank rail; its PayoutLines are
// the per-employee credit instructions (a FROZEN snapshot of net pay + the
// employee's primary bank account at create time — immutable so the generated
// advice file always matches what was sent to the bank).
//
// MONEY RULE: amounts are INTEGER MINOR UNITS (paise) — `amountMinor`,
// `totalMinor`. Never floats. sum(PayoutLine.amountMinor) == PayoutBatch.totalMinor
// == the run's net pay (round-tripped by the service).
//
// Tenant-walled on businessId; indexed for the run/batch/line lookups the
// disbursement console + reconcile upload perform.
// ─────────────────────────────────────────────────────────────────────────────

/// One salary-advice batch: a PayRun rendered for a specific bank rail.
model PayoutBatch {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunId        String
  payRun          PayRun            @relation(fields: [payRunId], references: [id], onDelete: Restrict)
  // Which bank salary-upload format this batch is rendered for (HDFC/ICICI/…) or
  // the generic NEFT/RTGS rail. Drives the pure formatter in bankFormats.js.
  bank            PayoutBank
  status          PayoutBatchStatus @default(QUEUED)
  // Money (paise). totalMinor == Σ line.amountMinor == run net (round-tripped).
  totalMinor      BigInt            @default(0)
  count           Int               @default(0)
  currencyCode    String            @db.Char(3)
  // Company debit account the bank pulls the aggregate credit from (optional —
  // some banks key it off the channel login). Free-text account number.
  debitAccount    String?
  // Requested value date (credit date) for the bank file (YYYY-MM-DD).
  valueDate       DateTime?         @db.Date
  // Optional gateway rail (RazorpayX/Cashfree) — null = bank-file path only.
  gatewayProvider String?
  gatewayBatchId  String?
  createdBy       String
  fileGeneratedAt DateTime? // stamped when the advice file is first generated
  reconciledAt    DateTime? // stamped when reconciliation rolls the batch to a terminal state
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  version         Int               @default(0)

  lines PayoutLine[]

  @@index([businessId, payRunId])
  @@index([businessId, status])
}

/// One per-employee credit instruction inside a PayoutBatch. Bank details are a
/// SNAPSHOT taken at create time (the source BankAccount can change later).
model PayoutLine {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batchId         String
  batch           PayoutBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  amountMinor     BigInt // net pay to credit (paise) — snapshot of PayRunLine.netPay
  beneficiaryName String // snapshot of the bank account holder name
  accountNumber   String // snapshot of BankAccount.accountNumber
  ifsc            String           @db.Char(11) // snapshot of BankAccount.ifsc (IN)
  narration       String? // statement narration (e.g. "SAL JUN2026")
  status          PayoutLineStatus @default(PENDING)
  utr             String? // bank Unique Transaction Reference once credited
  failureReason   String? // populated on FAILED/RETURNED
  reconciledAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  version         Int              @default(0)

  @@index([businessId, batchId, status])
  @@index([businessId, employeeId])
}

/// Supported bank salary-upload rails (India). Each maps to a pure formatter in
/// backend/src/hr/payroll/disbursement/bankFormats.js.
enum PayoutBank {
  HDFC // HDFC Enet bulk salary upload
  ICICI // ICICI Corporate Internet Banking (CIB)
  AXIS // Axis Corporate / Power Access
  KOTAK // Kotak (FYI/Net) bulk upload
  SBI // SBI Corporate (CINB) salary package
  NEFT_RTGS // generic NEFT/RTGS CSV (any bank)
}

/// Batch-level rollup. QUEUED → PROCESSING once the file is generated / sent;
/// PARTIAL/CREDITED/FAILED resolved by reconciliation.
enum PayoutBatchStatus {
  QUEUED
  PROCESSING
  PARTIAL
  CREDITED
  FAILED
}

/// Per-line lifecycle. PENDING → CREDITED (UTR) | FAILED | RETURNED (bounce).
enum PayoutLineStatus {
  PENDING
  CREDITED
  FAILED
  RETURNED
}

// ═══════════════════════════════════════════════════════════════════════════════
// Feature 35 — Rewards & Recognition (R&R). docs/features/35-rewards-recognition.md
// A thin domain layer over four existing engines: the recognition WALL is the
// engagement feed (a projected CELEBRATION Announcement), every approval (budget /
// committee / redemption) is an F10 ApprovalRequest, every certificate is an F9
// IssuedLetter, and the points wallet is an append-only ledger modelled exactly
// like the proven CustomerWallet/WalletLedgerEntry pair (HR-scoped copies below).
// ═══════════════════════════════════════════════════════════════════════════════

// A configurable company value an HR admin defines ("Customer First", "Ownership").
// Recognitions tag one (or zero) value. Seeded with a sensible India-first default set.
model RecognitionValue {
  id           String             @id @default(uuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String // "Customer First"
  description  String?
  icon         String? // emoji or icon key
  colorHex     String?
  sortOrder    Int                @default(0)
  isActive     Boolean            @default(true) // retire without deleting (history intact)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  recognitions Recognition[]
  badges       RecognitionBadge[]

  @@unique([businessId, name])
  @@index([businessId, isActive, sortOrder])
}

// An optional named badge attachable to a recognition ("Above & Beyond", "Team Player").
// May be tied to a value and may carry a DEFAULT point value (overridable per give).
model RecognitionBadge {
  id            String            @id @default(uuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  valueId       String? // optional link to a RecognitionValue
  value         RecognitionValue? @relation(fields: [valueId], references: [id], onDelete: SetNull)
  name          String
  icon          String?
  defaultPoints Int               @default(0) // suggested points when this badge is given
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  recognitions  Recognition[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

// The peer-to-peer give — the heartbeat of R&R.
model Recognition {
  id                String                 @id @default(uuid())
  businessId        String
  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  giverEmployeeId   String // who gave it
  giver             Employee               @relation("RecognitionGiver", fields: [giverEmployeeId], references: [id], onDelete: Cascade)
  valueId           String?
  value             RecognitionValue?      @relation(fields: [valueId], references: [id], onDelete: SetNull)
  badgeId           String?
  badge             RecognitionBadge?      @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  message           String                 @db.Text // the citation / shout-out (sanitised)
  pointsEach        Int                    @default(0) // points awarded to EACH recipient
  visibility        RecognitionVisibility  @default(PUBLIC) // PUBLIC=wall, PRIVATE=just recipient, TEAM
  status            RecognitionStatus      @default(POSTED) // PENDING_APPROVAL → POSTED | REJECTED
  // F10 link when budget approval is required (points*recipients over a threshold).
  approvalRequestId String? // ApprovalRequest.id (RECOGNITION module)
  // The projected feed Announcement (Option A projector, §4.1) — set when POSTED public/team.
  announcementId    String?
  postedAt          DateTime? // when it actually went live (post-approval)
  createdAt         DateTime               @default(now())
  recipients        RecognitionRecipient[]

  @@index([businessId, giverEmployeeId, createdAt])
  @@index([businessId, status, postedAt])
}

// One recognition can name MANY recipients (team kudos). Points post per recipient.
model RecognitionRecipient {
  id            String      @id @default(uuid())
  businessId    String
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pointsPosted  Int         @default(0) // actual points credited (0 until POSTED)
  ledgerEntryId String? // the PointsLedgerEntry that credited them

  @@unique([recognitionId, employeeId]) // no double-naming the same person
  @@index([businessId, employeeId])
}

enum RecognitionVisibility {
  PUBLIC
  PRIVATE
  TEAM
}

enum RecognitionStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED
}

// Cached running balance per employee. The LEDGER is the source of truth; this is the
// version-locked cache (closing == Σ ledger.points), exactly like CustomerWallet.
model PointsWallet {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  balance        Int      @default(0) // spendable points (>= 0, never negative)
  lifetimeEarned Int      @default(0) // for "all-time" leaderboard + badges
  version        Int      @default(0) // optimistic lock for credit/debit races
  updatedAt      DateTime @updatedAt

  @@unique([businessId, employeeId])
  @@index([businessId, balance])
}

// Append-only signed ledger. +points = earned (recognition/award/adjustment);
// -points = spent (redemption) or expired. NEVER updated/deleted (reverse with a new row).
model PointsLedgerEntry {
  id              String       @id @default(uuid())
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  points          Int // signed delta (+earn / -spend / -expire)
  reason          PointsReason // RECOGNITION | AWARD | REDEMPTION | EXPIRY | ADJUSTMENT | REVERSAL
  refType         String? // "Recognition" | "AwardNomination" | "Redemption"
  refId           String?
  note            String?
  expiresAt       DateTime? // for FIFO points-expiry (optional program)
  createdByUserId String? // for ADJUSTMENT (HR manual grant/clawback)
  createdAt       DateTime     @default(now())

  @@index([businessId, employeeId, createdAt])
  @@index([businessId, refType, refId])
  @@index([businessId, expiresAt])
}

enum PointsReason {
  RECOGNITION
  AWARD
  REDEMPTION
  EXPIRY
  ADJUSTMENT
  REVERSAL
}

// A points budget for a giver (or a cost-centre / department) over a period. The give
// path checks the remaining budget; over-budget gives route to F10 (manager) approval.
model RecognitionBudget {
  id              String       @id @default(uuid())
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scope           BudgetScope  @default(GIVER) // GIVER | DEPARTMENT | ENTITY | TENANT
  scopeRefId      String? // employeeId / departmentId / entityId (null for TENANT)
  periodType      BudgetPeriod @default(MONTHLY) // MONTHLY | QUARTERLY | YEARLY
  allocatedPoints Int // budget for the period
  // consumed is DERIVED from POSTED recognitions in the window (not stored), so a
  // mid-period budget edit re-bases cleanly. A cached `consumedPoints` may be added later.
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([businessId, scope, scopeRefId, periodType])
}

enum BudgetScope {
  GIVER
  DEPARTMENT
  ENTITY
  TENANT
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

// An award definition + its recurring cycle ("Employee of the Month"). The cycle is the
// open/close window for nominations; the committee approves via F10 (parallel level).
model AwardCycle {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String // "Employee of the Month — June 2026"
  awardType        String // "EOTM" | "STAR_PERFORMER" | "SPOT" (free label)
  periodLabel      String? // "Jun 2026"
  nominateOpenAt   DateTime
  nominateCloseAt  DateTime
  pointsToWinner   Int               @default(0) // points granted to each winner
  maxWinners       Int               @default(1)
  issueCertificate Boolean           @default(true) // render an F9 award certificate
  committeeUserIds String[]          @default([]) // F10 committee approver set (parallel level)
  status           AwardCycleStatus  @default(OPEN) // OPEN → CLOSED → DECIDED → ARCHIVED
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  nominations      AwardNomination[]

  @@index([businessId, status, nominateCloseAt])
}

model AwardNomination {
  id                  String           @id @default(uuid())
  businessId          String
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycleId             String
  cycle               AwardCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  nominatorEmployeeId String
  nominator           Employee         @relation("AwardNominator", fields: [nominatorEmployeeId], references: [id], onDelete: Cascade)
  nomineeEmployeeId   String
  nominee             Employee         @relation("AwardNominee", fields: [nomineeEmployeeId], references: [id], onDelete: Cascade)
  citation            String           @db.Text // why they deserve it
  valueId             String? // optional value tag
  status              NominationStatus @default(SUBMITTED) // SUBMITTED → SHORTLISTED → WON | NOT_SELECTED
  approvalRequestId   String? // F10 committee request (set when escalated)
  certificateLetterId String? // IssuedLetter.id when WON
  ledgerEntryId       String? // PointsLedgerEntry that granted the prize
  decidedByUserId     String?
  decidedAt           DateTime?
  createdAt           DateTime         @default(now())

  @@unique([cycleId, nominatorEmployeeId, nomineeEmployeeId]) // one nom per pair per cycle
  @@index([businessId, cycleId, status])
  @@index([businessId, nomineeEmployeeId])
}

enum AwardCycleStatus {
  OPEN
  CLOSED
  DECIDED
  ARCHIVED
}

enum NominationStatus {
  SUBMITTED
  SHORTLISTED
  WON
  NOT_SELECTED
}

model CatalogItem {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String // "₹500 Amazon Voucher", "1 Comp-Off Day"
  description    String?
  category       CatalogCategory @default(VOUCHER) // VOUCHER PERK SWAG COMP_OFF WFH CHARITY DONATION
  pointsCost     Int // points required to redeem
  inrValue       Int? // ₹ shadow (for taxable-perquisite flagging)
  stock          Int? // null = unlimited; else decremented on fulfil
  fulfilmentType FulfilmentType  @default(MANUAL) // MANUAL | VOUCHER_CODE | COMP_OFF_GRANT
  isTaxablePerk  Boolean         @default(false) // crosses the ₹5k/yr perquisite line → flag Finance
  isActive       Boolean         @default(true)
  imageUrl       String?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  redemptions    Redemption[]

  @@index([businessId, isActive, category, sortOrder])
}

model Redemption {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  catalogItemId     String
  catalogItem       CatalogItem      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  pointsSpent       Int // snapshot of cost at redeem time
  status            RedemptionStatus @default(PENDING) // PENDING → APPROVED → FULFILLED | REJECTED | CANCELLED
  approvalRequestId String? // F10 REDEMPTION request
  ledgerEntryId     String? // the -points debit row (set on APPROVED)
  fulfilmentRef     String? // voucher code / comp-off credit id / note
  fulfilledByUserId String?
  fulfilledAt       DateTime?
  rejectReason      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([businessId, employeeId, status])
  @@index([businessId, status, createdAt])
}

enum CatalogCategory {
  VOUCHER
  PERK
  SWAG
  COMP_OFF
  WFH
  CHARITY
  DONATION
}

enum FulfilmentType {
  MANUAL
  VOUCHER_CODE
  COMP_OFF_GRANT
}

enum RedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports Platform (gap-fill wave) — saved report definitions + email schedules.
// A ReportDefinition is a saved query over ONE whitelisted dataset in
// backend/src/hr/reports/datasets.js (chosen columns + filters + optional
// group-by + sort). It is validated against that registry on every write AND
// every run — the registry is the single source of truth for what may be
// queried, so a definition can never reach outside its dataset's whitelist.
// A ReportSchedule emails a definition's export (CSV/XLSX/PDF) on a simple
// cron preset (hourly runner in core/lib/scheduler.js).
// ─────────────────────────────────────────────────────────────────────────────

enum ReportCronPreset {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportExportFormat {
  CSV
  XLSX
  PDF
}

model ReportDefinition {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  datasetKey      String // whitelisted key in reports/datasets.js (validated, never free-form)
  columnsJson     Json // ordered chosen column keys ["code","firstName",...] ⊆ dataset.columns
  filtersJson     Json? // { status:"ACTIVE", from:"2026-01-01", ... } — keys ⊆ dataset.filters
  groupBy         String? // one of dataset.groupable (NULL = flat row listing)
  sortJson        Json? // { key, dir:"asc"|"desc" }
  // Visibility: isShared=true → every report viewer in the tenant sees it;
  // false → only its creator (list/read/run all filter on this).
  isShared        Boolean   @default(false)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete (schedules of a deleted definition stop firing)

  schedules ReportSchedule[]

  @@index([businessId, deletedAt])
  @@index([businessId, datasetKey])
}

model ReportSchedule {
  id                 String             @id @default(uuid())
  businessId         String
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reportDefinitionId String
  reportDefinition   ReportDefinition   @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  cronPreset         ReportCronPreset
  // WEEKLY: dayOfWeek 0-6 (Sunday=0). MONTHLY: dayOfMonth 1-31 (clamped to the
  // month's last day, so 31 fires on Feb 28/29). DAILY: unused (NULL).
  anchor             Int?
  hourUtc            Int // 0-23 — the UTC hour the window opens
  format             ReportExportFormat @default(CSV)
  recipientsJson     Json // ["ops@acme.com", ...] — validated email list
  isActive           Boolean            @default(true)
  lastRunAt          DateTime? // stamp of the last attempted window (dedupe within a window)
  lastStatus         String? // "SENT" | "FAILED: <reason>" (fail-soft per schedule)
  createdByUserId    String // the actor whose F1 data scope the scheduled run executes under
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([businessId, isActive])
  @@index([businessId, reportDefinitionId])
}

// =============================================================================
// SSO (SAML 2.0 SP + OIDC RP) + SCIM 2.0 provisioning — v1 (2026-07)
//
// One SsoConnection per tenant (businessId @unique). The public endpoints live
// at /sso/:tenant/* (tenant = Business.slug — IdP-initiated POSTs carry no
// tenant Host, so the slug rides the path). Secrets at rest go through
// core/lib/crypto.js AES-256-GCM (clientSecretEnc / spPrivateKeyEnc) and are
// WRITE-ONLY through the admin API (never echoed back).
//
// ScimToken mirrors the ApiKey pattern: sha256(token) stored, raw shown ONCE,
// last4 for the admin UI, bearer-authed at /scim/v2/* (no session).
// =============================================================================

enum SsoProtocol {
  SAML
  OIDC
}

// Which login surface the connection signs users into:
//   ESS      → employee portal (Customer session cookie)
//   OPERATOR → hr-admin console (User session cookie)
//   BOTH     → the /sso/:tenant/login?target= query picks per-request (ESS default)
enum SsoLoginTarget {
  ESS
  OPERATOR
  BOTH
}

model SsoConnection {
  id          String         @id @default(uuid())
  businessId  String         @unique // ONE connection per tenant (v1)
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  protocol    SsoProtocol
  isActive    Boolean        @default(true)
  displayName String? // login-page button label, e.g. "Sign in with Okta"
  loginTarget SsoLoginTarget @default(ESS)

  // ── OIDC (protocol = OIDC) ──
  issuerUrl       String? // discovery base, e.g. https://login.microsoftonline.com/<tid>/v2.0
  clientId        String?
  clientSecretEnc String? @db.Text // AES-256-GCM (core/lib/crypto) — write-only
  scopes          String  @default("openid email profile")

  // ── SAML (protocol = SAML) ──
  idpEntityId          String?
  idpSsoUrl            String? // IdP HTTP-Redirect SSO endpoint (AuthnRequest target)
  idpCertPem           String? @db.Text // IdP signing cert (PEM or bare base64)
  spPrivateKeyEnc      String? @db.Text // optional SP key for signed AuthnRequests — encrypted
  wantAssertionsSigned Boolean @default(true)

  // ── JIT provisioning ──
  // false → the assertion must match an EXISTING employee email (clean error otherwise);
  // true  → auto-provision a minimal Employee (+ portal identities) on first login.
  jitProvision           Boolean @default(false)
  jitDefaultDepartmentId String?
  // Optional claim/attribute overrides: { email, name, firstName, lastName }
  // each mapping to the IdP claim/attribute name to read instead of the default.
  attributeMapJson       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, isActive])
}

model ScimToken {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String // admin label, e.g. "Okta prod"
  tokenHash       String    @unique // sha256(raw) — raw shown once at mint
  last4           String
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime? // best-effort touch on accepted requests
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([businessId, isActive])
}
