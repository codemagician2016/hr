// ============================================================

model AdminCoupon {
  id                    String                  @id @default(uuid())
  code                  String                  @unique // "LAUNCH3M", "FOUNDERS"
  description           String?
  // FREE_PERIOD      — benefitValue months/days of free subscription
  // LIFETIME_FREE    — no expiry, never billed
  // PERCENT_OFF      — benefitValue = percentage (1-100) [needs Paddle]
  // FIXED_OFF        — benefitValue = amount in benefitCurrency [needs Paddle]
  benefitType           AdminCouponBenefitType
  benefitValue          Float? // interpretation depends on benefitType
  benefitUnit           AdminCouponBenefitUnit? // DAYS / MONTHS / CYCLES — for FREE_PERIOD and recurring discounts
  benefitCurrency       String? // ISO 4217 — for FIXED_OFF only
  allowedCountries      String[] // empty = all; ISO-2 codes
  allowedEmails         String[] // empty = all; lowercased
  allowedBusinessIds    String[] // empty = all
  applicableTiers       String[] // empty = all; PricingTier.slug values
  validFrom             DateTime?
  validUntil            DateTime?
  maxTotalUses          Int? // null = unlimited
  usedCount             Int                     @default(0)
  maxPerUser            Int? // usually 1; null = unlimited
  firstSubscriptionOnly Boolean                 @default(false)
  isActive              Boolean                 @default(true)
  paddleDiscountId      String?
  paddleDiscountStatus  String?
  createdById           String? // SUPER_ADMIN who created it (User.id)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  redemptions AdminCouponRedemption[]
}

