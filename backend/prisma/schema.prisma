model PricingAuditLog {
  id         String      @id @default(uuid())
  entityType String
  entityId   String
  action     AuditAction
  changedBy  String
  oldValue   Json?
  newValue   Json?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([changedBy, createdAt])
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  SYNCED
}

// =============================================================================
// Sprint 1.1 (2026-04-29) — Multi-channel notifications: SMS + WhatsApp + Email
// + dynamic per-country budget engine.
//
// The customer's monthly slot count (e.g., "100 SMS or 200 WhatsApp") is
// derived dynamically from:
//   1. PricingTier.messagingBudgetPercent  → percent of plan price
//   2. tier_price_in_local_currency        → from existing TierPrice rows
//   3. ProviderPriceCache                  → real per-country provider rates
//      (Twilio Pricing API + MSG91 manual config)
//
// Customer never sees dollar amounts — only slot counters that drain in
// real-time as they send. Super-admin tunes one number per tier
// (messagingBudgetPercent) to control SMS/WA generosity globally.
// =============================================================================

// Per-country provider rates, refreshed daily from Twilio Pricing API.
// Used at render time to compute customer-visible slot counts and at send
// time to deduct actual cost from BudgetUsage.
model ProviderPriceCache {
  id              String   @id @default(uuid())
  // ISO 3166-1 alpha-2 (e.g., 'US', 'IN', 'DE')
  countryCode     String
  // 'SMS' | 'WHATSAPP_UTILITY' | 'WHATSAPP_AUTHENTICATION' | 'WHATSAPP_MARKETING' | 'WHATSAPP_SERVICE'
  channel         String
  // Provider's wholesale cost per single message in USD. Stored as Decimal
  // for cent-precision math (Twilio publishes 4-decimal rates like $0.0079).
  providerCostUsd Decimal  @db.Decimal(10, 6)
  // 'TWILIO_API' (auto-refreshed daily) | 'MSG91_MANUAL' (config) | 'MANUAL' (admin override)
  source          String
  // Whether we offer this channel in this country at all. False if the
  // count would be useless (< 10 sends/cycle for a typical tier).
  isAvailable     Boolean  @default(true)
  // Last time the price was refreshed from source (Twilio API, manual update).
  // If older than 7 days for TWILIO_API rows, we alert super-admin.
  lastRefreshedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([countryCode, channel])
  @@index([countryCode])
  @@index([channel, isAvailable])
}

// Per-business notification configuration. Holds super-admin gates,
// customer-side preferences, and SMS terms acceptance.
model NotificationConfig {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Super-admin gates — default FALSE. Sitepresso must explicitly enable
  // managed channels per tenant (anti-abuse + compliance scoping). When
  // disabled, the customer sees no SMS/WA option (only Email).
  managedSmsEnabled      Boolean  @default(false)
  managedWhatsappEnabled Boolean  @default(false)
  // Optional super-admin override of the tier's quota — for power users
  // we want to give more headroom, or troubled accounts we want to throttle.
  // NULL = use tier default. Stored as plan-fraction percentage.
  budgetOverridePercent  Decimal? @db.Decimal(5, 2)

  // Customer's request-access state when managed channels are disabled.
  // Tenant clicks "Request access" → status=PENDING. Super-admin reviews,
  // sets status=APPROVED (auto-flips managedSmsEnabled) or REJECTED.
  // 'NONE' | 'PENDING' | 'APPROVED' | 'REJECTED'
  requestAccessStatus String    @default("NONE")
  requestAccessNote   String?   @db.Text
  requestAccessAt     DateTime?
  requestReviewedAt   DateTime?
  requestReviewedBy   String?

  // Customer-side per-event channel grid. JSON map:
  // { "BOOKING_CONFIRMED": { "sms": true, "whatsapp": true, "email": true },
  //   "REMINDER_DAY_BEFORE": { "sms": false, "whatsapp": true, "email": false }, ... }
  // Smart router consults this per outbound message.
  eventChannels Json @default("{}")

  // What happens when budget hits 100%:
  // 'AUTOBUY_5' (default — buy $5 pack) | 'PAUSE' | 'STOP'
  quotaExhaustedAction   String  @default("PAUSE")
  // Set when we last notified admin about exhaustion (avoid spamming).
  quotaExhaustedNotified Boolean @default(false)

  // Tenant SMS terms — required before managed SMS activates. Click-through
  // consent stored here; version bumps invalidate prior acceptance.
  smsTermsAcceptedAt DateTime?
  smsTermsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestAccessStatus])
}

// Pre-approved DLT/Twilio template registry. All managed SMS uses one of
// these (no free-form sending). Templates carry compliance metadata so
// the smart router can validate before send and block non-compliant.
model MessageTemplate {
  id          String   @id @default(uuid())
  // Stable identifier referenced from app code:
  // 'OTP_VERIFICATION', 'BOOKING_CONFIRMED', 'REMINDER_DAY_BEFORE', etc.
  templateKey String   @unique
  // Human label shown in admin UI.
  displayName String
  // 'TRANSACTIONAL' | 'SERVICE' | 'PROMOTIONAL' | 'AUTHENTICATION'
  category    String
  // Which vertical(s) this template is offered to.
  // 'ALL' | 'APPOINTMENT' | 'ECOMMERCE' | 'STATIC'
  vertical    String   @default("ALL")
  // Body with merge-tag placeholders, e.g.,
  // "Hi {NAME}, reminder: your visit to {BIZ} tomorrow at {TIME}."
  body        String   @db.Text
  // Variables this template accepts (validated at send time).
  variables   String[] @default([])

  // Channel-specific provider IDs (filled after DLT/Twilio approval).
  msg91TemplateId  String?
  twilioContentSid String? // Twilio Content API SID for WhatsApp templates
  // 'DRAFT' | 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED'
  approvalStatus   String    @default("DRAFT")
  approvalNote     String?   @db.Text
  approvedAt       DateTime?

  // Channels this template can be sent via.
  smsEnabled      Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  emailEnabled    Boolean @default(true)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries MessageDelivery[]

  @@index([vertical, isActive, sortOrder])
}

// Immutable audit log of every send attempt. Never deleted (1-year retention
// floor for regulatory inquiries). Tracks state machine: PENDING → SENT →
// DELIVERED, with FAILED / BLOCKED branches.
model MessageDelivery {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Recipient
  recipientPhone   String? // E.164 — null for email-only
  recipientEmail   String?
  recipientCountry String // ISO-2

  // Channel + content
  channel      String // 'SMS' | 'WHATSAPP' | 'EMAIL'
  templateId   String?
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  bodySnapshot String           @db.Text // Final rendered body (post merge tags)
  variables    Json? // Variables used in render (for debugging)

  // Cost tracking — what we paid the provider for this send.
  providerCostUsd Decimal @default(0) @db.Decimal(10, 6)

  // Provider details
  provider          String // 'TWILIO_SMS' | 'MSG91_SMS' | 'TWILIO_WA' | 'SES_EMAIL'
  providerMessageId String? // ID returned by provider for status callbacks

  // State machine
  // PENDING → SENT → DELIVERED (happy path)
  // PENDING → BLOCKED_OPTOUT | BLOCKED_QUOTA | BLOCKED_RATE_LIMIT (pre-send)
  // SENT → FAILED (post-send failure callback)
  status        String  @default("PENDING")
  failureReason String?

  // Trigger correlation (so we can investigate "why did this send")
  triggeredBy   String // 'CRON_REMINDER' | 'BOOKING_CREATED' | 'MANUAL_TEST' | 'ORDER_PAID' | etc.
  appointmentId String?
  orderId       String?

  // Timestamps
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?

  @@index([businessId, createdAt])
  @@index([recipientPhone, channel])
  @@index([status])
  @@index([triggeredBy])
}

// Atomic send-dedupe claim for the HR approval/SLA real-channel fan-out (notify.js).
// The previous design did a check-then-act against MessageDelivery.triggeredBy, which
// two concurrent sweeps could both pass — double-sending the same reminder/notice. This
// table makes the dedupe a single atomic INSERT under a UNIQUE token: the first send
// claims the token and proceeds; a concurrent second send hits the unique violation and
// skips. Best-effort/non-blocking: a claim failure never breaks the domain tx.
model HrNotifyDedupe {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // The deterministic dedupe token (e.g. 'HR_REM:<reqId>:<step>:w<ver>:<uid>'). Unique
  // per business so a token can only be claimed once.
  token     String
  createdAt DateTime @default(now())

  @@unique([businessId, token])
  @@index([businessId, createdAt])
}

// Per-business per-cycle messaging spend tracking. One row per (business,
// cycle). Cycle is calendar month 'YYYY-MM' for predictable resets.
// Internal accounting; customer dashboard shows derived slot counts only.
model BudgetUsage {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // 'YYYY-MM' calendar-month cycle — easy to query, easy to display.
  cycle      String

  // Actual USD spent (cumulative for this cycle).
  smsSpentUsd      Decimal @default(0) @db.Decimal(10, 6)
  whatsappSpentUsd Decimal @default(0) @db.Decimal(10, 6)

  // Counters (number of messages sent this cycle).
  smsCount      Int @default(0)
  whatsappCount Int @default(0)

  // Overage purchases this cycle (added to next Paddle invoice).
  overagePurchasedUsd Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, cycle])
  @@index([cycle])
}

// Universal opt-out list. When a recipient texts STOP to any tenant's SMS,
// we blacklist their number across ALL Sitepresso tenants — both regulatory
// (TCPA, TRAI) and ethical. Reverse with explicit user request only.
model SmsOptOut {
  id                    String   @id @default(uuid())
  // E.164 — universal across tenants.
  recipientPhone        String   @unique
  // 'STOP_REPLY' (auto from inbound webhook) | 'MANUAL' (admin) | 'TENANT_REQUEST'
  source                String
  optedOutAt            DateTime @default(now())
  // Optional: the tenant from whose message the STOP came (audit trail).
  triggeredByBusinessId String?

  @@index([recipientPhone])
}

// =============================================================================
// Sprint 1.2 (2026-04-29) — Marketing automation (Pro tier)
//
// Six pre-built campaigns:
//   BIRTHDAY · POST_VISIT · NO_SHOW_WINBACK · LAPSED_90D · ANNIVERSARY ·
//   LOYALTY_MILESTONE
//
// Tenant enables/disables each via AutomationCampaign rows. Triggers fire
// hourly via cron — creates AutomationEnrollment with scheduledFor (handles
// "send 24h after appointment" type delays). Send dispatcher (every 5 min)
// picks up due enrollments and routes through Sprint 1.1's smart channel
// router so email/SMS/WhatsApp + budget + opt-out all flow correctly.
//
// CustomerMarketingOptOut is a granular per-tenant opt-out (separate from
// SmsOptOut which is universal). Customer clicks unsubscribe in an email →
// blacklisted from marketing for that tenant only. SmsOptOut still blocks
// SMS/WA platform-wide; this only governs marketing-category sends.
// =============================================================================

model AutomationCampaign {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // 'BIRTHDAY' | 'POST_VISIT' | 'NO_SHOW_WINBACK' | 'LAPSED_90D' | 'ANNIVERSARY' | 'LOYALTY_MILESTONE'
  campaignKey String
  isEnabled   Boolean @default(false)

  // JSON { email: bool, sms: bool, whatsapp: bool } — defaults to email-only
  // when a tenant first enables a campaign. Customer can opt into SMS/WA but
  // those uses budget from Sprint 1.1.
  channels Json @default("{\"email\":true,\"sms\":false,\"whatsapp\":false}")

  // Optional content overrides — when null, campaign uses the bundled default
  // copy from `lib/marketing/campaigns.js`. Custom subject/body must still
  // honor the template-only architecture (DLT-compliant variables).
  customSubject    String?
  customBody       String? @db.Text
  // Couponcode to embed in win-back / anniversary campaigns. NULL = no coupon.
  customCouponCode String?

  // Per-campaign timing override (e.g., "send post-visit 48h instead of 24h").
  // NULL = use campaign defaults from lib/marketing/campaigns.js.
  delayHoursOverride Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments AutomationEnrollment[]

  @@unique([businessId, campaignKey])
  @@index([businessId, isEnabled])
}

model AutomationEnrollment {
  id         String             @id @default(uuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   AutomationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Recipient — typically a Customer row exists, but enrollment can also
  // target email-only contacts (legacy / imported lists).
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recipientEmail String?
  recipientPhone String?
  recipientName  String?

  // When the trigger condition was satisfied (e.g., the appointment ended).
  triggeredAt  DateTime
  // When to actually send (triggeredAt + campaign.delay).
  scheduledFor DateTime
  // Set when sent successfully.
  sentAt       DateTime?

  // 'PENDING' (waiting for scheduledFor) | 'SENT' | 'FAILED' | 'SUPPRESSED' | 'CANCELLED'
  // SUPPRESSED = customer opted out / over frequency cap / channels disabled
  status        String  @default("PENDING")
  failureReason String?

  // Snapshot of what got rendered (for debugging + analytics)
  variables         Json?
  // FK to MessageDelivery once the send succeeds — gives us the full audit
  // trail (provider cost, delivery status callbacks, etc.) for free.
  messageDeliveryId String?

  // Engagement tracking — populated as user interacts with the message.
  openedAt       DateTime?
  clickedAt      DateTime?
  unsubscribedAt DateTime?

  // Reference to source row (e.g., the appointmentId that triggered this).
  // Used by frequency-cap check ("only one POST_VISIT per appointment").
  triggerSourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, campaignId, customerId, triggeredAt, triggerSourceId])
  @@index([businessId, campaignId, status])
  @@index([scheduledFor, status])
  @@index([customerId])
}

model CustomerMarketingOptOut {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Either customerId OR recipientEmail must be set (we resolve via email
  // when a customer clicks unsubscribe from a one-shot anonymous send).
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recipientEmail String?

  // 'CUSTOMER_LINK' (one-click unsubscribe) | 'STAFF_REQUEST' | 'GLOBAL_STOP' (mirrored from SmsOptOut)
  source      String
  // Optional: which campaign triggered the unsubscribe. NULL = global opt-out
  // for this tenant (won't receive any marketing).
  campaignKey String?

  optedOutAt DateTime @default(now())

  @@unique([businessId, customerId, campaignKey])
  @@unique([businessId, recipientEmail, campaignKey])
  @@index([businessId, customerId])
  @@index([businessId, recipientEmail])
}

// =============================================================================
// Sprint 1.3 (2026-04-29) — Advanced intake forms (Pro tier)
//
// Tenant defines reusable forms (e.g. "New patient intake") and attaches
// them to specific services. Customer fills the form during the booking
// flow OR from their portal post-booking. Submission stored alongside the
// appointment for staff review.
//
// Field definitions live in JSON (`fields` on IntakeForm). Each field has:
//   id          stable identifier
//   type        text | textarea | email | phone | number | select | radio
//                | checkbox | date | file | signature | markdown (info)
//   label       customer-visible label
//   helpText    optional sub-label
//   required    bool
//   options[]   for select/radio/checkbox
//   showIf      conditional logic: { fieldId, operator, value }
//
// Answers in JSON on IntakeSubmission keyed by field.id. File uploads go
// through the existing /api/upload (S3) and the URL is stored as the answer.
// Signature is base64 PNG data URL.
// =============================================================================

model IntakeForm {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String // e.g. "New patient intake"
  description String? @db.Text

  // JSON array of field definitions. See file-level comment for shape.
  fields Json @default("[]")

  // Stays referenced by Service.intakeFormId until tenant deletes the form.
  // Soft-disable via isActive=false to hide from new bookings without
  // breaking existing submissions tied to this form.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services    Service[]
  submissions IntakeSubmission[]

  @@index([businessId, isActive])
}

// =============================================================================
// Sprint 3.2 (2026-04-29) — Blog engine (STATIC Pro tier)
// =============================================================================
model BlogPost {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  excerpt         String?   @db.Text
  content         String    @db.Text // Markdown or HTML
  coverImageUrl   String?   @db.Text
  authorName      String?
  // Comma-separated tag list (kept simple for MVP; full Tag table is Phase 3.2b)
  tagsCsv         String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Sprint 3.2b — comments + likes
  comments BlogComment[]
  likes    BlogLike[]

  // Sprint 3.2c — optional category. NULL = uncategorised; renders in
  // the "All posts" list but no chip filter highlights it.
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([businessId, slug])
  @@index([businessId, isPublished, publishedAt])
  @@index([categoryId, isPublished, publishedAt])
}

// Sprint 3.2c (2026-04-30) — Blog categories.
//
// Single-category-per-post (BlogPost.categoryId) is the MVP shape. If
// multi-category becomes a real product need (a post that belongs in
// "Recipes" + "Vegetarian" simultaneously), this evolves into a join
// table — but most small-business blogs are fine with one primary
// category, and the simpler schema also keeps the storefront filter UI
// trivial (chips → toggle one active category).
//
// Distinct from BlogPost.tagsCsv: tags are searchable keywords with no
// dedicated UI; categories are top-level navigation in the storefront
// (filter chips on /blog) and a dropdown in the admin post editor.
model BlogCategory {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  posts      BlogPost[]

  @@unique([businessId, slug])
  @@index([businessId, sortOrder])
}

// =============================================================================
// Sprint 3.2b (2026-04-30) — Blog comments + likes + per-tenant settings.
//
// Comments are 1-level threaded (parent + replies, no deeper nesting). Author
// is either a logged-in Customer (customerId set) or a Guest (customerId
// null, authorName + authorEmail collected from the form). Moderation is
// PRE_MODERATE by default — admin approves each comment before it's visible
// on the storefront. NONE skips moderation entirely.
//
// Likes are anonymous-friendly: a logged-in Customer's likes are stored with
// customerId; a guest visitor's likes are stored against a long-lived
// sessionId cookie. Either column is set, never both — and the table has
// unique constraints on (postId, customerId) and (postId, sessionId) to
// prevent dup-spam from the same actor.
//
// BlogSettings is one row per Business — created on first read via upsert
// in the controller (no migration backfill required).
// =============================================================================

enum BlogCommentStatus {
  PENDING // awaiting admin moderation
  APPROVED // visible on storefront
  SPAM // marked as spam by admin; hidden but kept for trail
}

enum BlogCommentAuthorType {
  GUEST // anonymous; name + email collected from the form
  CUSTOMER // logged-in tenant customer (customerId set)
}

enum BlogModerationMode {
  NONE // every comment is auto-approved on submit
  PRE_MODERATE // every comment lands as PENDING, admin reviews
}

// Who can comment / like — applied independently. STATIC verticals usually
// pick GUEST_ONLY (no customer registration on those sites). Tenants with
// customer accounts (APPOINTMENT, ECOMMERCE) can pick BOTH.
enum BlogParticipantPolicy {
  NONE // disabled — feature off
  GUEST_ONLY // anonymous only (name + email required for comments)
  REGISTERED_ONLY // logged-in customers only
  BOTH // either path is fine
}

model BlogComment {
  id          String                @id @default(uuid())
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  postId      String
  post        BlogPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Threading — one level deep. parent.parent is always null.
  parentId    String?
  parent      BlogComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     BlogComment[]         @relation("CommentReplies")
  authorType  BlogCommentAuthorType
  // Customer FK is set ONLY when authorType=CUSTOMER. SetNull on customer
  // self-delete preserves the comment under the stored authorName.
  customerId  String?
  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  body        String                @db.Text
  status      BlogCommentStatus     @default(PENDING)
  // Captured on submit purely for spam moderation; never displayed.
  ipAddress   String?
  userAgent   String?               @db.Text
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([postId, status, createdAt])
  @@index([businessId, status, createdAt])
  @@index([parentId])
}

model BlogLike {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  postId     String
  post       BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Exactly one of customerId / sessionId is non-null. The unique
  // constraints below prevent the same actor from liking twice.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  createdAt  DateTime  @default(now())

  @@unique([postId, customerId])
  @@unique([postId, sessionId])
  @@index([businessId, createdAt])
}

model BlogSettings {
  id                      String                @id @default(uuid())
  businessId              String                @unique
  business                Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  commentsEnabled         Boolean               @default(true)
  likesEnabled            Boolean               @default(true)
  commentPolicy           BlogParticipantPolicy @default(BOTH)
  likePolicy              BlogParticipantPolicy @default(BOTH)
  moderationMode          BlogModerationMode    @default(PRE_MODERATE)
  notifyAdminOnNewComment Boolean               @default(true)
  // Always true per product spec — guests must give an email so the admin
  // can spot fake/garbage comments. Kept as a column to make it tweakable
  // without code changes if the policy evolves.
  guestRequiresEmail      Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

// =============================================================================
// Sprint 2.8 (2026-04-29) — POS sync (ECOMMERCE Business tier)
//
// Read-only inventory + sales sync from a tenant's existing POS (Square,
// Clover). Stores OAuth tokens + last-sync timestamp + syncEnabled toggle.
// Actual sync workers run on a daily cron, pulling product + sales data
// and reconciling stock counts on Sitepresso side.
// =============================================================================
model PosIntegration {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider       String // 'SQUARE' | 'CLOVER'
  // OAuth credentials. Encrypted at the application layer; we store the
  // raw token here for simplicity but should switch to KMS-backed secrets
  // before scale.
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  // Provider-side merchant ID (Square) or merchant_id (Clover)
  merchantId     String?
  syncEnabled    Boolean   @default(false)
  lastSyncedAt   DateTime?
  lastSyncStatus String? // 'OK' | 'ERROR' | 'PARTIAL'
  lastSyncError  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, provider])
  @@index([businessId])
}

// =============================================================================
// Sprint 2.7 (2026-04-29) — Multi-store (ECOMMERCE Business tier)
//
// One Business can host multiple branded storefronts. Each StoreBrand has
// its own slug, display name, theme + tagline. Products + Orders carry an
// optional brandId; null = belongs to the main brand. Storefront routing
// resolves <brandSlug>.<businessSubdomain> or a separate custom domain.
// =============================================================================
model StoreBrand {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  slug         String // unique within a business
  description  String?  @db.Text
  logoUrl      String?  @db.Text
  // Storefront routing — either a sub-slug (brandSlug.businessSubdomain) or a fully custom domain.
  customDomain String?
  themeColors  String? // JSON: { primary, accent, surface }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Sprint 2.7b — products can be scoped to a specific brand (or NULL = shared)
  products Product[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
}

// =============================================================================
// Sprint 2.1 + 2.2 (2026-04-29) — Payment provider linked accounts (ECOMMERCE)
//
// Tenants on the ECOMMERCE vertical onboard with one of:
//   RAZORPAY  — IN-only; Sitepresso uses Razorpay Route (split payments).
//               Tenant gets onboarded as a Linked Account under Sitepresso's
//               principal Razorpay account; Razorpay handles KYC.
//   STRIPE    — Global; Stripe Connect Express. Tenant signs up via Stripe-
//               hosted onboarding link.
// =============================================================================
model BusinessPaymentAccount {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider       String // 'RAZORPAY' | 'STRIPE'
  // Provider's account id. Razorpay: linked-account ID (Route). Stripe:
  // connected account ID (acct_xxxxxxx).
  accountId      String
  // Legacy Razorpay BYO credentials. Retained only so already-connected legacy
  // accounts can continue to process/refund payments while sellers migrate to
  // Route linked-account onboarding.
  keyId          String?
  keySecretEnc   String?
  // 'PENDING' (KYC in progress) | 'ACTIVE' | 'REJECTED' | 'DISABLED'
  status         String   @default("PENDING")
  // Platform commission percentage to take per transaction. Tier-based:
  // Solo 2.5 / Starter 2.0 / Pro 1.5 / Business 1.0.
  // 0 = pure pass-through: the tenant keeps 100% of their sales and Sitepresso
  // takes NO per-sale cut (we monetize via subscriptions). A per-tenant fee can
  // still be set explicitly if ever desired.
  platformFeePct Decimal  @default(0) @db.Decimal(5, 2)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessId, provider])
  @@index([businessId])
}

// AapkaConnect — a tenant's connection to an external service app (delivery, WMS,
// chat, POS, …). ONE generic engine connects to ANY provider that speaks the
// AapkaConnect standard (a /.well-known/aapka-connect manifest + Bearer API key +
// HMAC-signed webhooks). Generalizes the BYO BusinessPaymentAccount idea to any
// service category — adding a new provider is a connection ROW, not new code.
model ServiceConnection {
  id            String   @id @default(uuid())
  businessId    String
  category      String // 'delivery' | 'wms' | 'chat' | 'pos' | …
  provider      String // manifest.name, e.g. 'AapkaRider'
  baseUrl       String
  apiKeyEnc     String? // the tenant's provider API key, encrypted at rest
  webhookSecret String? // secret returned when we registered our webhook (verify inbound)
  manifest      Json? // cached /.well-known/aapka-connect
  workspaceId   String? // the per-tenant workspace on the provider (if provisioned)
  status        String   @default("ACTIVE") // ACTIVE | DISABLED | ERROR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, category])
  @@index([businessId])
}

// Per-country buyer-payment policy (2026-06-09). Controls whether INTEGRATED
// buyer payments (Stripe Connect / Razorpay Route — where Sitepresso is the
// platform-of-record and carries the fraud/KYC/chargeback liability) are offered
// to sellers in that country, or ONLY BYO (the seller's own gateway keys;
// Sitepresso is never in the money flow → no liability). NO row = the safe
// default: BYO-only. A row with integratedEnabled=true opts that country in.
model PaymentCountryPolicy {
  countryCode       String   @id // ISO-2, uppercase
  integratedEnabled Boolean  @default(false)
  updatedBy         String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// =============================================================================
// Sprint 1.7 (2026-04-29) — Public API + webhooks (Business tier)
//
// Lets external integrations:
//   - Read appointments / customers / services / orders via /api/v1/*
//     authenticated by ApiKey
//   - Subscribe to events via WebhookSubscription (URL + event list)
//   - Receive POSTs with HMAC-SHA256 signature in `X-Sitepresso-Signature`
//
// WebhookDelivery rows track each attempt; cron retries failures with
// exponential backoff up to 5 attempts.
// =============================================================================

model ApiKey {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Stores hash(key) — raw key shown to admin once at creation, never again.
  keyHash    String    @unique
  // Last 4 chars for UI display so admin can identify which key is which.
  keyLast4   String
  name       String
  // JSON: { read: ['appointments','customers',...], write: ['appointments',...] }
  scopes     Json      @default("{\"read\":[],\"write\":[]}")
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId, isActive])
  @@index([keyHash])
}

model WebhookSubscription {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  // JSON array of event names: ['appointment.created', 'order.paid', ...]
  events     Json     @default("[]")
  // HMAC signing secret. Generated on creation, never re-shown.
  secret     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([businessId, isActive])
}

model WebhookDelivery {
  id             String              @id @default(uuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String // 'appointment.created' etc.
  payload        Json // body delivered
  // Delivery state machine.
  // PENDING → SENT (HTTP 2xx) | RETRYING (4xx/5xx; reschedules) | FAILED (max attempts)
  status         String              @default("PENDING")
  attempts       Int                 @default(0)
  responseStatus Int?
  responseBody   String?
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([status, nextRetryAt])
  @@index([businessId, createdAt])
  @@index([subscriptionId])
}

// =============================================================================
// Sprint 1.6 (2026-04-29) — RBAC custom roles (Business tier)
//
// User.role still drives platform-level access (USER / CUSTOMER / STAFF /
// BUSINESS_ADMIN / SUPER_ADMIN). For tenants on the Business tier we layer
// per-business custom roles on top: a "Senior Manager" role with permissions
// {canManageStaff, canViewReports, canRefundOrders, ...}. Enforcement is
// gradual — middleware checks added per controller as Business-tier needs
// surface. Storage is JSONB so adding a new permission key never requires
// a migration.
// =============================================================================
// Hierarchical data-scope band: WHO a role may act on, ANDed with action permissions.
// none ⊂ self ⊂ team(reporting sub-tree) ⊂ department ⊂ all. Default ALL keeps
// existing tenants behaving exactly as before (no regression).
enum ScopeBand {
  NONE
  SELF
  TEAM
  DEPARTMENT
  ALL
}

model BusinessRole {
  id             String         @id @default(uuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  // JSON: { canManageStaff: bool, canViewReports: bool, canRefund: bool,
  //         canEditPricing: bool, canExportData: bool, canManageMarketing: bool, ... }
  // Legacy back-compat for APPOINTMENT-vertical roles. ECOMMERCE Path B
  // (2026-05-01) uses the relational `permissionGrants` below — JSON stays
  // for tenants who haven't been migrated yet.
  permissions    Json           @default("{}")
  // HR hierarchical data scope (Feature 1). Resolves WHO this role acts on:
  // Manager=TEAM (their reporting sub-tree), Owner/HR-Admin/Finance=ALL.
  defaultScope   ScopeBand      @default(ALL)
  // Feature 5 — salary-masking level intersected with canViewCompensation + scope.
  // ABSOLUTE=full money, RANGE_ONLY=band/compa-ratio only (no absolute),
  // SELF_ONLY=own pay only, NONE=no team comp. Manager-with-grant→RANGE_ONLY,
  // HR/Finance/Owner→ABSOLUTE, Employee→SELF_ONLY.
  compVisibility CompVisibility @default(NONE)
  // Feature P5c — field-level permissions. Map of governable employee field-GROUP ->
  // access ('HIDDEN' | 'READ' | 'WRITE'), e.g. { bank:'HIDDEN', identity:'READ' }.
  // Absent/empty = WRITE on every group (fail-open; every existing role is unchanged).
  // Only ever RESTRICTS (never escalates), so it may be set on system roles too.
  fieldAccess    Json?          @default("{}")
  isSystem       Boolean        @default(false) // pre-seeded "Owner / Manager / Front Desk"
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members            User[]
  // ── ECOMMERCE Path B Phase 2a (2026-05-01) — relational RBAC ──
  permissionGrants   EcomRolePermissionGrant[]
  // ── HR fork — relational HR permission grants ──
  hrPermissionGrants HrRolePermissionGrant[]   @relation("HrRoleGrants")

  @@unique([businessId, name])
  @@index([businessId])
}

// =============================================================================
// Sprint 1.5 (2026-04-29) — Multi-location (Business tier)
// =============================================================================

model BusinessLocation {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String // "Main Branch", "Downtown Studio", etc.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  // Operating hours can later override Business.businessHours per-location.
  // For MVP we just store the location; appointments link to it.
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments                Appointment[]
  staffSchedules              StaffSchedule[]
  restaurantDiningAreas       RestaurantDiningArea[]
  restaurantServicePeriods    RestaurantServicePeriod[]
  restaurantReservations      RestaurantReservation[]
  // ── ECOMMERCE Path B Phase 2a (2026-05-01) ──
  inventoryStocks             InventoryStock[]             @relation("StockLocation")
  ecomRoutes                  EcomDeliveryRoute[]          @relation("RouteOrigin")
  ecomDeliveryRequests        EcomDeliveryRequest[]        @relation("DeliveryRequestLocation")
  ecomDeliveryCashSettlements EcomDeliveryCashSettlement[] @relation("DeliveryCashSettlementLocation")
  ecomRiderShifts             EcomRiderShift[]             @relation("RiderShiftLocation")
  ecomDeliverySlots           EcomDeliverySlot[]           @relation("SlotLocation")
  ecomRiderHomes              EcomRider[]                  @relation("RiderHomeLocation")
  ecomGrants                  EcomRolePermissionGrant[]    @relation("EcomGrantLocation")
  ecomPickupLocations         EcomPickupLocation[]         @relation("PickupBusinessLocation")
  // ── ECOMMERCE multi-store (2026-05-11) ──
  carts                       Cart[]                       @relation("CartLocation")
  orders                      Order[]                      @relation("OrderLocation")
  productOverrides            ProductLocationOverride[]    @relation("LocationProductOverride")
  holidays                    BusinessHoliday[]            @relation("HolidayLocation")

  @@index([businessId, isActive])
}

// =============================================================================
// Restaurant Reservations theme — table inventory, service periods, and
// reservation assignments. Kept separate from the generic appointment slot
// engine so doctors/lawyers continue to schedule by staff, while restaurants
// schedule by table capacity and turnover.
// =============================================================================

model RestaurantSettings {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slotIntervalMinutes   Int      @default(15)
  defaultTurnMinutes    Int      @default(90)
  minAdvanceMinutes     Int      @default(60)
  maxPartySizeOnline    Int      @default(12)
  graceMinutes          Int      @default(15)
  holdMinutes           Int      @default(10)
  onlineBookingEnabled  Boolean  @default(true)
  depositRequired       Boolean  @default(false)
  depositAmount         Float?
  depositMode           String   @default("NONE") // NONE | OPTIONAL | REQUIRED | PREPAID
  minimumSpendEnabled   Boolean  @default(false)
  minimumSpendAmount    Float?
  minimumSpendPerPerson Boolean  @default(false)
  prepaidEnabled        Boolean  @default(false)
  prepaidAmount         Float?
  cancellationFeeAmount Float?
  noShowFeeAmount       Float?
  policyText            String?  @db.Text
