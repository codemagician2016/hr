// BusinessPage — multi-page CMS. Each row is a single sub-page under one
// of the storefront's nav sections (services, team, about, ...). Content
// lives in the JSON `content` blob shaped by the `templateKey` template;
// see `backend/src/lib/pageTemplates.js` for the schema each template
// expects. Storefront renders by matching `templateKey` to the registry's
// renderer.
//
// Unique by (businessId, parentNav, slug) so a business can have one
// "/services/haircut" page but not two. parentNav values mirror the
// storefront top nav: services | team | about | products (e-commerce) |
// info (catch-all for static pages with no parent section).
//
// Pages start unpublished so admins can draft + preview before exposing.
// Admin-side ordering via sortOrder (lower first); ties broken by id.
model BusinessPage {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  parentNav   String // 'services' | 'team' | 'about' | 'products' | 'info'
  slug        String // 'haircut', 'jane-doe', 'our-story' (lowercase, dashes)
  title       String
  templateKey String // e.g. 'service-detail', 'team-bio', 'info-page', 'block-page'
  // Content is a JSON blob whose shape depends on templateKey. Use
  // pageTemplates.validate() before persisting. For 'block-page', this is
  // an object { blocks: [...] } where each block is one of the editor's
  // block types (header, richtext, imagetext, features, cta).
  content     Json          @default("{}")
  isPublished Boolean       @default(false)
  sortOrder   Int           @default(0)
  // Sprint 3.3 — Pages v2 nav placement. Drives where the storefront
  // surfaces this page in the navbar:
  //   TOP      — own top-level menu item
  //   DROPDOWN — nested under another nav item (legacy default; matches
  //              the existing parentNav-grouping behaviour)
  //   FOOTER   — listed in the footer only, not in the main nav
  //   HIDDEN   — accessible by direct URL only, never linked
  placement   PagePlacement @default(DROPDOWN)
  // Optional icon key (e.g. "leaf", "shield", "doc") rendered next to the
  // page in the admin list + nav-manager tree. NULL = no icon, falls back
  // to the templateKey's default in the UI.
  iconKey     String?

  // SEO overrides — optional; fall back to title + 1st paragraph of content
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, parentNav, slug])
  @@index([businessId, parentNav, isPublished, sortOrder])
}

model BusinessSeoSettings {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  siteTitle         String?
  siteDescription   String? @db.Text
  defaultKeywords   String? @db.Text
  canonicalDomain   String?
  defaultOgImageUrl String? @db.Text

  googleAnalyticsId               String?
  googleTagManagerId              String?
  googleSearchConsoleVerification String? @db.Text
  metaPixelId                     String?
  bingVerification                String? @db.Text
  customChatWidgetScript          String? @db.Text

  allowIndexing   Boolean @default(true)
  aiCrawlerPolicy String  @default("allow") // 'allow' | 'disallow_training' | 'disallow_all_ai'
  enableLlmsTxt   Boolean @default(true)
  schemaType      String?
  socialSameAs    String? @db.Text // JSON array of profile URLs
  metaTemplates   String? @db.Text // JSON: per-page-type title/description templates

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoPageOverride {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url       String
  pageType  String
  entityId  String?
  pageTitle String?

  metaTitle        String?
  metaDescription  String? @db.Text
  keywords         String? @db.Text
  canonicalUrl     String? @db.Text
  ogTitle          String?
  ogDescription    String? @db.Text
  ogImageUrl       String? @db.Text
  noIndex          Boolean @default(false)
  includeInSitemap Boolean @default(true)
  sitemapPriority  Float?
  changeFrequency  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, url])
  @@index([businessId, pageType])
}

// ECOMMERCE vertical — Phase 1: Product catalog (read-only storefront).
//
// Phase 2 will add Cart + CartItem + Order + OrderItem when checkout
// lands. Phase 3 adds delivery zones + inventory tracking. See ROADMAP
// E2 for the Shopify-style 7-phase build plan.
//
// All products belong to a Business. Optional category for grouping.
// `imageUrls` is JSON because product galleries vary 0-N images and we
// don't want a separate ProductImage table for v1 — drop in JSON, sort
// by array order, drag-to-reorder on the admin side.
//
// Pricing is stored in MINOR UNITS (paise / cents) so we never lose
// precision to floats. `currency` is ISO 4217 code. `comparePriceMinor`
// is the optional "was ₹X" strikethrough price for sales / promos.
//
// `stockQty` NULL = unlimited stock (digital goods, services); 0 = out
// of stock; positive int = real-time count decremented on order.
// Phase 4 adds the decrement-on-order logic; v1 (catalog only) doesn't
// touch this — it's just displayed on the product card.
//
// `weight` + `weightUnit` are for grocery (per-kg pricing) and shipping
// rate calc. NULL = digital / not weight-priced.
model Product {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name             String
  slug             String // unique per business — "haircut-kit", "wholewheat-bread"
  brand            String? // optional brand label shown above the name on the storefront card
  description      String? // long-form product description (markdown-light)
  shortDescription String? // 1-2 line summary shown on the product grid
  sku              String? // optional inventory code
  barcode          String? // optional EAN/UPC/GTIN or scanner value
  qrCode           String? // optional QR payload/link/text for future scan workflows

  priceMinor          Int // current sale price in minor units (paise / cents)
  comparePriceMinor   Int? // optional "was ₹X" strikethrough
  currency            String @default("INR") // ISO 4217 — INR / USD / etc.
  // How the discount badge is shown on storefront cards: percentage off or
  // flat amount saved. Admins toggle per product. "PERCENTAGE" | "FLAT"
  discountDisplayMode String @default("PERCENTAGE")

  stockQty        Int? // NULL = unlimited; 0 = out of stock; >0 = count
  weightGrams     Int? // for shipping calc + per-kg display
  weightDisplay   String? // free-text override e.g. "500 g pack" — falls back to grams
  // Variable-weight grocery items (loose produce, meat, deli, cheese). When
  // true the storefront sells an *estimate* (priceMinor for an average unit)
  // and the picker records the actual weight at pick time; the line total is
  // recomputed from pricePerKgMinor × pickedWeightGrams and any difference is
  // reconciled (over-estimate → partial refund; under-estimate capped by policy).
  soldByWeight    Boolean @default(false)
  pricePerKgMinor Int? // price per kilogram for soldByWeight items (minor units)
  imageUrls       Json    @default("[]") // array of image URLs (CloudFront / direct)
  specs           Json? // electronics-style structured spec sheet: { highlights: string[], groups: [{ title, rows: [{ label, value }] }] }. Null for non-spec verticals.
  isPublished     Boolean @default(false) // unpublished = drafts hidden from storefront
  isFeatured      Boolean @default(false) // promoted on storefront homepage
  sortOrder       Int     @default(0) // lower first within category

  // SEO overrides — fall back to name + description if null
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems         CartItem[]
  orderItems        OrderItem[]
  // Sprint 2.6b — per-currency price overrides; NULL fallback = FX from priceMinor in defaultCurrency
  prices            ProductPrice[]
  // Sprint 2.7b — optional brand scoping; NULL = product visible across all
  // of the tenant's brands (the default for single-store businesses).
  storeBrandId      String?
  storeBrand        StoreBrand?               @relation(fields: [storeBrandId], references: [id], onDelete: SetNull)
  // 2026-05-09 — structured product-brand FK. The free-text `brand` field
  // above is kept as a denormalized snapshot for back-compat + as the
  // shelf label (so a brand rename doesn't rewrite history). When
  // brandId is set the product participates in brand-level analytics.
  brandId           String?
  productBrand      ProductBrand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // ── ECOMMERCE Path B Phase 2a (2026-05-01) — per-location stock ──
  inventoryStocks   InventoryStock[]
  // ── ECOMMERCE multi-store (2026-05-11) — per-location price + availability ──
  locationOverrides ProductLocationOverride[]
  // ── ECOMMERCE Storefront UX (2026-05-02) ──
  variants          ProductVariant[]
  wishlistItems     WishlistItem[]
  isSample          Boolean                   @default(false) // seeded sample product; removable in one click

  @@unique([businessId, slug])
  @@index([businessId, isPublished, sortOrder])
  @@index([businessId, barcode])
  @@index([categoryId, isPublished, sortOrder])
  @@index([storeBrandId])
}

// Sprint 2.6b — per-currency price override for a single product.
// Tenants enable additional currencies via Business.supportedCurrencies[];
// without an explicit override, storefronts FX-convert from the product's
// `priceMinor` (in defaultCurrency). With an override, that exact figure
// is used instead — typical for "round to ₹999 vs $11.78 from FX".
model ProductPrice {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currencyCode      String // ISO 4217: INR, USD, GBP, …
  priceMinor        Int
  comparePriceMinor Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, currencyCode])
}

// Product variants — size/weight/unit options within one product family.
// e.g. "Capsicum - Green" has variants: 500g / 250g / 1kg, each with
// its own price, compare price, and stock count.
// Products with no variants stay as single-SKU flat products — the
// variant selector is hidden on the storefront card.
model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label             String // "500g", "1 kg" (grocery) OR composed "M / Red" (apparel)
  sku               String?
  priceMinor        Int
  comparePriceMinor Int?
  stockQty          Int? // NULL = unlimited; 0 = out of stock; >0 = count
  // ── Apparel/fashion variant axes (2026-06-13) ──
  // Optional two-dimensional option matrix (e.g. Size × Color). NULL on
  // single-axis grocery variants, which keep using `label` alone. When set,
  // the storefront renders size pills + colour swatches instead of a dropdown
  // and resolves the (option1,option2) pair back to this exact variant for
  // its own price/stock. `label` stays the composed human display.
  option1Name       String? // axis 1 name, e.g. "Size"
  option1Value      String? // axis 1 value, e.g. "M"
  option2Name       String? // axis 2 name, e.g. "Color"
  option2Value      String? // axis 2 value, e.g. "Red"
  swatchHex         String? // colour chip for option2 swatches, e.g. "#C0392B"
  imageUrl          String? // per-colourway image (overrides product gallery)
  sortOrder         Int      @default(0) // lower first in dropdown
  isDefault         Boolean  @default(false) // pre-selected in the picker
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([productId, sortOrder])
}

// Wishlist — one per shopper per business (guest or logged-in).
// Guest lists are keyed by sessionId (same as cart session) and stored
// server-side so they survive refreshes. On login the guest wishlist
// merges into the customer's account wishlist, identical to cart merge.
model Wishlist {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  items      WishlistItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([businessId, customerId])
  @@index([businessId, sessionId])
}

// WishlistItem — one saved product (with optional variant) per wishlist.
// No DB-level unique constraint: same NULL issue as CartItem.variantId —
// deduplication is enforced in application code.
model WishlistItem {
  id         String          @id @default(uuid())
  wishlistId String
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  addedAt    DateTime        @default(now())

  @@index([wishlistId, productId])
  @@index([variantId])
}

// Product categories. Supports one level of parent/child nesting —
// parentId null = top-level; parentId set = subcategory. Slug is unique
// per business for clean URLs.
model ProductCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  slug        String // unique per business — "produce", "dairy", "bakery"
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
  isSample    Boolean @default(false) // seeded by "Load sample catalog"; lets "Remove samples" clean up

  // Optional parent — depth gated by Business.categoryMaxDepth (default 2,
  // up to 3 with the 3-level feature, configurable to higher in future).
  // lib/categoryDepth.js validates depth + cycles on every create/move.
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([businessId, slug])
  @@index([businessId, isPublished, sortOrder])
  @@index([parentId])
}

// Cart — one-per-shopper-per-business. Two shopper-identity modes:
//   * Guest:        sessionId is set, customerId is null.
//   * Logged-in:    customerId is set; sessionId may also be present from
//                   their pre-login browsing — we merge guest carts into
//                   the customer cart on login.
// On checkout we DO NOT delete the cart immediately — we leave it so the
// "Order placed" confirmation can re-render line items, then a cleanup
// cron deletes carts older than 30 days. Lifetime is short by design;
// we intentionally do not persist long-lived wishlists here.
model Cart {
  id         String            @id @default(uuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  sessionId  String? // browser-side cookie ID; UUID set by storefront
  currency   String            @default("INR") // ISO 4217 — locked at first add
  // ECOMMERCE multi-store (2026-05-11) — which physical store fulfils this cart.
  // Nullable: set once the shopper resolves a location (pincode / geo / picker).
  // Switching it triggers cart reconciliation (price + availability re-check).
  locationId String?
  location   BusinessLocation? @relation("CartLocation", fields: [locationId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  items CartItem[]

  @@index([businessId, customerId])
  @@index([businessId, sessionId])
  @@index([businessId, locationId])
  @@index([updatedAt])
}

// CartItem — quantity of one product. Price is captured here as a snapshot
// at *add time* so that subsequent product price edits don't silently
// change the customer's basket without warning. The checkout flow re-reads
// current product price + stock to detect drift and warn before charging.
model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // NULL = no variant selected (single-SKU product). Set = specific size/weight
  // variant. Deduplication is enforced in application code because Postgres
  // UNIQUE treats NULLs as distinct, which would allow duplicate plain items.
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int
  priceMinor       Int // snapshot of Product.priceMinor (or variant.priceMinor) at time of add
  // P2 — per-item substitution preference. NULL = inherit Order.substitutionPolicy
  // set at checkout. Values match the order-level vocabulary: 'AUTO' (anything
  // similar), 'APPROVE' (ask first), 'REFUND' (do not substitute). UI gated by
  // perItemSubstitution feature flag; backend always accepts.
  substitutionPref String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

// Order — placed when a Cart converts at checkout. We keep snapshots of
// every billing-relevant field (price, name, contact, address) directly
// on the Order/OrderItem rows so future product/customer edits never
// rewrite the historical record. Money is in minor units (paise/cents).
model Order {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Soft FK — we don't relate to Customer because guest checkout is
  // first-class. customerId is set when the buyer was logged in.
  customerId String?

  // Snapshot of contact details at time of checkout. Source of truth for
  // confirmation emails / fulfillment so a later customer-profile edit
  // doesn't change the historical address.
  customerEmail   String
  customerName    String
  customerPhone   String?
  // Address is required for DELIVERY orders, omitted/empty for PICKUP. We
  // keep the column non-null with a "{}"-like default at the app layer so
  // pickup orders still have a stable shape for the admin order list.
  shippingAddress Json // free-form JSON: line1/line2/city/state/postalCode/country

  // How the buyer chose to pay. Captured at checkout so admin / receipts
  // can show "Cash on Delivery" vs "Paid online" without parsing notes.
  // 'cod' | 'online'. Null on legacy rows created before this column.
  paymentMethod String?
  // ECOMMERCE multi-store (2026-05-11) — which physical store fulfils this order.
  // Set at checkout from the cart's resolved location. Nullable for legacy
  // single-location rows. Distinct from pickupLocationId (separate table).
  locationId    String?
  location      BusinessLocation? @relation("OrderLocation", fields: [locationId], references: [id], onDelete: SetNull)

  // Fulfillment branch: home delivery vs store pickup ("Click & Collect").
  // Pickup orders have no shippingAddress + a pickupLocationId + a
  // pickupCode the staff verifies when the buyer arrives.
  fulfillmentType  String              @default("DELIVERY") // 'DELIVERY' | 'PICKUP'
  pickupLocationId String?
  // Soft FK — pickup locations can be deactivated; the snapshot fields on
  // EcomOrderEvent / order detail preserve the address shown to the buyer.
  pickupLocation   EcomPickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupCode       String? // 6-char alphanumeric handed to the buyer at confirmation; staff-side verification on pickup
  pickupReadyAt    DateTime?
  pickedUpAt       DateTime?

  status        OrderStatus @default(PENDING)
  currency      String      @default("INR")
  subtotalMinor Int // sum of items
  shippingMinor Int         @default(0)
  taxMinor      Int         @default(0)
  totalMinor    Int // subtotal + shipping + tax (denormalised for fast list views)

  // Payment provider reference. Filled once webhook / redirect confirms
  // the charge succeeded. Until then the order sits in PENDING.
  paymentProvider String? // 'PADDLE' | 'RAZORPAY' | 'STRIPE' | 'MANUAL'
  paymentRef      String? // provider txn ID

  // Sprint 2.3 — discount codes on storefront checkout
  couponCode    String?
  discountMinor Int     @default(0)

  notes String? // free-text customer note at checkout

  // Pick-exception reconciliation (grocery fulfilment). When picking changes
  // the order — actual weights on sold-by-weight items, substitutions, or
  // shorted/out-of-stock units — the recomputed amount lands in
  // adjustedTotalMinor while totalMinor keeps the originally-charged value, so
  // receipts and refunds can show the delta. refundedMinor accumulates partial
  // refunds (shorted items, over-estimated weight) without flipping the whole
  // order to REFUNDED. substitutionPolicy snapshots how proposed swaps resolve
  // for this order: 'AUTO' accept best match, 'APPROVE' wait for the customer,
  // 'REFUND' never substitute (short + refund instead).
  adjustedTotalMinor Int?
  refundedMinor      Int     @default(0)
  substitutionPolicy String? // 'AUTO' | 'APPROVE' | 'REFUND' — null falls back to business default

  // SLA — when fulfilment is promised by, derived from the delivery slot or
  // the pickup location's prep time at checkout. Powers On-time Delivery %.
  promisedAt DateTime?

  // Delivery slot — set when the customer picks a slot at checkout. Soft
  // FK because slots can be deactivated; the snapshot fields below preserve
  // what the buyer was promised. deliveryDate is the actual day the slot
  // applies to (slots without specificDate are recurring and reuse this).
  deliverySlotId             String?
  deliveryDate               DateTime?
  deliverySlotLabel          String? // "Today, 11 AM – 1 PM" snapshot for receipts
  deliverySlotSurchargeMinor Int       @default(0)

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  items            OrderItem[]
  deliveryRequests EcomDeliveryRequest[] @relation("DeliveryRequestOrder")

  @@index([businessId, status, placedAt])
  @@index([businessId, customerEmail])
  @@index([businessId, locationId, status])
  @@index([customerId])
  @@index([deliverySlotId, deliveryDate])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Soft FK — productId may go null if the product is later deleted; the
  // snapshot fields below preserve what was sold.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName    String // snapshot
  productSlug    String? // snapshot — for re-linking from order detail
  quantity       Int
  priceMinor     Int // snapshot of Product.priceMinor at checkout
  lineTotalMinor Int // priceMinor * quantity, denormalised

  // ── Sold-by-weight (grocery) ──────────────────────────────────────────────
  // Snapshot of Product.soldByWeight. For weight lines, quantity is the count
  // of weighed units (usually 1), orderedWeightGrams is the buyer's estimate,
  // and pickedWeightGrams is what the picker actually weighs. lineTotalMinor is
  // recomputed as pricePerKgMinor × pickedWeightGrams ÷ 1000 once weighed.
  soldByWeight       Boolean @default(false)
  pricePerKgMinor    Int? // snapshot of per-kg price for weight lines
  orderedWeightGrams Int? // buyer's estimated weight at checkout
  pickedWeightGrams  Int? // actual weight recorded at pick

  // ── Pick exceptions (substitution / short) ────────────────────────────────
  // fulfillmentStatus tracks the line through picking independently of the
  // order status: 'PENDING' (not yet picked) → 'PICKED' (in the bag as ordered)
  // | 'SUBSTITUTED' (swapped for substitute* product) | 'SHORTED' (some/all
  // units unavailable and refunded). substitutionStatus gates a proposed swap
  // through customer/policy approval. substitute* fields snapshot the
  // replacement (soft FK — substituteProductId, no relation, matching the
  // order's soft-FK pattern). shortedQuantity counts refunded units.
  fulfillmentStatus     String  @default("PENDING") // 'PENDING' | 'PICKED' | 'SUBSTITUTED' | 'SHORTED'
  exceptionReason       String? // 'OUT_OF_STOCK' | 'DAMAGED' | 'EXPIRED' | 'QUALITY' | 'OTHER'
  shortedQuantity       Int     @default(0)
  substitutionStatus    String? // null | 'PROPOSED' | 'AUTO_ACCEPTED' | 'ACCEPTED' | 'REJECTED'
  substituteProductId   String? // soft FK to the replacement Product
  substituteProductName String?
  substitutePriceMinor  Int?
  substituteQuantity    Int?
  substituteWeightGrams Int? // actual weight when the substitute is sold by weight
  // P2 — per-item substitution preference snapshotted from the cart at
  // checkout. NULL = fall back to Order.substitutionPolicy. Values:
  // 'AUTO' | 'APPROVE' | 'REFUND'. Read by resolveSubstitutionMode().
  substitutionPref      String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING // created, awaiting payment confirmation
  PAID // payment captured
  PACKING // admin started preparing the order
  OUT_FOR_DELIVERY
  DELIVERED
  // Click & Collect — order has been packed and is waiting at the pickup
  // location for the buyer to arrive. Customer email + portal show the
  // pickup code and the location address.
  READY_FOR_PICKUP
  PICKED_UP // buyer collected the order at the pickup location
  CANCELLED
  REFUNDED
  FAILED // payment failed
}

// BusinessIntegration — a connected third-party account (Google, Zoom,
// MS Teams) that the business has authorised us to create video meetings
// on their behalf. One row per (business, provider) combo.
//
// Refresh + access tokens are encrypted at rest with AES-256-GCM keyed off
// the existing JWT_SECRET so we don't introduce a new key-management
// surface. Access tokens are kept too (small optimisation — saves a
// refresh round-trip per booking when not yet expired).
//
// Status reflects the *health* of the integration:
//   ACTIVE   — happy path
//   EXPIRED  — refresh token rejected, admin needs to reconnect
//   REVOKED  — user explicitly disconnected from our side; row kept for
//              audit then removed when stale
//
// One booking-side flow: when a service is virtual AND the business has
// an ACTIVE integration for the admin's preferred provider, the booking
// controller calls provider.createMeeting() and stores the URL on
// Appointment.meetingUrl.
model BusinessIntegration {
  id                    String    @id @default(uuid())
  businessId            String
  provider              String // 'google_meet' | 'zoom' | 'ms_teams'
  status                String    @default("ACTIVE") // 'ACTIVE' | 'EXPIRED' | 'REVOKED'
  scopes                String? // comma-separated list of scopes granted
  externalAccountId     String? // provider's user / account ID, for display
  externalAccountEmail  String? // shown in admin UI: "Connected as foo@bar.com"
  refreshTokenEncrypted String?   @db.Text // AES-256-GCM ciphertext (base64)
  accessTokenEncrypted  String?   @db.Text // short-lived, refreshed on demand
  accessTokenExpiry     DateTime? // when accessTokenEncrypted needs refresh
  connectedByUserId     String? // which admin clicked Connect (audit)
  connectedAt           DateTime  @default(now())
  lastUsedAt            DateTime? // last successful createMeeting call
  lastError             String? // last refresh / API error, for admin visibility
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@index([provider])
  @@index([status])
}

// Enquiry — a customer-submitted form from the public storefront's
// Contact section. Business owners see these in their admin dashboard.
model Enquiry {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  subject    String?
  message    String
  status     EnquiryStatus @default(NEW)
  ipAddress  String? // captured for light abuse prevention
  userAgent  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([businessId, status, createdAt])
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday, 1=Monday ... 6=Saturday
