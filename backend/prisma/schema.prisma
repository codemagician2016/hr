// ── Feature 13 — typed Address rows (Figma §Address: correspondence / permanent /
// office + the "same as" toggle). `sameAsType` stores a POINTER (not a copy) so a
// later edit to the source propagates and we never persist drift (§9 "same as"
// integrity). The flat addressLine* columns on Employee remain the back-compat
// correspondence address.
model EmployeeAddress {
  id          String       @id @default(uuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        AddressType
  sameAsType  AddressType? // when set, this address mirrors another (UI "same as")
  line1       String?
  line2       String?
  city        String?
  stateCode   String?
  postalCode  String?
  countryCode String?      @db.Char(2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([businessId, employeeId, type])
  @@index([businessId, employeeId])
}

enum AddressType {
  CORRESPONDENCE
  PERMANENT
  OFFICE
}

// ─────────────────────────────────────────────────────────────────────────────
// §5  COMPENSATION & SALARY STRUCTURES
//   IN Code-on-Wages "Basic + DA ≥ 50%" primitive lives here: enforced by the
//   service layer + payroll engine reading SalaryComponent.kind ∈ {BASIC,
//   DEARNESS_ALLOWANCE} against total, with ComponentKind=SPECIAL_ALLOWANCE +
//   ComponentCalcMethod=BALANCING as the balancing line. See docs/03 §5.4.
// ─────────────────────────────────────────────────────────────────────────────

/// Configurable component; behavior comes from the fixed `kind` enum.
model SalaryComponent {
  id                  String              @id @default(uuid())
  businessId          String
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId            String? // NULL = available to all entities
  code                String // "BASIC","HRA","DA","SPECIAL","PF_EE"...
  name                String
  kind                ComponentKind // FIXED behavior selector
  category            ComponentCategory // EARNING | DEDUCTION | EMPLOYER_COST | REIMBURSEMENT
  // Calculation
  calcMethod          ComponentCalcMethod
  calcValue           Decimal?            @db.Decimal(15, 4) // flat amount OR percentage OR factor
  calcBaseCode        String? // for PERCENT_OF: which component(s)
  calcBaseScope       ComponentBaseScope  @default(SINGLE)
  // Statutory flags — drive the compliance engine
  isWageForPF         Boolean             @default(false) // counts toward EPF "wages"
  isWageForESI        Boolean             @default(false)
  isWageForPT         Boolean             @default(false)
  isWageForGratuity   Boolean             @default(false)
  isTaxable           Boolean             @default(true)
  taxSection          String? // IN exemption section e.g. "10(13A)" HRA
  isKiwiSaverable     Boolean             @default(false) // NZ: part of gross for KS calc
  isPayeable          Boolean             @default(true) // NZ: subject to PAYE
  // Behavior
  isRecurring         Boolean             @default(true)
  prorationMethod     ProrationMethod     @default(CALENDAR_DAYS)
  glCode              String?
  sortOrder           Int                 @default(0)
  isActive            Boolean             @default(true)
  // Feature 5 — derivation/clamp (all additive, nullable/defaulted):
  // derivationPass mirrors the engine's topo order (0=FLAT, 1=PERCENT_OF literal
  // base, 2=PERCENT_OF GROSS/CTC, 3=BALANCING) so deriveBreakup orders without a
  // graph solve and the structure builder can reject cycles at save time.
  derivationPass      Int                 @default(0)
  floorValue          Decimal?            @db.Decimal(15, 2) // per-component clamp → engine floorMinor
  capValue            Decimal?            @db.Decimal(15, 2) // per-component clamp → engine capMinor
  minWageFloorApplies Boolean             @default(false) // counts toward the min-wage Basic floor
  // Program P1.3 — custom SLAB components: ordered bracket-lookup bands over the
  // calcBase (GROSS | CTC | a named component). The WHOLE base falls in exactly
  // one band (PT-style, NOT progressive). [{upTo: number|null, value, valueType:
  // 'FLAT'|'PERCENT'}]; only the last band may be open-ended (upTo null).
  // Evaluated at derivation time (deriveBreakup) → materialized amounts.
  slabsJson           Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  version             Int                 @default(0)

  structureLines   SalaryComponentLine[]
  // Feature 17 — back-relation for the friendly CTC-policy builder. A policy line
  // references the pay-head master (Restrict on delete: a component used by a policy
  // cannot be hard-deleted out from under it). Additive; no behaviour change.
  ctcPolicyLines   CtcPolicyLine[]
  // Feature 25 — FBP back-relations. A component can be a plan's envelope and/or a
  // head's pay-head. Restrict on delete (a component a plan references stays put).
  fbpEnvelopePlans FbpPlan[]             @relation("FbpEnvelopeComponent")
  fbpPlanHeads     FbpPlanHead[]         @relation("FbpHeadComponent")

  @@unique([businessId, code])
  @@index([businessId, entityId, category])
}

/// Feature 17 — a reusable, CTC-AGNOSTIC salary template authored in the friendly
/// builder (sliders / % / flat / balancing / statutory). It holds the RULES for how
/// to split a CTC, never a person's resolved amounts. It compiles to the
/// SalaryComponentLine[] shape (→ deriveBreakup / materializeRevisionLines) at a
/// chosen target CTC. India-first: countryCode is ALWAYS the tenant country (the
/// single-country invariant — never user-chosen cross-country). Distinct from a
/// SalaryStructure (which is the RESOLVED package at a specific CTC).
model CtcPolicy {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId       String? // NULL = all entities of the tenant
  code           String // "STAFF-2026"
  name           String // "Staff CTC Policy 2026"
  countryCode    String          @db.Char(2) // ALWAYS the tenant country (IN). Server-stamped.
  currencyCode   String          @db.Char(3)
  basis          StructureBasis  @default(CTC) // CTC for IN; reserved for future
  // Quote-time employer-cost knobs (drive the deriveBreakup ctx; they do NOT change
  // the runtime engine — only how the CTC fixed point quotes employer cost):
  esiApplicable  Boolean         @default(false) // include employer ESI in the CTC fixed point
  capPfAtCeiling Boolean         @default(true) // cap PF at the ₹15,000 wage ceiling in the quote
  isActive       Boolean         @default(true)
  // Feature 42 — CTC LOCK: a locked policy refuses edits/deletes until an Owner
  // (canApproveCompensation holder) unlocks it — protects an agreed structure
  // from silent drift (policy writes have no maker-checker by design).
  isLocked       Boolean         @default(false)
  lockedById     String?
  lockedAt       DateTime?
  lines          CtcPolicyLine[]
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  version        Int             @default(0)

  @@unique([businessId, code])
  @@index([businessId, entityId, isActive])
}

/// Feature 17 — one rule row in a CtcPolicy. Maps 1:1 onto a SalaryComponentLine at
/// compile time. The friendly UI exposes only PERCENT_OF / FLAT / BALANCING /
/// STATUTORY; pct/flatMonthly carry the rule INPUT (never a resolved amount).
model CtcPolicyLine {
  id          String              @id @default(uuid())
  businessId  String
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  policyId    String
  policy      CtcPolicy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent     @relation(fields: [componentId], references: [id], onDelete: Restrict)
  calcMethod  ComponentCalcMethod // PERCENT_OF | FLAT | BALANCING | STATUTORY
  pct         Decimal?            @db.Decimal(8, 4) // for PERCENT_OF (e.g. 50.0000)
  flatMonthly Decimal?            @db.Decimal(15, 2) // for FLAT (monthly amount)
  baseCode    String? // PERCENT_OF base: "CTC" | "GROSS" | a component code ("BASIC")
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([businessId, policyId])
}

enum ComponentKind {
  BASIC
  DEARNESS_ALLOWANCE
  HRA
  SPECIAL_ALLOWANCE
  CONVEYANCE
  MEDICAL
  LTA
  BONUS
  COMMISSION
  OVERTIME_PAY
  ARREAR
  // statutory deductions
  PF_EMPLOYEE
  ESI_EMPLOYEE
  PT
  TDS
  KIWISAVER_EMPLOYEE
  PAYE
  STUDENT_LOAN
  // employer cost (shown on cost-to-company, not deducted from employee)
  PF_EMPLOYER
  ESI_EMPLOYER
  EPS
  EDLI
  PF_ADMIN
  GRATUITY_PROVISION
  KIWISAVER_EMPLOYER
  ESCT
  ACC_EMPLOYER
  // recoveries / others
  LOAN_REPAYMENT
  ADVANCE_RECOVERY
  LEAVE_ENCASHMENT
  NOTICE_RECOVERY
  REIMBURSEMENT_FUEL
  REIMBURSEMENT_PHONE
  CUSTOM
}

enum ComponentCategory {
  EARNING
  DEDUCTION
  EMPLOYER_COST
  REIMBURSEMENT
}

enum ComponentCalcMethod {
  FLAT
  PERCENT_OF
  FORMULA
  SLAB
  STATUTORY
  BALANCING
}

enum ComponentBaseScope {
  SINGLE
  MULTIPLE
  GROSS
  CTC
}

enum ProrationMethod {
  CALENDAR_DAYS
  WORKING_DAYS
  THIRTY_DAY_STANDARD
  TWENTYSIX_DAY_STANDARD // Feature 42 — the factory "26-day basis" (engine FIXED_26, now reachable)
  NONE
}

/// Reusable salary template per grade/entity.
model SalaryStructure {
  id           String                @id @default(uuid())
  businessId   String
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId     String
  code         String
  name         String // "IN Staff CTC 2026", "NZ Salaried"
  countryCode  String                @db.Char(2)
  currencyCode String                @db.Char(3)
  basis        StructureBasis // CTC (IN) | GROSS (NZ) | NET
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  version      Int                   @default(0)
  lines        SalaryComponentLine[]

  @@unique([businessId, entityId, code])
  @@index([businessId, entityId, isActive])
}

enum StructureBasis {
  CTC
  GROSS
  NET
}

/// A component within a structure OR an assigned compensation revision.
model SalaryComponentLine {
  id             String                @id @default(uuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  structureId    String?
  structure      SalaryStructure?      @relation(fields: [structureId], references: [id], onDelete: Cascade)
  compensationId String?
  compensation   CompensationRevision? @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  componentId    String
  component      SalaryComponent       @relation(fields: [componentId], references: [id], onDelete: Restrict)
  calcMethod     ComponentCalcMethod // can override component default
  calcValue      Decimal?              @db.Decimal(15, 4)
  amountMonthly  Decimal?              @db.Decimal(15, 2) // resolved monthly snapshot
  amountAnnual   Decimal?              @db.Decimal(15, 2)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  version        Int                   @default(0)

  @@index([businessId, structureId])
  @@index([businessId, compensationId])
}

/// Append-only assigned pay. Each hike/restructure creates a new revision.
/// Payroll reads the revision whose [effectiveFrom, effectiveTo] covers the
/// period. Never edited in place.
model CompensationRevision {
  id                String             @id @default(uuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entityId          String
  entity            Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  structureId       String?
  currencyCode      String             @db.Char(3)
  basis             StructureBasis
  ctcAnnual         Decimal?           @db.Decimal(15, 2)
  grossMonthly      Decimal?           @db.Decimal(15, 2)
  // Effective dating
  effectiveFrom     DateTime           @db.Date
  effectiveTo       DateTime?          @db.Date // NULL = current
  isCurrent         Boolean            @default(true)
  revisionReason    CompRevisionReason
  approvalRequestId String?
  notes             String?
  // Feature 5 — maker-checker status machine + SoD + increment-letter (additive).
  // Default EFFECTIVE keeps the existing direct-write path (provisioning HIRE,
  // programmatic) valid; the UI maker-checker path uses PROPOSED→APPROVED→EFFECTIVE.
  status            CompRevisionStatus @default(EFFECTIVE)
  proposedById      String? // SoD maker
  approvedById      String? // SoD checker — must differ from proposedById
  approvedAt        DateTime?
  letterEnvelopeId  String? // F4 SignatureEnvelope for the increment letter
  cycleId           String? // links a revision committed via a bulk IncrementCycle
  sourcePeriodCode  String? // ARREAR provenance when the revision is back-dated
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  version           Int                @default(0)

  lines         SalaryComponentLine[]
  // Feature 8: reviews whose merit hike resolved to this revision (loose-coupled).
  linkedReviews PerformanceReview[]   @relation("ReviewMeritRevision")

  @@unique([employeeId, effectiveFrom])
  @@index([businessId, employeeId, isCurrent])
  @@index([businessId, entityId, effectiveFrom])
  @@index([businessId, status])
}

enum CompRevisionReason {
  HIRE
  ANNUAL_REVISION
  PROMOTION
  CORRECTION
  RESTRUCTURE
  STATUTORY_ADJUSTMENT
}

// Feature 5 — maker-checker lifecycle for a CompensationRevision.
enum CompRevisionStatus {
  DRAFT
  PROPOSED
  APPROVED
  EFFECTIVE
  REJECTED
  WITHDRAWN
}

// Feature 5 — salary-masking level on a BusinessRole.
enum CompVisibility {
  ABSOLUTE
  RANGE_ONLY
  SELF_ONLY
  NONE
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 5 — Increment cycles (bulk maker-checker comp revisions).
// ─────────────────────────────────────────────────────────────────────────────

model IncrementCycle {
  id            String               @id @default(uuid())
  businessId    String
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  type          IncrementCycleType
  effectiveDate DateTime             @db.Date
  budgetMinor   BigInt? // optional pool, integer minor units
  status        IncrementCycleStatus @default(OPEN)
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  proposals     IncrementProposal[]

  @@index([businessId, status])
}

model IncrementProposal {
  id               String         @id @default(uuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycleId          String
  cycle            IncrementCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId       String
  proposedById     String
  currentCtcMinor  BigInt?
  proposedCtcMinor BigInt?
  pctHike          Decimal?       @db.Decimal(8, 4)
  justification    String?
  status           ProposalStatus @default(DRAFT)
  revisionId       String? // set on commit
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cycleId, employeeId])
  @@index([businessId, cycleId])
}

enum IncrementCycleType {
  MERIT
  PROMOTION
  MARKET
  COLA
}

enum IncrementCycleStatus {
  OPEN
  LOCKED
  CLOSED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// §6  STATUTORY PROFILES  (per-employee identity/elections + per-entity regs)
// ─────────────────────────────────────────────────────────────────────────────

/// 1:1 with Employee. Sparse country-specific extensions on one row (avoids a
/// join on the hot payroll path). @pii:identity, @retain:statutory.
model StatutoryProfile {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  countryCode String   @db.Char(2)

  // ── INDIA ──
  pan                 String?      @db.Char(10) // income tax PAN
  uan                 String?      @db.VarChar(12) // EPFO Universal Account Number
  pfMemberId          String?
  pfOptIn             Boolean? // >₹15k wage: contribute on actual vs ceiling
  pfJoinDate          DateTime?    @db.Date
  esicIp              String? // ESI Insurance Person number
  esiApplicable       Boolean?     @default(false)
  ptStateCode         String? // overrides location if employee remote
  // Feature 21 — Labour Welfare Fund: optional state override (rare case LWF state
  // ≠ PT state; defaults to the PT state precedence) + the managerial/supervisory
  // exclusion flag (several state LWF Acts exempt managerial staff above a low wage
  // ceiling). isManagerial null/false ⇒ covered (fail-open to charging the flat fee).
  lwfStateCode        String? // overrides PT state for LWF only (rarely differs)
  isManagerial        Boolean?     @default(false) // managerial/supervisory (LWF mgr-exclusion)
  aadhaarVerified     Boolean?     @default(false) // store flag, NOT the number
  taxRegime           INTaxRegime? @default(NEW) // NEW is statutory default
  // Feature 15/25 — regime ELECTION MARKER. The TRUE signal that the employee (or HR for
  // them) has deliberately elected a regime. NULL = never elected → getEffectiveRegime
  // falls back to the employer default (TaxRegimePolicy.defaultRegime) then statutory NEW.
  // This is SEPARATE from taxRegime, whose @default(NEW)/provisioning write means a stored
  // value can NOT distinguish "elected NEW" from "never elected" — the marker can.
  regimeElectedAt     DateTime? // when the regime was deliberately elected (null = never elected)
  // Feature 15/25 — regime ELECTION LOCK. Set once HR finalises the election (or the
  // FY election window closes); a non-null value freezes taxRegime (the regime service
  // rejects any further self/HR election). Bulk-set by lockRegime when the window shuts.
  regimeLockedAt      DateTime? // when the regime election was locked (null = still electable)
  section80CDeclared  Decimal?     @db.Decimal(15, 2) // old-regime declarations
  hraExemptionClaimed Boolean?     @default(false)
  abryEligible        Boolean?     @default(false)

  // ── Feature 15: declared IT-projection inputs (OLD-regime; ignored under NEW) ──
  // All amounts are ANNUAL rupees as DECLARED by the employee (proofs are roadmap).
  hraAnnualRentPaid          Decimal?         @db.Decimal(15, 2) // rent paid p.a. (HRA exemption leg 3)
  hraMetroCity               Boolean?         @default(false) // 50% vs 40% of salary leg
  sec80DDeclared             Decimal?         @db.Decimal(15, 2) // medical insurance premium
  sec80CCD1BDeclared         Decimal?         @db.Decimal(15, 2) // NPS additional ₹50k (80CCD(1B))
  sec80TTADeclared           Decimal?         @db.Decimal(15, 2) // savings interest (TTA/TTB)
  sec24BHomeLoanInterest     Decimal?         @db.Decimal(15, 2) // self-occupied home-loan interest (cap ₹2L)
  otherChapterVIADeclared    Json? // [{ section, label, grossAmount }] extensible
  // Perquisites (Figma "Value of perquisites"). Set by HR, stored here so the
  // projection reads one record. Nullable.
  perqRentFreeAccom          Boolean?         @default(false) // employer-provided accommodation
  perqAccomCityPopBand       String?          @db.VarChar(8) // ">40L" | "15-40L" | "<15L"
  perqAccomIsLeased          Boolean?         @default(false) // employer-leased (actual-rent leg)
  perqAccomLeaseRentPaid     Decimal?         @db.Decimal(15, 2) // employer's annual lease rent
  perqConcessionalLoanBal    Decimal?         @db.Decimal(15, 2) // avg outstanding employer loan
  perqLoanRateChargedPct     Decimal?         @db.Decimal(5, 2) // rate actually charged (vs SBI rate)
  // ── Previous-employer income + TDS (Figma "Tax deducted by previous employer") ──
  // Declared on joining mid-FY (Form 12B). ANNUAL/cumulative rupees for THIS FY.
  prevEmployerTaxableIncome  Decimal?         @db.Decimal(15, 2)
  prevEmployerTdsDeducted    Decimal?         @db.Decimal(15, 2)
  prevEmployerFY             String?          @db.VarChar(7) // "2026-27" guard: only count when == current FY
  // ── NEW ZEALAND ──
  irdNumber                  String?          @db.VarChar(11)
  taxCode                    String?          @db.VarChar(8) // "M","ME","M SL","S","WT","ND"...
  kiwiSaverStatus            KiwiSaverStatus? @default(NOT_ENROLLED)
  kiwiSaverEmployeeRate      Decimal?         @db.Decimal(5, 4) // 0.035 default from 1 Apr 2026
  kiwiSaverOptOutDate        DateTime?        @db.Date
  kiwiSaverSavingsSuspension Boolean?         @default(false)
  esctRate                   Decimal?         @db.Decimal(5, 4) // resolved annually
  studentLoan                Boolean?         @default(false) // tax code ends in SL
  studentLoanExtraDeduction  Decimal?         @db.Decimal(5, 2)
  hasSpecialTaxCode          Boolean?         @default(false)
  specialTaxRate             Decimal?         @db.Decimal(5, 4)
  accExempt                  Boolean?         @default(false)

  electionHistory StatutoryElectionHistory[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  version         Int                        @default(0)

  @@index([businessId, countryCode])
  @@index([businessId, uan])
  @@index([businessId, irdNumber])
}

// ── Feature 20 — Investment-Proof Submission + HR Verification ───────────────
// Year-end half of the F15 declaration loop (§192(2D)/Rule 26C/Form 12BB). The
// declared figures stay on StatutoryProfile; these two models carry the EVIDENCE
// (uploaded proofs) + the VERIFIED truth + the per-FY window that locks the TDS
// switch. Additive — nothing on StatutoryProfile changes.

// The per-FY declaration window for a tenant. Admin (HR/Finance) sets open/close
// + proof deadline; the proofDeadline is the date the TDS engine flips to
// verified-only. Resolved as-of the FY in the assembler (asOf >= proofDeadline).
model InvestmentDeclarationWindow {
  id             String                  @id @default(uuid())
  businessId     String
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialYear  String                  @db.VarChar(7) // "2026-27" (StatutoryProfile.prevEmployerFY format)
  countryCode    String                  @default("IN") @db.Char(2)
  // Feature 25 — purpose discriminator. INVESTMENT_PROOF (default) = the F20
  // window; FBP_ALLOCATION = the FBP allocation window (its proofDeadline is the
  // declared→verified flip date for the bill-backed FBP heads). One model, one
  // resolver, one cron drives both — see DeclWindowPurpose.
  purpose        DeclWindowPurpose       @default(INVESTMENT_PROOF)
  opensAt        DateTime                @db.Date // declaration editable / uploads accepted from
  closesAt       DateTime                @db.Date // declaration locks (no more edits/uploads after)
  proofDeadline  DateTime                @db.Date // TDS flips to VERIFIED-only on/after this date (Jan–Feb)
  status         DeclarationWindowStatus @default(DRAFT) // DRAFT|OPEN|CLOSED|LOCKED
  notes          String?                 @db.Text
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  version        Int                     @default(0)
  proofs         InvestmentProof[]
  fbpAllocations FbpAllocation[]

  @@unique([businessId, financialYear, countryCode, purpose]) // one window per FY per country per purpose
  @@index([businessId, status])
  @@index([businessId, proofDeadline])
}

// One uploaded proof for one claim line, with its verify verdict + verified amount.
// The "declared amount" stays on StatutoryProfile; this row is the EVIDENCE + the
// VERIFIED truth. A claim can have many proofs (12 rent receipts; 3 LIC + 1 PPF for
// the 80C bucket); each carries its own file, verdict and verified amount.
model InvestmentProof {
  id            String                      @id @default(uuid())
  businessId    String
  business      Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  windowId      String
  window        InvestmentDeclarationWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  financialYear String                      @db.VarChar(7)

  claimType      ProofClaimType // SEC_80C | SEC_80D | SEC_80CCD1B | SEC_80TTA | SEC_24B_HOME_LOAN | HRA_RENT | OTHER_VIA
  subSection     String?        @db.VarChar(16) // e.g. "LIC","PPF","ELSS" — for the 80C bucket breakdown
  declaredAmount Decimal        @db.Decimal(15, 2) // what this proof CLAIMS to support (annual ₹)
  verifiedAmount Decimal?       @db.Decimal(15, 2) // what HR ACCEPTS (≤ declared; capped by HR). NULL until verified.

  // The evidence file — same storage contract as EmployeeDocument (S3/R2 key + SHA-256).
  fileUrl      String  @db.Text
  fileHash     String? // SHA-256 of decoded bytes (server-computed, integrity anchor)
  mimeType     String?
  sizeBytes    Int?
  originalName String?

  // HRA-only evidence (Rule 26C: landlord PAN required when annual rent > ₹1,00,000).
  landlordName      String?
  landlordPan       String? @db.Char(10)
  rentMonthsCovered Int?

  status       ProofStatus @default(PENDING) // PENDING | ACCEPTED | REJECTED
  rejectReason String?     @db.Text // mandatory when REJECTED ("blurred","amount mismatch","wrong FY")
  verifiedById String? // operator User id (SoD: ≠ a self-verify)
  verifiedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (re-upload supersedes)
  version   Int       @default(0)

  @@index([businessId, employeeId, financialYear])
  @@index([businessId, windowId, status])
  @@index([businessId, employeeId, claimType])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 25 — Flexible Benefit Plan (FBP / Flexi Basket). India-only, OLD-regime
// tax-optimised allowances carved from CTC. Four additive models; the WINDOW is
// REUSED from F20 (InvestmentDeclarationWindow + purpose=FBP_ALLOCATION) and the
// PROOFS are REUSED from F20 (InvestmentProof + FBP_* claim types). No new payroll
// math, no second tax engine — the exempt subtraction is one line in the assembler.
// ─────────────────────────────────────────────────────────────────────────────

/// The tenant-level FBP plan: the basket DEFINITION (which heads, each head's
/// statutory cap + proof requirement). India-first; one active plan per entity
/// per FY. CTC-agnostic (like CtcPolicy) — it defines RULES, not a person's
/// allocation. The envelope component is the single CTC earning line that funds
/// the whole basket; the plan's heads allocate within its resolved amount.
model FbpPlan {
  id                  String          @id @default(uuid())
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId            String? // NULL = all entities
  code                String // "FBP-2026"
  name                String // "Flexi Benefit Plan 2026-27"
  countryCode         String          @default("IN") @db.Char(2) // server-stamped = tenant country
  financialYear       String          @db.VarChar(7) // "2026-27"
  // The basket envelope: which CTC earning component carries the total FBP allowance.
  envelopeComponentId String // FK SalaryComponent (kind SPECIAL_ALLOWANCE | CUSTOM code "FBP")
  envelopeComponent   SalaryComponent @relation("FbpEnvelopeComponent", fields: [envelopeComponentId], references: [id], onDelete: Restrict)
  isActive            Boolean         @default(true)
  heads               FbpPlanHead[]
  allocations         FbpAllocation[]
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  version             Int             @default(0)

  @@unique([businessId, code])
  @@index([businessId, entityId, financialYear, isActive])
}

/// One head in the basket (LTA, meal, fuel, telephone, books, prof-dev, uniform…).
/// Carries the statutory cap + the exemption section + whether proof is required.
model FbpPlanHead {
  id                  String              @id @default(uuid())
  businessId          String
  planId              String
  plan                FbpPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  componentId         String // FK SalaryComponent — the payslip pay-head this head pays as
  component           SalaryComponent     @relation("FbpHeadComponent", fields: [componentId], references: [id], onDelete: Restrict)
  headType            FbpHeadType // LTA | MEAL_CARD | FUEL_CAR | TELEPHONE_INTERNET | BOOKS_PERIODICALS | PROF_DEV | UNIFORM | OTHER
  label               String // friendly name shown in ESS
  taxSection          String?             @db.VarChar(16) // "10(5)" | "3(7)(iii)" | "3(2)" | "3(7)(ix)" | "10(14)"
  // Caps (annual ₹ unless noted). NULL = no statutory cap beyond the allocation/actuals.
  annualCapRupees     Decimal?            @db.Decimal(15, 2) // e.g. meal 26400; uniform per-policy
  monthlyCapRupees    Decimal?            @db.Decimal(15, 2) // e.g. meal 2200; fuel-slab 1800/2400; driver 900
  minAllocRupees      Decimal?            @db.Decimal(15, 2) // optional floor (0 default)
  // Exemption + proof behaviour
  exemptOldRegimeOnly Boolean             @default(true) // every head here is OLD-only; NEW pays-but-taxes
  proofRequired       Boolean             @default(true) // false only for MEAL_CARD (the card is the control)
  payCadence          FbpPayCadence       @default(MONTHLY) // MONTHLY allowance vs ON_CLAIM (LTA reimbursement)
  claimType           ProofClaimType? // the F20 claim type FBP bills upload as (FBP_LTA, …); NULL for proof-free heads
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  allocations         FbpAllocationLine[]

  @@index([businessId, planId, sortOrder])
}

/// One employee's FBP declaration for an FY: HEADER row (locks the envelope amount
/// at declaration time) + child allocation lines. Append-only per (employee, FY,
/// version) — a re-allocation supersedes (mirrors CompensationRevision discipline).
model FbpAllocation {
  id                   String                       @id @default(uuid())
  businessId           String
  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  planId               String
  plan                 FbpPlan                      @relation(fields: [planId], references: [id], onDelete: Restrict)
  windowId             String? // FK InvestmentDeclarationWindow (purpose FBP_ALLOCATION); NULL = no window (fail-open-provisional)
  window               InvestmentDeclarationWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)
  financialYear        String                       @db.VarChar(7)
  // The basket envelope amount RESOLVED for this employee at declaration (annual ₹),
  // snapshotted from the current CompensationRevision's envelope line. Σ lines must
  // reconcile to <= this (unallocated balance falls back to fully-taxable special pay).
  envelopeAnnualRupees Decimal                      @db.Decimal(15, 2)
  status               FbpAllocationStatus          @default(DRAFT) // DRAFT | SUBMITTED | LOCKED | SUPERSEDED
  lines                FbpAllocationLine[]
  submittedAt          DateTime?
  lockedAt             DateTime?
  createdById          String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?
  version              Int                          @default(0)

  @@unique([businessId, employeeId, financialYear, version])
  @@index([businessId, employeeId, financialYear, status])
}

/// One allocated head inside an employee's FBP declaration. The annual amount the
/// employee chose for this head (≤ the head's cap and within the envelope). The
/// EXEMPT vs TAXABLE split is computed (not stored as truth) by the pure aggregator
/// from (allocation, cap, verified|declared spend) — mirroring proofAggregator.
model FbpAllocationLine {
  id                  String        @id @default(uuid())
  businessId          String
  allocationId        String
  allocation          FbpAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  headId              String
  head                FbpPlanHead   @relation(fields: [headId], references: [id], onDelete: Restrict)
  annualAmountRupees  Decimal       @db.Decimal(15, 2) // chosen allocation for this head (annual)
  // Year-end VERIFIED spend (LTA/fuel/phone/books): Σ ACCEPTED proof amounts. Drives
  // the exempt portion after the proof deadline. NULL until a proof is accepted.
  verifiedSpendRupees Decimal?      @db.Decimal(15, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([businessId, allocationId])
  @@index([businessId, headId])
}

