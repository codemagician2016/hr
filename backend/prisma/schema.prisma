// ─────────────────────────────────────────────────────────────────────────────
// §7  PAY CALENDAR · PAY RUN · PAY RUN LINE · PAYSLIP · REMITTANCE
//   Exactly-once regular run per (entity, calendar, period) is enforced by a
//   raw partial unique index in the migration (docs/03 §7.2):
//     CREATE UNIQUE INDEX payrun_one_regular ON "PayRun"
//       (business_id, entity_id, pay_calendar_id, period_start)
//       WHERE type = 'REGULAR' AND deleted_at IS NULL;
//   The schema-expressible exactly-once key is @@unique([businessId, code]).
// ─────────────────────────────────────────────────────────────────────────────

model PayCalendar {
  id              String          @id @default(uuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId        String
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code            String
  name            String
  frequency       PayFrequency // MONTHLY (IN) | FORTNIGHTLY/WEEKLY (NZ)
  payDayRule      PayDayRule
  payDayValue     Int?
  cutoffDayRule   PayDayRule
  cutoffDayValue  Int?
  prorationMethod ProrationMethod @default(CALENDAR_DAYS)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  version         Int             @default(0)
  payRuns         PayRun[]

  @@unique([businessId, entityId, code])
  @@index([businessId, entityId, isActive])
}

enum PayFrequency {
  WEEKLY
  FORTNIGHTLY
  SEMI_MONTHLY
  MONTHLY
}

enum PayDayRule {
  LAST_WORKING_DAY
  FIRST_WORKING_DAY
  FIXED_DOM
  N_DAYS_AFTER_PERIOD_END
}

/// Period batch (per entity, per cycle). LOCKED ⇒ child lines/payslips
/// read-only; corrections spawn a CORRECTION child run.
model PayRun {
  id                  String       @id @default(uuid())
  businessId          String
  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId            String
  entity              Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict)
  payCalendarId       String
  payCalendar         PayCalendar  @relation(fields: [payCalendarId], references: [id], onDelete: Restrict)
  code                String // PR-2026-04-IN
  periodStart         DateTime     @db.Date
  periodEnd           DateTime     @db.Date
  payDate             DateTime     @db.Date
  sequenceInYear      Int // 1..12 (monthly) / 1..26 (fortnightly)
  taxYear             String // "2026-27"
  type                PayRunType   @default(REGULAR)
  status              PayRunStatus @default(DRAFT)
  currencyCode        String       @db.Char(3)
  // Compliance snapshot — which rule version this run computed against
  complianceVersionId String?
  // Totals (filled at compute; immutable once LOCKED)
  headcount           Int          @default(0)
  totalGross          Decimal      @default(0) @db.Decimal(18, 2)
  totalDeductions     Decimal      @default(0) @db.Decimal(18, 2)
  totalNet            Decimal      @default(0) @db.Decimal(18, 2)
  totalEmployerCost   Decimal      @default(0) @db.Decimal(18, 2)
  // Lifecycle actors
  computedAt          DateTime?
  computedBy          String?
  lockedAt            DateTime?
  lockedBy            String?
  approvedAt          DateTime?
  approvedBy          String?
  paidAt              DateTime?
  // Feature 7 — review-gate sub-state + close/totals fingerprint (all additive).
  // The reserved REVIEW PayRunStatus member carries the maker→checker gate; these
  // flags record WHO submitted/reviewed and the totalsHash the checker saw (the
  // STALE_TOTALS guard rejects approve-after-silent-recompute). closedAt models
  // CLOSED as FILED+flag (schema has no CLOSED member). varianceReport is the
  // run-level period-over-period roll-up persisted by computeVariance.
  submittedAt         DateTime?
  submittedBy         String?
  reviewedBy          String?
  reviewedAt          DateTime?
  sendBackReason      String?
  closedAt            DateTime?
  totalsHash          String?
  varianceReport      Json?
  filedAt             DateTime?
  approvalRequestId   String?
  parentPayRunId      String? // OFF_CYCLE/CORRECTION linked to a regular run
  // Feature 18 — provenance: a MIGRATED run generated from a back-dated import job.
  // NULL on every live run; set only by the import autogen driver. Additive.
  importJobId         String?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  version             Int          @default(0)

  lines            PayRunLine[]
  payslips         Payslip[]
  remittances      StatutoryRemittance[]
  attendanceInputs AttendancePayInput[]
  inputItems       PayRunInputItem[]
  payoutBatches    PayoutBatch[] // India salary disbursement — bank advice batches built from this run
  anomalyAcks      AnomalyAcknowledgement[]

  @@unique([businessId, code])
  @@index([businessId, entityId, payCalendarId, periodStart, type])
  @@index([businessId, entityId, status])
  @@index([businessId, taxYear])
}

enum PayRunType {
  REGULAR
  OFF_CYCLE
  BONUS
  ARREAR
  FNF
  CORRECTION
  SUPPLEMENTARY
  MIGRATED // Feature 18 — a back-dated run generated from imported history
}

enum PayRunStatus {
  DRAFT
  INPUTS_LOCKED
  COMPUTING
  COMPUTED
  REVIEW
  LOCKED
  APPROVED
  PAID
  FILED
  CANCELLED
}

/// Feature 7 — one-time / ad-hoc inputs for a run (bonus, ad-hoc deduction,
/// arrear, reimbursement). Editable only while the run is DRAFT; frozen into the
/// run inputHash at INPUTS_LOCKED. ADDITIVE; no FK constraints beyond payRun so a
/// historical run replays identically.
model PayRunInputItem {
  id            String          @id @default(uuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunId      String
  payRun        PayRun          @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employeeId    String
  kind          PayRunInputKind
  componentCode String? // target component (null = ad-hoc line)
  amountMinor   BigInt // integer minor units (paise/cents)
  sourcePeriod  String? // "YYYY-MM" for arrears
  taxable       Boolean         @default(true)
  note          String?
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  version       Int             @default(0)

  @@index([businessId, payRunId, employeeId])
}

enum PayRunInputKind {
  OTE
  OTD
  ARREAR
  REIMBURSEMENT
}

/// Feature 7 — per-tenant variance tolerances (overrides DEFAULT_THRESHOLDS in
/// variance.js). One row per business; absent ⇒ engine defaults.
model VarianceThreshold {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  config     Json // { softNetPct, hardNetPct, grossPct, componentPct, lopSpikeDays, absMinFloorMinor, statutoryRateTolerance, statutoryBasePct }
  updatedAt  DateTime @updatedAt
}

/// Feature 7 — an EXPLICIT, AUDITED human override of a pre-run anomaly BLOCKER.
/// approveRun gates on un-resolved BLOCKERs; a checker (canApprovePayroll) may
/// acknowledge a specific (code[, employeeId]) blocker WITH A REASON to let the
/// approval proceed. Each ack is append-only provenance: who, why, when. The ack
/// is scoped to a single run; a recompute that clears the blocker simply makes the
/// ack moot (the gate no longer sees that blocker). Additive; no behaviour change
/// for tenants that never acknowledge.
model AnomalyAcknowledgement {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunId       String
  payRun         PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  code           String // the variance/engine finding code being overridden
  employeeId     String? // NULL ⇒ a RUN-scoped blocker (e.g. RECONCILIATION_MISMATCH)
  reason         String // mandatory justification (audited)
  acknowledgedBy String // actor id (the canApprovePayroll checker)
  // Finding-CONTENT fingerprint captured at ack time (HIGH-1). A deterministic hash of
  // the EXACT blocker instance overridden — {code, employeeId, observed, baseline,
  // deltaMinor} plus the run's totalsHash. countUnacknowledgedBlockers only credits an
  // ack whose fingerprint MATCHES the current blocker, so a recompute that changes the
  // numbers (or a new/worse blocker for the same code/employee) INVALIDATES the stale
  // ack and forces a fresh, re-audited acknowledgement. Additive/nullable: legacy rows
  // (fingerprint NULL) still match only by (code, employeeId) — back-compatible.
  fingerprint    String?
  createdAt      DateTime @default(now())

  // One LIVE ack per (run, code, employee) — re-acknowledging updates the reason.
  // employeeId NULL collapses to a single run-scoped ack per code: Postgres treats
  // NULLs as DISTINCT in a multi-column UNIQUE, so this index does NOT dedup the
  // run-scoped (employeeId IS NULL) rows — a separate partial unique index
  // "(payRunId, code) WHERE employeeId IS NULL" enforces that (see migration), and
  // ackAnomaly branches to findFirst+update on NULL rather than upsert-on-NULL (LOW-5).
  @@unique([payRunId, code, employeeId])
  @@index([businessId, payRunId])
}

/// Frozen attendance/leave feed for a (payRun, employee). The "AttendancePayInput"
/// from the build brief — payable/LOP/OT days are snapshotted here when the
/// pay-run inputs lock, so the engine computes against an immutable input set
/// even if Attendance/LeaveTransaction rows change afterward.
model AttendancePayInput {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunId      String
  payRun        PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  // Frozen inputs (days/hours, never money — Decimal not Int)
  calendarDays  Decimal  @default(0) @db.Decimal(8, 4)
  payableDays   Decimal  @default(0) @db.Decimal(8, 4)
  lopDays       Decimal  @default(0) @db.Decimal(8, 4)
  paidLeaveDays Decimal  @default(0) @db.Decimal(8, 4)
  weeklyOffDays Decimal  @default(0) @db.Decimal(8, 4)
  holidayDays   Decimal  @default(0) @db.Decimal(8, 4)
  overtimeHours Decimal  @default(0) @db.Decimal(8, 2)
  // Feature 16 — LOP provenance split (pure; payableDays/lopDays math unchanged).
  // lwpDays   = approved Leave-Without-Pay days (ON_LEAVE + affectsLOP) — a subset of lopDays.
  // absentDays= AWOL / unauthorised LOP days (status ABSENT) — also a subset of lopDays.
  // standardDays = the frozen proration denominator (entity prorationBasis) so the
  //   denominator is immutable + part of the input hash, not re-derived at compute time.
  lwpDays       Decimal  @default(0) @db.Decimal(8, 4)
  absentDays    Decimal  @default(0) @db.Decimal(8, 4)
  standardDays  Decimal  @default(0) @db.Decimal(8, 4)
  frozenAt      DateTime @default(now())
  sourceJson    Json? // provenance: attendance/leave txn ids rolled up
  importJobId   String? // Feature 18 — set when a SUMMARY attendance import staged this rollup; NULL for live freeze
  createdAt     DateTime @default(now())

  @@unique([payRunId, employeeId])
  @@index([businessId, payRunId])
  @@index([businessId, employeeId])
}

/// Per-employee computation row inside a PayRun.
model PayRunLine {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunId          String
  payRun            PayRun           @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Program P1.2 — per-employee payslip HOLD within a published run (dispute/
  // legal hold): a held line's payslip is invisible to ESS/mobile until released.
  payslipHeldAt     DateTime?
  payslipHeldBy     String?
  payslipHoldNote   String?
  compensationId    String // revision used
  // Period attendance inputs (snapshot)
  payableDays       Decimal          @db.Decimal(8, 4)
  lopDays           Decimal          @default(0) @db.Decimal(8, 4)
  // Feature 16 — approved Leave-Without-Pay days (subset of lopDays) for payslip/run-review provenance.
  lwpDays           Decimal          @default(0) @db.Decimal(8, 4)
  overtimeHours     Decimal          @default(0) @db.Decimal(8, 2)
  // Totals
  grossEarnings     Decimal          @default(0) @db.Decimal(15, 2)
  totalDeductions   Decimal          @default(0) @db.Decimal(15, 2)
  netPay            Decimal          @default(0) @db.Decimal(15, 2)
  employerCost      Decimal          @default(0) @db.Decimal(15, 2)
  currencyCode      String           @db.Char(3)
  // Country statutory rollups (snapshot for fast reporting + filing)
  pfEmployee        Decimal?         @db.Decimal(15, 2)
  pfEmployer        Decimal?         @db.Decimal(15, 2)
  esiEmployee       Decimal?         @db.Decimal(15, 2)
  esiEmployer       Decimal?         @db.Decimal(15, 2)
  pt                Decimal?         @db.Decimal(15, 2)
  // Feature 21 — Labour Welfare Fund (period-incident; null in non-deduction months
  // so historical runs/golden snapshots are untouched). EE share is a net-pay
  // deduction; ER share is an employer cost (CTC), never netted from pay.
  lwfEmployee       Decimal?         @db.Decimal(15, 2)
  lwfEmployer       Decimal?         @db.Decimal(15, 2)
  tds               Decimal?         @db.Decimal(15, 2)
  paye              Decimal?         @db.Decimal(15, 2)
  kiwiSaverEmployee Decimal?         @db.Decimal(15, 2)
  kiwiSaverEmployer Decimal?         @db.Decimal(15, 2)
  esct              Decimal?         @db.Decimal(15, 2)
  accLevy           Decimal?         @db.Decimal(15, 2)
  studentLoan       Decimal?         @db.Decimal(15, 2)
  // Statutory WAGE BASES (not contributions) — the actual base the engine
  // computed each statutory deduction on, persisted so filing reads the real
  // wage figure straight through (NO float reconstruction by dividing a
  // contribution by a hardcoded rate). IN: PF/EPS/EDLI wage bases (post-cap).
  pfWagesBase       Decimal?         @db.Decimal(15, 2)
  epsWagesBase      Decimal?         @db.Decimal(15, 2)
  edliWagesBase     Decimal?         @db.Decimal(15, 2)
  // Status
  status            PayRunLineStatus @default(PENDING)
  errorJson         Json? // ENGINE per-line anomalies (compute/validation). Written ONLY by compute.
  varianceJson      Json? // VARIANCE per-line findings (period-over-period). Written ONLY by computeVariance.
  // Kept SEPARATE from errorJson so neither writer clobbers the other's BLOCKERs.
  computeTrace      Json? // optional engine trace (debug)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  version           Int              @default(0)

  components PayRunLineComponent[]
  payslip    Payslip?

  @@unique([payRunId, employeeId])
  @@index([businessId, employeeId])
  @@index([businessId, payRunId, status])
}

enum PayRunLineStatus {
  PENDING
  COMPUTED
  ON_HOLD
  ERROR
  EXCLUDED
  FINALIZED
}

/// Every component amount on a line (audit-grade, append-only).
model PayRunLineComponent {
  id            String            @id @default(uuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunLineId  String
  payRunLine    PayRunLine        @relation(fields: [payRunLineId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  componentId   String
  componentCode String
  componentName String
  category      ComponentCategory
  amount        Decimal           @db.Decimal(15, 2)
  baseAmount    Decimal?          @db.Decimal(15, 2) // base the calc ran on
  rateApplied   Decimal?          @db.Decimal(9, 6)
  isStatutory   Boolean           @default(false)
  sortOrder     Int               @default(0)

  @@index([businessId, payRunLineId])
  @@index([businessId, componentCode])
}

/// Immutable employee-facing artifact. Reissues use status=SUPERSEDED, never
/// delete; @retain:statutory (soft-delete only).
model Payslip {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payRunId        String
  payRun          PayRun        @relation(fields: [payRunId], references: [id], onDelete: Restrict)
  payRunLineId    String        @unique
  payRunLine      PayRunLine    @relation(fields: [payRunLineId], references: [id], onDelete: Restrict)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  code            String // PS-2026-04-EMP000142
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  payDate         DateTime      @db.Date
  currencyCode    String        @db.Char(3)
  grossEarnings   Decimal       @db.Decimal(15, 2)
  totalDeductions Decimal       @db.Decimal(15, 2)
  netPay          Decimal       @db.Decimal(15, 2)
  // Immutability + delivery
  snapshotJson    Json // full rendered payslip data, frozen
  pdfUrl          String?       @db.Text
  pdfHash         String? // SHA-256 of generated PDF (tamper evidence)
  yptdJson        Json? // year-to-date figures snapshot
  publishedAt     DateTime?
  viewedAt        DateTime?
  emailedAt       DateTime?
  status          PayslipStatus @default(GENERATED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime? // soft only; @retain:statutory
  version         Int           @default(0)

  @@unique([businessId, payRunId, employeeId])
  @@index([businessId, employeeId, payDate])
}

enum PayslipStatus {
  GENERATED
  PUBLISHED
  VIEWED
  SUPERSEDED
}

// ─────────────────────────────────────────────────────────────────────────────
// §22  STATUTORY BONUS (Payment of Bonus Act 1965) — Feature 22.
//   One BonusCycle = (entity, accounting year); mints exactly ONE PayRun(BONUS)
//   that rides the existing PayRun state machine + service.js pay/file/close.
//   Per-employee BonusAward rows are the immutable, frozen snapshot (≈ PayRunLine).
// ─────────────────────────────────────────────────────────────────────────────

/// One statutory-bonus cycle = (entity, accounting year). The header that the
/// per-employee BonusAward rows hang off, and that mints exactly ONE PayRun(BONUS).
model BonusCycle {
  id                      String           @id @default(uuid())
  businessId              String
  business                Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId                String
  entity                  Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  accountingYear          String // "2025-26" (FY; mirrors PayRun.taxYear)
  // The declared bonus rate for the year, 833..2000 (basis points: 8.33%..20%).
  rateBasisPoints         Int              @default(833) // 833 = 8.33% (min), 2000 = 20% (max)
  // Calculation-base cap: max(₹7,000, minWage). Stored in MINOR units (paise).
  calcCeilingMinor        BigInt           @default(700000) // ₹7,000 default; raised if min-wage higher
  minWageMonthlyMinor     BigInt? // optional per-scheduled-employment min wage (paise)
  eligibilityCeilingMinor BigInt           @default(2100000) // ₹21,000/mo wage ceiling (paise)
  // Optional HR-entered allocable surplus (paise) → drives set-on/set-off advisory only.
  allocableSurplusMinor   BigInt?
  priorSetOnMinor         BigInt           @default(0) // carried-forward set-on from prior years (§15)
  status                  BonusCycleStatus @default(DRAFT)
  // Statutory deadline = accountingYearEnd + 8 months (e.g. 2026-11-30). Resolved at create.
  dueDate                 DateTime         @db.Date
  payRunId                String? // the minted PayRun(type=BONUS); set at approve/mint
  computedAt              DateTime?
  computedBy              String?
  approvedAt              DateTime?
  approvedBy              String?
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?
  version                 Int              @default(0)
  awards                  BonusAward[]

  @@unique([businessId, entityId, accountingYear]) // exactly-once per (entity, FY)
  @@index([businessId, status, dueDate])
}

enum BonusCycleStatus {
  DRAFT // created; eligibility/computation not yet run
  COMPUTED // per-employee awards computed (snapshot frozen)
  APPROVED // maker-checker passed; PayRun(BONUS) minted
  PAID // disbursed (mirrors PayRun PAID)
  FILED // Form C/D generated/filed
  CANCELLED
}

/// One employee's bonus award for the cycle — the immutable per-employee snapshot
/// (mirrors a PayRunLine for the bonus run). Eligibility verdict + the capped-base math.
model BonusAward {
  id                  String     @id @default(uuid())
  businessId          String
  business            Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bonusCycleId        String
  bonusCycle          BonusCycle @relation(fields: [bonusCycleId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Eligibility verdict (Section 8/9 + ceiling).
  eligible            Boolean
  ineligibleReason    String? // 'OVER_CEILING' | 'UNDER_30_DAYS' | 'DISQUALIFIED_S9' | 'NOT_COVERED'
  // Inputs (frozen): the resolved monthly Basic+DA, worked/eligible months & days.
  monthlyBasicDaMinor BigInt     @default(0)
  cappedBaseMinor     BigInt     @default(0) // min(monthly Basic+DA, calcCeiling) (paise)
  eligibleMonths      Decimal    @default(0) @db.Decimal(5, 2) // proratable (e.g. 11.5 for a mid-year joiner)
  workedDays          Int        @default(0)
  rateBasisPoints     Int // the rate actually applied (snapshot of cycle rate)
  // Outputs (paise).
  grossBonusMinor     BigInt     @default(0) // base × months × rate, rounded ₹1
  advancePaidMinor    BigInt     @default(0) // festival/interim advance already paid (deduction)
  netBonusMinor       BigInt     @default(0) // grossBonus − advancePaid, floored at 0
  computeTrace        Json? // the explain[] for the bonus slip
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  version             Int        @default(0)

  @@unique([businessId, bonusCycleId, employeeId])
  @@index([businessId, bonusCycleId, eligible])
}

// ─────────────────────────────────────────────────────────────────────────────
// §46  VARIABLE PAY / INCENTIVE SCHEMES — Feature 46 (Phase 4). Country-agnostic.
//   The FIRST non-fixed, non-statutory earning: performance-linked incentives /
//   commission / discretionary variable pay. Mirrors BonusCycle/BonusAward 1:1:
//   VariablePayScheme (the reusable rule) → VariablePayCycle (one payout period,
//   DRAFT → COMPUTED → APPROVED (SoD maker-checker) → PAID) → per-employee
//   VariablePayAward (the immutable frozen snapshot ≈ PayRunLine). The approved
//   cycle pays each award by INJECTing a PayRunInputItem(kind=OTE) onto the
//   employee's entity's OPEN pay run (queued when none is open). Money lives in
//   integer paise through the pure core (variablePay.js); Decimal only at this edge.
// ─────────────────────────────────────────────────────────────────────────────

/// A reusable variable-pay RULE: what to pay, on what basis, how often, to whom.
/// One scheme spawns many VariablePayCycles (one per payout period).
model VariablePayScheme {
  id               String               @id @default(uuid())
  businessId       String
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  code             String? // optional short code, unique per business when set
  kind             VariablePayKind      @default(INCENTIVE)
  basis            VariablePayBasis     @default(GROSS)
  // Target as a % of the resolved basis (GROSS/BASIC/CTC). NULL when basis=FIXED_AMOUNT.
  targetPct        Decimal?             @db.Decimal(7, 4)
  // Flat target payout. Set ONLY when basis=FIXED_AMOUNT; NULL otherwise.
  targetAmount     Decimal?             @db.Decimal(15, 2)
  payoutFrequency  VariablePayFrequency @default(QUARTERLY)
  prorationMethod  VariablePayProration @default(NONE)
  // Eligibility filter, shaped like the recognition budget scope:
  // { entityIds?: [], departmentIds?: [], gradeIds?: [] }. NULL/empty ⇒ all active employees.
  eligibilityScope Json?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  cycles           VariablePayCycle[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

enum VariablePayKind {
  INCENTIVE
  COMMISSION
  BONUS
}

enum VariablePayBasis {
  GROSS // monthly gross from the current comp
  BASIC // monthly Basic (+DA) from the current comp
  CTC // annual CTC from the current comp
  FIXED_AMOUNT // a flat targetAmount (basis-independent)
}

enum VariablePayFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum VariablePayProration {
  NONE // everyone gets the full target (factor 1)
  BY_ATTENDANCE // reserved; v1 falls back to the active/period day-fraction
  BY_TENURE // active days / period days (mid-period joiners/leavers scaled)
}

/// One payout period for a scheme. The header the per-employee awards hang off and
/// that drives the OTE injections at approve. Mirrors BonusCycle's lifecycle.
model VariablePayCycle {
  id               String             @id @default(uuid())
  businessId       String
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  schemeId         String
  scheme           VariablePayScheme  @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  periodLabel      String // e.g. "2026-Q1"
  periodStart      DateTime           @db.Date
  periodEnd        DateTime           @db.Date
  status           VariablePayStatus  @default(DRAFT)
  computedAt       DateTime?
  computedBy       String? // SoD maker — the approver must differ (four-eyes)
  approvedByUserId String?
  approvedAt       DateTime?
  payRunId         String? // set when all injections landed on a single run
  totalsJson       Json? // { headcount, totalTargetMinor, totalComputedMinor, injected, queued, payRunIds }
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  version          Int                @default(0)
  awards           VariablePayAward[]

  @@unique([businessId, schemeId, periodLabel]) // exactly-once per (scheme, period)
  @@index([businessId, status])
}

enum VariablePayStatus {
  DRAFT // seeded; achievement% editable
  COMPUTED // computedAmount frozen per award
  APPROVED // maker-checker passed; OTE items injected / queued
  PAID // mirrors the paying run
  CANCELLED
}

/// One employee's variable-pay award for the cycle — the immutable per-employee
/// snapshot (≈ PayRunLine). computedAmount = targetAmount × achievement% × proration.
model VariablePayAward {
  id                String            @id @default(uuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycleId           String
  cycle             VariablePayCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Frozen inputs.
  basisAmount       Decimal           @default(0) @db.Decimal(15, 2) // resolved gross/basic/ctc for the period
  targetAmount      Decimal           @default(0) @db.Decimal(15, 2) // target payout before achievement/proration
  achievementPct    Decimal           @default(100) @db.Decimal(7, 4) // per-employee performance %, editable pre-compute
  prorationFactor   Decimal           @default(1) @db.Decimal(9, 6) // active/total days (or 1)
  computedAmount    Decimal           @default(0) @db.Decimal(15, 2) // frozen at compute
  status            VariablePayStatus @default(DRAFT)
  // Payout provenance (INJECT path).
  queued            Boolean           @default(false) // true when no open run existed at approve
  payRunInputItemId String? // the injected PayRunInputItem(kind=OTE), when injected
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  version           Int               @default(0)

  @@unique([cycleId, employeeId])
  @@index([businessId, cycleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// §27  AUTO-ARREAR ENGINE (retro salary revision) — Feature 27. India-only.
//   A CompensationRevision effective-dated in the PAST (an April increment
//   processed in July) yields ARREARS for the already-paid, FROZEN elapsed months.
//   Mirrors BonusCycle/BonusAward 1:1 (DRAFT → COMPUTED → APPROVED (SoD) → PAID):
//   one ArrearCycle per (business, revision), one ArrearMonth per source month
//   holding the recompute-vs-frozen diff to the paise. The approved cycle pays the
//   arrear by INJECTing a PayRunInputItem(kind=ARREAR) onto the open run OR MINTing
//   a PayRun(type=ARREAR) through the SAME persist path bonus/FnF use. Additive
//   only — two new models + one new enum; reuses PayRunType.ARREAR,
//   PayRunInputKind.ARREAR, CompRevisionReason, CompensationRevision.sourcePeriodCode.
// ─────────────────────────────────────────────────────────────────────────────

/// One detected retro revision turned into an arrears computation. Exactly-once on
/// (businessId, compensationRevisionId): a revision yields ONE cycle (the @@unique
/// is the idempotency guard that prevents a second cycle / double-pay).
model ArrearCycle {
  id                     String             @id @default(uuid())
  businessId             String
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId               String
  entity                 Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  employeeId             String // arrears are per-employee (one revision = one employee)
  employee               Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  compensationRevisionId String // the retro revision that triggered this
  revisionReason         CompRevisionReason // drives the ESI-on-arrears gate (§2)
  effectiveFrom          DateTime           @db.Date // revision retro date
  detectedInPeriod       String // "YYYY-MM" — the open period it was detected in
  taxYear                String // receipt FY, e.g. "2026-27" (drives Form 10E vs 39)
  esiOnArrears           Boolean            @default(true) // resolved from reason; operator-overridable
  status                 ArrearStatus       @default(DRAFT)
  targetMode             String? // 'INJECT' | 'MINT' (set at approve)
  // Totals (paise) — filled at compute.
  grossArrearMinor       BigInt             @default(0)
  pfArrearEeMinor        BigInt             @default(0)
  pfArrearErMinor        BigInt             @default(0)
  esiArrearEeMinor       BigInt             @default(0)
  esiArrearErMinor       BigInt             @default(0)
  // Section 89(1) relief data point (paise; null until computed).
  s89ReliefMinor         BigInt?
  s89DatapointJson       Json? // per-source-year slices + the 6-step arithmetic
  // Lifecycle.
  payRunId               String? // the minted/target run that pays the arrear
  payRunInputItemId      String? // the INJECTed PayRunInputItem (INJECT mode stamp)
  createdBy              String? // the actor who created the cycle (SoD: approver ≠ creator)
  computedAt             DateTime?
  computedBy             String?
  approvedAt             DateTime?
  approvedBy             String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  version                Int                @default(0)

  months ArrearMonth[]

  // Exactly-once per revision is enforced by a PARTIAL unique index (created in the
  // migration) that applies ONLY to LIVE rows (deletedAt IS NULL) — see review finding
  // #2: a full @@unique([businessId, compensationRevisionId]) permanently stranded a
  // CANCELLED/soft-deleted cycle (no new cycle could ever be created for that revision,
  // even though detectArrearCycles already excludes deleted cycles). The partial index
  // keeps exactly-once for ACTIVE cycles while letting a cancelled one be regenerated.
  @@index([businessId, compensationRevisionId])
  @@index([businessId, employeeId, status])
  @@index([businessId, entityId, detectedInPeriod])
}

/// Per source-month diff: the recompute-vs-frozen delta. The audit trail that makes
/// the arrear idempotent and explainable to the paise.
model ArrearMonth {
  id                     String      @id @default(uuid())
  businessId             String
  arrearCycleId          String
  arrearCycle            ArrearCycle @relation(fields: [arrearCycleId], references: [id], onDelete: Cascade)
  sourcePeriod           String // "YYYY-MM"
  sourcePayRunId         String // the frozen run that paid this month (the baseline)
  // Baseline (already paid) vs recomputed (at new comp) — paise.
  paidGrossMinor         BigInt
  recomputedGrossMinor   BigInt
  deltaGrossMinor        BigInt // recomputed − paid (can be negative for a downward revision)
  paidPfWageMinor        BigInt
  recomputedPfWageMinor  BigInt
  deltaPfWageMinor       BigInt
  paidEsiWageMinor       BigInt
  recomputedEsiWageMinor BigInt
  deltaEsiWageMinor      BigInt
  // Per-source-month statutory arrear (paise) — PF capped per source month, ESI gated.
  pfArrearEeMinor        BigInt      @default(0)
  pfArrearErMinor        BigInt      @default(0)
  esiArrearEeMinor       BigInt      @default(0)
  esiArrearErMinor       BigInt      @default(0)
  // Component-level deltas for the payslip explain (Json: [{code,label,deltaMinor}]).
  componentDeltasJson    Json
  // The frozen attendance the recompute used (provenance, not recomputed live).
  payableDays            Decimal     @db.Decimal(8, 4)
  lopDays                Decimal     @db.Decimal(8, 4)
  createdAt              DateTime    @default(now())

  @@unique([arrearCycleId, sourcePeriod]) // one diff row per source month
  @@index([businessId, sourcePeriod])
}

enum ArrearStatus {
  DRAFT // detected, not yet computed
  COMPUTED // per-month diffs + 89(1) figured
  APPROVED // SoD-approved; arrear injected into a run / minted
  PAID
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// §24  FORM 16 (TDS certificate) + Form 24Q — Feature 24. India-only.
//   One Form16Batch = (entity, financial year); a maker-checker generation run
//   mirroring BonusCycle (DRAFT → COMPUTED → APPROVED (SoD) → ISSUED). Per-employee
//   Form16Certificate rows freeze the paise-exact partAJson (TRACES-style quarter-
//   wise TDS deposited) + partBJson (the F15 annual projection at FY-end), then
//   bulk-issue through the EXISTING letters + e-sign engines (IssuedLetter +
//   EmployeeDocument EMPLOYEE_VISIBLE → the ESS vault). NO new tax math, NO new
//   challan model (Part A reads the existing StatutoryRemittance IN_TDS rows), NO
//   fork of the FVU generator (24Q reuses filing/india.js generate24Q).
// ─────────────────────────────────────────────────────────────────────────────

/// The annual Form-16 generation run for one entity + financial year. Mirrors
/// BonusCycle: DRAFT → COMPUTED → APPROVED (SoD) → ISSUED. India-only.
model Form16Batch {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId      String
  entity        Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  financialYear String // "2026-27" (Apr–Mar)
  formKind      RemittanceKind @default(IN_FORM16) // IN_FORM16 | IN_FORM130 (FY ≥ 2026-27, effective-dated §11)

  status                 Form16BatchStatus @default(DRAFT)
  // Deductor identity SNAPSHOT at generate (so a later Entity edit can't alter an issued cert).
  deductorPan            String?           @db.Char(10)
  deductorTan            String?           @db.Char(10)
  deductorName           String?
  // Reconciliation roll-up (computed at COMPUTED).
  headcount              Int               @default(0)
  totalTdsDeductedMinor  BigInt            @default(0) // Σ certificate TDS (paise)
  totalTdsDepositedMinor BigInt            @default(0) // Σ challan-matched deposited (paise)
  reconciledOk           Boolean           @default(false) // deducted == deposited within tolerance
  // Maker-checker actors (SoD — approver ≠ computedBy).
  computedAt             DateTime?
  computedBy             String?
  approvedAt             DateTime?
  approvedBy             String?
  issuedAt               DateTime?
  issuedBy               String?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  version                Int               @default(0)

  certificates Form16Certificate[]

  @@unique([businessId, entityId, financialYear]) // exactly one batch per entity+FY
  @@index([businessId, status])
}

enum Form16BatchStatus {
  DRAFT
  COMPUTED
  APPROVED
  ISSUED
  CANCELLED
}

/// One employee's Form-16 for the batch's FY. partAJson + partBJson are the
/// FROZEN, paise-exact certificate content (the immutable truth at generate);
/// the issued PDF + ESS vault doc link to the IssuedLetter (reuse, no fork).
model Form16Certificate {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Form16Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  financialYear String
  // Unique TDS certificate number. Deterministic per (entity, FY) via
  // allocateCode(scope='FORM16', periodKey=FY) — burned, never reused. The TRACES
  // authenticated number can be pasted into tracesCertNo before issue (optional).
  certificateNo String
  tracesCertNo  String? // optional: the TRACES Part-A unique number, if downloaded

  regime              INTaxRegime
  // Frozen content (the certificate as issued):
  partAJson           Json // deductor/deductee identity, employment period, quarter-wise TDS summary + challans
  partBJson           Json // the F15 annual computation (salary→exemptions→ChVIA→tax→TDS)
  // Money roll-ups (paise) for quick filter/reconcile + the register:
  grossSalaryMinor    BigInt           @default(0)
  totalTaxableMinor   BigInt           @default(0)
  totalTaxMinor       BigInt           @default(0) // tax+surcharge+cess after rebate/relief
  tdsDeductedMinor    BigInt           @default(0) // Σ TDS on this FY's payslips
  tdsDepositedMinor   BigInt           @default(0) // Σ challan-matched
  // Anomalies surfaced on the cert (e.g. MISSING_PAN, TDS_GAP, NO_PAYSLIPS).
  anomaliesJson       Json?
  // Issue linkage (reuse letters): set when bulk-issued.
  issuedLetterId      String? // → IssuedLetter (ref-no, PDF, e-sign envelope)
  employeeDocumentId  String? // → the ESS vault doc (mirror of IssuedLetter.employeeDocumentId)
  fileHash            String? // sha256 of the issued PDF (tamper anchor)
  signatureEnvelopeId String? // when the batch issues signed
  status              Form16CertStatus @default(PENDING)
  // Supersede chain (mirrors IssuedLetter.supersedes/supersededBy). A re-generate
  // NEVER mutates a frozen ISSUED cert: it marks the old row SUPERSEDED and INSERTs a
  // fresh row, linked both ways, so the originally-certified partAJson/partBJson stays
  // immutable and recoverable.
  supersedesCertId    String? // this row re-mints an older (now SUPERSEDED) cert
  supersededByCertId  String? // an older row superseded by a newer one
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  version             Int              @default(0)

  // NOTE: "one cert per employee per batch" is now a PARTIAL unique index (only over
  // rows whose status <> 'SUPERSEDED'), created in the migration via raw SQL — a
  // superseded cert and its replacement legitimately coexist for the same
  // (business, batch, employee). Prisma can't express a filtered unique, so the
  // compound @@unique is intentionally dropped here in favour of that partial index.
  @@unique([businessId, certificateNo]) // certificate number is unique per tenant (burned, never reused)
  @@index([businessId, batchId, employeeId])
  @@index([businessId, employeeId, financialYear])
  @@index([businessId, status])
}

enum Form16CertStatus {
  PENDING // computed, not yet issued
  ISSUED // PDF minted + in the employee's vault (unsigned or signed-complete)
  PENDING_SIGNATURE // issued into an e-sign envelope, awaiting signer(s)
  VOIDED // legally retracted (the IssuedLetter is revoked) without a replacement
  SUPERSEDED // immutable history: replaced by a re-generated cert (supersededByCertId)
}

/// Employer filing/payment obligations generated from a pay run.
model StatutoryRemittance {
  id              String                @id @default(uuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId        String
  entity          Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict)
  payRunId        String?
  payRun          PayRun?               @relation(fields: [payRunId], references: [id], onDelete: SetNull)
  kind            RemittanceKind
  taxPeriod       String // "2026-04" or "2026-Q1"
  amount          Decimal               @db.Decimal(18, 2)
  currencyCode    String                @db.Char(3)
  dueDate         DateTime              @db.Date
  filedDate       DateTime?
  paidDate        DateTime?
  challanRef      String? // CRN/challan/IRD ref
  status          RemittanceStatus      @default(PENDING)
  fileUrl         String?               @db.Text // ECR txt / Form 24Q / payday CSV
  meta            Json?
  // ── Feature 23 — Statutory Compliance Calendar (ADDITIVE, all nullable so the
  //    existing fileRun() writer's rows stay valid). The calendar OWNS the
  //    definition (ComplianceObligation); the INSTANCE row is shared with payroll.
  obligationId    String? // FK → ComplianceObligation (NULL for legacy/payroll-only rows)
  obligation      ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  stateCode       String? // mirror for PT/LWF per-state instances (NULL = entity-wide)
  // proof of filing (mark-filed action):
  proofUrl        String?               @db.Text // uploaded challan / receipt
  proofUploadedAt DateTime?
  filedByUserId   String? // who marked it filed (audit + SoD)
  // reminder bookkeeping (idempotent nudges — never spam):
  lastReminderAt  DateTime?
  remindersSent   Int                   @default(0)
  reminderStage   String? // "T-7" | "T-3" | "T-1" | "DUE" | "OVERDUE" — last stage nudged
  // waiver / not-applicable for a period:
  waivedReason    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  version         Int                   @default(0)

  // Natural-key uniqueness for the per-period INSTANCE row shared by fileRun() and
  // the compliance generator (calendarRunner upsertStub). Without it the P2002
  // guard in upsertStub was dead code → concurrent generate could insert duplicate
  // obligations. NOTE: the MIGRATION installs the stricter COALESCE(stateCode,'')
  // expression index (Postgres treats NULL as DISTINCT in a plain unique, which
  // would let dup entity-wide NULL rows in) — same pattern as ComplianceObligation.
  @@unique([businessId, entityId, kind, taxPeriod, stateCode])
  @@index([businessId, entityId, kind, taxPeriod])
  @@index([businessId, status, dueDate])
  @@index([businessId, obligationId])
}

enum RemittanceKind {
  IN_TDS
  IN_PF
  IN_ESI
  IN_PT
  IN_LWF
  IN_FORM24Q
  IN_FORM16
  IN_BONUS
  // Feature 23 — Statutory Compliance Calendar additions (additive only). The
  // Income Tax Act 2025 successors are effective-dated DATA, not a code branch:
  //   IN_FORM24Q → IN_FORM138 (TDS-salary quarterly return, txns ≥ 2026-04-01)
  //   IN_FORM16  → IN_FORM130 (TDS-salary annual certificate, FY ≥ 2026-27)
  IN_FORM138 // 24Q successor (Income Tax Act 2025)
  IN_FORM130 // Form 16 successor (Income Tax Act 2025)
  IN_ESI_RETURN // ESI half-yearly return (11 Apr / 11 Oct)
  IN_PF_ANNUAL // optional EPF annual tracker
  IN_GRATUITY // event-driven (separation + 30d); off the recurring calendar

  NZ_PAYE
  NZ_PAYDAY_FILING
  NZ_KIWISAVER
  NZ_ESCT
  NZ_STUDENT_LOAN
  NZ_ACC
}

enum RemittanceStatus {
  PENDING
  DUE
  FILED
  PAID
  OVERDUE
  WAIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// §23  STATUTORY COMPLIANCE CALENDAR — Feature 23.
//   ComplianceObligation is the per-tenant rule SCHEDULE (the definition of WHAT
//   this entity owes and on WHAT cadence), effective-dated so the Income Tax Act
//   2025 succession (24Q→138, Form16→130 from 1-Apr-2026) is DATA not a branch.
//   The per-period INSTANCE row is the EXISTING StatutoryRemittance (extended
//   above); the generator + fileRun() both write it, idempotent on the natural
//   key (businessId, entityId, kind, taxPeriod[, stateCode]).
// ─────────────────────────────────────────────────────────────────────────────

/// The per-tenant statutory-obligation rule schedule. One row per
/// (entity, kind, [stateCode], effectiveFrom) the tenant is liable for, seeded
/// from StatutoryRegistration on entity/registration change and editable by HR.
model ComplianceObligation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  kind      RemittanceKind // reuse the SAME enum as the instance row
  stateCode String? // PT / LWF: per-state; NULL = entity-wide
  cadence   ComplianceCadence // MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL | EVENT

  // Due-date rule (interpreted by the pure engine — compliance/india.calendar.js):
  dueDom       Int? // day-of-month the filing is due
  dueMonths    Int[] @default([]) // HALF_YEARLY/ANNUAL: calendar months it lands in ([4,10] ESI return; [6] Form16)
  offsetMonths Int   @default(1) // months after period end the due date lands (TDS=1, 24Q≈1)
  specialRules Json? // e.g. {"marchDueDom":30,"marchDueMonth":4} for TDS; {"ptPeriodicity":"MONTHLY"}

  // Effective-dating (24Q→138, 16→130 succession). Same shape as StatutoryRegistration.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // when superseded (e.g. 24Q effectiveTo 2026-03-31)
  supersededBy  String? // optional successor-kind label for the UX ("becomes Form 138")

  isActive     Boolean @default(true)
  autoGenerate Boolean @default(true) // generator materialises future instances for this
  reminderDays Int[]   @default([7, 3, 1, 0]) // T-minus days to nudge HR (0 = due day)
  meta         Json? // penaltyHint, label, govtPortalUrl, form name

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  version     Int                   @default(0)
  remittances StatutoryRemittance[]

  @@unique([businessId, entityId, kind, stateCode, effectiveFrom])
  @@index([businessId, entityId, isActive])
}

enum ComplianceCadence {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  EVENT
}

// ─────────────────────────────────────────────────────────────────────────────
// §7c  STATUTORY REGISTERS  (Feature 32 — muster roll + Form registers)
//
// A per-state, effective-dated DEFINITION table (each statutory form → its
// ordered columns, every column bound to a field PATH on one of the FROZEN
// sources: attendance freeze / payroll snapshot / leave ledger / employee). A
// PURE projector (src/hr/registers/projector.js) reads the definition + the
// already-fetched frozen rows and emits the register. NOTHING is recomputed; no
// source table is created or mutated. Mirrors ComplianceObligation (Feature 23):
// adding a state/form is DATA (a seed row), never a code branch.
// ─────────────────────────────────────────────────────────────────────────────

model RegisterDefinition {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Definitions are usually TENANT-DEFAULT (businessId-only, entityId NULL) seeded
  // rows that all entities inherit; an entityId-scoped row OVERRIDES the default
  // for one entity (e.g. a factory entity adopting a different state's forms).
  entityId   String?
  entity     Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  kind      RegisterKind // MUSTER_ROLL | WAGE_REGISTER | ... (the §2.1 families)
  formCode  String // "FORM_25" | "FORM_Q" | "FORM_D" | "FORM_3A" ...
  formLabel String // "Muster Roll (Factories Form 25)"
  actLabel  String // "Factories Act 1948" | "Maharashtra S&E 2017" | "Ease-of-Compliance Rules 2017"
  stateCode String? // per-state form; NULL = central / any state
  cadence   RegisterCadence // PERIOD | HALF_YEARLY | ANNUAL | SNAPSHOT
  source    RegisterSource // which FROZEN source the projector reads

  // The ordered columns. Each column binds a label to a field PATH on the source
  // row (resolved by the projector). `transform` is a named, whitelisted formatter
  // (e.g. "rupee", "days2", "statusMark", "date"); `daily:true` marks the per-day
  // muster grid expansion (one column per day-of-month). Validated by assertColumns
  // at write time. Stored as JSON (a small ordered read-mostly layout descriptor,
  // consumed wholesale — same rationale as ComplianceObligation.specialRules).
  columns Json // [{ key, label, source, path, transform?, daily?, statutory? }]

  // Effective-dating — same shape as StatutoryRegistration / ComplianceObligation,
  // so a form-number change (a state notifying a new format, or a tenant adopting
  // the Ease-of-Compliance set on a date) is DATA, not a code fork.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  meta          Json? // { retentionYears, govtRef, orientation:"landscape", combinedWith? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  exports RegisterExport[]

  @@unique([businessId, entityId, kind, formCode, stateCode, effectiveFrom])
  @@index([businessId, isActive, kind])
}

// Every generated register is logged (who / which entity / which period / which
// format / row + control totals + the frozen source refs it read) for inspector
// evidence + idempotent re-download + tamper evidence (fileHash). Optionally
// archives the bytes to S3 for the statutory retention window. No source mutation.
model RegisterExport {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  definitionId String?
  definition   RegisterDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  entityId     String
  entity       Entity              @relation(fields: [entityId], references: [id], onDelete: Restrict)
  kind         RegisterKind
  formCode     String
  stateCode    String?

  // The period the register covers:
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  periodLabel String // "2026-05" | "FY2025-26" | "H1-2026"
  format      String // "PDF" | "XLSX" | "CSV"

  // Provenance of the FROZEN sources rolled in (so a re-export is reproducible /
  // verifiable): the payRunIds / attendance-freeze markers / leave period it read.
  sourceRefs Json // { payRunIds:[], attendanceFrozen:true, leavePeriodCode? }

  rowCount      Int     @default(0)
  controlTotals Json? // { grossRupees, netRupees, pfEeRupees, ... } — printed footer + tamper check
  fileUrl       String? @db.Text // S3 archive (optional)
  fileHash      String? // SHA-256 of generated bytes (tamper evidence, like Payslip.pdfHash)

  generatedByUserId String
  createdAt         DateTime @default(now())

  @@index([businessId, entityId, kind, periodStart])
  @@index([businessId, definitionId])
}

enum RegisterKind {
  MUSTER_ROLL
  WAGE_REGISTER
  MUSTER_WAGE_COMBINED
  OVERTIME_REGISTER
  LEAVE_REGISTER
  FINES_REGISTER
  EMPLOYEE_REGISTER
  PF_ANNUAL // Form 3A/6A as a human register
  ESI_REGISTER // half-yearly contribution register
}

enum RegisterCadence {
  PERIOD
  HALF_YEARLY
  ANNUAL
  SNAPSHOT
}

enum RegisterSource {
  ATTENDANCE
  PAYRUN
  LEAVE
  EMPLOYEE
  PAYRUN_ANNUAL
}

// ─────────────────────────────────────────────────────────────────────────────
// §8  LEAVE  (type → policy → assignment → balance → transaction)
//   NZ Holidays Act 2003 carried via LeaveType.unit=WEEKS, nzPayBasis,
//   LeaveBalance.nzAccruedGrossEarnings (8%/AWE). Mined from booking StaffLeave.
// ─────────────────────────────────────────────────────────────────────────────

model LeaveType {
  id             String                   @id @default(uuid())
  businessId     String
  business       Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  countryCode    String?                  @db.Char(2) // NULL = both
  code           String // "EL","SL","CL","ANNUAL","SICK","BEREAVEMENT","PUBLIC","ALT"
  name           String
  category       LeaveCategory
  unit           LeaveUnit                @default(DAYS) // NZ ANNUAL = WEEKS
  isPaid         Boolean                  @default(true)
  isStatutory    Boolean                  @default(false)
  nzPayBasis     NZLeavePayBasis? // RDP | ADP | AWE_8PCT | OWP
  requiresReason Boolean                  @default(false)
  affectsLOP     Boolean                  @default(false) // unpaid → loss of pay on payroll
  isEncashable   Boolean                  @default(false)
  // Sandwich-leave behaviour for interior holidays/weekoffs inside a leave block
  // (Feature 6 §3.2). NULL ⇒ derive from countryCode (NZ ⇒ EXCLUSIVE, IN ⇒ INCLUSIVE).
  sandwichPolicy SandwichPolicy?
  color          String? // ESS calendar chip
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  version        Int                      @default(0)
  policies       LeavePolicy[]
  balances       LeaveBalance[]
  txns           LeaveTransaction[]
  encashRequests LeaveEncashmentRequest[] // Feature 31 — in-service encashment

  @@unique([businessId, code])
  @@index([businessId, countryCode, category])
}

enum SandwichPolicy {
  INCLUSIVE // interior holidays/weekoffs are debited against the balance (IN EL)
  EXCLUSIVE // interior public holidays are paid as holidays, never debited (NZ)
}

enum LeaveCategory {
  ANNUAL
  CASUAL
  SICK
  MATERNITY
  PATERNITY
  BEREAVEMENT
  PUBLIC_HOLIDAY
  ALTERNATIVE_DAY
  COMP_OFF
  UNPAID
  SABBATICAL
  MARRIAGE
  ADOPTION
  FAMILY_VIOLENCE
  OTHER
}

enum LeaveUnit {
  DAYS
  HOURS
  WEEKS
}

enum NZLeavePayBasis {
  RDP // Relevant Daily Pay (Holidays Act s9)
  ADP // Average Daily Pay (s9A)
  AWE_8PCT // Annual holiday pay: greater of OWP & Avg Weekly Earnings
  OWP // Ordinary Weekly Pay
}

model LeavePolicy {
  id                       String                  @id @default(uuid())
  businessId               String
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leaveTypeId              String
  leaveType                LeaveType               @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  entityId                 String?
  code                     String
  name                     String
  // Entitlement
  accrualMethod            AccrualMethod
  entitlementPerYear       Decimal?                @db.Decimal(8, 4) // 18 EL days, or 4 weeks (NZ)
  // Feature 16 — the India statutory floor (EL/SL/CL minimum days/yr) resolved at
  // author time for audit. The LIVE gate re-resolves the floor from
  // india.leaveStatutoryFramework on every save so a floor change re-validates;
  // this column is the as-authored stamp. NULL for non-floored types (LWP, NZ).
  statutoryFloorPerYear    Decimal?                @db.Decimal(8, 4)
  accrualFrequency         AccrualFrequency        @default(MONTHLY)
  accrualProrateOnJoin     Boolean                 @default(true)
  // Carry-forward & expiry
  carryForwardCap          Decimal?                @db.Decimal(8, 4)
  carryForwardExpiryMonths Int?
  // Limits
  maxBalanceCap            Decimal?                @db.Decimal(8, 4)
  maxConsecutive           Int?
  minNoticeDays            Int?
  allowNegative            Boolean                 @default(false) // advance leave
  negativeCap              Decimal?                @db.Decimal(8, 4)
  // Eligibility gates
  minTenureMonths          Int                     @default(0) // NZ annual leave vests at 12 months
  blockDuringProbation     Boolean                 @default(false) // leave-audit: gate on EmployeeStatus.PROBATION (orthogonal to tenure months)
  appliesToEmploymentTypes String? // CSV of EmploymentType
  genderRestriction        Gender? // maternity/paternity
  // Encashment (EXIT — F&F, §10(10AA) exemption applies)
  encashOnExit             Boolean                 @default(false)
  encashFormula            String?
  maxEncashCap             Decimal?                @db.Decimal(8, 4) // cap encashable units (Feature 6 §3.2); NULL = unbounded
  // Feature 31 — IN-SERVICE encashment (distinct from encashOnExit). The annual
  // "encashment window" most IN factories/BPOs run alongside the leave year-end.
  // FULLY TAXABLE under §17 (§10(10AA) is EXIT-ONLY); the per-day money basis is
  // shared with F&F (fnf.perDay26 for BASIC_DA_26). maxEncashCap (exit) and
  // encashMaxDaysPerYear (in-service) are SEPARATE caps. NZ tenants leave these inert.
  encashInService          Boolean                 @default(false) // master opt-in for this type
  encashBasis              EncashmentBasis         @default(BASIC_DA_26) // per-day money basis
  encashMaxDaysPerYear     Decimal?                @db.Decimal(8, 4) // cap on days/policy-year (e.g. 15)
  encashMinDaysPerRequest  Decimal?                @db.Decimal(8, 4) // floor (e.g. must encash >= 5)
  encashMinBalanceAfter    Decimal?                @db.Decimal(8, 4) // must leave >= N days (statutory carry intent)
  encashMaxRequestsPerYear Int                     @default(1) // typically once/year
  encashWindowOpenMonth    Int? // 1–12; NULL = always open (e.g. only in March)
  encashWindowCloseMonth   Int?
  encashPfWages            Boolean                 @default(false) // §1.4 — usually NOT PF wages
  encashEsiWages           Boolean                 @default(false) // periodicity > 2 months => not ESI wages
  encashPtWages            Boolean                 @default(true) // part of month gross for PT slab
  encashWorkflowId         String? // F10 approval chain; NULL => built-in default
  // Feature 30 — comp-off knobs (only meaningful for a COMP_OFF-type policy).
  // { expiryDays:60, requireApproval:true, autoEarn:true, minWorkedMinutesForCredit:240,
  //   fullDayMinutes:480, allowHalfDay:true, allowEncash:false,
  //   earnFromWeeklyOff:true, earnFromHoliday:true, expiryReminderDays:7 }
  compOffConfig            Json?
  workflowDefinitionId     String?
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  version                  Int                     @default(0)
  assignments              LeavePolicyAssignment[]
  accrualRules             AccrualRule[]

  @@unique([businessId, code])
  @@index([businessId, leaveTypeId, entityId])
}

enum AccrualMethod {
  UPFRONT_ANNUAL
  MONTHLY_ACCRUAL
  ANNIVERSARY_GRANT
  WORKED_HOURS_RATIO
  CONTINUOUS_NZ
  NONE // Feature 16 — LWP / no-accrual types: never grants a LeaveBalance row
}

enum AccrualFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  PER_PAY_PERIOD
}

/// Tenure-tiered accrual (more EL after N years). Append-only config row.
model AccrualRule {
  id              String      @id @default(uuid())
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leavePolicyId   String
  leavePolicy     LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  minTenureMonths Int
  maxTenureMonths Int?
  ratePerPeriod   Decimal     @db.Decimal(8, 4)
  createdAt       DateTime    @default(now())

  @@index([businessId, leavePolicyId, minTenureMonths])
}

model LeavePolicyAssignment {
  id            String          @id @default(uuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leavePolicyId String
  leavePolicy   LeavePolicy     @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  scope         AssignmentScope
  scopeRefId    String? // entity/dept/grade/employee id
  effectiveFrom DateTime        @db.Date
  effectiveTo   DateTime?       @db.Date
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([businessId, leavePolicyId, scope, scopeRefId])
}

enum AssignmentScope {
  ENTITY
  DEPARTMENT
  GRADE
  EMPLOYMENT_TYPE
  EMPLOYEE
}

/// Running balance per (employee, leaveType, period). Derived `closing` is
/// persisted for fast reads; reconstructable from LeaveTransaction ledger.
model LeaveBalance {
  id                     String    @id @default(uuid())
  businessId             String
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId            String
  leaveType              LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  periodCode             String // "2026-27" or NZ anniversary "2026-ANNIV"
  unit                   LeaveUnit
  opening                Decimal   @default(0) @db.Decimal(10, 4)
  accrued                Decimal   @default(0) @db.Decimal(10, 4)
  taken                  Decimal   @default(0) @db.Decimal(10, 4)
  pendingApproval        Decimal   @default(0) @db.Decimal(10, 4) // soft-hold
  encashed               Decimal   @default(0) @db.Decimal(10, 4)
  lapsed                 Decimal   @default(0) @db.Decimal(10, 4)
  adjusted               Decimal   @default(0) @db.Decimal(10, 4)
  closing                Decimal   @default(0) @db.Decimal(10, 4) // derived; persisted
  // NZ annual leave money valuation (weeks → $ via 8% / AWE)
  nzAccruedGrossEarnings Decimal?  @db.Decimal(15, 2)
  lastAccrualAt          DateTime?
  // Year-end carry-forward idempotency marker (Feature 6 §4.4). Stamped on the
  // SOURCE balance when runCarryForward rolls it into the next period; the in-tx
  // re-guard skips a balance whose carriedForwardAt is already set, so a re-run /
  // double-click / double-fired cron can never double-lapse + double-carry.
  carriedForwardAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  version                Int       @default(0)

  @@unique([businessId, employeeId, leaveTypeId, periodCode])
  @@index([businessId, employeeId])
}

/// Append-only ledger: every accrual/application/cancellation/encashment/
/// lapse/adjustment is a row, so the balance is always reconstructable.
model LeaveTransaction {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId       String
  leaveType         LeaveType        @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveBalanceId    String?
  txnType           LeaveTxnType
  unit              LeaveUnit
  quantity          Decimal          @db.Decimal(10, 4) // +accrual / -taken (signed)
  // Application-specific (NULL for accrual/lapse rows)
  startDate         DateTime?        @db.Date
  endDate           DateTime?        @db.Date
  startHalf         DayHalf? // FIRST_HALF/SECOND_HALF for half-days
  endHalf           DayHalf?
  reason            String? // @pii:sensitive for sick/bereavement
  // NZ pay valuation snapshot at approval
  nzPayBasisUsed    NZLeavePayBasis?
  paidAmount        Decimal?         @db.Decimal(15, 2)
  // Workflow
  status            LeaveTxnStatus   @default(DRAFT)
  approvalRequestId String?
  appliedAt         DateTime?
  decidedAt         DateTime?
  decidedBy         String?
  payRunId          String? // when consumed by payroll (LOP/paid)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  version           Int              @default(0)

  compOffConsumptions CompOffConsumption[] // Feature 30 — lots this APPLICATION debited (finding #5)

  @@index([businessId, employeeId, leaveTypeId])
  @@index([businessId, status])
  @@index([businessId, startDate, endDate])
}

enum LeaveTxnType {
  ACCRUAL
  APPLICATION
  CANCELLATION
  ENCASHMENT
  LAPSE
  ADJUSTMENT
  OPENING_BALANCE
}

enum LeaveTxnStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
  AVAILED
}

enum DayHalf {
  FIRST_HALF
  SECOND_HALF
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 31 — IN-SERVICE leave encashment (distinct from F&F exit encashment).
// An employee surrenders unused EL/PL days for cash WHILE in service; the request
// debits the leave balance on APPROVE (a ENCASHMENT LeaveTransaction + encashed+/
// closing−) and pays out via the next pay run as a positive, FULLY-TAXABLE earning.
// The §10(10AA) exemption is EXIT-ONLY and is NEVER applied here.
// ─────────────────────────────────────────────────────────────────────────────

enum EncashmentBasis {
  BASIC_DA_26 // (Basic+DA)/26 — reuses fnf.perDay26 (DEFAULT, market standard)
  BASIC_30 // Basic/30
  GROSS_30 // Gross/30
}

enum EncashmentStatus {
  PENDING // soft-hold placed; awaiting approval
  APPROVED // balance DEBITED; queued for next run (un-paid: payRunId NULL)
  REJECTED // hold released; no debit
  CANCELLED // employee withdrew while PENDING; hold released
  PAID // run disbursed; payRunId + paidAmountMinor stamped (terminal)
}

/// The in-service encashment request. Mirrors LeaveTransaction's workflow fields +
/// ExpenseClaim's payRunId/paidViaPayrollAmount payout-stamp fields (the two
/// idempotency anchors: the balance debit at APPROVE, the cash stamp at DISBURSE).
model LeaveEncashmentRequest {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leavePolicyId String? // the resolved policy at request time (audit)
  periodCode    String // the LeaveBalance period the days come from ("2026-27")

  // What & how much
  days                Decimal         @db.Decimal(8, 4) // requested days
  basis               EncashmentBasis // snapshot of policy.encashBasis at request
  basicDaMonthlyMinor BigInt? // snapshot of last-drawn Basic+DA (paise) at APPROVE
  perDayMinor         BigInt? // snapshot perDay at APPROVE (display)
  amountMinor         BigInt? // floor(basicDa×days/26+0.5) — computed at APPROVE
  reason              String?

  // Workflow (mirror LeaveTransaction)
  status            EncashmentStatus @default(PENDING)
  approvalRequestId String? // F10 ApprovalRequest link
  appliedAt         DateTime?
  decidedAt         DateTime?
  decidedBy         String?
  // The append-only ledger row that carried the balance debit (set at APPROVE).
  encashmentTxnId   String? // → LeaveTransaction(txnType=ENCASHMENT)

  // Payout stamp (set by the pay pass at DISBURSE — mirror ExpenseClaim.payRunId)
  payRunId        String? // owning run; the idempotency anchor
  paidAmountMinor BigInt? // paise actually paid through the run (== amountMinor)
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([businessId, employeeId, status])
  @@index([businessId, status, payRunId]) // pay-pass selection scan
  @@index([businessId, leaveTypeId, periodCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature 30 — COMP-OFF (compensatory off) expiry lot.
//
// A comp-off credit is the per-credit expiry "lot" that the flat aggregate
// LeaveBalance cannot express. The aggregate COMP_OFF LeaveBalance.closing is kept
// in lockstep (== Σ remaining over ACTIVE lots) so every existing balance/ledger/
// reconcile/FnF path works unchanged. `remaining` is DERIVED (quantity − consumed),
// never stored — mirroring how LeaveBalance.closing is derived from the ledger.
// ─────────────────────────────────────────────────────────────────────────────
model CompOffCredit {
  id                String              @id @default(uuid())
  businessId        String
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Provenance — the worked-on-off-day that earned this credit (NULL for HR_GRANT).
  sourceDate        DateTime            @db.Date
  sourceKind        CompOffSourceKind
  attendanceId      String? // the HOLIDAY_WORKED Attendance row, when auto-detected
  // Quantity in DAYS (0.5 / 1.0). worked >= fullDayMinutes → 1.0; >= min → 0.5.
  quantity          Decimal             @db.Decimal(6, 4)
  consumed          Decimal             @default(0) @db.Decimal(6, 4) // units availed/encashed from THIS lot
  // Expiry clock — per credit. earnedOn + policy.expiryDays.
  earnedOn          DateTime            @db.Date
  expiresOn         DateTime            @db.Date
  status            CompOffCreditStatus @default(PENDING)
  // Workflow (earn approval) — mirrors LeaveTransaction.approvalRequestId.
  approvalRequestId String?
  grantedBy         String? // HR userId for HR_GRANT / manual
  reason            String?
  // Bridge to the leave ledger: the ACCRUAL-equivalent LeaveTransaction that
  // credited the aggregate LeaveBalance when this lot was finalized.
  creditTxnId       String?
  leaveBalanceId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  version           Int                 @default(0)

  consumptions CompOffConsumption[]

  // Idempotent earn keyed on the IMMUTABLE attendance row, NOT the runtime-derived
  // sourceKind (Feature 30 finding #2). A worked rest-day maps to exactly one
  // Attendance row; keying on attendanceId means a holiday/weekly-off classification
  // flip between runner passes can never mint a second credit. HR_GRANT has
  // attendanceId = NULL and is excepted (Postgres treats NULLs as distinct, so HR
  // can post multiple manual grants on one date).
  @@unique([businessId, employeeId, attendanceId])
  @@index([businessId, employeeId, status, expiresOn]) // FIFO consume + ESS list
  @@index([businessId, status, expiresOn]) // expiry-runner scan
}

/// Per-application comp-off lot allocation (Feature 30 finding #5). Records EXACTLY
/// which lots a COMP_OFF leave APPLICATION debited at approve, so withdraw re-credits
/// the SAME lots (not arbitrary reverse-FIFO ones) — keeping each credit's expiry
/// window honest and forfeiting units whose source lot has since expired (finding #1).
model CompOffConsumption {
  id                 String           @id @default(uuid())
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // The COMP_OFF APPLICATION LeaveTransaction that debited these units.
  leaveTransactionId String
  leaveTransaction   LeaveTransaction @relation(fields: [leaveTransactionId], references: [id], onDelete: Cascade)
  compOffCreditId    String
  compOffCredit      CompOffCredit    @relation(fields: [compOffCreditId], references: [id], onDelete: Cascade)
  units              Decimal          @db.Decimal(6, 4) // units this leave drew from THIS lot
  // Stamped on withdraw when these units were returned (idempotent reversal guard).
  reversedAt         DateTime?
  createdAt          DateTime         @default(now())

  @@unique([leaveTransactionId, compOffCreditId]) // one allocation row per (application, lot)
  @@index([businessId, compOffCreditId])
  @@index([businessId, leaveTransactionId])
}

enum CompOffSourceKind {
  WEEKLY_OFF
  HOLIDAY
  EXTRA_HOURS // factory: beyond statutory weekly hours (v2; behind a policy flag)
  HR_GRANT // manual HR grant, no attendance source
}

enum CompOffCreditStatus {
  PENDING // earned, awaiting manager/HR approval (if requireApproval)
  ACTIVE // approved, available to avail; consumed < quantity
  EXHAUSTED // consumed == quantity
  EXPIRED // expiresOn passed with remaining > 0 → residual lapsed
  VOIDED // earn rejected / attendance reversed / HR void
}

// ─────────────────────────────────────────────────────────────────────────────
// §9  ATTENDANCE · SHIFTS · TIMESHEETS  (mined from booking StaffSchedule,
//     BusinessHours, BusinessHoliday)
// ─────────────────────────────────────────────────────────────────────────────

/// Shift pattern incl. weekly-off CSV (replaces a WeekOffPattern table).
model ShiftPattern {
  id                      String            @id @default(uuid())
  businessId              String
  business                Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId                String?
  code                    String
  name                    String // "General 9-6", "Night A"
  startTime               String // "09:00" local
  endTime                 String // "18:00"
  breakMinutes            Int               @default(60)
  graceInMinutes          Int               @default(10)
  graceOutMinutes         Int? // early-out grace; defaults to graceInMinutes
  halfDayThresholdMinutes Int?
  minMinutesForPresent    Int? // defaults to halfDayThresholdMinutes
  fullDayMinutes          Int               @default(480)
  isFlexi                 Boolean           @default(false)
  otEligible              Boolean           @default(false)
  dailyOtThresholdMin     Int? // OT beyond N min/day (default = fullDayMinutes)
  isNightShift            Boolean           @default(false)
  crossesMidnight         Boolean           @default(false)
  weeklyOffDays           String            @default("0") // CSV ISO weekday (0=Sun)
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?
  version                 Int               @default(0)
  assignments             ShiftAssignment[]
  rosterDays              RosterDay[] // Feature 29 — per-day roster cells referencing this pattern
  openShifts              OpenShift[] // Open shifts published against this pattern

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

model ShiftAssignment {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftPatternId String
  shiftPattern   ShiftPattern @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessId, employeeId, effectiveFrom])
}

// ── Feature 29: Shift management (rosters, rotation, swap) — India ──
// Reuses ShiftPattern (master) + ShiftAssignment (effective-dated window) UNCHANGED.
// Adds the per-employee-per-day roster CELL, a reusable rotation ring, and the
// shift-swap request that rides the F10 SHIFT_SWAP approval. All businessId-scoped.

/// One employee × one civil day → the shift to work that day (or an explicit OFF).
/// THE roster cell. derive.js reads PUBLISHED rows FIRST (precedence over the
/// covering ShiftAssignment); a DRAFT row is ignored by derive (invariant I4). A
/// dayType=OFF surfaces as WEEKLY_OFF; dayType=WORK requires a shiftPattern.
model RosterDay {
  id                 String        @id @default(uuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date               DateTime      @db.Date // civil day (UTC-midnight, same convention as Attendance)
  dayType            RosterDayType @default(WORK)
  shiftPatternId     String?
  shiftPattern       ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)
  status             RosterStatus  @default(DRAFT) // DRAFT until published; derive ignores DRAFT
  source             RosterSource  @default(MANUAL) // ROTATION | MANUAL | SWAP — provenance for the grid + audit
  rotationTemplateId String? // set when generated, for "regenerate" idempotency
  swapRequestId      String? // set when a SWAP overwrote this cell
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  version            Int           @default(0) // optimistic lock for the swap consumer

  @@unique([businessId, employeeId, date]) // ONE roster cell per employee per day (idempotent generate/upsert)
  @@index([businessId, date, status]) // grid page (a date column across employees)
  @@index([businessId, employeeId, date]) // ESS my-week + derive read
}

enum RosterDayType {
  WORK
  OFF
}

enum RosterStatus {
  DRAFT
  PUBLISHED
}

enum RosterSource {
  ROTATION
  MANUAL
  SWAP
  OPEN_CLAIM // an open shift that was claimed + manager-confirmed materialised this cell
}

/// A reusable rotation ring. slotsJson = ordered array; each slot is a shiftPatternId
/// OR an OFF marker. cycleLength = slotsJson.length. The generator walks the ring from
/// anchorDate, one slot per civil day, looping. Population is resolved at apply-time
/// (entity/dept/picked ids), NOT stored as a static member list.
model RotationTemplate {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId    String?
  code        String
  name        String // "Factory 3-shift 6-1-6-1-6-2"
  /// slots: [{ kind:"WORK", shiftPatternId } | { kind:"OFF" }] — ordered, length = cycleLength
  slotsJson   Json
  cycleLength Int // = slotsJson.length (denormalised for validation)
  anchorDate  DateTime  @db.Date // day 0 of the ring (so two teams can be phase-offset)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(0)

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

/// Employee A asks to swap their shift on requesterDate with employee B's shift on
/// counterpartyDate (commonly the same day, two people trading). Drives an F10
/// SHIFT_SWAP approval; on APPROVED the consumer swaps the two RosterDay cells.
model ShiftSwapRequest {
  id                     String        @id @default(uuid())
  businessId             String
  business               Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requesterEmployeeId    String
  requester              Employee      @relation("SwapRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  counterpartyEmployeeId String
  counterparty           Employee      @relation("SwapCounterparty", fields: [counterpartyEmployeeId], references: [id], onDelete: Cascade)
  requesterDate          DateTime      @db.Date // the day the requester gives away
  counterpartyDate       DateTime      @db.Date // the day they take (== requesterDate for a same-day trade)
  reason                 String
  counterpartyConsent    ConsentStatus @default(PENDING) // B must accept before the manager chain activates
  status                 RequestStatus @default(PENDING)
  approvalRequestId      String? // the F10 ApprovalRequest (manager chain)
  decidedBy              String?
  decidedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([businessId, requesterEmployeeId, requesterDate])
  @@index([businessId, counterpartyEmployeeId, counterpartyDate])
  @@index([businessId, status])
}

enum ConsentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Open shifts — an UNASSIGNED shift the roster manager publishes to a pool. Eligible
/// employees CLAIM it (OpenShiftClaim) and the manager confirms via the F10
/// OPEN_SHIFT_CLAIM approval. On a claim's APPROVE the consumer materialises the
/// claimant's RosterDay (source=OPEN_CLAIM, PUBLISHED) and increments filledCount;
/// the shift flips to FILLED when filledCount >= headcount (auto-rejecting the losers).
model OpenShift {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId          String? // optional scope (mirrors ShiftPattern.entityId — plain scalar, no relation)
  locationId        String?
  departmentId      String?
  date              DateTime         @db.Date // the civil day the shift is worked
  shiftPatternId    String
  shiftPattern      ShiftPattern     @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)
  headcount         Int              @default(1) // slots to fill
  filledCount       Int              @default(0) // approved claims so far
  status            OpenShiftStatus  @default(OPEN)
  note              String?
  publishedByUserId String? // the operator who published it
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  claims            OpenShiftClaim[]

  @@index([businessId, status, date])
}

enum OpenShiftStatus {
  OPEN
  FILLED
  CANCELLED
}

/// One employee's claim on an OpenShift. Rides an F10 OPEN_SHIFT_CLAIM approval (the
/// roster manager confirms). At most one claim per person per shift. Reuses
/// RequestStatus (PENDING|APPROVED|REJECTED|CANCELLED) — CANCELLED == withdrawn.
model OpenShiftClaim {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  openShiftId       String
  openShift         OpenShift     @relation(fields: [openShiftId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status            RequestStatus @default(PENDING) // PENDING|APPROVED|REJECTED|CANCELLED (CANCELLED = withdrawn)
  approvalRequestId String? // the F10 ApprovalRequest (manager confirm chain)
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([openShiftId, employeeId]) // one claim per person per shift
  @@index([businessId, status])
  @@index([businessId, employeeId, status])
}

/// Public/company holiday calendar. NZ regional anniversary days + mondayisation
/// (observed-Monday rows seeded by the NZ compliance module). `scopeKey`
/// collapses the two nullable scope columns into a NOT-NULL key so the unique
/// fires for global holidays (Postgres treats NULL as distinct). Mined from
/// booking BusinessHoliday.
model Holiday {
  id           String      @id @default(uuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId     String?
  locationId   String? // region-specific (NZ provincial anniversary)
  date         DateTime    @db.Date
  name         String
  type         HolidayType
  countryCode  String      @db.Char(2)
  isPaid       Boolean     @default(true)
  isRestricted Boolean     @default(false) // IN optional/restricted holiday
  scopeKey     String // = coalesce(entityId,'*') || ':' || coalesce(locationId,'*')
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([businessId, scopeKey, date, name])
  @@index([businessId, countryCode, date])
  @@index([businessId, entityId, locationId, date])
}

enum HolidayType {
  PUBLIC
  NATIONAL
  REGIONAL
  COMPANY
  RESTRICTED_OPTIONAL
}

model AttendancePunch {
  id                      String             @id @default(uuid())
  businessId              String
  business                Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId              String
  employee                Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId              String?
  punchType               PunchType
  punchAt                 DateTime // stored UTC; rendered in location TZ
  source                  PunchSource
  geoLat                  Decimal?           @db.Decimal(9, 6)
  geoLng                  Decimal?           @db.Decimal(9, 6)
  // Out-of-geofence marker, stamped at punch time when the punch carries coords
  // AND the employee's assigned Location has a geofence (geoLat/geoLng/geofenceM).
  // null = not evaluated (no location geofence or no punch coords); false = inside
  // the radius; true = outside. Drives the OUT_OF_GEOFENCE exception via derive.js.
  outOfGeofence           Boolean?
  geoDistanceM            Int? // Haversine distance (m) from the assigned location, when evaluated
  ipAddress               String?
  deviceId                String?
  selfieUrl               String?            @db.Text // @pii:sensitive (optional)
  isManual                Boolean            @default(false) // regularization
  regularizationRequestId String?
  // Feature 28 — biometric/device punch provenance (additive, nullable → existing
  // rows unaffected). When source=BIOMETRIC the punch carries its registered device
  // (punchDeviceId, FK-by-id, distinct from the free-text deviceId serial above) and
  // the immutable RawPunchEvent that produced it (rawPunchEventId, 1:1 traceability
  // back to the muster-roll evidence layer). Both null for web/mobile/manual punches.
  punchDeviceId           String?
  rawPunchEventId         String?
  // Feature 2 (multi-mode capture) — additive, nullable → existing rows unaffected.
  // captureMethods: the ordered list of capture modes the policy evaluated at punch
  // time (e.g. ["GEO_FENCE","IP_RESTRICTED","FACE"]) — audit of what was enforced.
  // ipAllowed: null = not evaluated (no IP policy); true = punch IP fell inside a
  // configured office CIDR; false = off-network. Mirrors outOfGeofence's tri-state.
  // faceMatchScore/faceMatched/faceMatchStatus: the pluggable matcher's verdict.
  // reviewStatus drives the HR review queue: PENDING when a flagged (not hard-blocked)
  // punch needs a human; CLEARED/REJECTED once an HR admin acts. captureFlagged =
  // "this punch tripped a capture rule" (off-network / low face score / missing selfie
  // when the policy is warn-not-block).
  captureMethods          String[]           @default([])
  ipAllowed               Boolean?
  faceMatchScore          Float?
  faceMatched             Boolean?
  faceMatchStatus         FaceMatchStatus?
  captureFlagged          Boolean            @default(false)
  captureFlagReasons      String[]           @default([]) // e.g. ["OFF_NETWORK","FACE_LOW_SCORE"]
  reviewStatus            PunchReviewStatus?
  reviewedBy              String? // operator userId who cleared/rejected
  reviewedAt              DateTime?
  reviewNote              String?            @db.Text
  createdAt               DateTime           @default(now())

  @@index([businessId, employeeId, punchAt])
  @@index([businessId, locationId, punchAt])
  // Feature 2 — review queue: list flagged-and-pending punches for a tenant fast.
  @@index([businessId, captureFlagged, reviewStatus])
}

enum FaceMatchStatus {
  MATCHED // score >= threshold
  NO_MATCH // score < threshold (a real comparison ran)
  NEEDS_REVIEW // stub/low-confidence matcher → defer to a human
  NO_REFERENCE // FACE required but the employee never enrolled
  SKIPPED // FACE not required by policy (or no selfie supplied where optional)
}

enum PunchReviewStatus {
  PENDING // flagged, awaiting HR action
  CLEARED // HR accepted the punch as legitimate
  REJECTED // HR rejected (out-of-policy)
}

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum PunchSource {
  WEB
  MOBILE_APP
  BIOMETRIC
  KIOSK
  GEO_FENCE
  API
  IMPORT
  MANUAL
}

// ===========================================================================
// Feature 2 (multi-mode attendance capture) — HR-admin "Attendance Capture
// Policy". A per-tenant policy, OVERRIDABLE per entity / location / employee-group,
// selecting which punch methods are allowed/required: GEO_FENCE (reuses the Cycle-0
// Location geofence + geo.js Haversine), IP_RESTRICTED (punch only from configured
// office CIDRs), FACE (selfie enrolment + match). These models are relation-LESS
// (keyed by plain String businessId/scope ids + @@index, exactly like
// AttendancePunch.regularizationRequestId / rawPunchEventId) so they add NO edits to
// the shared Business / Employee / Location / Entity relation blocks. The punch path
// resolves the most-specific matching policy and enforces it; the existing recompute
// (service.js/derive.js) is reused untouched for geofence.
// ===========================================================================

/// One Attendance Capture Policy row. The resolver picks the MOST SPECIFIC active
/// row for a punch by scope precedence: EMPLOYEE_GROUP > LOCATION > ENTITY > TENANT.
/// `scopeId` is null for TENANT scope, else the entity/location/group (department) id.
model AttendanceCapturePolicy {
  id         String             @id @default(uuid())
  businessId String
  scope      CapturePolicyScope @default(TENANT)
  scopeId    String? // null for TENANT; entityId / locationId / departmentId otherwise
  name       String? // optional human label

  // Mode toggles. requireX = the punch is REJECTED/FLAGGED when the mode fails; a
  // mode left false is simply not evaluated. GEO_FENCE reuses the per-Location
  // geofence config (geoLat/geoLng/geofenceM) — there is no radius column here.
  requireGeo  Boolean @default(false)
  requireIp   Boolean @default(false)
  requireFace Boolean @default(false)

  // Enforcement levers (per mode). false = WARN (flag + queue for HR review, never
  // block the punch); true = ENFORCE (reject the punch with 4xx). Default WARN so a
  // freshly-configured policy never locks people out on day one (mirrors geofence).
  geoEnforce  Boolean @default(false)
  ipEnforce   Boolean @default(false)
  faceEnforce Boolean @default(false)

  // FACE matcher threshold ∈ [0,1]: a match score below this flags the punch (and,
  // if faceEnforce, rejects it). The default stub matcher returns NEEDS_REVIEW, so
  // this only bites once a real embedding matcher is installed.
  faceThreshold Float @default(0.7)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // operator userId
  version   Int      @default(0)

  // One active policy per (tenant, scope, scopeId). The resolver picks the newest
  // active row within a scope.
  @@unique([businessId, scope, scopeId])
  @@index([businessId, isActive])
}

enum CapturePolicyScope {
  TENANT
  ENTITY
  LOCATION
  EMPLOYEE_GROUP // scopeId holds the department id (the natural employee grouping)
  EMPLOYEE // Feature 39 — scopeId holds ONE employee id (highest precedence: a per-person override)
}

/// An allowed office IP range for IP_RESTRICTED capture. CIDR (v4 or v6) scoped to a
/// LOCATION (the natural office unit). A punch's trusted req.ip is tested against the
/// union of a location's active CIDRs. Relation-less (locationId is a plain id).
model LocationOfficeIp {
  id         String   @id @default(uuid())
  businessId String
  locationId String
  cidr       String // "203.0.113.0/24" or "2001:db8::/48" or a single "203.0.113.7"
  label      String? // "HQ wifi", "VPN egress", …
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  createdBy  String?

  @@index([businessId, locationId, isActive])
}

/// The employee's enrolled reference face. ONE row per (tenant, employee) — a
/// re-enrolment OVERWRITES the row back to PENDING, so face punching is deliberately
/// unavailable until HR re-approves the new reference (secure default; blocks the
/// "swap the reference on a stolen session" attack). imageUrl = object-storage key of
/// the reference selfie (audit). embedding = the matcher's reference vector (JSON
/// array) when a real embedding matcher produced one at enrol time; null for the stub.
/// Feature 39: `status` gates matching — ONLY an ACTIVE row is a valid reference; the
/// PENDING→ACTIVE flip rides the F10 approval engine (module FACE_ENROLLMENT, built-in
/// default chain = a single HR step). DPDP/PII note: the selfie is @pii:sensitive and
/// the embedding is derived biometric data — both tenant-scoped, deleted with the
/// employee; matching runs ONLY on our servers (no third-party biometric processor).
/// Liveness is OUT OF SCOPE v1 (roadmap).
model FaceEnrollment {
  id         String   @id @default(uuid())
  businessId String
  employeeId String
  imageUrl   String   @db.Text // @pii:sensitive — object-storage key of the reference selfie
  embedding  Json? // reference embedding vector (real matcher) or null (stub)
  matcher    String? // which matcher impl produced the embedding ("stub" | "arcface-onnx" | …)
  isActive   Boolean  @default(true)
  enrolledAt DateTime @default(now())
  enrolledBy String? // self (the employee's userId) or an HR operator

  // Feature 39 — HR approval gate. Legacy rows default ACTIVE (they were live before
  // the gate existed); every NEW self-enrolment is written PENDING explicitly.
  status            FaceEnrollmentStatus @default(ACTIVE)
  approvalRequestId String? // the open/decided F10 ApprovalRequest gating this reference
  decidedBy         String? // operator userId who approved/rejected/revoked
  decidedAt         DateTime?
  decisionNote      String?              @db.Text // HR's reject/revoke reason (shown to the employee)
  detScore          Float? // detector confidence at enrol (quality audit)

  version Int @default(0)

  @@unique([businessId, employeeId])
  @@index([businessId, employeeId, isActive])
  @@index([businessId, status])
}

enum FaceEnrollmentStatus {
  PENDING // submitted, awaiting HR approval — NOT a valid matching reference yet
  ACTIVE // HR-approved — the live matching reference
  REJECTED // HR declined (decisionNote carries the reason); employee may retake
  REVOKED // HR pulled an ACTIVE reference (compromise/exit); face punch disabled
}

// ===========================================================================
// Feature 39 — Face & Geo Attendance Controls: polygon geofences. A named,
// map-drawn polygon attachable to a LOCATION (office zone) or to ONE EMPLOYEE
// (individual restriction — beats office zones when present). Zone resolution
// at punch: employee links > location links > legacy Location radius circle.
// Relation-less (plain ids + @@index), same posture as every F2 capture model.
// ===========================================================================

/// A named polygon geofence. polygonJson = the closed outer ring as [[lng,lat], ...]
/// (GeoJSON vertex order; first==last optional — the evaluator closes it). Validated
/// at save: ≥3 distinct vertices, coords in range, non-degenerate area. Centroid is
/// stamped at save for map centering + nearest-zone distance hints.
model AttendanceGeoFence {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  polygonJson Json
  centroidLat Decimal? @db.Decimal(9, 6)
  centroidLng Decimal? @db.Decimal(9, 6)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  version     Int      @default(0)

  @@index([businessId, isActive])
}

/// Attach a fence to an office (scopeKind=LOCATION, scopeId=locationId) or to an
/// individual (scopeKind=EMPLOYEE, scopeId=employeeId). An employee with ANY active
/// EMPLOYEE link punches only inside THOSE zones (personal override); otherwise the
/// zones of their current location apply; otherwise the legacy radius circle.
model AttendanceFenceLink {
  id         String         @id @default(uuid())
  businessId String
  fenceId    String
  scopeKind  FenceScopeKind
  scopeId    String // locationId | employeeId (tenant-validated at the API)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  createdBy  String?

  @@unique([businessId, fenceId, scopeKind, scopeId])
  @@index([businessId, scopeKind, scopeId, isActive])
  @@index([businessId, fenceId, isActive])
}

enum FenceScopeKind {
  LOCATION
  EMPLOYEE
}

// ===========================================================================
// Feature 28 — Biometric / device punch ingestion (additive ingestion layer).
// A device registry + a device-code→employee map + an IMMUTABLE raw-event spine.
// These models ONLY land raw vendor punch logs as canonical AttendancePunch rows
// (source=BIOMETRIC) and then call the EXISTING attendance recompute — they never
// re-implement IN/OUT pairing / night-shift / geofence / OT / LOP (that stays in
// derive.js + service.js, untouched). DPDP note: only the EVENT (code+time+device)
// is stored — never the biometric template (which never leaves the terminal).
// ===========================================================================

/// A physical biometric / access-control terminal registered to a tenant site.
/// The trust + mapping anchor: every inbound punch must name a known device.
model PunchDevice {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Site scoping — a device lives at one entity (drives country/TZ) and optionally
  // a location (seeds the punch's locationId so geofence/holiday scope work).
  entityId   String
  entity     Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  vendor                 DeviceVendor // ESSL | ZKTECO | MATRIX | MANTRA | CAMS | REALTIME | BIOMAX | GENERIC
  adapterKey             String // resolves the normaliser, e.g. "zkteco.adms", "essl.csv", "cams.rest"
  name                   String // operator-facing, e.g. "Plant-A Main Gate"
  // Device identity AS THE DEVICE REPORTS IT — the join key for push/SFTP. ZK ADMS
  // sends the terminal serial (SN=...); CSV imports may carry it as a column.
  serialNumber           String?
  // Direction handling: TRUST_DEVICE (use the device's IN/OUT) | DERIVE (ignore
  // device direction, alternate by time order per employee-day) | ALL_IN (single
  // reader gate — every punch is an IN; OUT inferred downstream by derive.js).
  directionMode          DeviceDirectionMode @default(DERIVE)
  // De-bounce: two events for the same employee within this window collapse to one
  // (a double-tap on the reader). The 2nd → DUPLICATE, never deleted.
  dedupWindowSec         Int                 @default(60)
  // When no DeviceEmployeeMap row resolves a code, fall back to Employee.code.
  fallbackToEmployeeCode Boolean             @default(true)
  // Optional per-device clock correction (seconds) applied BEFORE zonedWallTimeToUtc
  // for a device whose wall-clock is known-skewed. Default 0 (trust as-reported).
  clockOffsetSec         Int                 @default(0)
  // Push/SFTP auth: a per-device shared secret (hashed) the device/agent presents.
  // NEVER the raw secret in the DB.
  ingestSecretHash       String?
  ingestSecretLast4      String? // display hint only
  // Polling (SFTP/folder) config, when this device is pulled rather than pushed.
  pollKind               PollKind? // SFTP | FOLDER | null (push/CSV-only)
  pollConfigJson         Json? // { host, port, user, path, keyRef } — secrets BY REFERENCE
  pollCursor             String? // last consumed file / offset (idempotent poll)
  // Health / watchdog
  lastSeenAt             DateTime? // last successful inbound batch
  expectedSilenceMin     Int? // alert if no punch for N minutes during site hours
  timezone               String? // override; else resolved location→entity→business
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
  version                Int                 @default(0)

  maps   DeviceEmployeeMap[]
  events RawPunchEvent[]

  @@unique([businessId, serialNumber]) // a serial is unique per tenant (push join key)
  @@index([businessId, entityId, isActive])
  @@index([businessId, locationId])
}

enum DeviceVendor {
  ESSL
  ZKTECO
  MATRIX
  MANTRA
  CAMS
  REALTIME
  BIOMAX
  GENERIC
}

enum DeviceDirectionMode {
  TRUST_DEVICE
  DERIVE
  ALL_IN
}

enum PollKind {
  SFTP
  FOLDER
}

/// device-side employee code (enroll-no / PIN) → DriftHR employee. Explicit map for
/// the common case where the enroll number ≠ Employee.code. A missing map row falls
/// back to Employee.code (per device.fallbackToEmployeeCode).
model DeviceEmployeeMap {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // device-specific (deviceId set) OR tenant-wide (deviceId null): a PIN namespace
  // is often shared across a site's gates.
  deviceId   String?
  device     PunchDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceCode String // enroll-no / PIN as the device reports it (string, exact)
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  createdBy  String?

  // One mapping per (device-or-tenant, code). NULL deviceId is the tenant-wide row.
  @@unique([businessId, deviceId, deviceCode])
  @@index([businessId, employeeId])
}

/// The IMMUTABLE raw inbound punch event — the audit + dedup spine. We keep the
/// device's literal payload forever; nothing downstream mutates the raw record.
/// This is the muster-roll evidence layer. A RawPunchEvent that materialises
/// produces an AttendancePunch (linked); one that can't (unmapped / unknown device
/// / locked day) is parked with a reason and surfaced on the error report.
model RawPunchEvent {
  id                String         @id @default(uuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deviceId          String?
  device            PunchDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  importJobId       String? // set when ingested via the file-import surface (F18 job)
  // As-reported, before mapping
  deviceCode        String // enroll-no / PIN string
  localTimeRaw      String // the device's literal "YYYY-MM-DD HH:MM:SS" (no TZ)
  punchAt           DateTime // resolved UTC instant (zonedWallTimeToUtc in device TZ)
  rawDirection      String? // device's raw direction token, if any ("0","C/In","OUT")
  resolvedType      PunchType? // IN/OUT/BREAK_* after direction resolution (null until resolved)
  rawPayloadJson    Json // the full original record (every column the adapter saw)
  // Lifecycle
  status            RawPunchStatus @default(RECEIVED)
  reason            String?
  employeeId        String? // resolved subject (null when UNMAPPED)
  attendancePunchId String? // the AttendancePunch this produced (null until MATERIALISED)
  // DEDUP / idempotency natural key: sha256(businessId|deviceId|deviceCode|punchAt|rawDirection)
  dedupKey          String
  createdAt         DateTime       @default(now())

  @@unique([businessId, dedupKey]) // exactly-once: same device+code+instant lands once
  @@index([businessId, deviceId, punchAt])
  @@index([businessId, status])
  @@index([businessId, employeeId, punchAt])
}

enum RawPunchStatus {
  RECEIVED // landed, not yet processed
  MAPPED // employee resolved, ready to materialise
  MATERIALISED // AttendancePunch created + recompute run
  UNMAPPED // device code has no employee mapping
  UNKNOWN_DEVICE // serial/secret not in the registry
  LOCKED // target civil day is frozen (period closed)
  DUPLICATE // dedupKey already present (no-op) / de-bounced
  ERROR // adapter/parse/validation failure
  IGNORED // operator-discarded (manual correction) — never hard-deleted
}

/// Derived daily summary (one per emp/day).
model Attendance {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation("EmployeeAttendances", fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  shiftPatternId  String?
  firstIn         DateTime?
  lastOut         DateTime?
  workedMinutes   Int              @default(0)
  breakMinutes    Int              @default(0)
  overtimeMinutes Int              @default(0)
  status          AttendanceStatus
  lopFraction     Decimal          @default(0) @db.Decimal(5, 4) // 0/0.5/1 LOP for payroll
  isLocked        Boolean          @default(false) // frozen once period inputs lock
  importJobId     String? // Feature 18 — set when this daily row was bulk-imported (badge/filter); NULL for live rows
  exceptionsJson  Json? // late, early-out, missing-punch flags
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  version         Int              @default(0)

  @@unique([businessId, employeeId, date])
  @@index([businessId, date, status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
  WORK_FROM_HOME
  ON_DUTY
  HOLIDAY_WORKED
  MISSING_PUNCH
}

model Timesheet {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart       DateTime         @db.Date
  periodEnd         DateTime         @db.Date
  totalHours        Decimal          @default(0) @db.Decimal(8, 2)
  billableHours     Decimal          @default(0) @db.Decimal(8, 2)
  overtimeHours     Decimal          @default(0) @db.Decimal(8, 2)
  status            TimesheetStatus  @default(DRAFT)
  approvalRequestId String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  decidedBy         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  version           Int              @default(0)
  entries           TimesheetEntry[]

  @@unique([businessId, employeeId, periodStart])
  @@index([businessId, status])
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  projectCode String?
  taskCode    String?
  hours       Decimal   @db.Decimal(6, 2)
  isBillable  Boolean   @default(false)
  isOvertime  Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([businessId, timesheetId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Expense reimbursement
//
// Employees raise an ExpenseClaim (one or more lines) against an ExpenseCategory;
// the claim moves through a DRAFT → SUBMITTED → APPROVED/REJECTED → REIMBURSED
// state machine. ExpensePolicy caps per-category spend. Money is Decimal — never
// parse it. Tenant-scoped by businessId; soft-delete via deletedAt.
// ─────────────────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id         String             @id @default(uuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String
  name       String
  glCode     String? // general-ledger / cost-account mapping
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  version    Int                @default(0)
  policies   ExpensePolicy[]
  claims     ExpenseClaim[]
  claimLines ExpenseClaimLine[] // Feature 11 — per-line category back-relation

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

model ExpensePolicy {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId     String
  category       ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  maxPerClaim    Decimal?          @db.Decimal(15, 2)
  maxPerMonth    Decimal?          @db.Decimal(15, 2)
  requireReceipt Boolean           @default(true)
  // Feature 11 — fold ExpensePolicy into the policy engine: daily cap + enforcement.
  dailyCap       Decimal?          @db.Decimal(15, 2)
  enforcement    PolicyEnforcement @default(FLAG)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  version        Int               @default(0)

  gradeRules ExpenseGradeRule[] // Feature 45 — per-JOB-LEVEL cap overrides

  @@index([businessId, categoryId])
}

/// Feature 45 — per-grade cap override for a category's reimbursement policy
/// (the owner's "reimbursement per job level"). gradeRank NULL = all levels
/// (the base row); an exact gradeRank match overrides. A null override field
/// falls back to the policy's flat cap. Mirrors the TravelHotelRule grade
/// pattern; rows are REPLACE-ALL via PUT (like travel per-diem/hotel rules).
model ExpenseGradeRule {
  id          String        @id @default(uuid())
  businessId  String
  policyId    String
  policy      ExpensePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  gradeRank   Int? // matches Grade.rank; NULL = applies to all levels
  maxPerClaim Decimal?      @db.Decimal(15, 2)
  maxPerMonth Decimal?      @db.Decimal(15, 2)
  dailyCap    Decimal?      @db.Decimal(15, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([businessId, policyId])
}

model ExpenseClaim {
  id                   String                     @id @default(uuid())
  businessId           String
  business             Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             ExpenseCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  claimNumber          String? // human-friendly reference
  amount               Decimal                    @db.Decimal(15, 2)
  currencyCode         String                     @default("INR")
  description          String?
  receiptUrl           String?
  expenseDate          DateTime?                  @db.Date
  status               ExpenseClaimStatus         @default(DRAFT)
  // Workflow stamps
  submittedAt          DateTime?
  decidedAt            DateTime?
  decidedBy            String? // operator userId who approved/rejected
  rejectReason         String?
  reimbursedAt         DateTime?
  reimbursedBy         String?
  paymentRef           String? // bank/payout reference once reimbursed
  payRunId             String? // when settled through payroll
  // Feature 11 — claims + travel + policy engine (additive, all nullable/defaulted).
  claimType            ClaimType                  @default(REIMBURSEMENT) // REIMBURSEMENT (standalone) | TRAVEL (bills vs a trip)
  travelRequestId      String? // links bills to the travel ID (TRV-####)
  travelRequest        TravelRequest?             @relation(fields: [travelRequestId], references: [id], onDelete: SetNull)
  approvalRequestId    String? // the EXPENSE ApprovalRequest driving the chain
  policyVerdict        PolicyVerdict              @default(NO_POLICY) // rollup of the worst line verdict
  policyId             String? // active TravelPolicy snapshot ref applied at submit
  policySnapshotJson   Json? // immutable copy of the rules applied at submit (audit)
  importJobId          String? // Feature 18 — set when this claim was bulk-imported (back-dated history); NULL for live claims
  // Feature 26 — reimbursement paid via payroll (additive, all nullable/defaulted).
  // The per-claim channel choice: settle out-of-band (today's manual Finance
  // reimburse) or ride the next pay run's payslip as a non-taxable post-tax line.
  // Defaulted from Entity.reimbursementDefaultChannel at submit; editable only while
  // APPROVED + un-stamped (payRunId NULL). Once a run stamps it, the channel freezes.
  payoutChannel        ReimbursementPayoutChannel @default(PAY_SEPARATELY)
  // The paise ACTUALLY paid through a pay run for this claim — the single
  // reconciliation figure (mirrors LoanInstallment.recoveredAmount). Set by
  // reimbursementPayout.applyPayout off the engine's reported EXPENSE_REIMBURSEMENT
  // amount; reversed exactly by unwindForRun on recompute/reopen/cancel. NULL = never
  // paid via payroll. A claim is paid whole (== amount) or deferred untouched — never
  // split — so this is sufficient (the net-floor guard blocks, never partial-pays).
  paidViaPayrollAmount Decimal?                   @db.Decimal(15, 2)
  // payRunId (above) doubles as the owning-run stamp for the payroll payout pass.
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime?
  version              Int                        @default(0)
  lines                ExpenseClaimLine[]

  // claimNumber (EXP-####) is a human-facing reference used on payment refs / payslips,
  // so it MUST be unique per tenant — the DB backstop the legacy P2002 retry relied on
  // but never had. It stays nullable (legacy/in-flight DRAFTs carry NULL); on Postgres a
  // composite unique index treats every NULL as distinct, so any number of NULL rows
  // coexist while a duplicate non-null EXP-#### is rejected.
  @@unique([businessId, claimNumber])
  @@index([businessId, employeeId])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, travelRequestId])
  // Feature 26 — the selection scan for the pay pass (APPROVED + PAY_VIA_PAYROLL).
  @@index([businessId, payoutChannel, status])
}

// Feature 26 — the per-claim payout-channel choice (tenant default lives on Entity).
enum ReimbursementPayoutChannel {
  PAY_SEPARATELY // out-of-band (today's manual Finance reimburse) — DEFAULT
  PAY_VIA_PAYROLL // settle through the next pay run's payslip (non-taxable line)
}

model ExpenseClaimLine {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimId        String
  claim          ExpenseClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  description    String?
  amount         Decimal          @db.Decimal(15, 2)
  receiptUrl     String?
  expenseDate    DateTime?        @db.Date
  // Feature 11 — per-line category + policy verdict + transport + receipt integrity.
  categoryId     String? // per-line category (claim header categoryId stays optional)
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  policyStatus   PolicyVerdict    @default(NO_POLICY)
  policyReason   String? // human reason: "Hotel 6500 > TIER_2 L3 cap 5000"
  appliedCap     Decimal?         @db.Decimal(15, 2) // the cap the engine checked against
  transportMode  TransportMode?
  distanceKm     Decimal?         @db.Decimal(8, 2) // SELF_CAR per-km basis
  nights         Int? // HOTEL nights count
  durationBand   PerDiemBand? // PER_DIEM band on a food/incidental line
  fileHash       String? // sha256(receipt) — integrity anchor
  mimeType       String?
  receiptOcrJson Json? // reserved (OCR deferred)
  createdAt      DateTime         @default(now())

  @@index([businessId, claimId])
  @@index([businessId, categoryId])
}

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
  CANCELLED
}

// ── Feature 11 — Reimbursement/Claims + Travel & Outdoor-duty + custom policy ──
// Additive, non-breaking. Claims keep their EXP-#### id (now via allocateCode);
// trips mint a TRV-#### travel id and bills link to it; a fully admin-configurable
// TravelPolicy (per-diem / hotel-by-level×tier / transport rules + city-tier map)
// drives the pure policyEngine that auto-validates every bill on submit.

enum ClaimType {
  REIMBURSEMENT // standalone out-of-pocket (no trip)
  TRAVEL // bills booked against a TravelRequest (travel ID)
}

enum TravelStatus {
  DRAFT // employee drafting the trip request
  SUBMITTED // routed for pre-trip approval
  APPROVED // trip green-lit; employee may add bills
  REJECTED
  IN_PROGRESS // travel dates active (derived, optional)
  COMPLETED // trip dates passed; claims may still settle
  CANCELLED
}

enum TransportMode {
  PUBLIC_TRANSPORT // bus/metro/auto — receipt, cap
  SELF_CAR // own vehicle — per-km × distance
  TAXI_CAB // cab/ride-hail — receipt, cap
  TRAIN // class gated by level
  FLIGHT // gated by journey-duration / level
  OTHER
}

enum PolicyVerdict {
  OK // within policy
  FLAGGED // over a soft limit — approver must decide
  AUTO_REJECTED // over a hard cap — engine blocks
  NO_POLICY // no active policy matched — passes, advisory note
}

enum PolicyEnforcement {
  FLAG // soft — over-limit lines are flagged for the approver
  HARD // over the hard cap → AUTO_REJECTED blocks submit
}

enum PerDiemBand {
  FULL_24H // 24h full-day allowance
  HALF_12H // 12h band
  HALF_DAY // short/half-day band
}

// City-tier classification (config). A trip's destination city → CityTier.tier;
// unmatched cities fall to the policy's defaultTier.
model CityTier {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tier        String // "TIER_1" | "TIER_2" | "TIER_3" | tenant-custom label
  city        String // normalized lower-cased match key
  stateCode   String?
  countryCode String    @db.Char(2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([businessId, countryCode, city]) // one tier per (tenant, country, city)
  @@index([businessId, tier])
}

// The custom Travel & Expense policy (versioned config). Child rule tables let the
// admin builder edit cells without JSON surgery; a denormalized snapshot is stored
// on each claim/line at validation time for audit immutability.
model TravelPolicy {
  id             String                @id @default(uuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId       String? // optional per-legal-entity policy
  name           String
  countryCode    String                @db.Char(2) // IN / NZ — currency + defaults
  currencyCode   String                @db.Char(3)
  isActive       Boolean               @default(true)
  effectiveFrom  DateTime              @db.Date
  defaultTier    String                @default("TIER_3") // fallback when city unmatched
  enforcement    PolicyEnforcement     @default(FLAG) // FLAG (soft) vs HARD (auto-reject over cap)
  perDiemRules   TravelPerDiemRule[]
  hotelRules     TravelHotelRule[]
  transportRules TravelTransportRule[]
  travelRequests TravelRequest[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  version        Int                   @default(0)

  @@index([businessId, isActive])
  @@index([businessId, entityId, countryCode])
}

// Per-diem caps by trip-duration band (24h full / 12h / half), food + incidentals,
// optionally varied by level (gradeRank) and city tier.
model TravelPerDiemRule {
  id            String       @id @default(uuid())
  businessId    String
  policyId      String
  policy        TravelPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  durationBand  PerDiemBand
  gradeRank     Int? // null = applies to all levels
  cityTier      String? // null = all tiers
  foodCap       Decimal      @db.Decimal(15, 2)
  incidentalCap Decimal      @db.Decimal(15, 2)

  @@index([businessId, policyId])
}

// Hotel budget by employee LEVEL (gradeRank) × city TIER — the core matrix.
model TravelHotelRule {
  id         String       @id @default(uuid())
  businessId String
  policyId   String
  policy     TravelPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  gradeRank  Int // employee level
  cityTier   String
  nightlyCap Decimal      @db.Decimal(15, 2)

  @@unique([policyId, gradeRank, cityTier])
  @@index([businessId, policyId])
}

// Allowed transport modes + fare/eligibility conditions per level.
model TravelTransportRule {
  id            String        @id @default(uuid())
  businessId    String
  policyId      String
  policy        TravelPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  mode          TransportMode
  gradeRank     Int? // null = all levels
  allowed       Boolean       @default(true)
  perKmRate     Decimal?      @db.Decimal(8, 2) // SELF_CAR: reimbursable per-km
  fareCap       Decimal?      @db.Decimal(15, 2) // per-journey ceiling (taxi/flight)
  travelClass   String? // TRAIN: "AC_2T"/"AC_3T"; FLIGHT: "ECONOMY"
  minJourneyHrs Int? // FLIGHT allowed only if journey >= N hrs
  conditionJson Json? // extensible: {"minDistanceKm":250}

  @@unique([policyId, mode, gradeRank])
  @@index([businessId, policyId])
}

// The trip / outdoor-duty record. Mints a TRV-#### travel id; bills link via
// ExpenseClaim.travelRequestId.
model TravelRequest {
  id                String         @id @default(uuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  travelNumber      String // TRV-#### — the "travel ID"
  purpose           String
  isOutdoorDuty     Boolean        @default(false) // local outdoor/official duty vs out-station
  originCity        String?
  destCity          String?
  destTier          String? // snapshot of resolved CityTier at submit
  startAt           DateTime
  endAt             DateTime
  durationHours     Int? // derived → per-diem band
  estimateJson      Json? // per-diem + hotel + transport estimate vs policy
  advanceAmount     Decimal?       @db.Decimal(15, 2) // requested trip advance (netted at settlement)
  currencyCode      String         @db.Char(3)
  policyId          String? // active TravelPolicy applied
  policy            TravelPolicy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  status            TravelStatus   @default(DRAFT)
  approvalRequestId String? // pre-trip approval (TRAVEL workflow)
  submittedAt       DateTime?
  decidedAt         DateTime?
  decidedBy         String?
  rejectReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  version           Int            @default(0)
  claims            ExpenseClaim[]

  @@unique([businessId, travelNumber])
  @@index([businessId, employeeId])
  @@index([businessId, status])
}

// ── Employee loans / salary advances ──────────────────────────────────────
// A LoanScheme is the reusable product/template (interest rate, max tenure).
// A Loan is an employee's borrowing against an optional scheme, with a generated
// LoanInstallment repayment schedule (EMI). Money is Decimal(15,2); recovery is
// driven through payroll via the LOAN_REPAYMENT / ADVANCE_RECOVERY deduction kinds.

model LoanScheme {
  id              String             @id @default(uuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code            String
  name            String
  loanType        LoanType           @default(LOAN)
  interestRate    Decimal?           @db.Decimal(5, 2) // annual %, null = interest-free
  // How interest is amortised across the EMI schedule (Phase 4). FLAT is the
  // historical default (simple interest split evenly) so existing schemes are
  // behaviour-preserving; REDUCING_BALANCE amortises on the outstanding balance.
  interestMethod  LoanInterestMethod @default(FLAT)
  maxPrincipal    Decimal?           @db.Decimal(15, 2)
  maxTenureMonths Int?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  version         Int                @default(0)
  loans           Loan[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

model Loan {
  id              String             @id @default(uuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schemeId        String?
  scheme          LoanScheme?        @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  loanNumber      String? // human-friendly reference
  loanType        LoanType           @default(LOAN)
  principal       Decimal            @db.Decimal(15, 2)
  interestRate    Decimal?           @db.Decimal(5, 2) // annual %, snapshot from scheme
  // Snapshot of the scheme's interest method at create time (Phase 4). Drives the
  // EMI schedule builder: FLAT/SIMPLE = flat simple interest, REDUCING_BALANCE =
  // amortised on outstanding, ZERO = interest-free regardless of interestRate.
  interestMethod  LoanInterestMethod @default(FLAT)
  currencyCode    String             @default("INR")
  tenureMonths    Int // number of installments
  emiAmount       Decimal?           @db.Decimal(15, 2) // per-installment; null = auto-computed
  startDate       DateTime           @db.Date
  reason          String?
  status          LoanStatus         @default(DRAFT)
  // Repayment running totals (denormalised; source of truth is the schedule)
  totalPayable    Decimal?           @db.Decimal(15, 2)
  amountRepaid    Decimal            @default(0) @db.Decimal(15, 2)
  outstanding     Decimal?           @db.Decimal(15, 2)
  // Workflow stamps
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String? // operator userId who approved
  rejectedAt      DateTime?
  rejectReason    String?
  disbursedAt     DateTime?
  disbursedBy     String?
  disbursementRef String? // bank/payout reference once disbursed
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  version         Int                @default(0)
  installments    LoanInstallment[]

  @@index([businessId, employeeId])
  @@index([businessId, status])
  @@index([businessId, schemeId])
}

model LoanInstallment {
  id                 String            @id @default(uuid())
  businessId         String
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loanId             String
  loan               Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  seq                Int // 1-based installment number
  dueDate            DateTime          @db.Date
  principalComponent Decimal           @db.Decimal(15, 2)
  interestComponent  Decimal           @default(0) @db.Decimal(15, 2)
  amount             Decimal           @db.Decimal(15, 2) // principal + interest for this installment
  status             InstallmentStatus @default(PENDING)
  // recoveredAmount — the paise ACTUALLY credited to the loan for this installment by
  // its owning pay run (`payRunId`). For a fully-recovered installment it equals
  // `amount` (status PAID); for a NET-CAPPED partial it is < amount and the row stays
  // PENDING so the remainder (amount − recoveredAmount) carries to a future run. It is
  // the single reconciliation figure: the LOAN_REPAYMENT debit, this credit and the
  // Loan.amountRepaid increment are all the SAME number, and unwind reverses exactly it
  // (never the nominal `amount`). Null = never touched by a run.
  recoveredAmount    Decimal?          @db.Decimal(15, 2)
  paidAt             DateTime?
  payRunId           String? // when recovered through payroll
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([loanId, seq])
  @@index([businessId, loanId])
  @@index([businessId, status])
  @@index([businessId, payRunId])
}

enum LoanType {
  LOAN
  ADVANCE
}

// How a loan's interest is amortised across its EMI schedule (Phase 4).
//   FLAT             — simple interest (principal × rate% × tenure/12) split evenly.
//   SIMPLE           — alias of FLAT (identical math; explicit name for clarity).
//   REDUCING_BALANCE — standard amortised EMI; interest each period on the balance.
//   ZERO             — no interest regardless of interestRate (equal-principal).
enum LoanInterestMethod {
  FLAT
  REDUCING_BALANCE
  SIMPLE
  ZERO
}

enum LoanStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  WAIVED
}

// =============================================================================
// HR FORK — schema-gap-fix: previously-dangling relation targets now defined.
// Per docs/03-data-model.md §§11A,12,12.1,13,14,15,16,18,19. Every model is
// tenant-scoped (businessId + business FK + leading @@index); money is Decimal.
// =============================================================================

// ── §11A Separation & Full-and-Final settlement ──
model SeparationCase {
  id                    String           @id @default(uuid())
  businessId            String
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entityId              String // entity for statutory exit obligations
  code                  String // SEP-000017
  type                  SeparationType
  reason                String?
  // Key dates
  initiatedAt           DateTime         @db.Date
  resignationDate       DateTime?        @db.Date // employee notice date
  noticePeriodDays      Int?
  noticeShortfallDays   Int              @default(0) // -> NOTICE_RECOVERY component
  lastWorkingDay        DateTime?        @db.Date // payroll cutoff for FNF
  relievingDate         DateTime?        @db.Date
  // Settlement components (snapshot of computed FNF inputs; engine fills)
  gratuityAmount        Decimal?         @db.Decimal(15, 2) // IN: 15/26 x last-drawn x completed yrs
  leaveEncashmentDays   Decimal?         @db.Decimal(8, 4)
  leaveEncashmentAmount Decimal?         @db.Decimal(15, 2)
  nzHolidayPayoutAmount Decimal?         @db.Decimal(15, 2) // NZ: 8% accrued + untaken annual @ OWP/AWE
  noticeRecoveryAmount  Decimal?         @db.Decimal(15, 2)
  loanForeclosureAmount Decimal?         @db.Decimal(15, 2)
  assetRecoveryAmount   Decimal?         @db.Decimal(15, 2)
  netSettlement         Decimal?         @db.Decimal(15, 2)
  fnfSnapshotJson       Json? // full computeFnf result (payRunInput + breakdown); PayRun(FNF) is minted from this so gross−ded=net always reconciles
  currencyCode          String           @db.Char(3)
  fnfPayRunId           String? // FNF PayRun (type=FNF) that paid it
  clearanceJson         Json? // {assets,it,finance,knowledge_transfer}
  status                SeparationStatus @default(INITIATED)
  initiatedByUserId     String? // SoD anchor: who initiated (HR actor or ESS self); approve-fnf fails closed when null/equals approver
  approvalRequestId     String?
  exitInterviewJson     Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  version               Int              @default(0)

  @@unique([businessId, code])
  @@unique([businessId, employeeId, initiatedAt]) // one active case per separation event
  @@index([businessId, status])
  @@index([businessId, entityId, lastWorkingDay])
}

enum SeparationType {
  RESIGNATION
  TERMINATION_FOR_CAUSE
  RETRENCHMENT
  REDUNDANCY
  END_OF_CONTRACT
  RETIREMENT
  DEATH
  ABSCONDING
  PROBATION_FAILURE
  MUTUAL_SEPARATION
}

enum SeparationStatus {
  INITIATED
  NOTICE_SERVING
  CLEARANCE_PENDING
  FNF_PENDING
  FNF_COMPUTED
  FNF_APPROVED
  SETTLED
  CANCELLED
}

// ── Feature 4 (Employee Lifecycle) §A — configurable onboarding/offboarding checklist templates ──
enum LifecycleDirection {
  ONBOARDING
  OFFBOARDING
}

model LifecycleTemplate {
  id            String             @id @default(uuid())
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId      String?
  code          String // ONBT-… / OFBT-… (NumberSequence)
  name          String
  direction     LifecycleDirection
  countryCode   String?            @db.Char(2) // IN / NZ variant
  // Applicability selectors (most-specific wins; NULLs are wildcards)
  departmentId  String?
  designationId String?
  isDefault     Boolean            @default(true) // v1: exactly one default per (business,direction)
  isActive      Boolean            @default(true)
  version       Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  taskDefs      LifecycleTaskDef[]

  @@unique([businessId, code])
  @@index([businessId, direction, isActive])
}

model LifecycleTaskDef {
  id                String            @id @default(uuid())
  businessId        String
  templateId        String
  template          LifecycleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stageKey          LifecycleStage
  taskKey           LifecycleTaskKey? // NULL = manual/custom; non-NULL = system-actioned
