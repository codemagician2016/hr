generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Key-value settings store (managed by SUPER_ADMIN)
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  password          String
  name              String
  role              Role          @default(USER)
  businessId        String?
  business          Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resetToken        String?
  resetTokenExpiry  DateTime?
  emailVerified     Boolean       @default(false)
  emailOtp          String?
  emailOtpExpiry    DateTime?
  // Set whenever the password changes (reset/change). Sessions whose JWT was
  // issued before this instant are rejected by the auth middleware, so a
  // password reset actually revokes stolen access/refresh tokens.
  passwordChangedAt DateTime?
  otpAttempts       Int           @default(0) // per-account failed-OTP counter
  avatarUrl         String?       @db.Text
  signatureUrl      String?       @db.Text
  stampUrl          String?       @db.Text
  // GDPR account deletion (Article 17). Soft-delete pattern with 30-day
  // grace period: pendingDeletionAt set when user requests deletion;
  // user can undo within the window. After 30 days, a cron purges PII
  // and sets anonymisedAt — AuditLog row preserves identity proof for
  // legal-claims defence + law-enforcement subpoenas.
  pendingDeletionAt DateTime?
  anonymisedAt      DateTime?
  // Short role shown on storefront team cards (e.g. "Senior Dentist")
  subtitle          String?
  // Longer personal bio shown on the team card (short paragraph)
  bio               String?
  // ── Clinical provider profile (doctor_clinic theme) ──
  // One-time professional identity, auto-stamped (read-only) onto every Rx and
  // surfaced on the storefront doctor card. Registration number on every Rx is
  // effectively a legal requirement (e.g. NMC India). NULL for non-clinical staff.
  registrationNumber String?      // medical registration / licence no.
  qualification      String?      // e.g. "MBBS, MD (Internal Medicine)"
  speciality         String?      // e.g. "Cardiologist"
  languages          String?      // comma-separated, e.g. "English, Hindi"
  experienceYears    Int?
  consultationFee    Float?       // default fee shown + pre-filled at consultation
  isActive          Boolean       @default(true)
  // Controls whether this staff member is featured on the public website's
  // Team section. Independent of isActive (which governs booking/login).
  // Lets business owners hide temp staff or those who decline a public profile.
  showOnWebsite     Boolean       @default(true)
  // Controls whether this person takes bookings. Separate from showOnWebsite
  // (marketing presence) and isActive (login). Lets an owner step away from
  // personally serving customers once they have staff, while still appearing
  // on the site. Receptionists/non-clinical staff can have this off too.
  isServiceProvider Boolean       @default(true)
  // Legal consent (GDPR / NZ Privacy Act evidence of acceptance)
  termsAcceptedAt   DateTime?
  termsVersion      String?
  calendarFeedToken String?       @unique
  // BCP-47 locale code (en, hi, es, fr, de, it, pt-BR, …). Drives the
  // language of the admin/staff UI + outbound email. NULL = "follow
  // cookie / browser preference" — set only when the user explicitly
  // picks from the language selector.
  preferredLanguage String?
  // Sprint 1.6b — optional per-staff custom role. NULL = fall back to the
  // legacy `role` enum's implicit permission set (BUSINESS_ADMIN ≈ Owner,
  // STAFF ≈ FrontDesk).
  businessRoleId    String?
  businessRole      BusinessRole? @relation(fields: [businessRoleId], references: [id], onDelete: SetNull)
  // Doctor v2 — structured specialty/department (replaces free-text speciality for filtering)
  specialtyId       String?
  specialty         Specialty?    @relation("DoctorSpecialty", fields: [specialtyId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  staffSchedules    StaffSchedule[]
  staffAppointments Appointment[]       @relation("StaffAppointments")
  userAppointments  Appointment[]       @relation("UserAppointments")
  createdPrescriptions AppointmentPrescription[] @relation("PrescriptionAuthor")
  createdDocuments  AppointmentDocument[] @relation("AppointmentDocumentAuthor")
  leaveRequests     StaffLeave[]
  notifications     InboxNotification[]
  supportMessages   SupportMessage[]     @relation("SupportUserMessages")
  staffWaitlist     Waitlist[]          @relation("StaffWaitlist")
  mattersResponsible Matter[]           @relation("LawyerMatters")
  amcContractsResponsible AmcContract[] @relation("TechnicianAmcContracts")
  serviceVisitsAssigned   ServiceVisit[] @relation("TechnicianServiceVisits")
  doctorReviews     Review[]            @relation("DoctorReviews")

  @@index([businessRoleId])
  @@index([specialtyId])
}

model Business {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  slugLastChangedAt DateTime?
  // Human-friendly 8-digit code (vs the uuid). Easy to read out / type into
  // admin tools like coupon business-restrictions. Nullable so the column adds
  // cleanly; backfilled + assigned on create. See lib/businessShortId.js.
  shortId           String?   @unique
  description       String?
  address           String? // storefront address line 1 (public-facing)
  addressLine2      String? // storefront address line 2 (suite/unit/floor)
  city              String? // storefront city
  postalCode        String? // storefront postal/PIN/ZIP code
  state             String?
  country           String? // ISO-3166-1 alpha-2 (e.g. "IN", "US")
  timezone          String? // IANA zone (e.g. "Pacific/Auckland")
  phone             String?
  email             String?
  category          String?
  bookingType       String    @default("POSTPAID") // 'PREPAID' | 'POSTPAID'
  // ECOMMERCE multi-store / multi-region mode (2026-05-12).
  // Controls whether the storefront prompts the shopper for a delivery
  // location before browsing AND how the resolution flows behave.
  //
  //   OFF      — single-location tenant. No LocationPrompt, no cart.locationId.
  //              The default for legacy + APPOINTMENT / STATIC verticals.
  //   CHAIN    — Pak'nSave-style. N physical stores under one tenant, each
  //              with its own catalog + pricing + slots. Shopper picks a
  //              STORE; cart scopes to it. (Phases 1-7 already wired this.)
  //   FULFILLMENT — Shopify-style. Shopper sees one storefront, while
  //              admin fulfils from the primary active BusinessLocation.
  //   REGIONAL — Shopify-Markets-style. Stores are pooled by region; the
  //              shopper picks a REGION (EcomServiceCity) and the system
  //              resolves which store fulfils within that region pool.
  //              Used when assortment is uniform but currency / pricing /
  //              language varies by country or state.
  //   BOTH     — two-step: region first, then store within region. For a
  //              tenant operating chains across multiple countries.
  multiStoreMode    String    @default("OFF") // 'OFF' | 'FULFILLMENT' | 'CHAIN' | 'REGIONAL' | 'BOTH'
  // Max nesting depth for ProductCategory tree. 1 = flat (no nesting),
  // 2 = parent + child (current default), 3 = parent + child + sub-child.
  // Tier-gated in `apps/shop/admin` Settings panel — Phase E. Backend
  // enforces this via lib/categoryDepth.js on every create + parent move.
  categoryMaxDepth  Int       @default(2)
  // Per-tenant feature flag overrides. Admin can OPT OUT of features their
  // plan tier already enables (turn them off). They CANNOT opt in to
  // features their tier doesn't include — the TierFeature row is the
  // entitlement ceiling, this column is the floor adjustment. Shape:
  //   { "buyAgain": false, "walletCredit": true, ... }
  // See core/lib/featuresCatalog.js for the catalog + per-feature defaults
  // and core/controllers/tenant.controller.js#resolveFeatures for merge.
  featureFlags      Json?
  // Doctor v2 — reminder config, e.g. { "channels": ["WHATSAPP","EMAIL"], "offsets": [1440, 120] } (minutes before)
  appointmentReminderConfig Json?
  isActive          Boolean   @default(true)
  suspendedReason   String?
  suspendedAt       DateTime?
  // GDPR Article 17 — soft-delete with 30-day grace period. See User
  // model for the same pattern. Subscription/Paddle is cancelled at
  // request time; tenant data is purged when the cron sweeps after 30d.
  pendingDeletionAt DateTime?
  anonymisedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users                    User[]
  services                 Service[]
  appointments             Appointment[]
  specialties              Specialty[]
  consentRecords           ConsentRecord[]
  reviews                  Review[]
  prescriptions            AppointmentPrescription[]
  appointmentDocuments     AppointmentDocument[]
  lawFirmIntakes           LawFirmIntake[]
  subscription             Subscription?
  content                  BusinessContent?
  seoSettings              BusinessSeoSettings?
  seoPageOverrides         SeoPageOverride[]
  redirects                Redirect[]
  customers                Customer[]
  hours                    BusinessHours[]
  holidays                 BusinessHoliday[]
  leaveRequests            StaffLeave[]
  waitlist                 Waitlist[]
  autoApproveLeave         Boolean                   @default(false)
  // When true, every new customer booking lands as CONFIRMED instead
  // of PENDING — saves admins from manually approving each one. Off
  // by default so the existing flow (admin reviews + confirms) stays
  // the safe path; admins opt in from Settings → Bookings when they
  // want hands-off booking. The auto-cancel-stale-pending cron only
  // touches PENDING rows, so flipping this on also short-circuits
  // that risk.
  autoConfirmBookings      Boolean                   @default(false)
  // Review-request email sent ~24h after a COMPLETED appointment. When
  // reviewRequestEnabled is true AND reviewRequestLink is set, the
  // customer gets a "How was your visit?" email with a 1-click CTA to
  // the business's Google / Yelp / internal review page.
  reviewRequestEnabled     Boolean                   @default(true)
  reviewRequestLink        String?
  // Tenant's "house language" — used as the fallback when a visitor
  // hasn't picked a language yet (no NEXT_LOCALE cookie, no
  // Customer.preferredLanguage). Doesn't override an individual's
  // explicit pick. NULL = no preference set; existing customer/cookie
  // logic applies. BCP-47 codes matching i18n SUPPORTED_LOCALES
  // (en, hi, es, fr, de, it, pt-BR).
  defaultLanguage          String?
  coupons                  Coupon[]
  enquiries                Enquiry[]
  notifications            InboxNotification[]
  supportConversations     SupportConversation[]
  supportMessages          SupportMessage[]
  integrations             BusinessIntegration[]
  domains                  Domain[]
  // Vertical the business is configured for. Drives storefront layout +
  // admin nav. APPOINTMENT is the existing product (booking-first).
  // STATIC = marketing-only site (no booking, no shop).
  // ECOMMERCE = product catalog + cart + checkout (grocery launch theme).
  // Default APPOINTMENT for backward compat with all existing tenants.
  vertical                 String                    @default("APPOINTMENT") // 'STATIC' | 'APPOINTMENT' | 'ECOMMERCE'
  // Default currency the admin's new-product form pre-fills with. ISO
  // 4217 (e.g. "USD", "INR", "EUR"). Null = fall back to "INR" in UI for
  // back-compat. Existing per-product currencies are NOT touched when
  // this changes — products keep their own currency snapshot.
  defaultCurrency          String?
  currencyChangedAt        DateTime? // rate-limit guard — updated on every manual currency change
  // Subscription billing profile. Separate from storefront contact/address:
  // a customer may buy Sitepresso for a registered company while the public
  // site shows a clinic/shop/location address.
  billingPurchaserType     String                    @default("INDIVIDUAL") // 'INDIVIDUAL' | 'BUSINESS'
  billingBusinessName      String?
  billingContactName       String?
  billingEmail             String?
  billingTaxId             String?
  billingAddressLine1      String?
  billingAddressLine2      String?
  billingCity              String?
  billingState             String?
  billingPostalCode        String?
  billingCountry           String?
  paddleBillingAddressId   String?
  paddleBillingBusinessId  String?
  pages                    BusinessPage[]
  products                 Product[]
  productCategories        ProductCategory[]
  carts                    Cart[]
  orders                   Order[]
  // Sprint 1.1 — multi-channel notifications (SMS + WhatsApp + Email + budget engine)
  notificationConfig       NotificationConfig?
  messageDeliveries        MessageDelivery[]
  budgetUsages             BudgetUsage[]
  // Sprint 1.2 — marketing automation (Pro tier)
  automationCampaigns      AutomationCampaign[]
  automationEnrollments    AutomationEnrollment[]
  customerMarketingOptOuts CustomerMarketingOptOut[]
  // Sprint 1.3 — advanced intake forms (Pro tier)
  intakeForms              IntakeForm[]
  intakeSubmissions        IntakeSubmission[]
  // Sprint 1.4 — CRM tags & segments (Pro tier)
  customerTags             CustomerTag[]
  customerSegments         CustomerSegment[]
  // Sprint 1.5 — multi-location (Business tier)
  locations                BusinessLocation[]
  // Restaurant Reservations theme — dining rooms, service periods, tables
  // and reservation-to-table assignments. APPOINTMENT tenants outside the
  // restaurant theme ignore these tables completely.
  restaurantSettings       RestaurantSettings?
  restaurantDiningAreas    RestaurantDiningArea[]
  restaurantTables         RestaurantTable[]
  restaurantServicePeriods RestaurantServicePeriod[]
  restaurantReservations   RestaurantReservation[]
  // Sprint 1.6 — RBAC (Business tier)
  businessRoles            BusinessRole[]
  // Sprint 1.7 — Public API + webhooks (Business tier)
  apiKeys                  ApiKey[]
  webhookSubscriptions     WebhookSubscription[]
  webhookDeliveries        WebhookDelivery[]
  paddleWebhookEvents      PaddleWebhookEvent[]
  paddleBillingSubscriptions PaddleBillingSubscription[]
  billingPurchases         BillingPurchase[]
  paymentAttempts          PaymentAttempt[]
  adjustmentLedger         AdjustmentLedger[]
  messagingTopupGrants     MessagingTopupGrant[]
  // Sprint 2.1 / 2.2 — payment provider linked accounts (ECOMMERCE)
  paymentAccounts          BusinessPaymentAccount[]
  // Sprint 2.5 — WhatsApp ordering (ECOMMERCE Pro tier)
  // E.164 number including country code; buyers tap "Order on WhatsApp" on
  // product page and a wa.me deep-link opens with the product pre-filled.
  whatsappOrderNumber      String?
  whatsappOrdersEnabled    Boolean                   @default(false)
  // Sprint 2.6 — Multi-currency (ECOMMERCE Pro tier)
  // JSON array of ISO-4217 codes the storefront accepts at checkout. Empty
  // = single-currency (defaultCurrency only). Conversions use FX_TO_USD
  // table in budgetEngine; product prices stay in defaultCurrency in the
  // DB and convert at render time. Future: per-currency product overrides.
  supportedCurrencies      String[]                  @default([])
  // Sprint 2.7 — Multi-store (ECOMMERCE Business tier)
  storeBrands              StoreBrand[]
  // Sprint 2.8 — POS sync (ECOMMERCE Business tier)
  posIntegrations          PosIntegration[]
  // Sprint 3.2 — Blog engine (STATIC Pro tier)
  blogPosts                BlogPost[]
  // Sprint 3.2b — Blog comments + likes + per-tenant settings
  blogComments             BlogComment[]
  blogLikes                BlogLike[]
  blogSettings             BlogSettings?
  // Sprint 3.2c — Blog categories (top-level groupings, distinct from
  // tagsCsv keyword tags — categories drive the storefront filter UI).
  blogCategories           BlogCategory[]
  // Sprint 3.3 — Pages CMS v2 (drag-to-nest navbar)
  // Stores the admin's site-nav tree: ordered top-level entries, each
  // pointing to a system-page key (e.g. "home") or a custom BusinessPage
  // by id, plus an optional `children` array of the same shape. Empty /
  // null = fall back to the default order computed from system pages
  // + each BusinessPage row's parentNav. Schema:
  //   [{ kind:"system"|"custom", key?:string, pageId?:string,
  //      children?: [...] }]
  siteNav                  Json?
  // ── ECOMMERCE Path B Phase 2a (2026-05-01) ──
  // Relational entities for the full grocery-operations console. Optional —
  // STATIC + APPOINTMENT tenants ignore these entirely.
  inventoryStocks          InventoryStock[]
  inventoryAdjustments     InventoryAdjustment[]
  ecomRiders               EcomRider[]
  ecomDeliveryRequests     EcomDeliveryRequest[]
  ecomDeliveryRequestEvents EcomDeliveryRequestEvent[]
  ecomDeliveryLocationPings EcomDeliveryLocationPing[]
  ecomDeliveryCashSettlements EcomDeliveryCashSettlement[]
  ecomRiderShifts          EcomRiderShift[]
  ecomDeliveryRoutes       EcomDeliveryRoute[]
  ecomDeliverySlots        EcomDeliverySlot[]
  ecomDeliverySlotBookings EcomDeliverySlotBooking[]
  ecomRolePermissionGrants EcomRolePermissionGrant[]
  // ── ECOMMERCE Path B Phase 2b (2026-05-01) ──
  ecomReturns              EcomReturn[]
  ecomReviews              EcomReview[]
  ecomBanners              EcomBanner[]
  ecomCmsBlocks            EcomCmsBlock[]
  storePolicies            StorePolicy[]
  ecomOrderEvents          EcomOrderEvent[]
  // ── ECOMMERCE Path B Phase 2c (2026-05-01) ──
  ecomServiceCities        EcomServiceCity[]
  ecomDeliveryZones        EcomDeliveryZone[]
  ecomSuppliers            EcomSupplier[]
  ecomGoodsReceiptNotes    EcomGoodsReceiptNote[]
  ecomInventoryTransfers   EcomInventoryTransfer[]
  ecomActivityEvents       EcomActivityEvent[]
  // F3 — customer-facing loyalty ledger (one row per earn/redeem event).
  ecomLoyaltyLedger        EcomLoyaltyLedger[]
  // ── ECOMMERCE Storefront UX (2026-05-02) ──
  wishlists                Wishlist[]
  // Storefront announcement bar — admin sets text + colours; shown above the
  // main nav when enabled. Replaces the hardcoded "Track order / My account"
  // strip with a configurable promo/info strip.
  announcementBarEnabled   Boolean                   @default(false)
  announcementBarText      String?
  announcementBarBgColor   String                    @default("#146A39")
  announcementBarTextColor String                    @default("#ffffff")
  // Wishlist icon type shown on product cards. "bookmark" | "heart"
  wishlistEnabled          Boolean                   @default(true)
  wishlistIconType         String                    @default("bookmark")
  // Controls which category depth the storefront homepage grid shows.
  // 'main' = top-level only (default), 'sub' = second level, 'leaf' = deepest.
  categoryGridDisplay      String                    @default("main")
  // Brand catalog — Unilever/ITC/etc. (family) + Surf/Dove/etc. (brand).
  // Two-level hierarchy: brand belongs to a family, product picks a brand.
  // Drives the storefront brand picker + per-brand sales analytics.
  productBrandFamilies     ProductBrandFamily[]
  productBrands            ProductBrand[]
  // Storefront checkout payment-mode policy (admin-controlled). The
  // /payment-providers endpoint reads this and the storefront only renders
  // the allowed methods. 'BOTH' = customer chooses, 'COD_ONLY' = no online
  // gateway shown, 'PREPAID_ONLY' = no Cash-on-Delivery shown. Default
  // BOTH so existing tenants keep current behaviour.
  paymentMode              String                    @default("BOTH") // 'BOTH' | 'COD_ONLY' | 'PREPAID_ONLY'
  // Click & Collect (in-store pickup). When true, checkout shows a
  // Delivery vs Pickup toggle and the admin's pickupLocations are
  // listed for the buyer to choose from. Off by default — opt-in feature.
  pickupEnabled            Boolean                   @default(false)
  // Home-delivery model (2026-06-06). Independent of pickupEnabled (Click &
  // Collect), this controls HOW home delivery works and drives the Store
  // Setup window + storefront checkout slot picker.
  //   SCHEDULED = customer picks a delivery time window (uses EcomDeliverySlot)
  //   ASAP      = delivered as soon as possible, no time windows shown
  //   NONE      = no home delivery (pickup-only; requires pickupEnabled=true)
  // Default ASAP so new/no-slot tenants never show an empty "pick a slot"
  // picker; the migration backfills SCHEDULED for tenants that already have
  // active slots, preserving their current checkout.
  deliveryMode             String                    @default("ASAP") // 'SCHEDULED' | 'ASAP' | 'NONE'
  // Store-level FLAT delivery (2026-06-09). The deliver-anywhere baseline: used
  // when the shopper's address matches no EcomDeliveryZone, so a store with no
  // zones (or addresses outside its zones) still gets a SERVER-computed delivery
  // charge + ETA instead of trusting a client-sent shipping value. A matching
  // zone overrides these. flatDeliveryFeeMinor=0 = free flat delivery.
  flatDeliveryFeeMinor           Int  @default(0)
  flatFreeDeliveryThresholdMinor Int  @default(0)
  deliveryEtaMinutes             Int?
  pickupLocations          EcomPickupLocation[]
  ProductLocationOverride  ProductLocationOverride[]
  mailboxes                Mailbox[]
  matters                  Matter[]
  trustTransactions        TrustTransaction[]
  installedUnits           InstalledUnit[]
  amcContracts             AmcContract[]
  serviceVisits            ServiceVisit[]
  amcInvoices              AmcInvoice[]
}

// BusinessPage — multi-page CMS. Each row is a single sub-page under one
// of the storefront's nav sections (services, team, about, ...). Content
// lives in the JSON `content` blob shaped by the `templateKey` template;
// see `backend/src/lib/pageTemplates.js` for the schema each template
// expects. Storefront renders by matching `templateKey` to the registry's
// renderer.
//
// Unique by (businessId, parentNav, slug) so a business can have one
// "/services/haircut" page but not two. parentNav values mirror the
// storefront top nav: services | team | about | products (e-commerce) |
// info (catch-all for static pages with no parent section).
//
// Pages start unpublished so admins can draft + preview before exposing.
// Admin-side ordering via sortOrder (lower first); ties broken by id.
model BusinessPage {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  parentNav   String // 'services' | 'team' | 'about' | 'products' | 'info'
  slug        String // 'haircut', 'jane-doe', 'our-story' (lowercase, dashes)
  title       String
  templateKey String // e.g. 'service-detail', 'team-bio', 'info-page', 'block-page'
  // Content is a JSON blob whose shape depends on templateKey. Use
  // pageTemplates.validate() before persisting. For 'block-page', this is
  // an object { blocks: [...] } where each block is one of the editor's
  // block types (header, richtext, imagetext, features, cta).
  content     Json          @default("{}")
  isPublished Boolean       @default(false)
  sortOrder   Int           @default(0)
  // Sprint 3.3 — Pages v2 nav placement. Drives where the storefront
  // surfaces this page in the navbar:
  //   TOP      — own top-level menu item
  //   DROPDOWN — nested under another nav item (legacy default; matches
  //              the existing parentNav-grouping behaviour)
  //   FOOTER   — listed in the footer only, not in the main nav
  //   HIDDEN   — accessible by direct URL only, never linked
  placement   PagePlacement @default(DROPDOWN)
  // Optional icon key (e.g. "leaf", "shield", "doc") rendered next to the
  // page in the admin list + nav-manager tree. NULL = no icon, falls back
  // to the templateKey's default in the UI.
  iconKey     String?

  // SEO overrides — optional; fall back to title + 1st paragraph of content
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, parentNav, slug])
  @@index([businessId, parentNav, isPublished, sortOrder])
}

model BusinessSeoSettings {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  siteTitle       String?
  siteDescription String? @db.Text
  defaultKeywords String? @db.Text
  canonicalDomain String?
  defaultOgImageUrl String? @db.Text

  googleAnalyticsId            String?
  googleTagManagerId           String?
  googleSearchConsoleVerification String? @db.Text
  metaPixelId                  String?
  bingVerification             String? @db.Text
  customChatWidgetScript       String? @db.Text

  allowIndexing    Boolean @default(true)
  aiCrawlerPolicy  String  @default("allow") // 'allow' | 'disallow_training' | 'disallow_all_ai'
  enableLlmsTxt    Boolean @default(true)
  schemaType       String?
  socialSameAs     String? @db.Text // JSON array of profile URLs
  metaTemplates    String? @db.Text // JSON: per-page-type title/description templates

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoPageOverride {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url        String
  pageType   String
  entityId   String?
  pageTitle  String?

  metaTitle       String?
  metaDescription String? @db.Text
  keywords        String? @db.Text
  canonicalUrl    String? @db.Text
  ogTitle         String?
  ogDescription   String? @db.Text
  ogImageUrl      String? @db.Text
  noIndex         Boolean @default(false)
  includeInSitemap Boolean @default(true)
  sitemapPriority Float?
  changeFrequency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, url])
  @@index([businessId, pageType])
}

// ECOMMERCE vertical — Phase 1: Product catalog (read-only storefront).
//
// Phase 2 will add Cart + CartItem + Order + OrderItem when checkout
// lands. Phase 3 adds delivery zones + inventory tracking. See ROADMAP
// E2 for the Shopify-style 7-phase build plan.
//
// All products belong to a Business. Optional category for grouping.
// `imageUrls` is JSON because product galleries vary 0-N images and we
// don't want a separate ProductImage table for v1 — drop in JSON, sort
// by array order, drag-to-reorder on the admin side.
//
// Pricing is stored in MINOR UNITS (paise / cents) so we never lose
// precision to floats. `currency` is ISO 4217 code. `comparePriceMinor`
// is the optional "was ₹X" strikethrough price for sales / promos.
//
// `stockQty` NULL = unlimited stock (digital goods, services); 0 = out
// of stock; positive int = real-time count decremented on order.
// Phase 4 adds the decrement-on-order logic; v1 (catalog only) doesn't
// touch this — it's just displayed on the product card.
//
// `weight` + `weightUnit` are for grocery (per-kg pricing) and shipping
// rate calc. NULL = digital / not weight-priced.
model Product {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name             String
  slug             String // unique per business — "haircut-kit", "wholewheat-bread"
  brand            String? // optional brand label shown above the name on the storefront card
  description      String? // long-form product description (markdown-light)
  shortDescription String? // 1-2 line summary shown on the product grid
  sku              String? // optional inventory code
  barcode          String? // optional EAN/UPC/GTIN or scanner value
  qrCode           String? // optional QR payload/link/text for future scan workflows

  priceMinor          Int // current sale price in minor units (paise / cents)
  comparePriceMinor   Int? // optional "was ₹X" strikethrough
  currency            String @default("INR") // ISO 4217 — INR / USD / etc.
  // How the discount badge is shown on storefront cards: percentage off or
  // flat amount saved. Admins toggle per product. "PERCENTAGE" | "FLAT"
  discountDisplayMode String @default("PERCENTAGE")

  stockQty      Int? // NULL = unlimited; 0 = out of stock; >0 = count
  weightGrams   Int? // for shipping calc + per-kg display
  weightDisplay String? // free-text override e.g. "500 g pack" — falls back to grams
  // Variable-weight grocery items (loose produce, meat, deli, cheese). When
  // true the storefront sells an *estimate* (priceMinor for an average unit)
  // and the picker records the actual weight at pick time; the line total is
  // recomputed from pricePerKgMinor × pickedWeightGrams and any difference is
  // reconciled (over-estimate → partial refund; under-estimate capped by policy).
  soldByWeight    Boolean @default(false)
  pricePerKgMinor Int? // price per kilogram for soldByWeight items (minor units)
  imageUrls     Json    @default("[]") // array of image URLs (CloudFront / direct)
  specs         Json?   // electronics-style structured spec sheet: { highlights: string[], groups: [{ title, rows: [{ label, value }] }] }. Null for non-spec verticals.
  isPublished   Boolean @default(false) // unpublished = drafts hidden from storefront
  isFeatured    Boolean @default(false) // promoted on storefront homepage
  sortOrder     Int     @default(0) // lower first within category

  // SEO overrides — fall back to name + description if null
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems         CartItem[]
  orderItems        OrderItem[]
  // Sprint 2.6b — per-currency price overrides; NULL fallback = FX from priceMinor in defaultCurrency
  prices            ProductPrice[]
  // Sprint 2.7b — optional brand scoping; NULL = product visible across all
  // of the tenant's brands (the default for single-store businesses).
  storeBrandId      String?
  storeBrand        StoreBrand?               @relation(fields: [storeBrandId], references: [id], onDelete: SetNull)
  // 2026-05-09 — structured product-brand FK. The free-text `brand` field
  // above is kept as a denormalized snapshot for back-compat + as the
  // shelf label (so a brand rename doesn't rewrite history). When
  // brandId is set the product participates in brand-level analytics.
  brandId           String?
  productBrand      ProductBrand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // ── ECOMMERCE Path B Phase 2a (2026-05-01) — per-location stock ──
  inventoryStocks   InventoryStock[]
  // ── ECOMMERCE multi-store (2026-05-11) — per-location price + availability ──
  locationOverrides ProductLocationOverride[]
  // ── ECOMMERCE Storefront UX (2026-05-02) ──
  variants          ProductVariant[]
  wishlistItems     WishlistItem[]
  isSample          Boolean                   @default(false) // seeded sample product; removable in one click

  @@unique([businessId, slug])
  @@index([businessId, isPublished, sortOrder])
  @@index([businessId, barcode])
  @@index([categoryId, isPublished, sortOrder])
  @@index([storeBrandId])
}

// Sprint 2.6b — per-currency price override for a single product.
// Tenants enable additional currencies via Business.supportedCurrencies[];
// without an explicit override, storefronts FX-convert from the product's
// `priceMinor` (in defaultCurrency). With an override, that exact figure
// is used instead — typical for "round to ₹999 vs $11.78 from FX".
model ProductPrice {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currencyCode      String // ISO 4217: INR, USD, GBP, …
  priceMinor        Int
  comparePriceMinor Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, currencyCode])
}

// Product variants — size/weight/unit options within one product family.
// e.g. "Capsicum - Green" has variants: 500g / 250g / 1kg, each with
// its own price, compare price, and stock count.
// Products with no variants stay as single-SKU flat products — the
// variant selector is hidden on the storefront card.
model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label             String // "500g", "1 kg" (grocery) OR composed "M / Red" (apparel)
  sku               String?
  priceMinor        Int
  comparePriceMinor Int?
  stockQty          Int? // NULL = unlimited; 0 = out of stock; >0 = count
  // ── Apparel/fashion variant axes (2026-06-13) ──
  // Optional two-dimensional option matrix (e.g. Size × Color). NULL on
  // single-axis grocery variants, which keep using `label` alone. When set,
  // the storefront renders size pills + colour swatches instead of a dropdown
  // and resolves the (option1,option2) pair back to this exact variant for
  // its own price/stock. `label` stays the composed human display.
  option1Name       String? // axis 1 name, e.g. "Size"
  option1Value      String? // axis 1 value, e.g. "M"
  option2Name       String? // axis 2 name, e.g. "Color"
  option2Value      String? // axis 2 value, e.g. "Red"
  swatchHex         String? // colour chip for option2 swatches, e.g. "#C0392B"
  imageUrl          String? // per-colourway image (overrides product gallery)
  sortOrder         Int      @default(0) // lower first in dropdown
  isDefault         Boolean  @default(false) // pre-selected in the picker
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([productId, sortOrder])
}

// Wishlist — one per shopper per business (guest or logged-in).
// Guest lists are keyed by sessionId (same as cart session) and stored
// server-side so they survive refreshes. On login the guest wishlist
// merges into the customer's account wishlist, identical to cart merge.
model Wishlist {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  items      WishlistItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([businessId, customerId])
  @@index([businessId, sessionId])
}

// WishlistItem — one saved product (with optional variant) per wishlist.
// No DB-level unique constraint: same NULL issue as CartItem.variantId —
// deduplication is enforced in application code.
model WishlistItem {
  id         String          @id @default(uuid())
  wishlistId String
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  addedAt    DateTime        @default(now())

  @@index([wishlistId, productId])
  @@index([variantId])
}

// Product categories. Supports one level of parent/child nesting —
// parentId null = top-level; parentId set = subcategory. Slug is unique
// per business for clean URLs.
model ProductCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  slug        String // unique per business — "produce", "dairy", "bakery"
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
  isSample    Boolean @default(false) // seeded by "Load sample catalog"; lets "Remove samples" clean up

  // Optional parent — depth gated by Business.categoryMaxDepth (default 2,
  // up to 3 with the 3-level feature, configurable to higher in future).
  // lib/categoryDepth.js validates depth + cycles on every create/move.
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([businessId, slug])
  @@index([businessId, isPublished, sortOrder])
  @@index([parentId])
}

// Cart — one-per-shopper-per-business. Two shopper-identity modes:
//   * Guest:        sessionId is set, customerId is null.
//   * Logged-in:    customerId is set; sessionId may also be present from
//                   their pre-login browsing — we merge guest carts into
//                   the customer cart on login.
// On checkout we DO NOT delete the cart immediately — we leave it so the
// "Order placed" confirmation can re-render line items, then a cleanup
// cron deletes carts older than 30 days. Lifetime is short by design;
// we intentionally do not persist long-lived wishlists here.
model Cart {
  id         String            @id @default(uuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  sessionId  String? // browser-side cookie ID; UUID set by storefront
  currency   String            @default("INR") // ISO 4217 — locked at first add
  // ECOMMERCE multi-store (2026-05-11) — which physical store fulfils this cart.
  // Nullable: set once the shopper resolves a location (pincode / geo / picker).
  // Switching it triggers cart reconciliation (price + availability re-check).
  locationId String?
  location   BusinessLocation? @relation("CartLocation", fields: [locationId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  items CartItem[]

  @@index([businessId, customerId])
  @@index([businessId, sessionId])
  @@index([businessId, locationId])
  @@index([updatedAt])
}

// CartItem — quantity of one product. Price is captured here as a snapshot
// at *add time* so that subsequent product price edits don't silently
// change the customer's basket without warning. The checkout flow re-reads
// current product price + stock to detect drift and warn before charging.
model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // NULL = no variant selected (single-SKU product). Set = specific size/weight
  // variant. Deduplication is enforced in application code because Postgres
  // UNIQUE treats NULLs as distinct, which would allow duplicate plain items.
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int
  priceMinor Int // snapshot of Product.priceMinor (or variant.priceMinor) at time of add
  // P2 — per-item substitution preference. NULL = inherit Order.substitutionPolicy
  // set at checkout. Values match the order-level vocabulary: 'AUTO' (anything
  // similar), 'APPROVE' (ask first), 'REFUND' (do not substitute). UI gated by
  // perItemSubstitution feature flag; backend always accepts.
  substitutionPref String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

// Order — placed when a Cart converts at checkout. We keep snapshots of
// every billing-relevant field (price, name, contact, address) directly
// on the Order/OrderItem rows so future product/customer edits never
// rewrite the historical record. Money is in minor units (paise/cents).
model Order {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Soft FK — we don't relate to Customer because guest checkout is
  // first-class. customerId is set when the buyer was logged in.
  customerId String?

  // Snapshot of contact details at time of checkout. Source of truth for
  // confirmation emails / fulfillment so a later customer-profile edit
  // doesn't change the historical address.
  customerEmail   String
  customerName    String
  customerPhone   String?
  // Address is required for DELIVERY orders, omitted/empty for PICKUP. We
  // keep the column non-null with a "{}"-like default at the app layer so
  // pickup orders still have a stable shape for the admin order list.
  shippingAddress Json // free-form JSON: line1/line2/city/state/postalCode/country

  // How the buyer chose to pay. Captured at checkout so admin / receipts
  // can show "Cash on Delivery" vs "Paid online" without parsing notes.
  // 'cod' | 'online'. Null on legacy rows created before this column.
  paymentMethod String?
  // ECOMMERCE multi-store (2026-05-11) — which physical store fulfils this order.
  // Set at checkout from the cart's resolved location. Nullable for legacy
  // single-location rows. Distinct from pickupLocationId (separate table).
  locationId    String?
  location      BusinessLocation? @relation("OrderLocation", fields: [locationId], references: [id], onDelete: SetNull)

  // Fulfillment branch: home delivery vs store pickup ("Click & Collect").
  // Pickup orders have no shippingAddress + a pickupLocationId + a
  // pickupCode the staff verifies when the buyer arrives.
  fulfillmentType  String              @default("DELIVERY") // 'DELIVERY' | 'PICKUP'
  pickupLocationId String?
  // Soft FK — pickup locations can be deactivated; the snapshot fields on
  // EcomOrderEvent / order detail preserve the address shown to the buyer.
  pickupLocation   EcomPickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupCode       String? // 6-char alphanumeric handed to the buyer at confirmation; staff-side verification on pickup
  pickupReadyAt    DateTime?
  pickedUpAt       DateTime?

  status        OrderStatus @default(PENDING)
  currency      String      @default("INR")
  subtotalMinor Int // sum of items
  shippingMinor Int         @default(0)
  taxMinor      Int         @default(0)
  totalMinor    Int // subtotal + shipping + tax (denormalised for fast list views)

  // Payment provider reference. Filled once webhook / redirect confirms
  // the charge succeeded. Until then the order sits in PENDING.
  paymentProvider String? // 'PADDLE' | 'RAZORPAY' | 'STRIPE' | 'MANUAL'
  paymentRef      String? // provider txn ID

  // Sprint 2.3 — discount codes on storefront checkout
  couponCode    String?
  discountMinor Int     @default(0)

  notes String? // free-text customer note at checkout

  // Pick-exception reconciliation (grocery fulfilment). When picking changes
  // the order — actual weights on sold-by-weight items, substitutions, or
  // shorted/out-of-stock units — the recomputed amount lands in
  // adjustedTotalMinor while totalMinor keeps the originally-charged value, so
  // receipts and refunds can show the delta. refundedMinor accumulates partial
  // refunds (shorted items, over-estimated weight) without flipping the whole
  // order to REFUNDED. substitutionPolicy snapshots how proposed swaps resolve
  // for this order: 'AUTO' accept best match, 'APPROVE' wait for the customer,
  // 'REFUND' never substitute (short + refund instead).
  adjustedTotalMinor Int?
  refundedMinor      Int     @default(0)
  substitutionPolicy String? // 'AUTO' | 'APPROVE' | 'REFUND' — null falls back to business default

  // SLA — when fulfilment is promised by, derived from the delivery slot or
  // the pickup location's prep time at checkout. Powers On-time Delivery %.
  promisedAt DateTime?

  // Delivery slot — set when the customer picks a slot at checkout. Soft
  // FK because slots can be deactivated; the snapshot fields below preserve
  // what the buyer was promised. deliveryDate is the actual day the slot
  // applies to (slots without specificDate are recurring and reuse this).
  deliverySlotId             String?
  deliveryDate               DateTime?
  deliverySlotLabel          String? // "Today, 11 AM – 1 PM" snapshot for receipts
  deliverySlotSurchargeMinor Int       @default(0)

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  items OrderItem[]
  deliveryRequests EcomDeliveryRequest[] @relation("DeliveryRequestOrder")

  @@index([businessId, status, placedAt])
  @@index([businessId, customerEmail])
  @@index([businessId, locationId, status])
  @@index([customerId])
  @@index([deliverySlotId, deliveryDate])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Soft FK — productId may go null if the product is later deleted; the
  // snapshot fields below preserve what was sold.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName    String // snapshot
  productSlug    String? // snapshot — for re-linking from order detail
  quantity       Int
  priceMinor     Int // snapshot of Product.priceMinor at checkout
  lineTotalMinor Int // priceMinor * quantity, denormalised

  // ── Sold-by-weight (grocery) ──────────────────────────────────────────────
  // Snapshot of Product.soldByWeight. For weight lines, quantity is the count
  // of weighed units (usually 1), orderedWeightGrams is the buyer's estimate,
  // and pickedWeightGrams is what the picker actually weighs. lineTotalMinor is
  // recomputed as pricePerKgMinor × pickedWeightGrams ÷ 1000 once weighed.
  soldByWeight       Boolean @default(false)
  pricePerKgMinor    Int? // snapshot of per-kg price for weight lines
  orderedWeightGrams Int? // buyer's estimated weight at checkout
  pickedWeightGrams  Int? // actual weight recorded at pick

  // ── Pick exceptions (substitution / short) ────────────────────────────────
  // fulfillmentStatus tracks the line through picking independently of the
  // order status: 'PENDING' (not yet picked) → 'PICKED' (in the bag as ordered)
  // | 'SUBSTITUTED' (swapped for substitute* product) | 'SHORTED' (some/all
  // units unavailable and refunded). substitutionStatus gates a proposed swap
  // through customer/policy approval. substitute* fields snapshot the
  // replacement (soft FK — substituteProductId, no relation, matching the
  // order's soft-FK pattern). shortedQuantity counts refunded units.
  fulfillmentStatus     String  @default("PENDING") // 'PENDING' | 'PICKED' | 'SUBSTITUTED' | 'SHORTED'
  exceptionReason       String? // 'OUT_OF_STOCK' | 'DAMAGED' | 'EXPIRED' | 'QUALITY' | 'OTHER'
  shortedQuantity       Int     @default(0)
  substitutionStatus    String? // null | 'PROPOSED' | 'AUTO_ACCEPTED' | 'ACCEPTED' | 'REJECTED'
  substituteProductId   String? // soft FK to the replacement Product
  substituteProductName String?
  substitutePriceMinor  Int?
  substituteQuantity    Int?
  substituteWeightGrams Int? // actual weight when the substitute is sold by weight
  // P2 — per-item substitution preference snapshotted from the cart at
  // checkout. NULL = fall back to Order.substitutionPolicy. Values:
  // 'AUTO' | 'APPROVE' | 'REFUND'. Read by resolveSubstitutionMode().
  substitutionPref      String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING // created, awaiting payment confirmation
  PAID // payment captured
  PACKING // admin started preparing the order
  OUT_FOR_DELIVERY
  DELIVERED
  // Click & Collect — order has been packed and is waiting at the pickup
  // location for the buyer to arrive. Customer email + portal show the
  // pickup code and the location address.
  READY_FOR_PICKUP
  PICKED_UP // buyer collected the order at the pickup location
  CANCELLED
  REFUNDED
  FAILED // payment failed
}

// BusinessIntegration — a connected third-party account (Google, Zoom,
// MS Teams) that the business has authorised us to create video meetings
// on their behalf. One row per (business, provider) combo.
//
// Refresh + access tokens are encrypted at rest with AES-256-GCM keyed off
// the existing JWT_SECRET so we don't introduce a new key-management
// surface. Access tokens are kept too (small optimisation — saves a
// refresh round-trip per booking when not yet expired).
//
// Status reflects the *health* of the integration:
//   ACTIVE   — happy path
//   EXPIRED  — refresh token rejected, admin needs to reconnect
//   REVOKED  — user explicitly disconnected from our side; row kept for
//              audit then removed when stale
//
// One booking-side flow: when a service is virtual AND the business has
// an ACTIVE integration for the admin's preferred provider, the booking
// controller calls provider.createMeeting() and stores the URL on
// Appointment.meetingUrl.
model BusinessIntegration {
  id                    String    @id @default(uuid())
  businessId            String
  provider              String // 'google_meet' | 'zoom' | 'ms_teams'
  status                String    @default("ACTIVE") // 'ACTIVE' | 'EXPIRED' | 'REVOKED'
  scopes                String? // comma-separated list of scopes granted
  externalAccountId     String? // provider's user / account ID, for display
  externalAccountEmail  String? // shown in admin UI: "Connected as foo@bar.com"
  refreshTokenEncrypted String?   @db.Text // AES-256-GCM ciphertext (base64)
  accessTokenEncrypted  String?   @db.Text // short-lived, refreshed on demand
  accessTokenExpiry     DateTime? // when accessTokenEncrypted needs refresh
  connectedByUserId     String? // which admin clicked Connect (audit)
  connectedAt           DateTime  @default(now())
  lastUsedAt            DateTime? // last successful createMeeting call
  lastError             String? // last refresh / API error, for admin visibility
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@index([provider])
  @@index([status])
}

// Enquiry — a customer-submitted form from the public storefront's
// Contact section. Business owners see these in their admin dashboard.
model Enquiry {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  subject    String?
  message    String
  status     EnquiryStatus @default(NEW)
  ipAddress  String? // captured for light abuse prevention
  userAgent  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([businessId, status, createdAt])
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday, 1=Monday ... 6=Saturday
  openTime   String // "09:00"
  closeTime  String // "17:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
}

model BusinessHoliday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Per-branch holidays (2026-06-07): null = applies to ALL branches
  // (business-wide). A locationId scopes the closed day to one branch so
  // different cities can observe different public holidays. APPOINTMENT
  // tenants keep null (business-wide) — behaviour unchanged.
  locationId String?
  location   BusinessLocation? @relation("HolidayLocation", fields: [locationId], references: [id], onDelete: Cascade)
  date       DateTime
  name       String // "Christmas Day", "New Year's Day", etc.
  createdAt  DateTime @default(now())

  @@unique([businessId, locationId, date])
  @@index([businessId, locationId])
}

model Customer {
  id                String    @id @default(uuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email             String
  password          String
  name              String
  phone             String? // optional, customer-editable from portal Settings
  dateOfBirth       DateTime? // optional, customer-editable from portal Settings
  googleId          String?
  isActive          Boolean   @default(true)
  // GDPR Article 17 — soft-delete with 30-day grace. When the cron
  // purges, name/email/phone are nulled but Booking/Enquiry rows stay
  // (anonymised) so the business keeps revenue stats. AuditLog row
  // retains identity proof for legal/subpoena lookups.
  pendingDeletionAt DateTime?
  anonymisedAt      DateTime?
  // Email verification via OTP at signup. Customers created via Google OAuth
  // are marked verified immediately (Google already verified the email).
  emailVerified     Boolean   @default(false)
  emailOtp          String?
  emailOtpExpiry    DateTime?
  // See User.passwordChangedAt — revokes pre-change sessions on reset/change.
  passwordChangedAt DateTime?
  otpAttempts       Int       @default(0) // per-account failed-OTP counter
  // false = social-only (random password); don't demand a "current password"
  // they never set on password-change / account-delete.
  hasPassword       Boolean   @default(true)
  // Legal consent (GDPR / NZ Privacy Act evidence of acceptance)
  termsAcceptedAt   DateTime?
  termsVersion      String?
  calendarFeedToken String?   @unique
  avatarUrl         String?   @db.Text
  // BCP-47 locale code (en, hi, es, fr, de, it, pt-BR, …). Drives the
  // language of the customer portal + emails. NULL = "follow cookie /
  // browser preference" — set only when the customer explicitly picks
  // from the language selector.
  preferredLanguage String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // F3 customer notification preferences. Free-form JSON keyed by
  // category ('order_updates', 'promotions', 'restock_alerts'), each value
  // is an object of channel→bool ({ email, sms, whatsapp }). NULL means
  // "use defaults" — order_updates always on, marketing on by default
  // unless the customer opts out via CustomerMarketingOptOut.
  notificationPrefs Json?

  appointments          Appointment[]             @relation("CustomerAppointments")
  consentRecords        ConsentRecord[]
  reviews               Review[]
  notifications         InboxNotification[]
  supportConversations  SupportConversation[]
  supportMessages       SupportMessage[]          @relation("SupportCustomerMessages")
  waitlist              Waitlist[]
  marketingOptOuts      CustomerMarketingOptOut[]
  automationEnrollments AutomationEnrollment[]
  // Sprint 1.4 — CRM tags + segments (Pro tier)
  tagAssignments        CustomerTagAssignment[]
  // Sprint 3.2b — Blog comments + likes (registered customers can post,
  // like, etc.). Customer self-deletion nullifies authorship on comments
  // (history preserved with stored authorName) and cascades likes away.
  blogComments          BlogComment[]
  blogLikes             BlogLike[]
  wishlists             Wishlist[]
  addresses             CustomerAddress[]
  loyaltyLedger         EcomLoyaltyLedger[]
  // Multi-provider social logins (Google now; Apple / Microsoft / etc.
  // later). The (businessId, email) pair below stays the primary tenant
  // identity key — this just records which external providers are linked.
  identities            CustomerIdentity[]
  matters               Matter[]                  @relation("CustomerMatters")
  installedUnits        InstalledUnit[]           @relation("CustomerInstalledUnits")
  amcContracts          AmcContract[]             @relation("CustomerAmcContracts")

  @@unique([businessId, email])
}

// One row per (customer, provider). Lets ANY OIDC provider attach to a
// customer without schema changes — add a provider module on the backend
// and the only new value here is the `provider` string. `Customer.googleId`
// is kept for backward compatibility and is backfilled into this table.
model CustomerIdentity {
  id          String    @id @default(uuid())
  // Denormalised tenant scope — matches the repo-wide convention that
  // every customer-owned row carries businessId for fast tenant queries.
  businessId  String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider    String // 'google' | 'apple' | 'microsoft' | ...
  subject     String // the provider's stable user id (the OIDC "sub" claim)
  email       String? // email asserted by the provider at link time (informational)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  // Within a business, a given provider identity maps to exactly one
  // customer; and a customer has at most one identity per provider.
  @@unique([businessId, provider, subject])
  @@unique([customerId, provider])
  @@index([customerId])
  @@index([businessId])
}

// ECOMMERCE address book — saved shipping addresses per customer.
// Snapshotted into Order.shippingAddress at checkout (orders never reference
// this row directly, so editing/deleting an address never mutates history).
// Only one isDefault per customer; controller enforces.
model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String? // e.g. "Home", "Work" — optional friendly tag
  fullName   String // recipient — defaults to customer.name on create
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String // ISO 3166-1 alpha-2 (uppercase, validated by Zod)
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isDefault])
}

