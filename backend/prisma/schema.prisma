  purchaseId           String?
  purchase             BillingPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paddleAdjustmentId   String?          @unique
  paddleTransactionId  String?
  paddleSubscriptionId String?
  action               String
  status               String
  reason               String?
  currencyCode         String?
  amountMinor          Int?
  raw                  Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([businessId, createdAt])
  @@index([purchaseId])
  @@index([paddleTransactionId])
  @@index([paddleSubscriptionId])
}

model DomainPricing {
  tld                   String    @id
  registrar             Registrar
  wholesaleMinor        Int
  retailMinor           Int
