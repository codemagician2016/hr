  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productKind          String   // PLAN | DOMAIN | MAILBOX | SMS | OTHER
  checkoutKind         String?
  status               String   @default("CHECKOUT_CREATED")
