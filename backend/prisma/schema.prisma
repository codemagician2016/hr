model RestaurantReservationTable {
  id            String                @id @default(uuid())
  reservationId String
  reservation   RestaurantReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tableId       String
  table         RestaurantTable       @relation(fields: [tableId], references: [id])
  createdAt     DateTime              @default(now())

  @@unique([reservationId, tableId])
  @@index([tableId])
}

// Structured intake for the law_firm booking theme. One row per consultation
// request (1:1 with Appointment), holding the legal-specific detail captured
// at booking: matter, the other parties (for the conflict-of-interest check),
// AML/CFT photo-ID type, and consent timestamps. conflictStatus drives the
// pre-engagement approval gate — the firm clears conflicts before confirming.
// String status fields (not enums) mirror RestaurantReservation's convention.
model LawFirmIntake {
  id                  String      @id @default(uuid())
  businessId          String
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId       String      @unique
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  format              String      @default("IN_PERSON") // IN_PERSON | VIDEO | PHONE
  matterType          String?
  matterSummary       String?     @db.Text
  opposingParty       String?     @db.Text
  deadline            String?
  existingClient      String? // No | Yes
  idDocumentType      String?
  referralSource      String?
  source              String      @default("ONLINE") // ONLINE | PHONE | ADMIN
  conflictStatus      String      @default("PENDING") // PENDING | CLEARED | CONFLICT | WAIVED
  conflictNotes       String?     @db.Text
  conflictCheckedById String? // User id of the lawyer/admin who ran the check (no FK yet)
  conflictCheckedAt   DateTime?
  conflictConsentAt   DateTime?
  amlConsentAt        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([businessId, conflictStatus, createdAt])
}

// =============================================================================
// Sprint 1.4 (2026-04-29) — CRM tags & segments (Pro tier)
// =============================================================================

model CustomerTag {
  id          String                  @id @default(uuid())
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  color       String? // hex e.g., '#6366f1'
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  assignments CustomerTagAssignment[]

  @@unique([businessId, name])
  @@index([businessId])
}

model CustomerTagAssignment {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([customerId, tagId])
  @@index([tagId])
}

model CustomerSegment {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  // JSON: { tagIds: [], hasUpcomingAppointment: bool, lastVisitDaysAgo: {gte,lte},
  //         totalSpentMinor: {gte,lte}, hasEmail: bool, hasPhone: bool, ... }
  filter     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model IntakeSubmission {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  formId String
  form   IntakeForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  // Optional: tied to a specific appointment + customer. Submissions can
  // exist standalone (e.g. pre-registration form filled before booking).
  appointmentId String?
  customerId    String?

  // Recipient identifier when no Customer row exists yet.
  customerEmail String?
  customerName  String?

  // JSON object: { fieldId: value }. Value is string for most types,
  // string[] for checkbox, base64 data URL for signature, S3 URL for file.
  answers Json @default("{}")

  // Snapshot of the form fields AT SUBMISSION TIME so historical records
  // survive form edits. Without this, if admin renames a field after the
  // submission, the answer's meaning drifts.
  fieldsSnapshot Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([appointmentId])
  @@index([formId])
  @@index([customerId])
}

// Sprint 3.3 — Pages CMS v2. Placement controls where the page surfaces
// in the storefront's navbar. DROPDOWN keeps the legacy behaviour (groups
// by parentNav under a parent menu); TOP / FOOTER / HIDDEN are new.
enum PagePlacement {
  TOP // own top-level menu item
  DROPDOWN // nested under another nav item
  FOOTER // footer only
  HIDDEN // direct URL only
}

// =============================================================================
// ECOMMERCE Path B — Phase 2a (2026-05-01) — RBAC, Inventory, Riders, Slots
// =============================================================================
//
// Strategic shift: ECOMMERCE vertical no longer "solo-first." The 28-screen
// FreshCart prototype is the v1 spec. This block adds the relational entities
// the prototype assumes — granular RBAC, per-location inventory, delivery
// fleet, route batching, and time-window delivery slots.
//
// Conventions:
//   - All ECOMMERCE-only entities are prefixed `Ecom` to keep them visually
//     separate from APPOINTMENT-vertical models in `git grep`. Inventory*
//     models are unprefixed because "inventory" is unambiguously e-commerce.
//   - Every model carries `businessId` (tenant scope). Most also carry
//     `locationId` (store scope) — null = applies to all locations.
//   - All money in minor units (paise / pence). Currency comes from
//     Order.currency or Business.defaultCurrency.

// EcomPermission — catalog of every permission key the ECOMMERCE admin
// can grant. Seeded server-side from a fixed list (24 keys × 6 areas, see
// `Grocery E-Commerce/roles.html` for the full matrix). `key` is the stable
// identifier code reads against (e.g. "orders.refund", "inventory.adjust").
model EcomPermission {
  id          String   @id @default(uuid())
  key         String   @unique // "orders.view", "orders.refund", "inventory.adjust", …
  area        String // "orders" | "catalogue" | "inventory" | "customers" | "finance" | "system"
  label       String // "Refund orders"
  description String? // human-readable explanation shown in role builder
  // Lower = more dangerous (refund > view). Used to sort the matrix UI.
  weight      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grants EcomRolePermissionGrant[]

  @@index([area, weight])
}

// Per-(BusinessRole, EcomPermission) grant — the relational backbone of
// the RBAC matrix. The legacy `BusinessRole.permissions Json` column
// stays for back-compat with existing APPOINTMENT-vertical roles; new
// ECOMMERCE roles use these grants exclusively. Fresh installs migrate
// JSON → grants on first read (handled in middleware).
model EcomRolePermissionGrant {
  id           String            @id @default(uuid())
  businessId   String // denormalised for fast tenant-scoped queries
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roleId       String
  role         BusinessRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   EcomPermission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  // Optional location scope — when set, the grant only applies at this
  // location. NULL = applies across all of the tenant's locations.
  locationId   String?
  location     BusinessLocation? @relation("EcomGrantLocation", fields: [locationId], references: [id], onDelete: Cascade)
  grantedAt    DateTime          @default(now())
  // Optional time-bound grants (e.g. holiday-cover access expires at midnight)
  expiresAt    DateTime?

  @@unique([roleId, permissionId, locationId])
  @@index([businessId])
  @@index([locationId])
}

// InventoryStock — per (Product, BusinessLocation) on-hand quantity.
// The legacy `Product.stockQty` column stays for solo-store back-compat
// (NULL on product = unlimited; not tracked here either). For ECOMMERCE
// Path B tenants with multi-location, the source of truth lives here and
// `Product.stockQty` becomes a denormalised sum updated via trigger.
//
// `reorderPoint` and `reorderQty` drive low-stock alerts and the
// suggested-PO flow on the Inventory panel.
model InventoryStock {
  id         String           @id @default(uuid())
  businessId String // denormalised for fast tenant-scoped queries
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   BusinessLocation @relation("StockLocation", fields: [locationId], references: [id], onDelete: Cascade)

  onHand       Int @default(0) // physical units on shelf + back room
  reserved     Int @default(0) // committed to in-flight orders, not yet picked
  // Computed available = onHand - reserved (we don't store; query-time only)
  reorderPoint Int @default(0) // alert when onHand drops below this
  reorderQty   Int @default(0) // suggested re-order amount

  // Cost-price snapshot at last GRN. Used for stock-value reports +
  // accounting. Currency follows Business.defaultCurrency.
  unitCostMinor Int?

  // Optional per-stock metadata. Product.sku stays the central catalogue
  // SKU; these fields are specific to how one store/warehouse receives,
  // stores and picks the same product.
  supplierSku   String?
  localPickCode String?
  aisleCode     String?
  rackCode      String?
  shelfCode     String?
  binLocation   String? // legacy/free-form "Aisle 3 / Shelf B / Bin 12"
  expiresAt     DateTime? // earliest expiry across batches
  lastCountedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjustments InventoryAdjustment[]

  @@unique([productId, locationId])
  @@index([businessId, locationId])
  @@index([businessId, onHand])
  @@index([businessId, supplierSku])
  @@index([businessId, localPickCode])
}

// Audit row for every stock change. Drives the ledger view and
// reconciliation. Reasons cover the lifecycle: receipt (GRN), sale
// (order), transfer in/out, damage, theft, count adjustment.
model InventoryAdjustment {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockId    String
  stock      InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Signed delta — +12 for receipt, -3 for damaged, etc.
  delta  Int
  reason InventoryAdjustmentReason
  // Free-text note ("expired stock removed", "theft - aisle 4 cam footage saved")
  note   String?

  // Soft FK to whatever caused the change. Null for manual adjustments.
  // sourceType discriminates: "GRN", "ORDER", "TRANSFER", "RETURN", "MANUAL".
  sourceType String?
  sourceId   String?

  // Snapshot of stock state AFTER this adjustment (denormalised so the
  // ledger doesn't require recomputing across the whole audit chain).
  onHandAfter Int

  // Who did it (User.id). NULL for system / cron / webhook origins.
  actorUserId String?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([stockId, createdAt])
  @@index([sourceType, sourceId])
}

enum InventoryAdjustmentReason {
  GRN_RECEIPT // goods receipt note from supplier
  ORDER_PICK // committed to an order (reserve)
  ORDER_FULFILL // order shipped — reserved → out
  ORDER_CANCEL // reservation released
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_RESTOCK
  RETURN_SCRAP
  DAMAGE
  THEFT
  EXPIRY
  COUNT_ADJUSTMENT // physical count vs system mismatch
  PROMOTIONAL_GIVEAWAY
  OTHER
}

// ECOMMERCE multi-store (2026-05-11) — per-(product, location) override row.
//
// Why this exists:
//   - `ProductPrice` overrides price per CURRENCY, not per LOCATION.
//   - `InventoryStock` tracks per-location stock count, but a missing row
//     could mean either "not stocked yet" or "not sold here". This model
//     gives an explicit `isAvailable` flag so a store can opt out of a
//     product without deleting stock.
//   - Lets two stores in different cities sell the same SKU at different
//     prices (city-level cost-of-living, regional promos).
//
// Rules:
//   - Absent row OR isAvailable=true means the product is sold at the
//     location at the product's base price (Product.priceMinor) unless
//     `priceMinor` is set here.
//   - isAvailable=false hides the product from that location's storefront.
//   - priceMinor null = inherit Product.priceMinor.
//   - Admin "copy catalog from store X" creates rows in bulk.
model ProductLocationOverride {
  id         String           @id @default(uuid())
  businessId String // denormalised for fast tenant-scoped queries
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   BusinessLocation @relation("LocationProductOverride", fields: [locationId], references: [id], onDelete: Cascade)

  // Null = use Product.priceMinor / comparePriceMinor.
  priceMinor        Int?
  comparePriceMinor Int?

  // Hard availability flag — distinct from stock count.
  // false = "we don't sell this here", regardless of InventoryStock rows.
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([businessId, locationId, isAvailable])
  @@index([locationId, isAvailable])
}

// EcomRider — delivery-fleet member. One row per rider per tenant.
// Riders are USERS in the auth system (so they can log in to the rider
// app), with extended fleet-specific fields here. Some riders may be
// contractors without User rows — `userId` is optional for that case.
model EcomRider {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Optional link to User account — if set, the rider can log in.
  userId String?

  fullName String
  phone    String // E.164
  email    String?

  // Vehicle + license
  vehicleType        String // 'BIKE' | 'EBIKE' | 'VAN' | 'CYCLE' | 'WALKING'
  vehicleReg         String? // license plate
  licenseNo          String?
  licenseExpiresAt   DateTime?
  insuranceExpiresAt DateTime?

  // Default working location (the store the rider reports to)
  homeLocationId String?
  homeLocation   BusinessLocation? @relation("RiderHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)

  // Service-zone postcodes / area names this rider covers — JSON for v1
  // (full polygon zones land in Phase 2c via DeliveryZone).
  serviceZones Json @default("[]")

  status         RiderStatus @default(ACTIVE)
  // Cash float at start of shift, settled at end-of-day
  cashFloatMinor Int         @default(0)

  // Performance counters (denormalised — fast for leaderboard)
  totalDeliveries Int   @default(0)
  onTimeRate      Float @default(1.0) // 0–1
  avgRating       Float @default(0.0) // 0–5

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes                EcomDeliveryRoute[]
  deliveryRequests      EcomDeliveryRequest[]        @relation("DeliveryRequestRider")
  deliveryLocationPings EcomDeliveryLocationPing[]
  cashSettlements       EcomDeliveryCashSettlement[]
  shifts                EcomRiderShift[]

  @@index([businessId, status])
  @@index([homeLocationId])
}

enum RiderStatus {
  ACTIVE
  OFF_SHIFT
  ON_LEAVE
  SUSPENDED
  DEPARTED
}

// Rider shift/check-in ledger. `EcomRider.status` remains the quick roster
// state, while this table records operational attendance, cash float, and
// handover context for each rider app session.
model EcomRiderShift {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  riderId String
  rider   EcomRider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  locationId String?
  location   BusinessLocation? @relation("RiderShiftLocation", fields: [locationId], references: [id], onDelete: SetNull)

  status    EcomRiderShiftStatus @default(OPEN)
  startedAt DateTime             @default(now())
  endedAt   DateTime?

  startLat Float?
  startLng Float?
  endLat   Float?
  endLng   Float?

  cashFloatMinor  Int  @default(0)
  cashInHandMinor Int  @default(0)
  startBatteryPct Int?
  endBatteryPct   Int?

  startNote       String?
  endNote         String?
  startedByUserId String?
  endedByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, riderId, status])
  @@index([businessId, locationId, startedAt])
  @@index([businessId, status, startedAt])
}

enum EcomRiderShiftStatus {
  OPEN
  CLOSED
  VOID
}

// AapkaRider product core — one delivery request regardless of source.
// Sources can be native Sitepresso ecommerce orders, external API/POS systems,
// or staff-created manual/offline delivery jobs. Route/stop rows remain the
// dispatch batching layer; this row is the product-level delivery contract.
model EcomDeliveryRequest {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  locationId String?
  location   BusinessLocation? @relation("DeliveryRequestLocation", fields: [locationId], references: [id], onDelete: SetNull)

  // Native ecommerce linkage is optional so API/manual deliveries can exist
  // without a Sitepresso order.
  orderId String?
  order   Order?  @relation("DeliveryRequestOrder", fields: [orderId], references: [id], onDelete: SetNull)

  source    DeliveryRequestSource @default(MANUAL)
  sourceRef String? // merchant/POS/external order id; unique per source when present
  channel   String? // 'sitepresso', 'shopify', 'pos', 'whatsapp', etc.

  status   DeliveryRequestStatus @default(PENDING)
  priority String                @default("NORMAL") // NORMAL | URGENT | SCHEDULED

  riderId String?
  rider   EcomRider? @relation("DeliveryRequestRider", fields: [riderId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String?
  customerEmail String?

  pickupName       String?
  pickupAddress1   String?
  pickupAddress2   String?
  pickupCity       String?
  pickupState      String?
  pickupPostalCode String?
  pickupCountry    String?
  pickupLat        Float?
  pickupLng        Float?

  dropoffName       String?
  dropoffAddress1   String?
  dropoffAddress2   String?
  dropoffCity       String?
  dropoffState      String?
  dropoffPostalCode String?
  dropoffCountry    String?
  dropoffLat        Float?
  dropoffLng        Float?

  items       Json    @default("[]")
  packageNote String?

  deliverySlotLabel  String?
  requestedPickupAt  DateTime?
  requestedDropoffAt DateTime?
  promisedAt         DateTime?

  currency           String  @default("INR")
  paymentMethod      String? // 'cod' | 'online' | 'manual' | null
  cashToCollectMinor Int     @default(0)
  cashCollectedMinor Int     @default(0)
  cashReceivedMinor  Int     @default(0)
  cashChangeDueMinor Int     @default(0)
  paymentReference   String?
  paymentNote        String?

  trackingToken String @unique @default(uuid())

  proofPhotoUrl           String?
  proofSignatureUrl       String?
  proofOtp                String?
  customerRating          Int?
  customerFeedback        String?
  failureReason           String?
  attemptCount            Int       @default(0)
  nextAttemptAt           DateTime?
  exceptionCode           String?
  exceptionStatus         String?
  exceptionNote           String?
  exceptionOpenedAt       DateTime?
  exceptionEscalatedAt    DateTime?
  exceptionResolvedAt     DateTime?
  exceptionResolutionNote String?
  notes                   String?

  assignedAt  DateTime?
  pickedUpAt  DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  returnedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeStops    EcomDeliveryRouteStop[]
  events        EcomDeliveryRequestEvent[]
  locationPings EcomDeliveryLocationPing[]

  @@unique([businessId, source, sourceRef])
  @@index([businessId, status, createdAt])
  @@index([businessId, locationId, status])
  @@index([businessId, riderId, status])
  @@index([businessId, exceptionStatus, createdAt])
  @@index([businessId, exceptionCode, createdAt])
  @@index([orderId])
  @@index([sourceRef])
}

enum DeliveryRequestSource {
  SITEPRESSO
  API
  MANUAL
}

enum DeliveryRequestStatus {
  PENDING
  READY_FOR_DISPATCH
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  ATTEMPTED_FAILED
  CANCELLED
  RETURNED
}

// EcomDeliveryRequestEvent — delivery-scoped audit trail for manual/API/
// Sitepresso delivery jobs. This powers merchant support, customer tracking,
// and webhook/debug timelines without requiring a native ecommerce order.
model EcomDeliveryRequestEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  deliveryRequestId String
  deliveryRequest   EcomDeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)

  // 'CREATED' | 'STATUS_CHANGED' | 'RIDER_ASSIGNED' |
  // 'PROOF_UPLOADED' | 'PAYMENT_CAPTURED' | 'NOTE_ADDED'
  kind String

  fromStatus String?
  toStatus   String?

  message String?
  payload Json?

  actorUserId String?
  // 'ADMIN' | 'API' | 'RIDER' | 'CUSTOMER' | 'WEBHOOK' | 'CRON' | 'SYSTEM'
  actorSource String  @default("SYSTEM")

  createdAt DateTime @default(now())

  @@index([businessId, deliveryRequestId, createdAt])
  @@index([deliveryRequestId, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, kind, createdAt])
}

// EcomDeliveryRoute — a batched run of multiple orders assigned to one
// rider. Created when dispatcher hits "Auto-batch" or manually drags
// orders together. Status moves PENDING → DISPATCHED → COMPLETED.
model EcomDeliveryRoute {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String // dispatch origin
  location   BusinessLocation @relation("RouteOrigin", fields: [locationId], references: [id], onDelete: Cascade)

  riderId String?
  rider   EcomRider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  // Sequential per-tenant code: "RTE-20260501-001"
  code String @unique

  status       DeliveryRouteStatus @default(PENDING)
  // ISO datetimes
  scheduledAt  DateTime?
  dispatchedAt DateTime?
  completedAt  DateTime?

  // Snapshot at dispatch — total stops, total distance, planned ETA
  totalStops          Int  @default(0)
  totalDistanceMeters Int?
  plannedDurationMin  Int?

  // Cash to collect across all COD orders on this route
  cashToCollectMinor Int @default(0)
  cashCollectedMinor Int @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops         EcomDeliveryRouteStop[]
  locationPings EcomDeliveryLocationPing[]

  @@index([businessId, status, scheduledAt])
  @@index([locationId, scheduledAt])
  @@index([riderId, scheduledAt])
}

enum DeliveryRouteStatus {
  PENDING // created, not yet dispatched
  DISPATCHED // rider on the road
  COMPLETED
  CANCELLED
}

// One stop on a delivery route. `sequence` is the visit order (1-based).
// `arrivedAt` / `deliveredAt` populate as the rider's app pings updates.
model EcomDeliveryRouteStop {
  id                String               @id @default(uuid())
  routeId           String
  route             EcomDeliveryRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  // Each stop = one order. Soft FK to Order; if order cancelled, stop
  // stays for the historical audit but linked Order is null.
  orderId           String?
  deliveryRequestId String?
  deliveryRequest   EcomDeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: SetNull)
  sequence          Int

  // Address snapshot for offline rider apps
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  lat          Float?
  lng          Float?

  // Per-stop status independent of route status
  status            DeliveryStopStatus @default(PENDING)
  // ISO datetimes
  arrivedAt         DateTime?
  deliveredAt       DateTime?
  // Photo proof (S3 URL) + signature (data URL or S3)
  proofPhotoUrl     String?
  proofSignatureUrl String?
  // Customer rating + free-text feedback collected at door
  customerRating    Int?
  customerFeedback  String?

  // For COD — minor units collected at this stop
  cashCollectedMinor Int     @default(0)
  cashReceivedMinor  Int     @default(0)
  cashChangeDueMinor Int     @default(0)
  paymentReference   String?
  paymentNote        String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationPings EcomDeliveryLocationPing[]

  @@unique([routeId, sequence])
  @@index([orderId])
  @@index([deliveryRequestId])
}

enum DeliveryStopStatus {
  PENDING
  EN_ROUTE
  ARRIVED
  DELIVERED
  ATTEMPTED_FAILED // no-one home / refused / etc.
  SKIPPED
}

// EcomDeliveryLocationPing — high-volume rider GPS points for in-house
// delivery tracking. These are separate from audit events so live tracking can
// retain dense operational data while support timelines stay readable.
model EcomDeliveryLocationPing {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  deliveryRequestId String?
  deliveryRequest   EcomDeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: SetNull)

  riderId String?
  rider   EcomRider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  routeId String?
  route   EcomDeliveryRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  routeStopId String?
  routeStop   EcomDeliveryRouteStop? @relation(fields: [routeStopId], references: [id], onDelete: SetNull)

  lat                  Float
  lng                  Float
  accuracyMeters       Float?
  headingDegrees       Float?
  speedMetersPerSecond Float?
  batteryPct           Int?
  source               String @default("RIDER_APP")

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([deliveryRequestId, createdAt])
  @@index([riderId, createdAt])
  @@index([routeId, createdAt])
  @@index([routeStopId, createdAt])
}

// Rider cash handover ledger for COD/in-person collections. A settlement
// references the delivered delivery-request ids it closes, so finance can
// void a settlement without changing the immutable delivery events.
model EcomDeliveryCashSettlement {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  riderId String?
  rider   EcomRider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  locationId String?
  location   BusinessLocation? @relation("DeliveryCashSettlementLocation", fields: [locationId], references: [id], onDelete: SetNull)

  status         EcomDeliveryCashSettlementStatus @default(SETTLED)
  settlementDate DateTime                         @default(now())
  fromAt         DateTime
  toAt           DateTime

  currency          String   @default("INR")
  expectedCashMinor Int      @default(0)
  countedCashMinor  Int      @default(0)
  varianceMinor     Int      @default(0)
  deliveryCount     Int      @default(0)
  deliveryIds       String[] @default([])

  reference       String?
  notes           String? @db.Text
  settledByUserId String?

  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, riderId, settlementDate])
  @@index([businessId, locationId, settlementDate])
  @@index([businessId, status, createdAt])
}

enum EcomDeliveryCashSettlementStatus {
  DRAFT
  SETTLED
  VOID
}

// EcomDeliverySlot — a configurable time window per location. The owner
// defines slots in Settings → Delivery slots; customers pick one at
// checkout. Capacity is per-slot; surcharge supports peak-hour pricing.
model EcomDeliverySlot {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String
  location   BusinessLocation @relation("SlotLocation", fields: [locationId], references: [id], onDelete: Cascade)

  // Either recurring (dayOfWeek + start/end times) or one-off (specificDate).
  // Exactly one of `dayOfWeek` or `specificDate` is set per row.
  dayOfWeek    Int? // 0=Sun … 6=Sat
  specificDate DateTime? // for ad-hoc holiday slots / peak-day overrides

  startTime String // "08:00" — 24h "HH:mm" local to the location's timezone
  endTime   String // "10:00"

  // Cap on number of orders that can be accepted in this window
  capacity Int @default(20)

  // Surcharge applied on top of standard delivery fee for this slot.
  // 0 = no surcharge (standard slot). > 0 = peak / express slot.
  surchargeMinor Int              @default(0)
  // Type tag for filter UI — STANDARD / EXPRESS / SAME_DAY / NEXT_DAY / RECURRING
  slotType       DeliverySlotType @default(STANDARD)

  // Free delivery threshold specific to this slot — overrides
  // location-default. 0 = inherit from location settings.
  freeDeliveryThresholdMinor Int @default(0)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings EcomDeliverySlotBooking[]

  @@index([businessId, locationId, dayOfWeek])
  @@index([businessId, locationId, specificDate])
  @@index([locationId, isActive])
}

enum DeliverySlotType {
  STANDARD
  EXPRESS // 60-min premium
  SAME_DAY
  NEXT_DAY
  SCHEDULED
}

// EcomDeliverySlotBooking — concrete booking of a slot for a specific
// date by a specific order. Capacity enforcement counts rows here. One
// row per (slotId, deliveryDate, orderId).
model EcomDeliverySlotBooking {
  id           String           @id @default(uuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slotId       String
  slot         EcomDeliverySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  // The actual delivery date the customer picked — recurring slot rows
  // need this to disambiguate "Mon 08:00–10:00" between weeks.
  deliveryDate DateTime // 00:00 local at location, used as a date key
  // Soft FK to Order; the booking holds the slot until the order is paid.
  orderId      String?

  // Snapshot of the surcharge applied at checkout
  surchargeAppliedMinor Int @default(0)

  status SlotBookingStatus @default(HELD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slotId, deliveryDate, orderId])
  @@index([businessId, deliveryDate])
  @@index([slotId, deliveryDate])
  @@index([orderId])
}

enum SlotBookingStatus {
  HELD // capacity reserved while customer is in checkout
  CONFIRMED // order paid, slot locked
  RELEASED // checkout abandoned / order cancelled
}

// =============================================================================
// ECOMMERCE Path B — Phase 2b (2026-05-01) — Returns, Reviews, Banners, CMS,
//                                            OrderEvents
// =============================================================================
//
// Customer-facing operations layer + storefront content. Notification
// templates use the existing global `MessageTemplate` model with
// vertical='ECOMMERCE' — no separate `EcomNotificationTemplate` needed.
// Coupons reuse the existing `Coupon` model.

// ─── Returns ──────────────────────────────────────────────────────────────

model EcomReturn {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Sequential per-tenant code: "RET-20260501-001"
  code       String   @unique

  // Soft FK — order may be hard-deleted by GDPR purge but the return
  // record stays (regulatory). Snapshot fields below preserve context.
  orderId   String?
  orderCode String? // snapshot of order code at request time

  // Snapshot — customer ID may go null on GDPR delete
  customerId    String?
  customerName  String
  customerEmail String

  // Lifecycle: REQUESTED → APPROVED → COLLECTED → REFUNDED → CLOSED
  // (REJECTED is terminal from REQUESTED)
  status EcomReturnStatus @default(REQUESTED)

  reasonCategory EcomReturnReason
  reasonNote     String?

  // Refund routing
  refundMethod      String? // 'ORIGINAL_PAYMENT' | 'STORE_CREDIT' | 'CASH_AT_PICKUP'
  totalRefundMinor  Int       @default(0)
  refundedAt        DateTime?
  refundProviderRef String? // gateway reference

  // Reverse logistics
  pickupAddress  Json?
  pickupSlotId   String? // soft FK to EcomDeliverySlot for collection
  collectedAt    DateTime?
  closedByUserId String?
  closedAt       DateTime?

  // Photo / video evidence URLs (S3) — uploaded by customer
  evidenceUrls Json @default("[]")

  // Internal admin notes (not shown to customer)
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  EcomReturnItem[]
  events EcomReturnEvent[]

  @@index([businessId, status, createdAt])
  @@index([orderId])
  @@index([customerEmail])
}

enum EcomReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COLLECTED
  REFUNDED
  CLOSED
}

enum EcomReturnReason {
  DAMAGED
  WRONG_ITEM
  EXPIRED
  CHANGED_MIND
  POOR_QUALITY
  NOT_AS_DESCRIBED
  ARRIVED_LATE
  OTHER
}

model EcomReturnItem {
  id       String     @id @default(uuid())
  returnId String
  return   EcomReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String?

  productId         String?
  productName       String
  productSlug       String?
  quantity          Int
  unitPriceMinor    Int // snapshot at order time
  refundAmountMinor Int // computed at approval, may differ from unit*qty

  disposition EcomReturnDisposition @default(PENDING)

  reason EcomReturnReason?
  note   String?

  // Linked InventoryAdjustment when restocked or scrapped
  adjustmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnId])
  @@index([productId])
}

enum EcomReturnDisposition {
  PENDING
  RESTOCK
  SCRAP
  RETURN_TO_SUPPLIER
  HOLD_FOR_INSPECTION
}

// Audit row for each state change on a return — distinct from
// InventoryAdjustment (which tracks stock changes).
model EcomReturnEvent {
  id          String            @id @default(uuid())
  returnId    String
  return      EcomReturn        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  // 'STATUS_CHANGE' | 'NOTE_ADDED' | 'EVIDENCE_UPLOADED' | 'REFUND_ISSUED'
  kind        String
  fromStatus  EcomReturnStatus?
  toStatus    EcomReturnStatus?
  message     String?
  actorUserId String?
  createdAt   DateTime          @default(now())

  @@index([returnId, createdAt])
}

// P3 — Customer wallet / store credit. One row per (businessId, customerId).
// balanceMinor is the cached running balance; every mutation goes through
// walletLib which also writes a WalletLedgerEntry, so the ledger is the
// source of truth and balanceMinor can be reconstructed by summing entries.
// Refunds with feature `walletCredit` enabled route here instead of calling
// the payment gateway (instant, fee-free, sticky).
model CustomerWallet {
  id           String              @id @default(uuid())
  businessId   String
  customerId   String
  balanceMinor Int                 @default(0)
  currency     String              @default("INR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  entries      WalletLedgerEntry[]

  @@unique([businessId, customerId])
  @@index([businessId])
}

// P7 — Persistent shopping list. Customers add over the week, then push
// the whole list into the cart in one go. Each customer can have multiple
// named lists ("My list" is the default seeded by the API on first use).
// Items aren't constrained to currently-published products at insert time
// — the list survives a brief delisting; the "add to cart" path silently
// skips items that aren't purchasable today.
model CustomerShoppingList {
  id         String             @id @default(uuid())
  businessId String
  customerId String
  name       String             @default("My list")
  isDefault  Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  items      ShoppingListItem[]

  @@index([businessId, customerId])
}

model ShoppingListItem {
  id        String               @id @default(uuid())
  listId    String
  list      CustomerShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId String
  variantId String?
  quantity  Int                  @default(1)
  note      String?
  createdAt DateTime             @default(now())

  @@unique([listId, productId, variantId])
  @@index([productId])
}

// P11 — "Got it wrong" report. One-tap customer report against a specific
// order line — damaged / wrong / missing / quality / other — with optional
// photo + free text. When the requested credit is at or under the per-feature
// autoCreditMaxMinor cap, walletLib.credit() runs immediately and the report
// goes straight to RESOLVED (AUTO_CREDITED). Above the cap, status stays
// PENDING for admin review.
model OrderIssueReport {
  id             String    @id @default(uuid())
  businessId     String
  orderId        String
  orderItemId    String?
  customerId     String?
  customerEmail  String?
  // 'DAMAGED' | 'WRONG_ITEM' | 'MISSING' | 'QUALITY' | 'OTHER'
  reasonCode     String
  description    String?
  photoUrl       String?
  // 'PENDING' | 'AUTO_CREDITED' | 'APPROVED' | 'REJECTED'
  status         String    @default("PENDING")
  requestedMinor Int       @default(0)
  creditedMinor  Int       @default(0)
  walletEntryId  String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId, status, createdAt])
  @@index([orderId])
}

// P9 — Recipes that turn into a cart. Admin authors a recipe (title, image,
// description) and links existing products as ingredients with target
// quantities. Storefront renders a recipe card with "Add all ingredients
// to cart" — products that have been delisted are silently skipped at add
// time. Lifts average order value + solves "what to cook tonight".
model Recipe {
  id          String             @id @default(uuid())
  businessId  String
  title       String
  slug        String
  description String?
  imageUrl    String?            @db.Text
  servings    Int?
  prepMinutes Int?
  cookMinutes Int?
  isPublished Boolean            @default(false)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  ingredients RecipeIngredient[]

  @@unique([businessId, slug])
  @@index([businessId, isPublished, sortOrder])
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String
  variantId String?
  quantity  Int     @default(1)
  // Free-text alongside the product link (e.g. "use ripe ones", "or substitute curry leaves").
  note      String?
  sortOrder Int     @default(0)

  @@index([recipeId, sortOrder])
  @@index([productId])
}

// P6 — Customer-level Subscribe & Save. Distinct from the Sitepresso
// platform Subscription model (the tenant's SaaS plan) — this is the
// shopper subscribing to a recurring grocery item ("milk every Tuesday").
// Status: ACTIVE → PAUSED → ACTIVE → CANCELLED (terminal). The order-
// generation cron consumes nextDeliveryAt and stamps lastDeliveryAt.
model CustomerSubscription {
  id             String    @id @default(uuid())
  businessId     String
  customerId     String
  productId      String
  variantId      String?
  quantity       Int       @default(1)
  // 'WEEKLY' | 'MONTHLY'. Repeat every N weeks/months.
  intervalKind   String    @default("WEEKLY")
  intervalCount  Int       @default(1)
  // Per-line discount applied at order-generation time.
  discountPct    Int       @default(5)
  // 'ACTIVE' | 'PAUSED' | 'CANCELLED'.
  status         String    @default("ACTIVE")
  nextDeliveryAt DateTime?
  lastDeliveryAt DateTime?
  pausedUntil    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId, customerId])
  @@index([businessId, status, nextDeliveryAt])
}

model WalletLedgerEntry {
  id                String         @id @default(uuid())
  walletId          String
  wallet            CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  businessId        String
  customerId        String
  // Signed amount in minor units — positive for credits, negative for debits.
  deltaMinor        Int
  balanceAfterMinor Int
  // 'REFUND_CREDIT' | 'ORDER_DEBIT' | 'ADMIN_ADJUSTMENT' | 'WELCOME_BONUS' | 'EXPIRY'
  reason            String
  refType           String? // 'order' | 'return' | 'admin'
  refId             String? // orderId, returnId, etc.
  note              String?
  createdAt         DateTime       @default(now())

  @@index([walletId, createdAt])
  @@index([businessId, createdAt])
}

// ─── Reviews ──────────────────────────────────────────────────────────────

// EcomReview — customer review on a product (and/or rider). Separate from
// `BlogComment` because the ECOMMERCE flow has its own moderation,
// photo-upload, and merchant-reply semantics.
model EcomReview {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // What's being reviewed
  productId String?
  riderId   String? // when set, the review targets the rider
  // The order that prompted this review (drives "verified buyer" badge)
  orderId   String?

  // Reviewer
  customerId    String?
  customerName  String // snapshot (back-compat for guest reviews)
  customerEmail String? // snapshot

  // Content
  rating    Int // 1..5
  title     String?
  body      String? @db.Text
  // Photo / video URLs (S3) uploaded by customer
  mediaUrls Json    @default("[]")

  // Moderation
  status                EcomReviewStatus @default(PENDING)
  flagReason            String?
  // Merchant reply (single thread; if more needed, normalise later)
  merchantReply         String?          @db.Text
  merchantReplyByUserId String?
  merchantReplyAt       DateTime?

  // Helpfulness counters (denormalised — fast reads)
  helpfulCount   Int @default(0)
  unhelpfulCount Int @default(0)

  // Verified-buyer flag — set when orderId resolves to a paid order
  verifiedBuyer Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, productId, status, createdAt])
  @@index([businessId, riderId, status, createdAt])
  @@index([businessId, status, createdAt])
}

enum EcomReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

// ─── Banners (storefront promotional surfaces) ────────────────────────────

// EcomBanner — distinct from the existing `NotificationBanner` (admin-side
// messaging). These are storefront-facing creatives.
model EcomBanner {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  placement EcomBannerPlacement
  sortOrder Int                 @default(0)

  // Optional location scope — null = all locations
  locationId String?
  // 'ALL' | 'GUEST' | 'LOGGED_IN' | 'NEW' | 'RETURNING' | 'VIP'
  audience   String  @default("ALL")

  startsAt     DateTime?
  endsAt       DateTime?
  // Optional time-of-day window (e.g. "weekdays 09:00–17:00")
  scheduleJson Json? // { dow: [1,2,3,4,5], startTime:"09:00", endTime:"17:00" }

  // Creative
  desktopImageUrl String?
  mobileImageUrl  String?
  altText         String?
  headline        String?
  subheadline     String?

  // Click target
  ctaLabel       String?
  // 'PRODUCT' | 'CATEGORY' | 'PAGE' | 'URL' | 'NONE'
  linkType       String  @default("NONE")
  linkProductId  String?
  linkCategoryId String?
  linkPageId     String?
  linkUrl        String?

  // A/B test bucket
  groupKey String?

  isActive Boolean @default(true)

  // Counters (denormalised — incremented from analytics events)
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, placement, isActive, sortOrder])
  @@index([businessId, locationId])
  @@index([businessId, startsAt, endsAt])
}

enum EcomBannerPlacement {
  HOMEPAGE_HERO
  HOMEPAGE_STRIP
  CATEGORY_HERO
  CART_UPSELL
  ACCOUNT_OFFER
  CHECKOUT_BANNER
}

// ─── Storefront CMS blocks ────────────────────────────────────────────────

// EcomCmsBlock — content blocks rendered on storefront pages. Different
// from `BusinessPage` (whole pages) — these are reusable sections.
model EcomCmsBlock {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Slot key — where this block surfaces:
  //   'home.hero', 'home.featured', 'category.<slug>.intro', …
  slotKey String

  blockType EcomCmsBlockType
  sortOrder Int              @default(0)

  // Schema-loose payload — shape depends on `blockType`.
  payload Json @default("{}")

  // Targeting
  locationId    String?
  audience      String    @default("ALL")
  startsAt      DateTime?
  endsAt        DateTime?
  // Per-locale variants — { "en": {...}, "hi": {...} }
  i18nOverrides Json?

  // Workflow
  status            EcomCmsBlockStatus @default(DRAFT)
  publishedAt       DateTime?
  publishedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, slotKey, status, sortOrder])
  @@index([businessId, status])
}

enum EcomCmsBlockType {
  HERO
  FEATURED_COLLECTION
  BESTSELLERS_AUTO
  EDITORIAL_RICHTEXT
  RECIPE_LINKED
  TESTIMONIAL_STRIP
  CATEGORY_GRID
  COUPON_CALLOUT
}

enum EcomCmsBlockStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// ─── Per-order event log ──────────────────────────────────────────────────

// EcomOrderEvent — audit row for every state transition or admin action
// on an Order. Drives the "Order timeline" UI on the order-detail page.
// Distinct from the global ActivityEvent (Phase 2c) which spans the whole
// tenant — that's the cross-cutting log; this is order-scoped.
model EcomOrderEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String

  // 'CREATED' | 'STATUS_CHANGED' | 'PAYMENT_CAPTURED' | 'REFUND_ISSUED' |
  // 'NOTE_ADDED' | 'ITEM_REPLACED' | 'SLOT_CHANGED' | 'ASSIGNED_TO_RIDER' |
  // 'PROOF_OF_DELIVERY_UPLOADED' | 'CUSTOMER_CONTACTED' |
  // Pick-exception flow (grocery): 'ITEM_WEIGHED' | 'ITEM_SUBSTITUTED' |
  // 'ITEM_SHORTED' | 'SUBSTITUTION_PROPOSED' | 'SUBSTITUTION_ACCEPTED' |
  // 'SUBSTITUTION_REJECTED' | 'ORDER_TOTAL_ADJUSTED' | 'PARTIAL_REFUND_ISSUED'
  kind String

  fromStatus String?
  toStatus   String?

  message String?
  payload Json?

  // Actor (User.id) — null for customer-driven or system events
  actorUserId String?
  // 'ADMIN' | 'CUSTOMER' | 'WEBHOOK' | 'CRON' | 'SYSTEM'
  actorSource String  @default("ADMIN")

  createdAt DateTime @default(now())

  @@index([businessId, orderId, createdAt])
  @@index([orderId, createdAt])
}

// =============================================================================
// ECOMMERCE Path B — Phase 2c (2026-05-01) — Geo, Suppliers, GRNs, Transfers,
//                                            ActivityEvent
// =============================================================================

// ─── Service-area geography ───────────────────────────────────────────────

// EcomServiceCity — a city the tenant ships to. Distinct from
// `BusinessLocation` (a physical store). One service city can be served
// by many physical locations. Drives city-level brand overrides.
model EcomServiceCity {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String // "Mumbai", "Bengaluru", "London"
  slug        String // "mumbai", "bengaluru", "london"
  countryCode String // ISO-3166-1 alpha-2: 'IN', 'GB', 'US'
  // Optional region/state — "Maharashtra", "Karnataka", "Greater London"
  region      String?
  // Default timezone for the city (IANA) — used for slot rendering
  timezone    String?

  // Launch state: 'LIVE' | 'COMING_SOON' | 'PAUSED'
  status String @default("LIVE")

  // Tax + currency binding — overrides Business defaults at the city level
  taxJurisdiction String? // 'UK_VAT' | 'IN_GST' | 'EU_VAT' | 'NONE'
  currency        String? // ISO 4217 — when null, inherits from Business
  defaultLocale   String? // BCP-47 — 'en', 'hi', 'en-GB'

  // Optional city-level brand override (logo / hero copy / colour).
  brandOverrides Json?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones EcomDeliveryZone[]

  @@unique([businessId, slug])
  @@index([businessId, isActive, sortOrder])
}

// EcomDeliveryZone — a service-area inside a city defined by a list of
// postcodes (UK style) or a polygon. Multiple zones per city, each with
// its own delivery fee + free-delivery threshold.
model EcomDeliveryZone {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cityId     String
  city       EcomServiceCity @relation(fields: [cityId], references: [id], onDelete: Cascade)

  // Optional store assignment — when set, this zone is served by a
  // specific location. Null = any location in the city can fulfil.
  primaryLocationId String?

  name String // "Andheri West", "EC1V postcodes", "Inner ring"
  slug String // unique per (businessId, cityId)

  // Definition — exactly one of the two should be populated:
  //   - postcodes: array of strings (UK / IN style)
  //   - polygon: GeoJSON-like array of [lng, lat] pairs forming a closed loop
  postcodes Json  @default("[]")
  polygon   Json?

  // Pricing
  deliveryFeeMinor           Int @default(0)
  freeDeliveryThresholdMinor Int @default(0)
  // Express surcharge if customer picks an EXPRESS slot at checkout
  expressSurchargeMinor      Int @default(0)

  // Capacity / SLA — 0 = unlimited
  maxInFlightOrders Int  @default(0)
  promiseMinutes    Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, cityId, slug])
  @@index([businessId, isActive])
  @@index([cityId, isActive])
  @@index([primaryLocationId])
}

// EcomPickupLocation — physical store / counter where buyers can collect
// "Click & Collect" orders. Distinct from EcomServiceCity (city-level
// service area for delivery). One row per pickup point; the buyer picks
// from the active list at checkout when fulfillmentType=PICKUP.
//
// Hours are stored as a JSON map keyed by weekday number ("0".."6", Sun..Sat)
// with `{ open: "HH:MM", close: "HH:MM" }` or `null` for closed days. We
// surface "Open today until X" on the storefront from this.
//
// prepTimeMinutes is the buyer-facing "Ready in ~30 min" promise — admin
// can override per-location for slower kitchens / queues. The order stays
// PACKING until staff flips it to READY_FOR_PICKUP, which triggers the
// pickup-ready email + SMS to the buyer.
model EcomPickupLocation {
  id         String            @id @default(uuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   BusinessLocation? @relation("PickupBusinessLocation", fields: [locationId], references: [id], onDelete: SetNull)

  name         String // "Indiranagar Branch", "Mall Counter", "Drive-Thru"
  // Physical address — required so the buyer knows where to come.
  addressLine1 String
  addressLine2 String?
  city         String
  region       String? // state / county
  postalCode   String
  countryCode  String // ISO-3166-1 alpha-2

  // Optional map pin — if provided, the storefront renders a Google-Maps-
  // style mini-map and a "Get directions" link.
  latitude  Float?
  longitude Float?

  // Contact for the buyer — shown on the pickup confirmation card so the
  // buyer can call ahead if they're running late or can't find the door.
  contactPhone String?
  contactEmail String?

  // Opening hours — JSON: { "0": { open: "10:00", close: "21:00" }, "1": ... }
  // Null entry = closed that day. Empty object = open 24/7 (rare but allowed).
  hours Json @default("{}")

  // Estimated time between order placement and "ready for pickup". Shown
  // on the storefront ("Usually ready in 30 min") and used as a default
  // for the auto-suggested pickup time.
  prepTimeMinutes Int @default(30)

  // Free-text instructions shown on confirmation: "Park in B2, ask for
  // counter 5", "Use the side door after 9 PM", etc.
  pickupInstructions String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([businessId, isActive, sortOrder])
  @@index([businessId, locationId, isActive])
}

// ProductBrandFamily — the corporate parent that owns one or more product
// brands. e.g. Unilever (family) → Surf, Dove, Lux, Lipton (brands).
// Pre-seeded per country at business setup so a fresh seller doesn't have
// to type the catalog from scratch (see brandCatalog.js).
model ProductBrandFamily {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String // "Unilever", "Procter & Gamble", "Fonterra"
  slug        String // "unilever" — unique per business
  logoUrl     String?
  description String?
  // Country code the family was seeded from (when applicable). Lets the
  // admin filter the picker to "show me only IN brands" if they sell into
  // multiple markets. NULL for hand-added families.
  countryCode String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brands   ProductBrand[]
  isSample Boolean        @default(false)

  @@unique([businessId, slug])
  @@index([businessId, isActive, sortOrder])
  @@index([businessId, countryCode])
}

// ProductBrand — the brand a buyer recognises on the shelf. Belongs to
// at most one family (NULL family = independent brand). Products soft-FK
// to a brand row; the free-text `Product.brand` column stays as the
// denormalized snapshot so a brand rename doesn't rewrite order history.
model ProductBrand {
  id            String              @id @default(uuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brandFamilyId String?
  brandFamily   ProductBrandFamily? @relation(fields: [brandFamilyId], references: [id], onDelete: SetNull)
  name          String // "Surf", "Dove", "Pampers"
  slug          String // "surf" — unique per business
  logoUrl       String?
  description   String?
  // Mirror the family's countryCode so a seller can quickly filter the
  // picker. Independent brands (no family) carry their own countryCode.
  countryCode   String?
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  products Product[]
  isSample Boolean   @default(false)

  @@unique([businessId, slug])
  @@index([businessId, brandFamilyId])
  @@index([businessId, isActive, sortOrder])
  @@index([businessId, countryCode])
}

// ─── Suppliers + goods receipts ───────────────────────────────────────────

model EcomSupplier {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  email       String?
  phone       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?

  // Tax — UK VAT, IN GSTIN, etc.
  taxIdType String? // 'UK_VAT' | 'IN_GST' | 'EU_VAT' | 'OTHER'
  taxId     String?

  // Banking — encrypted at rest in app code
  bankAccountName   String?
  bankAccountNumber String?
  bankSortCode      String?
  bankIfsc          String?

  // Default payment terms — Net 30, Net 7, Cash on receipt
  paymentTerms String?

  // Pricing currency for this supplier
  currency String? // ISO 4217

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceiptNotes EcomGoodsReceiptNote[]

  @@index([businessId, isActive])
  @@index([businessId, name])
}

// EcomGoodsReceiptNote (GRN) — record of stock received from a supplier
// at a specific location on a specific date.
model EcomGoodsReceiptNote {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Sequential per-tenant code: "GRN-20260501-001"
  code       String   @unique

  supplierId String?
  supplier   EcomSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  locationId String // where the goods were received
  receivedAt DateTime

  supplierInvoiceNo String?
  purchaseOrderRef  String?
  invoiceTotalMinor Int     @default(0)

  // 'DRAFT' | 'POSTED' | 'CANCELLED' — Posted = stock added to InventoryStock
  status         String    @default("DRAFT")
  postedAt       DateTime?
  postedByUserId String?

  attachmentUrl String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items EcomGoodsReceiptItem[]

  @@index([businessId, status, receivedAt])
  @@index([locationId, receivedAt])
  @@index([supplierId])
}

// One line per SKU received on a GRN. quantityReceived may differ from
// quantityOrdered (over-receipt / shortage). On POSTING the GRN we
// generate one InventoryAdjustment per item with reason=GRN_RECEIPT.
model EcomGoodsReceiptItem {
  id    String               @id @default(uuid())
  grnId String
  grn   EcomGoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)

  productId   String?
  // Snapshot — preserves what was received even if product is later renamed
  productName String
  productSku  String?

  quantityOrdered  Int @default(0) // from PO; 0 = ad-hoc receipt
  quantityReceived Int

  // Per-unit cost paid (minor units, supplier currency)
  unitCostMinor  Int @default(0)
  taxMinor       Int @default(0)
  lineTotalMinor Int @default(0)

  // Batch / expiry tracking
  batchNumber String?
  expiresAt   DateTime?

  // Linked InventoryAdjustment created on GRN posting
  adjustmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grnId])
  @@index([productId])
}

// ─── Inter-location inventory transfers ──────────────────────────────────

// EcomInventoryTransfer — moves stock from one BusinessLocation to another.
// Two-leg lifecycle: SHIPPED at origin (decrement onHand), RECEIVED at
// destination (increment onHand). Each leg generates one InventoryAdjustment.
model EcomInventoryTransfer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Sequential per-tenant code: "TRF-20260501-001"
  code       String   @unique

  fromLocationId String
  toLocationId   String

  // 'DRAFT' | 'IN_TRANSIT' | 'RECEIVED' | 'CANCELLED'
  status String @default("DRAFT")

  // Optional rider carrying it (cross-store own-fleet transfer)
  riderId String?

  shippedAt  DateTime?
  receivedAt DateTime?

  initiatedByUserId String?
  receivedByUserId  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items EcomInventoryTransferItem[]

  @@index([businessId, status, shippedAt])
  @@index([fromLocationId, shippedAt])
  @@index([toLocationId, receivedAt])
  @@index([riderId])
}

model EcomInventoryTransferItem {
  id         String                @id @default(uuid())
  transferId String
  transfer   EcomInventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId   String?
  productName String
  productSku  String?

  quantityShipped  Int
  quantityReceived Int @default(0) // populated on receive leg; may differ on shortage

  // Linked adjustments — ship leg + receive leg
  shipAdjustmentId    String?
  receiveAdjustmentId String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transferId])
  @@index([productId])
}

// ─── Cross-cutting activity log ──────────────────────────────────────────

// EcomActivityEvent — global audit log for the ECOMMERCE admin. Drives
// the Activity Log panel. Distinct from `EcomOrderEvent` (order-scoped)
// and `EcomReturnEvent` (return-scoped) — those are subject-specific
// timelines; this is the cross-cutting "who did what when."
//
// Events flow in from middleware on mutation routes. Retention is 90
// days by default; security events (auth.*, settings.*) kept 2 years.
model EcomActivityEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Stable code in dot.notation: 'order.created', 'inventory.adjusted',
  // 'auth.login', 'auth.login_failed', 'role.assigned', 'staff.invited'
  eventKey String
  // Functional area: 'orders' | 'catalogue' | 'inventory' | 'customers' |
  //                  'finance' | 'auth' | 'system' | 'marketing'
  area     String
  // Severity for filter UI: 'INFO' | 'WARNING' | 'CRITICAL' | 'SECURITY'
  severity String @default("INFO")

  actorUserId String?
  actorName   String? // snapshot — survives user delete
  actorRole   String?
  // 'ADMIN' | 'CUSTOMER' | 'WEBHOOK' | 'CRON' | 'SYSTEM' | 'SUPER_ADMIN'
  actorSource String  @default("ADMIN")

  // Target (what was acted upon) — soft FKs as TEXT
  targetType String? // 'order' | 'product' | 'location' | 'role' | …
  targetId   String?
  targetCode String? // human label snapshot, e.g. "FC-4218"

  // Optional location scope
  locationId String?

  // Free-text + structured payload
  message String?
  payload Json?

  ipAddress String?
  userAgent String?

  // 'SUCCESS' | 'DENIED' | 'FAILED'
  outcome String @default("SUCCESS")

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, area, createdAt])
  @@index([businessId, severity, createdAt])
  @@index([businessId, actorUserId, createdAt])
  @@index([businessId, targetType, targetId])
}

// ─── Loyalty ──────────────────────────────────────────────────────────────────
// F3 — customer rewards engine. Append-only ledger; balance = SUM(points) for
// (businessId, customerId). Earn rule lives in code (1pt per ₹100 paid by
// default); redemption is wired via type='REDEEM' rows with negative points.
//
// We deliberately use a ledger (not a stored balance) because:
//   - Audit: every earn / redeem / expire / adjust is traceable.
//   - Idempotency: earn-on-PAID dedupes via @@unique(orderId, type='EARN').
model EcomLoyaltyLedger {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // 'EARN' | 'REDEEM' | 'EXPIRE' | 'ADJUST'
  type   String
  // Signed integer. EARN/ADJUST positive, REDEEM/EXPIRE negative.
  points Int

  // Soft FK — order that triggered the earn (null for ADJUST/EXPIRE rows).
  orderId String?
  note    String?

  createdAt DateTime @default(now())

  // Earn idempotency — one EARN row per order. Other types use a NULL
  // orderId so the unique constraint doesn't block them.
  @@unique([orderId, type])
  @@index([businessId, customerId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AccountAuditLog — immutable, append-only record of account lifecycle events
// for GDPR Article 17 compliance + law-enforcement subpoena response.
//
// We retain THIS table forever even after a Business / User / Customer is
// purged. The PII columns (originalEmail, originalName) here remain so that:
//   - Legal-claims defence (Art. 17(3)(e)) — we can prove who owned what,
//     when, even if they deleted their account.
//   - Government subpoena — we can confirm a business existed at time X,
//     who owned it, what country they signed up from.
//   - Anti-fraud — repeat-signup IP detection survives account deletion.
//
// originalEmailHash is also stored so future privacy reviews can search
// for "did this email ever exist" without reading plaintext PII.
//
// Never queried from product UIs — only by superadmin compliance flow.
// No FKs back to Business/User/Customer because those rows can be deleted;
// the IDs are stored as plain strings for forensic linking.
// ─────────────────────────────────────────────────────────────────────────────
model AccountAuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // 'BUSINESS_CREATED' | 'BUSINESS_DELETE_REQUESTED' | 'BUSINESS_DELETE_UNDONE'
  // | 'BUSINESS_PURGED' | 'STAFF_DELETE_REQUESTED' | 'STAFF_DELETE_UNDONE'
  // | 'STAFF_PURGED' | 'CUSTOMER_DELETE_REQUESTED' | 'CUSTOMER_DELETE_UNDONE'
  // | 'CUSTOMER_PURGED'
  eventType String

  // 'BUSINESS' | 'USER' | 'CUSTOMER'
  targetType String
  // Original primary-key UUID of the deleted entity. Plain string (no FK)
  // because the row may already be purged when this is read.
  targetId   String

  // Snapshot of the entity at event time — survives the purge.
  targetSlug        String? // business.slug if applicable
  originalEmail     String? // plaintext for subpoena response
  originalEmailHash String? // SHA-256 for opaque "does this email exist" lookups
  originalName      String?
  originalPhone     String?
  ownerCountry      String? // ISO-3166-1 alpha-2

  // Forensics
  ipAddress String?
  userAgent String?

  // Free-text reason if the user provided one + structured payload
  reason  String?
  payload Json?

  @@index([eventType, createdAt])
  @@index([targetType, targetId])
  @@index([originalEmailHash])
}

// AuditLog — append-only trail of SENSITIVE operator actions (pay-run approve,
// compensation change, employee terminate, branding/domain change, role change).
// Written best-effort by core/lib/audit.js#writeAudit; a write failure NEVER
// breaks the request path.
//
// Tenant scope: `businessId` is NULLABLE with NO FK back to Business — platform
// (super-admin) actions have no tenant, and the trail must SURVIVE tenant
// offboarding/purge for forensic + compliance reasons (see §1.2 invariant note).
// Every product read is still filtered by businessId, so the nullable column
// does not weaken tenant isolation for in-product queries.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Owning tenant (null for platform-level actions). No FK on purpose.
  businessId String?
  // The operator/user who performed the action (User.id). Plain string, no FK.
  actorId    String?

  // Verb of the sensitive action, e.g. 'payrun.approve', 'compensation.change',
  // 'employee.terminate', 'branding.change', 'domain.change', 'role.change'.
  action     String
  // Domain object the action targeted, e.g. 'PayRun', 'Employee', 'BusinessRole'.
  entityType String
  // Primary key of the targeted row (plain string; row may later be deleted).
  entityId   String?

  // Structured, non-sensitive context (ids, before/after status, amounts).
  meta Json?

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([action, createdAt])
}

// Per-tenant URL redirects (301/302). Managed in the SEO Center and
// auto-created when a CMS page's slug/section changes, so renamed pages
// never 404 and keep their search equity.
model Redirect {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromPath   String
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  source     String   @default("manual") // manual | auto_slug_change | import
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, fromPath])
  @@index([businessId])
}

// ─── Storefront legal policies (Privacy, Terms, Refund, Shipping, …) ─────────
// Owner-authored, per-tenant. Each policy has a name + rich-text content and
// can be surfaced in the storefront footer and/or required for acceptance at
// customer signup. Acceptance itself is recorded on Customer.termsAcceptedAt.
model StorePolicy {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String // "Privacy Policy", "Terms of Service", "Refund Policy"
  slug         String // url-safe, unique per business → /policy/<slug>
  content      String   @default("") @db.Text // HTML from the rich-text editor
  showInFooter Boolean  @default(true)
  showAtSignup Boolean  @default(false) // require acceptance at customer signup
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Law firm: matter management → engagement → billing → trust (Phase 1+2).
// Mirrors the doctor-consultation invoice engine (Float money, per-business
// gapless numbering). The engagement LETTER itself stays an AppointmentDocument
// (reuses the mature legal-document engine); the Matter just tracks its status.
// ─────────────────────────────────────────────────────────────────────────────
model Matter {
  id                   String               @id @default(uuid())
  businessId           String
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  matterNumber         String // per-business human sequence, e.g. "M-00012"
  title                String
  description          String?              @db.Text
  practiceArea         String?
  status               String               @default("OPEN") // PROSPECT | OPEN | ON_HOLD | CLOSED
  feeBasis             String               @default("HOURLY") // HOURLY | FIXED | CONTINGENCY | RETAINER
  defaultRate          Float? // hourly rate when feeBasis = HOURLY
  fixedFee             Float? // agreed fee when feeBasis = FIXED
  currency             String?
  // Engagement lifecycle (the letter lives as an AppointmentDocument on the
  // origin appointment; this tracks where it is in the flow).
  engagementStatus     String               @default("NONE") // NONE | DRAFT | SENT | ACCEPTED
  engagementDocId      String?
  engagementSentAt     DateTime?
  engagementAcceptedAt DateTime?
  // Client + responsible lawyer
  customerId           String?
  customer             Customer?            @relation("CustomerMatters", fields: [customerId], references: [id], onDelete: SetNull)
  responsibleLawyerId  String?
  responsibleLawyer    User?                @relation("LawyerMatters", fields: [responsibleLawyerId], references: [id], onDelete: SetNull)
  // The intake consultation it was opened from (1:1).
  originAppointmentId  String?              @unique
  originAppointment    Appointment?         @relation("MatterOriginAppointment", fields: [originAppointmentId], references: [id], onDelete: SetNull)
  openedAt             DateTime             @default(now())
  closedAt             DateTime?
  invoices             MatterInvoice[]
  timeEntries          MatterTimeEntry[]
  disbursements        MatterDisbursement[]
  trustTransactions    TrustTransaction[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([businessId, matterNumber])
  @@index([businessId, status, openedAt])
  @@index([businessId, customerId])
}

model MatterInvoice {
  id            String    @id @default(uuid())
  businessId    String
  matterId      String
  matter        Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  invoiceNumber String // per-business sequence, e.g. "LINV-00012"
  currency      String?
  lineItemsJson String    @db.Text // [{ label, qty, unitAmount, amount, kind }]
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  total         Float     @default(0)
  taxLabel      String?
  amountPaid    Float     @default(0)
  status        String    @default("ISSUED") // DRAFT | ISSUED | PAID | VOID
  dueDate       DateTime?
  clientName    String?
  clientContact String?
  snapshotJson  String?   @db.Text
  issuedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status, issuedAt])
  @@index([matterId])
}

model MatterTimeEntry {
  id          String   @id @default(uuid())
  businessId  String
  matterId    String
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId      String? // lawyer who did the work
  workedOn    DateTime @default(now())
  minutes     Int      @default(0)
  rate        Float    @default(0) // per-hour rate
  amount      Float    @default(0) // (minutes / 60) * rate, computed at create
  narrative   String?  @db.Text
  billed      Boolean  @default(false)
  invoiceId   String? // MatterInvoice id once billed
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, matterId, billed])
}

model MatterDisbursement {
  id          String   @id @default(uuid())
  businessId  String
  matterId    String
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  incurredOn  DateTime @default(now())
  description String
  amount      Float    @default(0)
  billed      Boolean  @default(false)
  invoiceId   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, matterId, billed])
}

// Append-only client-funds ledger. Simplified record (NOT statutory trust
// reconciliation). balanceAfter is the running TRUST balance for the matter.
model TrustTransaction {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  matterId         String?
  matter           Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
  customerId       String?
  type             String // DEPOSIT | WITHDRAWAL | TRANSFER_TO_OFFICE | REFUND | DISBURSEMENT
  amount           Float    @default(0) // positive magnitude; type implies direction
  balanceAfter     Float    @default(0) // running trust balance for the matter after this txn
  relatedInvoiceId String?
  reference        String?
  note             String?  @db.Text
  createdById      String?
  createdAt        DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([matterId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Water purifier: installed-unit (asset) → AMC contract → scheduled service
// visits → dispatch → billing (Phase 1+2). Mirrors the law-firm Matter engine
// (Float money, per-business gapless numbering). A service visit reuses an
// Appointment for the calendar slot + technician; ServiceVisit adds the AMC /
// asset / parts / TDS / dispatch semantics on top.
// ─────────────────────────────────────────────────────────────────────────────
model InstalledUnit {
  id                  String         @id @default(uuid())
  businessId          String
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?      @relation("CustomerInstalledUnits", fields: [customerId], references: [id], onDelete: SetNull)
  brand               String?
  model               String?
  serial              String?
  purifierType        String? // RO | UV | UF | RO+UV | ...
  waterSource         String?
  installedAt         DateTime?
  warrantyUntil       DateTime?
  addressLine         String?        @db.Text
  pincode             String?
  lastTds             Int?
  notes               String?        @db.Text
  originAppointmentId String?        @unique
  originAppointment   Appointment?   @relation("InstalledUnitOriginAppointment", fields: [originAppointmentId], references: [id], onDelete: SetNull)
  contracts           AmcContract[]
  visits              ServiceVisit[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([businessId, pincode])
  @@index([businessId, customerId])
}

model AmcContract {
  id                      String         @id @default(uuid())
  businessId              String
  business                Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contractNumber          String // per-business sequence, e.g. "AMC-00012"
  customerId              String?
  customer                Customer?      @relation("CustomerAmcContracts", fields: [customerId], references: [id], onDelete: SetNull)
  installedUnitId         String?
  installedUnit           InstalledUnit? @relation(fields: [installedUnitId], references: [id], onDelete: SetNull)
  tier                    String         @default("BASIC") // BASIC | PREMIUM | ELITE
  status                  String         @default("ACTIVE") // PROSPECT | ACTIVE | EXPIRED | CANCELLED
  startDate               DateTime       @default(now())
  endDate                 DateTime?
  price                   Float?
  currency                String?
  visitsIncluded          Int            @default(0)
  visitsUsed              Int            @default(0)
  nextVisitDueAt          DateTime?
  responsibleTechnicianId String?
  responsibleTechnician   User?          @relation("TechnicianAmcContracts", fields: [responsibleTechnicianId], references: [id], onDelete: SetNull)
  originAppointmentId     String?        @unique
  originAppointment       Appointment?   @relation("AmcContractOriginAppointment", fields: [originAppointmentId], references: [id], onDelete: SetNull)
  visits                  ServiceVisit[]
  invoices                AmcInvoice[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@unique([businessId, contractNumber])
  @@index([businessId, status, endDate])
  @@index([businessId, nextVisitDueAt])
}

model ServiceVisit {
  id                String         @id @default(uuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amcContractId     String?
  amcContract       AmcContract?   @relation(fields: [amcContractId], references: [id], onDelete: SetNull)
  installedUnitId   String?
  installedUnit     InstalledUnit? @relation(fields: [installedUnitId], references: [id], onDelete: SetNull)
  appointmentId     String?        @unique
  appointment       Appointment?   @relation("ServiceVisitAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  kind              String         @default("PREVENTIVE") // PREVENTIVE | REPAIR | INSTALL | COMPLAINT
  scheduledFor      DateTime?
  dueBy             DateTime?
  status            String         @default("SCHEDULED") // SCHEDULED | ASSIGNED | EN_ROUTE | DONE | MISSED
  technicianId      String?
  technician        User?          @relation("TechnicianServiceVisits", fields: [technicianId], references: [id], onDelete: SetNull)
  tdsBefore         Int?
  tdsAfter          Int?
  partsReplacedJson String?        @db.Text // [{ part, qty, amount }]
  reportDocId       String?
  notes             String?        @db.Text
  billed            Boolean        @default(false)
  invoiceId         String?
  completedAt       DateTime?
  reminderSentAt    DateTime?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([businessId, status, scheduledFor])
  @@index([businessId, dueBy])
  @@index([amcContractId])
}

model AmcInvoice {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amcContractId String?
  amcContract   AmcContract? @relation(fields: [amcContractId], references: [id], onDelete: SetNull)
  customerId    String?
  invoiceNumber String // per-business sequence, e.g. "WINV-00012"
  currency      String?
  lineItemsJson String       @db.Text
  subtotal      Float        @default(0)
  taxAmount     Float        @default(0)
  total         Float        @default(0)
  taxLabel      String?
  amountPaid    Float        @default(0)
  status        String       @default("ISSUED") // DRAFT | ISSUED | PAID | VOID
  dueDate       DateTime?
  clientName    String?
  clientContact String?
  snapshotJson  String?      @db.Text
  issuedAt      DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status, issuedAt])
  @@index([amcContractId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Internal QA testing portal
// ─────────────────────────────────────────────────────────────────────────────
// Separate from Sitepresso tenant users/customers. These accounts are for
// manual testers, product managers, and internal admins using test.aapkatech.com.
model QaUser {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String?
  isAdmin           Boolean   @default(false)
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projectAccess   QaProjectMember[]
  submittedIssues QaIssue[]         @relation("QaIssueCreator")
  comments        QaIssueComment[]  @relation("QaCommentAuthor")

  @@index([isActive, createdAt])
}

model QaProject {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  nextIssueNumber Int      @default(1001)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verticals QaProjectVertical[]
  members   QaProjectMember[]
  issues    QaIssue[]

  @@index([isActive, name])
}

model QaProjectVertical {
  id        String    @id @default(uuid())
  projectId String
  project   QaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  issues QaIssue[]

  @@unique([projectId, key])
  @@index([projectId, isActive, sortOrder])
}

model QaProjectMember {
  id                        String    @id @default(uuid())
  userId                    String
  user                      QaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId                 String
  project                   QaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canTest                   Boolean   @default(true)
  canApproveRecommendations Boolean   @default(false)
  canDevelop                Boolean   @default(false)
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([userId, projectId])
  @@index([projectId, isActive])
  @@index([userId, isActive])
}

// Admin-created API keys for AI/automation "developer" agents (Claude / Codex).
// The raw token is shown ONCE at creation; only its sha256 hash is stored.
model QaAgentKey {
  id          String    @id @default(uuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  createdById String?
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([isActive])
}

model QaIssue {
  id                 String             @id @default(uuid())
  publicId           String             @unique
  projectId          String
  project            QaProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectIssueNumber Int
  verticalId         String?
  vertical           QaProjectVertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  type               String             @default("BUG") // BUG | RECOMMENDATION
  severity           String             @default("LOW") // CRITICAL | MEDIUM | LOW
  description        String             @db.Text
  imageUrl           String?            @db.Text
  imageDataUrl       String?            @db.Text
  status             String             @default("DEVELOPMENT")
  createdById        String?
  createdBy          QaUser?            @relation("QaIssueCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agentClaimedAt     DateTime?
  agentClaimedBy     String?
  verifiedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  comments QaIssueComment[]

  @@unique([projectId, projectIssueNumber])
  @@index([projectId, status, createdAt])
  @@index([projectId, type, createdAt])
  @@index([verticalId, status])
  @@index([createdById, createdAt])
}

model QaIssueComment {
  id           String   @id @default(uuid())
  issueId      String
  issue        QaIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorUserId String?
  authorUser   QaUser?  @relation("QaCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  actorType    String   @default("USER") // USER | AGENT | SYSTEM
  body         String   @db.Text
  fromStatus   String?
  toStatus     String?
  createdAt    DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([authorUserId, createdAt])
}

// ════════════════════════════════════════════════════════════════════════════
// ═════════════════════════════  HR DOMAIN  ═════════════════════════════════
// ════════════════════════════════════════════════════════════════════════════
//
// HR & Payroll data model for the multi-tenant white-label HRMS (IN + NZ).
// Authoritative design: docs/03-data-model.md. Sitepresso shapes mined per
// docs/17-reuse-map.md §2.4 / §5 (StaffLeave, BusinessHoliday, StaffSchedule,
// BusinessHours, EcomRolePermissionGrant, BusinessLocation, StoreBrand).
//
// INVARIANTS enforced on every model below:
//   • Tenant-scoped: `businessId` + mandatory `business Business @relation(...)`
//     + leading `@@index([businessId, ...])`; composite uniques include scope.
//     (Sole exception: AuditLog.businessId is nullable with NO FK — platform
//      actions have no tenant and audit must survive tenant offboarding.)
//   • Money: Decimal @db.Decimal(...) — NEVER Int/Float. Amounts (15,2);
//     org-level totals (18,2); rates (9,6); hours (8,2); leave days (8,4)/(10,4).
//   • Effective-dating via append-only revisions (effectiveFrom/effectiveTo,
//     isCurrent) or effectiveDate, per docs/03 §1.4.
//   • Status/state machines are DB-enforced Prisma enums; tenant-extensible
//     vocabularies (leave type, expense category, salary component) are rows
//     that pick behavior from a fixed `kind` enum ("configure, not build").
// ════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// §3  ORGANIZATION  — Entity, Location, Department, Designation, Grade, Band
// ─────────────────────────────────────────────────────────────────────────────

/// Legal payroll entity — the unit of statutory registration and the
/// pay-currency boundary. Founder #4: one tenant → many entities/pay-groups,
/// ALL in the tenant's single `hrCountry` (a tenant is not IN+NZ mixed).
/// `countryCode` selects the compliance module and MUST equal the tenant country.
model Entity {
  id                          String                     @id @default(uuid())
  businessId                  String
  business                    Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code                        String // human: "IN-HQ", "NZ-AKL"
  legalName                   String // @pii:identity — registered legal name
  tradeName                   String?
  countryCode                 String                     @db.Char(2) // "IN" | "NZ"
  payCurrency                 String                     @db.Char(3) // "INR" | "NZD"
  timezone                    String // IANA, e.g. "Asia/Kolkata", "Pacific/Auckland"
  taxYearStartMonth           Int                        @default(4) // Apr in both markets
  // Registered (statutory) address — distinct from work-site Location
  addressLine1                String?
  addressLine2                String?
  city                        String?
  stateCode                   String? // IN state (drives PT slab) / NZ region
  postalCode                  String?
  // IN extensions (NULL for NZ) — @pii:identity, @retain:statutory
  pan                         String?                    @db.Char(10)
  tan                         String?                    @db.Char(10) // TDS account no. (Form 24Q)
  gstin                       String?                    @db.VarChar(15)
  cin                         String? // company identification no.
  // NZ extensions (NULL for IN)
  nzbn                        String? // NZ Business Number
  irdEntityNumber             String?                    @db.VarChar(11) // employer IRD number @pii:identity
  // Lifecycle
  status                      EntityStatus               @default(ACTIVE)
  activeFrom                  DateTime
  activeTo                    DateTime?
  // Feature 16 — the salary-proration denominator policy for this entity
  // (what "standardDays" payroll prorates a monthly salary against). India
  // default = CALENDAR_DAYS (per-month length); FIXED_30 / WORKING_DAYS are the
  // other industry conventions. Frozen into the AttendancePayInput at run time so
  // the denominator is immutable + auditable (part of inputHash). NULL = engine
  // default (CALENDAR_DAYS).
  prorationBasis              ProrationMethod?
  // Feature 26 — the tenant/entity DEFAULT reimbursement payout channel, applied to
  // a new claim at submit when no per-claim override is set. PAY_SEPARATELY (today's
  // out-of-band manual reimburse) keeps existing behaviour; an employer that always
  // settles via payroll flips this to PAY_VIA_PAYROLL so every approved claim rides
  // the next run. A per-claim override always wins over this default.
  reimbursementDefaultChannel ReimbursementPayoutChannel @default(PAY_SEPARATELY)
  // Program P1.7 — per-entity DEFAULT bank payout file format, preselected when
  // a disbursement batch is created without an explicit bank. NULL = the batch
  // must name one (today's behaviour).
  defaultPayoutBank           PayoutBank?
  // Program P1.7 — the per-day divisor for notice pay-in-lieu/recovery
  // (monthly gross ÷ divisor). NULL = the 30-day convention. The statutory
  // 26-day gratuity/encashment basis is unaffected.
  noticeDivisorDays           Int?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  deletedAt                   DateTime?
  version                     Int                        @default(0)

  locations             Location[]
  registrations         StatutoryRegistration[]
  payCalendars          PayCalendar[]
  employments           EmploymentRecord[]
  payRuns               PayRun[]
  bonusCycles           BonusCycle[]
  arrearCycles          ArrearCycle[]
  remittances           StatutoryRemittance[]
  complianceObligations ComplianceObligation[]
  // Feature 32 — per-entity register definition overrides + generated exports.
  registerDefinitions   RegisterDefinition[]
  registerExports       RegisterExport[]
  compensations         CompensationRevision[]
  importJobs            ImportJob[]
  form16Batches         Form16Batch[]
  punchDevices          PunchDevice[] // Feature 28 — biometric devices live at an entity site

  @@unique([businessId, code])
  @@index([businessId, countryCode, status])
}

enum EntityStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Physical work-site. Generalizes Sitepresso BusinessLocation, bound to an
/// Entity and carrying HR fields (PT state, ACC class unit, geofence).
model Location {
  id               String    @id @default(uuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId         String
  entity           Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  code             String
  name             String
  addressLine1     String?
  city             String?
  stateCode        String? // IN: drives Professional Tax slab selection
  postalCode       String?
  countryCode      String    @db.Char(2)
  timezone         String
  // Attendance support
  geoLat           Decimal?  @db.Decimal(9, 6)
  geoLng           Decimal?  @db.Decimal(9, 6)
  geofenceM        Int? // allowed punch radius, metres
  // Geofence policy: false (default) = WARN ONLY (flag + surface OUT_OF_GEOFENCE
  // but never block); true = ENFORCE (still flags; a future hard-block path keys
  // off this). Default warn so a freshly-configured geofence never locks people
  // out on day one. Per-location lever; a tenant-wide default can live on
  // Business.featureFlags.attendance.geofenceEnforce (resolved in service.js).
  geofenceEnforce  Boolean   @default(false)
  ptRegistrationId String? // IN: PT registration is per state
  accClassUnit     String? // NZ: ACC classification unit (CU) code
  isPrimary        Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  version          Int       @default(0)

  employments  EmploymentRecord[]
  punchDevices PunchDevice[] // Feature 28 — biometric devices optionally scoped to a location

  @@unique([businessId, entityId, code])
  @@index([businessId, entityId, isActive])
}

/// Department tree (self-referential, like Sitepresso ProductCategory).
model Department {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code           String
  name           String
  parentId       String?
  parent         Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[] @relation("DeptTree")
  headEmployeeId String? // department head (manager-of-record fallback)
  costCenter     String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  version        Int          @default(0)

  employments EmploymentRecord[]

  @@unique([businessId, code])
  @@index([businessId, parentId])
}

/// Job title. Optionally anchored to a Grade.
model Designation {
  id          String             @id @default(uuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code        String
  title       String // "Senior Engineer"
  gradeId     String?
  grade       Grade?             @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  version     Int                @default(0)
  employments EmploymentRecord[]

  @@unique([businessId, code])
  @@index([businessId, gradeId])
}

/// Seniority grade (L1..L8) — pay-band anchor.
model Grade {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code         String
  name         String
  rank         Int // ordering for comparisons / approvals
  bandId       String?
  band         Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)
  minSalary    Decimal?      @db.Decimal(15, 2)
  midSalary    Decimal?      @db.Decimal(15, 2) // Feature 5 — compa-ratio midpoint (else derive (min+max)/2)
  maxSalary    Decimal?      @db.Decimal(15, 2)
  currencyCode String?       @db.Char(3)
  designations Designation[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  version      Int           @default(0)

  @@unique([businessId, code])
  @@index([businessId, rank])
}

/// Broad compensation band grouping grades.
model Band {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String
  name       String
  grades     Grade[]
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  version    Int       @default(0)

  @@unique([businessId, code])
}

// ─────────────────────────────────────────────────────────────────────────────
// §4  EMPLOYEE & EMPLOYMENT
// ─────────────────────────────────────────────────────────────────────────────

/// HR master record (≠ login). Founder #5: NEW model; only auth columns are
/// borrowed conceptually from Customer (passwordChangedAt lives on User;
/// here we keep preferredLanguage, isActive, anonymisedAt). Portal login is
/// optional via `userId` → User. Tenant-scoped.
model Employee {
  id                        String         @id @default(uuid())
  businessId                String
  business                  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code                      String // human EMP-000142, tenant-unique
  // Optional portal identity (reused User model)
  userId                    String?        @unique
  user                      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Person — @pii:identity
  firstName                 String
  middleName                String?
  lastName                  String
  preferredName             String?
  dateOfBirth               DateTime?      @db.Date
  gender                    Gender?
  maritalStatus             MaritalStatus?
  nationality               String?
  // Contact — @pii:contact
  personalEmail             String?
  workEmail                 String?
  phone                     String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  stateCode                 String?
  postalCode                String?
  countryCode               String?        @db.Char(2)
  photoUrl                  String?        @db.Text
  // Sensitive — @pii:sensitive (consent-gated, country-config driven)
  disabilityStatus          String?
  bloodGroup                String?
  // ── Feature 13: rich Personal Information (Figma §Personal) ──
  // Co-located identity attributes read on every profile render (keeps the ESS
  // self-card a single-row read). All nullable/optional (additive migration).
  // @pii:sensitive for religion/community — returned only on the SELF read or to
  // an in-scope operator (masked otherwise), per docs/features/13 §9.
  religion                  String? // @pii:sensitive
  community                 String? // @pii:sensitive
  motherTongue              String?
  placeOfBirth              String?
  stateOfBirthCode          String?        @db.Char(2) // ISO-3166-2 subdivision suffix / free state code
  identificationMark        String? // "ID mark" on the Figma
  heightCm                  Decimal?       @db.Decimal(5, 1)
  weightKg                  Decimal?       @db.Decimal(5, 1)
  fatherName                String?
  fatherOccupation          String?
  motherName                String?
  motherOccupation          String?
  // Contact (Figma §Contact — official vs personal split + landlines).
  // officialEmail == existing workEmail; personalEmail/phone already exist above.
  homePhone                 String?
  officePhone               String?
  // Reused-auth columns (conceptually from Customer, per reuse-map §12.2)
  preferredLanguage         String? // BCP-47; payslip/letter locale
  // Cycle 0 — notification fan-out. Per-employee channel preferences + opt-out for
  // HR-event notifications (approval-pending/decided, SLA reminders). Shape:
  //   { "optOut": false, "channels": { "email": true, "whatsapp": true, "sms": false } }
  // NULL = tenant/router defaults apply. `optOut: true` suppresses real-channel fan-out
  // entirely (IN_APP is still written so the in-app inbox stays complete). A missing
  // `channels` map = router's default cascade. This NEVER bypasses the existing
  // budget/opt-out engine — it only narrows the cascade further (best-effort, additive).
  notifyPrefs               Json?
  // Cycle 1 — ESS company directory (FLAG: additive). Per-employee opt-out for the
  // OPTIONAL shareable directory fields (the work/office phone). When true, the
  // colleague directory hides this employee's office phone from other employees —
  // never their name/designation/department/work email (those stay visible so the
  // person is still findable). Defaults to false (work phone shown). This governs
  // ONLY the directory surface; it never affects HR/operator reads.
  directoryHidePhone        Boolean        @default(false)
  isActive                  Boolean        @default(true)
  // Lifecycle (denormalized current values; history in EmploymentRecord)
  status                    EmployeeStatus @default(PRE_HIRE)
  hireDate                  DateTime?      @db.Date // first joining date (tenure anchor)
  probationEndDate          DateTime?      @db.Date
  terminationDate           DateTime?      @db.Date
  // Pointers to current records (maintained by service layer per revision)
  currentEmploymentRecordId String?        @unique
  currentCompensationId     String?        @unique
  managerEmployeeId         String?
  manager                   Employee?      @relation("EmpManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  reports                   Employee[]     @relation("EmpManager")
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  deletedAt                 DateTime? // soft; anonymise PII but keep statutory
  anonymisedAt              DateTime? // mirrors User.anonymisedAt pattern
  version                   Int            @default(0)

  employmentRecords        EmploymentRecord[]
  statutoryProfile         StatutoryProfile?
  compensations            CompensationRevision[]
  bankAccounts             BankAccount[]
  payoutLines              PayoutLine[] // India salary disbursement — per-employee credit lines
  emergencyContacts        EmergencyContact[]
  dependants               Dependant[]
  leaveBalances            LeaveBalance[]
  leaveTxns                LeaveTransaction[]
  // Feature 29 — women/graveyard night-shift consent. Default false = must opt in;
  // the rotation generator + swap consumer refuse to place a non-consenting employee
  // on an isNightShift pattern (hard block, admin override audited).
  nightShiftEligible       Boolean                           @default(false)
  compOffCredits           CompOffCredit[] // Feature 30 — comp-off expiry lots
  leaveEncashmentRequests  LeaveEncashmentRequest[] // Feature 31 — in-service encashment
  punches                  AttendancePunch[]
  deviceEmployeeMaps       DeviceEmployeeMap[] // Feature 28 — device enroll-no/PIN → this employee
  shiftAssignments         ShiftAssignment[]
  rosterDays               RosterDay[] // Feature 29 — per-day roster cells
  swapsRequested           ShiftSwapRequest[]                @relation("SwapRequester") // Feature 29
  swapsCounterparty        ShiftSwapRequest[]                @relation("SwapCounterparty") // Feature 29
  openShiftClaims          OpenShiftClaim[] // Open-shift claims (this employee claimed an open shift)
  timesheets               Timesheet[]
  attendances              Attendance[]                      @relation("EmployeeAttendances")
  attendancePayInputs      AttendancePayInput[]
  expenseClaims            ExpenseClaim[]
  travelRequests           TravelRequest[] // Feature 11
  loans                    Loan[]
  documents                EmployeeDocument[]
  assets                   AssetAssignment[]
  reviews                  PerformanceReview[]               @relation("RevieweeReviews")
  reviewsGiven             PerformanceReview[]               @relation("ReviewerReviews")
  goals                    Goal[]
  skills                   EmployeeSkill[]
  // Performance — Feature 8
  objectivesOwned          Objective[]                       @relation("ObjectiveOwner")
  oneOnOnesAsManager       OneOnOne[]                        @relation("OneOnOneManager")
  oneOnOnesAsEmployee      OneOnOne[]                        @relation("OneOnOneEmployee")
  // Talent depth — Feature 34
  nineBoxPlacements        NineBoxPlacement[]                @relation("NineBoxSubject")
  talentTags               TalentTag[]                       @relation("TalentTagSubject")
  payRunLines              PayRunLine[]
  payslips                 Payslip[]
  helpdeskTickets          HelpdeskTicket[]
  approvalRequests         ApprovalRequest[]                 @relation("RequesterApprovals")
  separations              SeparationCase[]
  profileChangeRequests    ProfileChangeRequest[]
  documentRequests         DocumentRequest[]
  regularizationRequests   AttendanceRegularizationRequest[]
  overtimeRequests         OvertimeRequest[] // OT pre-approval requests
  bonusAwards              BonusAward[]
  arrearCycles             ArrearCycle[]
  variablePayAwards        VariablePayAward[]
  // Letters & Communication (Feature 9) — letters issued to this employee
  issuedLetters            IssuedLetter[]
  // Feature 13 — rich profile sub-models (Education + typed Addresses)
  educations               EmployeeEducation[]
  addresses                EmployeeAddress[]
  // Engagement (Cycle 1) — per-employee announcement read receipts. Read receipts
  // are keyed by employee (the ESS session resolves the subject employee), so the
  // unread badge + per-row read state survive a userId remap.
  announcementReads        AnnouncementRead[]
  // Feed social layer — this employee's reactions + authored comments.
  feedReactions            FeedReaction[]
  feedComments             FeedComment[]                     @relation("FeedCommentAuthor")
  // Feature 33 — survey participation ledger ONLY (never SurveyResponse: an anonymous
  // ballot has no employee relation by design — the anonymity firewall).
  surveyParticipations     SurveyParticipation[]
  // Portal-invitation flow — the welcome/set-password tokens minted for this
  // employee's ESS (Customer) login. Single-use, expiring, hashed-at-rest.
  portalInvites            EmployeeInvite[]
  // Investment-proof workflow (Feature 20) — the employee's uploaded year-end proofs.
  investmentProofs         InvestmentProof[]
  // Form 16 (Feature 24) — the employee's annual TDS certificates.
  form16Certificates       Form16Certificate[]
  // Feature 25 — FBP / Flexi Basket allocations.
  fbpAllocations           FbpAllocation[]
  // Feature 37 — LMS: the employee's training enrollments (per-employee learner records).
  enrollments              Enrollment[]
  // Feature 35 — Rewards & Recognition: kudos given/received, points wallet + ledger,
  // award nominations made/received, catalog redemptions.
  recognitionsGiven        Recognition[]                     @relation("RecognitionGiver")
  recognitionsReceived     RecognitionRecipient[]
  pointsWallets            PointsWallet[]
  pointsLedgerEntries      PointsLedgerEntry[]
  awardNominationsMade     AwardNomination[]                 @relation("AwardNominator")
  awardNominationsReceived AwardNomination[]                 @relation("AwardNominee")
  redemptions              Redemption[]
  // Phase 5b — tenant-defined custom-field values stored against this employee.
  customFieldValues        CustomFieldValue[]

  // SSO/SCIM (v1) — identity-provider provisioning linkage. `externalId` is the
  // IdP's stable id for this person (Okta/Azure AD "externalId" on SCIM create);
  // `scimManaged` marks rows the tenant's SCIM connector owns (created/updated
  // via /scim/v2/Users) so admin UIs can badge them + audits can tell the writer.
  externalId  String?
  scimManaged Boolean @default(false)

  @@unique([businessId, code])
  // FLAG (Feature 17 — review HIGH fix): a PARTIAL unique index backs the
  // onboard-by-CTC email+DOJ idempotency. Prisma's @@unique cannot express the
  // WHERE predicate, so it lives ONLY in migration
  // 20260624_feature17_onboard_dedupe/migration.sql (NOT declared here, by design):
  //   UNIQUE (businessId, workEmail, hireDate) WHERE workEmail IS NOT NULL AND deletedAt IS NULL
  @@index([businessId, status])
  @@index([businessId, managerEmployeeId])
  @@index([businessId, workEmail])
  // SSO/SCIM — GET /scim/v2/Users?filter=externalId eq "…" resolves via this.
  @@index([businessId, externalId])
  // Feature 19 — scalable org chart: keep the lazy-tree API index-only at 1000+.
  @@index([businessId, managerEmployeeId, lastName, firstName]) // ordered child pages (sibling sort) without a sort step
  @@index([businessId, lastName, firstName]) // tenant-wide name sort + search prefix
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  UNDISCLOSED
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  CIVIL_UNION
  UNDISCLOSED
}

enum EmployeeStatus {
  PRE_HIRE // offer accepted, not joined
  PROBATION
  ACTIVE
  ON_LEAVE // long leave (maternity, sabbatical) — still employed
  NOTICE_PERIOD // resigned/terminated, serving notice
  SUSPENDED // disciplinary; payroll may be held
  TERMINATED // separated; FNF pending or done
  RETIRED
}

/// Employee portal-invitation token. provisionEmployee mints the ESS Customer
/// login with a RANDOM temp password; THIS is the welcome/set-password loop that
/// lets the new hire actually claim it. Single-use, expiring, and tenant-scoped.
/// SECURITY: we store only a SHA-256 HASH of the raw token (sent in the email/
/// WhatsApp link) — a DB leak never yields a usable token. Look-ups go by the
/// hash (the raw token is never persisted). Re-invite invalidates the prior token
/// by superseding its row (status REVOKED) and minting a fresh one.
model EmployeeInvite {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // The login identity the token claims — always the WORK email (never personal).
  // Stored alongside so accept-invite can verify the Customer match without a join.
  email           String
  // SHA-256 hex digest of the raw token. @unique so a presented token resolves to
  // exactly one row (and a collision is impossible to use across tenants).
  tokenHash       String               @unique
  expiresAt       DateTime
  usedAt          DateTime? // stamped when the new hire claims the password
  status          EmployeeInviteStatus @default(PENDING)
  // True only when this token was minted as an EXPLICIT password RESET for an
  // already-claimed login (createInvite allowReset). A non-reset (first-claim)
  // token must NEVER overwrite an already-active login — that's the account-
  // takeover guard in acceptInvite(). Defaults false so every pre-existing /
  // first-claim invite is treated as non-reset (fail-closed).
  isReset         Boolean              @default(false)
  // Audit — the operator who sent it (User.id). Nullable for system-issued.
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([businessId, employeeId])
  @@index([businessId, status])
}

enum EmployeeInviteStatus {
  PENDING // sent, not yet claimed, not expired
  ACCEPTED // claimed — the new hire set their password
  REVOKED // superseded by a re-invite (the old token is dead)
}

/// Append-only employment history. Rehire/transfer creates a new record.
/// Effective-dated; Employee keeps a denormalized pointer for fast reads.
model EmploymentRecord {
  id                String                 @id @default(uuid())
  businessId        String
  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entityId          String
  entity            Entity                 @relation(fields: [entityId], references: [id], onDelete: Restrict)
  locationId        String?
  location          Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId     String?
  designation       Designation?           @relation(fields: [designationId], references: [id], onDelete: SetNull)
  gradeId           String?
  managerEmployeeId String?
  // Employment terms
  employmentType    EmploymentType
  workerCategory    WorkerCategory // staff/worker — IR Code applicability
  payCalendarId     String?
  noticeDays        Int?
  fteRatio          Decimal                @default(1.0000) @db.Decimal(5, 4) // part-time proration
  // Temporal validity (effective-dated, append-only)
  effectiveFrom     DateTime               @db.Date
  effectiveTo       DateTime?              @db.Date // NULL = current segment
  changeReason      EmploymentChangeReason
  isCurrent         Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  version           Int                    @default(0)

  @@unique([employeeId, effectiveFrom])
  @@index([businessId, entityId, isCurrent])
  @@index([businessId, employeeId, effectiveFrom])
  @@index([businessId, departmentId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
  CONTRACT
  INTERN
  APPRENTICE
  CASUAL
  CONSULTANT
}

enum WorkerCategory {
  STAFF
  WORKER
}

// IN Industrial Relations Code distinction
enum EmploymentChangeReason {
  HIRE
  PROMOTION
  TRANSFER_LOCATION
  TRANSFER_DEPARTMENT
  REORG
  MANAGER_CHANGE
  TYPE_CHANGE
  FTE_CHANGE
  PROBATION_CONFIRM
  REHIRE
}

/// Salary disbursement bank account. @pii:identity.
model BankAccount {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
