model SupportConversation {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // PLATFORM_SUPPORT = tenant owner/team talks to Sitepresso super-admin.
  // WEBSITE_CUSTOMER = storefront/website visitor talks to the tenant team.
