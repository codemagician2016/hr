// Mailbox — a Zoho-provisioned business email inbox sold as a reseller
// subscription. Sitepresso creates the account in its Zoho org, writes the
// domain's mail DNS (MX/SPF/DKIM), and emails the customer their credentials;
// the customer then signs in at Zoho directly. Mirrors the Domain status
// pattern (PENDING -> ACTIVE / FAILED) so a scheduler can retry pending ones.
model Mailbox {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  address       String // full mailbox address, e.g. hello@acme.com
  domain        String // mail domain, e.g. acme.com
  status        String   @default("PENDING") // PENDING | PROVISIONING | ACTIVE | FAILED | PENDING_DNS
  statusMessage String?  @db.Text
  provider      String   @default("ZOHO")
  zohoZoid      String? // Zoho organization id the account lives in
  zohoAccountId String? // Zoho account/zuid for the created mailbox
  dnsManaged    Boolean  @default(false) // true when we wrote DNS in our Cloudflare zone
  deliveredTo   String? // address the credentials email was sent to
  credentialsSentAt DateTime?
  billingStatus String?  // Mirrors Paddle status for the mailbox subscription.
  billingCycle  String?
  billingQuantity Int    @default(1)
  paddleCustomerId String?
  paddleSubscriptionId String? @unique
  paddleTransactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, address])
  @@index([businessId])
  @@index([status])
  @@index([billingStatus])
  @@index([paddleTransactionId])
}

