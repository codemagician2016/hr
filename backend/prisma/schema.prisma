// ─────────────────────────────────────────────────────────────────────────────
// §6  STATUTORY PROFILES  (per-employee identity/elections + per-entity regs)
// ─────────────────────────────────────────────────────────────────────────────

/// 1:1 with Employee. Sparse country-specific extensions on one row (avoids a
/// join on the hot payroll path). @pii:identity, @retain:statutory.
model StatutoryProfile {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  countryCode   String   @db.Char(2)

  // ── INDIA ──
  pan                 String?  @db.Char(10) // income tax PAN
  uan                 String?  @db.VarChar(12) // EPFO Universal Account Number
  pfMemberId          String?
  pfOptIn             Boolean? // >₹15k wage: contribute on actual vs ceiling
  pfJoinDate          DateTime? @db.Date
  esicIp              String? // ESI Insurance Person number
  esiApplicable       Boolean? @default(false)
  ptStateCode         String? // overrides location if employee remote
  aadhaarVerified     Boolean? @default(false) // store flag, NOT the number
  taxRegime           INTaxRegime? @default(NEW) // NEW is statutory default
  section80CDeclared  Decimal? @db.Decimal(15, 2) // old-regime declarations
  hraExemptionClaimed Boolean? @default(false)
  abryEligible        Boolean? @default(false)
  // ── NEW ZEALAND ──
  irdNumber                  String?  @db.VarChar(11)
  taxCode                    String?  @db.VarChar(8) // "M","ME","M SL","S","WT","ND"...
  kiwiSaverStatus            KiwiSaverStatus? @default(NOT_ENROLLED)
  kiwiSaverEmployeeRate      Decimal? @db.Decimal(5, 4) // 0.035 default from 1 Apr 2026
  kiwiSaverOptOutDate        DateTime? @db.Date
  kiwiSaverSavingsSuspension Boolean? @default(false)
  esctRate                   Decimal? @db.Decimal(5, 4) // resolved annually
  studentLoan                Boolean? @default(false) // tax code ends in SL
  studentLoanExtraDeduction  Decimal? @db.Decimal(5, 2)
  hasSpecialTaxCode          Boolean? @default(false)
  specialTaxRate             Decimal? @db.Decimal(5, 4)
  accExempt                  Boolean? @default(false)

  electionHistory StatutoryElectionHistory[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(0)

  @@index([businessId, countryCode])
  @@index([businessId, uan])
  @@index([businessId, irdNumber])
}

enum INTaxRegime {
  NEW
  OLD
}
enum KiwiSaverStatus {
  NOT_ENROLLED
  ACTIVE
  OPTED_OUT
  SAVINGS_SUSPENSION
  CASUAL_AGRICULTURAL
}

/// Append-only audit of regime/rate elections (effective-dated).
model StatutoryElectionHistory {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  statutoryProfileId String
  statutoryProfile   StatutoryProfile @relation(fields: [statutoryProfileId], references: [id], onDelete: Cascade)
  field              String // "taxRegime","kiwiSaverEmployeeRate","taxCode"
  oldValue           String?
  newValue           String
  effectiveFrom      DateTime @db.Date
  changedBy          String
  createdAt          DateTime @default(now())

  @@index([businessId, statutoryProfileId, field])
}

/// Per-entity employer statutory registrations (EPF/ESI/PT/TAN/IRD/ACC...).
model StatutoryRegistration {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind          RegistrationKind
  number        String // EPFO estab code, ESIC code, PT reg, TAN…
  stateCode     String? // for PT (per state)
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean  @default(true)
  meta          Json? // scheme-specific (e.g. PT periodicity)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
