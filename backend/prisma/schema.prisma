model RestaurantTable {
  id             String               @id @default(uuid())
  businessId     String
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  areaId         String
  area           RestaurantDiningArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label          String
  minCovers      Int                  @default(1)
  maxCovers      Int
  shape          String               @default("ROUND") // ROUND | SQUARE | RECTANGLE | BOOTH | BAR
  x              Float                @default(0)
  y              Float                @default(0)
  width          Float                @default(80)
  height         Float                @default(80)
  rotation       Float                @default(0)
  sortOrder      Int                  @default(0)
  isActive       Boolean              @default(true)
  onlineBookable Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  reservationAssignments RestaurantReservationTable[]

  @@unique([businessId, areaId, label])
  @@index([businessId, isActive, onlineBookable])
