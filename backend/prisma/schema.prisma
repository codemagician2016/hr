  electionOpenFrom DateTime? // employees may self-elect on/after this (null = always open)
  electionLockDate DateTime? // employees may self-elect strictly before this (null = no deadline)
  lockedGlobally   Boolean     @default(false) // hard freeze: no election for this FY, period
  updatedBy        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
