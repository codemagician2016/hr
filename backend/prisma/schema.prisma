model RestaurantServicePeriod {
  id                     String                @id @default(uuid())
  businessId             String
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId             String?
  location               BusinessLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  areaId                 String?
  area                   RestaurantDiningArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  dayOfWeek              Int
  name                   String
  startTime              String
  endTime                String
  slotIntervalMinutes    Int                   @default(15)
  turnMinutes            Int                   @default(90)
  flowCoverLimit         Int?
  onlineInventoryPercent Int                   @default(100)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([businessId, locationId, dayOfWeek, isActive])
}

model RestaurantReservation {
  id                    String            @id @default(uuid())
  businessId            String
  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId         String            @unique
  appointment           Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  locationId            String?
  location              BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  partySize             Int
  guestName             String
  guestEmail            String?
  guestPhone            String?
  seatingPreference     String?
  occasion              String?
  dietaryNotes          String?
  source                String            @default("ONLINE") // ONLINE | PHONE | WALK_IN | ADMIN
  arrivalStatus         String            @default("RESERVED") // RESERVED | ARRIVED | SEATED | COMPLETED | NO_SHOW | CANCELLED
  tableNote             String?
  reservationType       String            @default("STANDARD") // STANDARD | CHEF_COUNTER | PRIVATE_DINING | CELEBRATION | WALK_IN
  experienceName        String?
  depositAmount         Float?
  minimumSpendAmount    Float?
  minimumSpendPerPerson Boolean           @default(false)
  prepaidAmount         Float?
  policyAcceptedAt      DateTime?
  preorderItems         Json?
  paymentNote           String?
  quotedWaitMinutes     Int?
