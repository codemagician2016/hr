// ── Calibration ──
model CalibrationSession {
  id                  String                  @id @default(cuid())
  businessId          String
  cycleId             String
  cycle               ReviewCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  skipLevelEmployeeId String // group root (reviewer's manager)
  status              CalibrationStatus       @default(OPEN)
  // Feature 34: discriminator so a session can be a rating histogram, a 9-box grid,
  // or both. Default RATING → existing rows keep their current behaviour.
  kind                CalibrationKind         @default(RATING)
  version             Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  adjustments         CalibrationAdjustment[]

  @@index([businessId, cycleId])
}

model CalibrationAdjustment {
  id               String             @id @default(cuid())
  businessId       String
  sessionId        String
  session          CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewInstanceId String
  reviewInstance   PerformanceReview  @relation(fields: [reviewInstanceId], references: [id], onDelete: Cascade)
  fromRating       Decimal?           @db.Decimal(4, 2)
  toRating         Decimal            @db.Decimal(4, 2)
  reason           String
  byEmployeeId     String
  createdAt        DateTime           @default(now())

  @@index([businessId, sessionId])
  @@index([businessId, reviewInstanceId])
}

// ── 1:1 ──
model OneOnOne {
  id                 String   @id @default(cuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  managerEmployeeId  String
  manager            Employee @relation("OneOnOneManager", fields: [managerEmployeeId], references: [id], onDelete: Cascade)
  employeeEmployeeId String
  employee           Employee @relation("OneOnOneEmployee", fields: [employeeEmployeeId], references: [id], onDelete: Cascade)
  scheduledAt        DateTime
  agendaJson         Json?
  sharedNotes        String?
  privateNotes       String? // NEVER returned to the employee's ESS
  actionItemsJson    Json?
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId, managerEmployeeId])
  @@index([businessId, employeeEmployeeId])
}

// ── Merit hand-off (this module's OUTPUT; F5 owns the decision) ──
model MeritRecommendation {
  id                     String            @id @default(cuid())
  businessId             String
  business               Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewInstanceId       String
  reviewInstance         PerformanceReview @relation(fields: [reviewInstanceId], references: [id], onDelete: Cascade)
  subjectEmployeeId      String
  cycleId                String
  cycle                  ReviewCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  finalRating            Decimal           @db.Decimal(4, 2)
  compositeScore         Decimal           @db.Decimal(6, 3)
  proRationFactor        Decimal           @db.Decimal(5, 4)
  recommendedPct         Decimal           @db.Decimal(5, 2)
  status                 MeritStatus       @default(PENDING) // PENDING|APPROVED|APPLIED|REJECTED
  compensationRevisionId String? // set by F5 when applied
  version                Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([businessId, reviewInstanceId])
  @@index([businessId, cycleId, status])
}

