enum RegularizationKind {
  MISSED_PUNCH
  LATE_WAIVER
  EARLY_OUT_WAIVER
  WFH
  ON_DUTY
}

/// Overtime policy (entity/location scoped). Absent → derivation uses defaults
/// and credits OT only when the ShiftPattern is otEligible.
/// Program P1.5 — LATE-COMING PENALTY policy (India-common "N lates allowed per
/// month, then every M further lates costs a half/quarter/full day"). Entity/
/// location scoped like OvertimeRule (most-specific active rule wins). Enforced
/// as a month-context pass inside attendance recompute — the penalty adjusts
/// lopFraction on the offending late days, idempotently (recomputed from scratch
/// each pass, marked in exceptionsJson.latePenalty).
/// Program P1.7 — an employee's election of a restricted/optional holiday
/// (IN: pick N from the tenant's restricted list per calendar year; N lives at
/// Business.featureFlags.leave.restrictedHolidayAllowance, default 2). Elected
/// dates flow into attendance recompute + leave netting as optedRestrictedDates.
model RestrictedHolidayElection {
  id         String   @id @default(uuid())
  businessId String
  employeeId String
  holidayId  String
  year       Int
  createdAt  DateTime @default(now())

  @@unique([businessId, employeeId, holidayId])
  @@index([businessId, employeeId, year])
}

/// Program P1.6 — per-tenant notification template override. The in-code
/// registry (core templates.js + HR_TEMPLATES) stays the KEY/variable
/// authority and fallback body; an active override row replaces the rendered
/// BODY only (tokens validated at save time against the registry variables).
model TenantMessageTemplate {
  id              String   @id @default(uuid())
  businessId      String
  templateKey     String
  body            String   @db.Text
  isActive        Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, templateKey])
}

/// Program P1.4 — tenant probation policy (replaces the hardcoded 90-day
/// default). Scoped rows, most-specific wins: (entity+type) > entity > type >
/// tenant-wide. autoConfirm drives the nightly probationSweep (PROBATION→ACTIVE
/// at end date + optional CONFIRMATION letter via letterTemplateId).
model ProbationPolicy {
  id               String          @id @default(uuid())
  businessId       String
  entityId         String?
  employmentType   EmploymentType?
  probationDays    Int             @default(90)
  autoConfirm      Boolean         @default(false)
  letterTemplateId String?
  remindDaysBefore Int             @default(7)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([businessId, entityId, employmentType])
  @@index([businessId, isActive])
}

model LateComingRule {
  id                   String   @id @default(uuid())
  businessId           String
  entityId             String?
  locationId           String?
  allowedLatesPerMonth Int      @default(3) // grace count before penalties start
  perLates             Int      @default(1) // every N further lates → one penalty
  penaltyDayFraction   Decimal  @default(0.5) @db.Decimal(4, 2) // 0.25 | 0.5 | 1
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([businessId, entityId, locationId, isActive])
}

model OvertimeRule {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId            String?
  locationId          String?
  dailyThresholdMin   Int      @default(480)
  weekdayMultiplier   Decimal  @default(1.0) @db.Decimal(4, 2)
  weeklyOffMultiplier Decimal  @default(2.0) @db.Decimal(4, 2)
  holidayMultiplier   Decimal  @default(2.0) @db.Decimal(4, 2)
  dailyCapMin         Int?
  roundingMin         Int      @default(15)
  isActive            Boolean  @default(true)
  // OT pre-approval gate. When true for the resolved rule, attendance derivation
  // credits computed OT ONLY up to the employee's APPROVED OvertimeRequest minutes
  // for that day (0 when none approved). Default false = the historical behaviour
  // (OT credited straight off worked-minutes, no authorization) — regression-safe.
  requirePreApproval  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([businessId, entityId, locationId])
}

/// OT pre-approval request. An employee (ESS) asks to be authorized for N overtime
/// minutes on a given day; the request rides the F10 approval engine
/// (WorkflowModule.OVERTIME — the reporting manager authorizes). The attendance
/// derivation GATES computed OT on the APPROVED minutes ONLY WHEN the resolved
/// OvertimeRule.requirePreApproval is true (otherwise OT is credited exactly as
/// before). One LIVE request per employee-day — the unique key lets a decided row be
/// re-opened (flipped back to PENDING) rather than accumulating duplicates.
model OvertimeRequest {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date              DateTime      @db.Date
  requestedMinutes  Int
  reason            String?
  status            RequestStatus @default(PENDING)
  approvalRequestId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([businessId, employeeId, date])
  @@index([businessId, employeeId, status])
  @@index([businessId, status])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ── §13 Asset management ──
model Asset {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId       String?
  code           String // AST-000045
  name           String
  category       AssetCategory
  serialNumber   String?
  purchaseDate   DateTime?         @db.Date
  purchaseCost   Decimal?          @db.Decimal(15, 2)
  currencyCode   String?           @db.Char(3)
  condition      AssetCondition    @default(GOOD)
  status         AssetStatus       @default(AVAILABLE)
  warrantyExpiry DateTime?         @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  version        Int               @default(0)
  assignments    AssetAssignment[]

  @@unique([businessId, code])
  @@index([businessId, status, category])
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MOBILE
  MONITOR
  ACCESSORY
  SIM
  VEHICLE
  FURNITURE
  ID_CARD
  ACCESS_CARD
  SOFTWARE_LICENSE
  OTHER
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  RETIRED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  LOST
  RETIRED
}

model AssetAssignment {
  id                     String                @id @default(uuid())
  businessId             String
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId                String
  asset                  Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt             DateTime              @db.Date
  returnedAt             DateTime?             @db.Date
  conditionOut           AssetCondition?
  conditionIn            AssetCondition?
  acknowledgmentSignedAt DateTime?
  recoveryAmount         Decimal?              @db.Decimal(15, 2) // if lost/damaged -> payroll recovery
  notes                  String?
  status                 AssetAssignmentStatus @default(ASSIGNED)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([businessId, employeeId, status])
  @@index([businessId, assetId])
}

enum AssetAssignmentStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
  PENDING_RECOVERY
}

// ── §14 Performance ──
model ReviewCycle {
  id                   String                @id @default(uuid())
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityId             String?
  code                 String
  name                 String // "FY2026 Annual", "H1 2026"
  type                 ReviewCycleType
  periodStart          DateTime              @db.Date
  periodEnd            DateTime              @db.Date
  status               ReviewCycleStatus     @default(DRAFT)
  ratingScaleJson      Json // fixed scale options (1-5 / labels)
  // ── Feature 8 additions ──
  templateId           String? // optional ReviewTemplate
  ratingScaleId        String? // optional RatingScale (overrides ratingScaleJson)
  releasedAt           DateTime? // org-wide release gate (no leak pre-release)
  goalWeightPct        Decimal?              @db.Decimal(5, 2) // composite weighting: goals
  competencyWeightPct  Decimal?              @db.Decimal(5, 2) // composite weighting: competencies
  meritMatrixJson      Json? // rating→% merit matrix (config; drives MeritRecommendation)
  // Feature 34: per-cycle 9-box config — { perfBands:[{max,band}], potentialScaleId,
  // gridTargetJson }. Banding thresholds + the potential scale + the grid target
  // distribution live here so the grid is reproducible per cycle and the scale-lock
  // guard protects them once the cycle launches. Additive, optional.
  nineBoxConfigJson    Json?
  hrReviewerEmployeeId String? // fallback reviewer for top-of-tree subjects
  version              Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  reviews              PerformanceReview[]
  objectives           Objective[]
  calibrationSessions  CalibrationSession[]
  meritRecommendations MeritRecommendation[]
  nineBoxPlacements    NineBoxPlacement[]

  @@unique([businessId, code])
  @@index([businessId, status])
}

enum ReviewCycleType {
  ANNUAL
  HALF_YEARLY
  QUARTERLY
  PROBATION
  PROJECT
  CONTINUOUS
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  SELF_REVIEW
  MANAGER_REVIEW
  CALIBRATION
  CLOSED
}

model PerformanceReview {
  id                     String                  @id @default(uuid())
  businessId             String
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewCycleId          String
  reviewCycle            ReviewCycle             @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  employeeId             String // reviewee
  employee               Employee                @relation("RevieweeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId             String // manager
  reviewer               Employee                @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  selfRating             Decimal?                @db.Decimal(4, 2)
  managerRating          Decimal?                @db.Decimal(4, 2)
  finalRating            Decimal?                @db.Decimal(4, 2) // post-calibration
  selfComments           String?
  managerComments        String?
  status                 ReviewStatus            @default(NOT_STARTED)
  outcomeJson            Json? // promotion/PIP/hike recommendation
  // ── Feature 8: linkedCompensationId is now a REAL relation (was a loose String?) ──
  linkedCompensationId   String? // hike -> CompensationRevision
  linkedCompensation     CompensationRevision?   @relation("ReviewMeritRevision", fields: [linkedCompensationId], references: [id], onDelete: SetNull)
  // ── Feature 8: ReviewInstance additions ──
  subjectSnapshot        Json? // frozen-on-open {managerId, dept, hireDate, …}
  proRationFactor        Decimal                 @default(1) @db.Decimal(5, 4) // joiner/transfer tenure factor
  compositeScore         Decimal?                @db.Decimal(6, 3) // goal×goalW + comp×compW, ×proRation
  calibratedRating       Decimal?                @db.Decimal(4, 2) // skip-level adjustment (≠ finalRating until signOff)
  meritEligible          Boolean                 @default(false)
  releasedAt             DateTime? // per-instance release gate
  acknowledgedAt         DateTime?
  rebuttalNote           String?
  submittedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  version                Int                     @default(0)
  responses              ReviewResponse[]
  peerRequests           PeerFeedbackRequest[]
  calibrationAdjustments CalibrationAdjustment[]
  meritRecommendations   MeritRecommendation[]
  nineBoxPlacements      NineBoxPlacement[]

  @@unique([businessId, reviewCycleId, employeeId])
  @@index([businessId, reviewerId, status])
}

enum ReviewStatus {
  NOT_STARTED
  SELF_SUBMITTED
  MANAGER_SUBMITTED
  CALIBRATED
  ACKNOWLEDGED
  CLOSED
}

model Goal {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewCycleId String?
  title         String
  description   String?
  category      GoalCategory @default(INDIVIDUAL)
  weight        Decimal?     @db.Decimal(5, 2)
  target        String?
  progress      Decimal      @default(0) @db.Decimal(5, 2)
  status        GoalStatus   @default(DRAFT)
  dueDate       DateTime?    @db.Date
  parentGoalId  String? // cascade from org/dept OKR
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  version       Int          @default(0)

  @@index([businessId, employeeId, status])
}

enum GoalCategory {
  ORGANIZATION
  DEPARTMENT
  TEAM
  INDIVIDUAL
  DEVELOPMENT
}

enum GoalStatus {
  DRAFT
  ACTIVE
  ON_TRACK
  AT_RISK
  ACHIEVED
  MISSED
  CANCELLED
}

model EmployeeSkill {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillName   String
  proficiency Int // 1-5
  isPrimary   Boolean  @default(false)
  endorsedBy  String?
  createdAt   DateTime @default(now())

  @@index([businessId, employeeId])
