# =============================================================================
# Sitepresso backend env template
# =============================================================================
# Copy to `.env` and fill in. Required vars MUST be set for the app to work.
# When deploying a new environment, walk this file top to bottom — missing any
# REQUIRED var causes silent failures (login broken, emails not sending, etc).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — core
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB"

# DEPLOY_ENV controls email routing:
#   production → real recipients
#   anything else (staging, dev) → STAGING_EMAIL_OVERRIDE inbox
# This is the ONLY switch for prod email behaviour. Don't omit on prod.
DEPLOY_ENV=production

# JWT signing secrets — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# REQUIRED — domain & cookies
# -----------------------------------------------------------------------------
# PLATFORM_DOMAIN drives CORS, tenant routing, frontend URL building.
# Set to the bare apex (no protocol, no leading dot).
PLATFORM_DOMAIN=sitepresso.com
PLATFORM_PROTOCOL=https
FRONTEND_URL=https://sitepresso.com

# AUTH_COOKIE_DOMAIN scopes auth cookies across subdomains.
# MUST start with a dot. If wrong, login appears to succeed but session
# isn't persisted (cookie domain ≠ host = browser drops it).
#   staging:    .aapkatech.com
#   production: .sitepresso.com
AUTH_COOKIE_DOMAIN=.sitepresso.com

# -----------------------------------------------------------------------------
# OPTIONAL — custom customer domains
# -----------------------------------------------------------------------------
# cloudflare = Cloudflare for SaaS custom hostnames (legacy/default)
# vercel     = add customer domains directly to Vercel public projects
CUSTOM_DOMAIN_PROVIDER=vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_TEAM_SLUG=
VERCEL_CNAME_TARGET=cname.vercel-dns-0.com
VERCEL_APEX_IP=76.76.21.21
VERCEL_PROJECT_BOOKING_PUBLIC=sitepresso-prod-booking-public
VERCEL_PROJECT_SHOP_PUBLIC=sitepresso-prod-shop-public
VERCEL_PROJECT_WEB_PUBLIC=sitepresso-prod-web-public

# -----------------------------------------------------------------------------
# OPTIONAL — domain reseller (staging should use sandbox registrar credentials)
# -----------------------------------------------------------------------------
# Registrar = Openprovider REST API (v1beta), the single provider for all TLDs.
# Stays in sandbox (deterministic mock results) until USERNAME/PASSWORD are set
# AND the box's outbound IP is on the Openprovider CP IP whitelist.
# DOMAIN_RESELLER_MODE=sandbox
# DOMAIN_RESELLER_NAMESERVERS=ns1.sitepresso.com,ns2.sitepresso.com
# OPENPROVIDER_USERNAME=
# OPENPROVIDER_PASSWORD=
# OPENPROVIDER_CUSTOMER_HANDLE=        # e.g. AB123456-XX (owner/admin/tech/billing)
# OPENPROVIDER_NAMESERVERS=            # optional; falls back to DOMAIN_RESELLER_NAMESERVERS
# OPENPROVIDER_AUTH_IP=                # optional; blank lets Openprovider use the source IP
# OPENPROVIDER_API_BASE_SANDBOX=http://api.sandbox.openprovider.nl:8480/v1beta
# OPENPROVIDER_API_BASE_LIVE=https://api.openprovider.eu/v1beta

# -----------------------------------------------------------------------------
# REQUIRED — email (SES)
# -----------------------------------------------------------------------------
# Without these, signup/login/forgot-password silently fail with
# "We couldn't deliver a verification code" (HTTP 502).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sender address MUST be on a verified SES domain. Check console at
# SES → Verified identities. Domain (mail.sitepresso.com) is preferred
# over single addresses (lets you use any @subdomain.tld from address).
SES_FROM_EMAIL=noreply@mail.sitepresso.com

# Where staging mail gets diverted to (ignored when DEPLOY_ENV=production)
STAGING_EMAIL_OVERRIDE=codemagician2016@gmail.com

# -----------------------------------------------------------------------------
# OPTIONAL — observability
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# LAUNCH_FREE_UNTIL=2026-12-31  # disable Paddle paywall before this date

# -----------------------------------------------------------------------------
# OPTIONAL — captcha (signup/login bot protection)
# -----------------------------------------------------------------------------
# TURNSTILE_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — billing (Paddle)
# -----------------------------------------------------------------------------
# PADDLE_ENVIRONMENT=live                 # or `sandbox`
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# PADDLE_CHECKOUT_URL=
# PADDLE_MAILBOX_PRICE_ID_MONTHLY=
# PADDLE_MAILBOX_PRICE_ID_ANNUAL=
# MAILBOX_ALLOW_UNPAID_PROVISIONING=false
# SUBSCRIPTION_PAST_DUE_GRACE_DAYS=0

# -----------------------------------------------------------------------------
# OPTIONAL — payments (ECOMMERCE vertical)
# -----------------------------------------------------------------------------
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Preferred Razorpay tenant onboarding: hosted Partner OAuth.
# RAZORPAY_OAUTH_CLIENT_ID=
# RAZORPAY_OAUTH_CLIENT_SECRET=
# RAZORPAY_OAUTH_MODE=test
# Fallback/API-assisted Route setup and legacy partner order path.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — OAuth (calendar integrations)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — SMS / WhatsApp
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_CATALOG_ID=
# MSG91_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — POS / misc
# -----------------------------------------------------------------------------
# CLOVER_APP_ID=
# SQUARE_APPLICATION_ID=
# REDIS_URL=
# RATE_LIMIT_SKIP_IPS=  # comma-separated IPs to exempt from rate limits

# -----------------------------------------------------------------------------
# Build metadata (set automatically by deploy.sh / GH Actions — leave blank)
# -----------------------------------------------------------------------------
# BUILD_COMMIT=
# BUILD_BRANCH=
# BUILD_TIME=
