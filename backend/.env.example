# =============================================================================
# DriftHR backend env template
# =============================================================================
# Copy to `backend/.env` on each box and fill in. REQUIRED vars MUST be set or
# the app fails (login broken, emails not sending, custom domains not issuing).
# This file is committed; it contains NO real values — placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — core
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000                                   # API cluster port (matches BACKEND_PORT)
# Postgres connection string for Prisma.
DATABASE_URL="postgresql://USER:PASS@HOST:5432/drifthr"

# DEPLOY_ENV controls email routing: production → real recipients; anything
# else (staging/dev) → STAGING_EMAIL_OVERRIDE inbox. Only switch for prod email.
DEPLOY_ENV=production

# JWT signing — generate with: openssl rand -hex 64
JWT_SECRET=                                 # access-token signing secret
JWT_REFRESH_SECRET=                         # refresh-token signing secret (if used)
JWT_EXPIRES_IN=15m                          # access-token lifetime
JWT_ACCESS_EXPIRES_IN=15m                   # alias used in code; keep equal to JWT_EXPIRES_IN
JWT_REFRESH_EXPIRES_IN=30d                  # refresh-token lifetime

# -----------------------------------------------------------------------------
# REQUIRED — domain & cookies
# -----------------------------------------------------------------------------
# Bare apex (no protocol, no leading dot). Drives CORS, tenant routing, URLs.
#   staging: staging.drifthr.com   prod: drifthr.com
PLATFORM_DOMAIN=drifthr.com
PLATFORM_PROTOCOL=https
FRONTEND_URL=https://drifthr.com
# Scopes auth cookies across subdomains — MUST start with a dot.
AUTH_COOKIE_DOMAIN=.drifthr.com

# -----------------------------------------------------------------------------
# REQUIRED — cache / router coordination
# -----------------------------------------------------------------------------
# Shared with drifthr-router for tenant-route caching + public microcache.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# REQUIRED — email (AWS SES)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1                        # also used by S3/SES SDK clients
AWS_ACCESS_KEY_ID=                           # prefer the EC2 instance role; leave blank if so
AWS_SECRET_ACCESS_KEY=
# Sender MUST be on a verified SES identity/domain.
#
# All DriftHR mail sends from the drifthr.com apex — one identity, every
# environment. It carries Easy DKIM plus a custom MAIL FROM (bounce.drifthr.com,
# MX + SPF), so DKIM and SPF both align EXACTLY with drifthr.com under its
# DMARC p=reject. The older mail.drifthr.com identity is still verified and left
# in place as a fallback, but nothing should point at it: it only aligns by
# relaxed subdomain matching, which is weaker.
#
# Tenants do NOT send from their own domains (owner decision) — a client's mail
# goes out as drifthr.com, not hr@theirdomain.
SES_FROM_EMAIL=no-reply@drifthr.com
# Where staging mail is diverted (ignored when DEPLOY_ENV=production).
STAGING_EMAIL_OVERRIDE=ops@example.com

# -----------------------------------------------------------------------------
# REQUIRED — tenant custom domains (Cloudflare for SaaS)
# -----------------------------------------------------------------------------
# Used by the backend to create/verify CF custom hostnames for bound tenant
# domains. The router resolves those hosts via /api/internal/domain-route.
CUSTOM_DOMAIN_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=                        # scoped: SSL+Custom Hostnames edit on the zone
CLOUDFLARE_ACCOUNT_ID=                       # CF account id
CLOUDFLARE_ZONE_ID=                          # drifthr.com zone id
CLOUDFLARE_ZONE_NAME=drifthr.com
# Origin that CF custom hostnames fall back to (the box's edge).
CLOUDFLARE_CUSTOM_HOSTNAME_FALLBACK_ORIGIN=origin.drifthr.com

# -----------------------------------------------------------------------------
# OPTIONAL — object storage (uploads, exports)
# -----------------------------------------------------------------------------
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — face-recognition attendance (Feature 39)
# -----------------------------------------------------------------------------
# The real matcher (arcface-onnx) self-registers at boot when onnxruntime-node +
# sharp + the model files exist; otherwise the stub runs (face punches queue for
# HR review). Models ship in-repo at backend/models/face/.
# FACE_MATCHER=auto        # auto (default) | onnx (require real) | stub (force off)
# FACE_MODELS_DIR=         # override the model dir (default backend/models/face)

# -----------------------------------------------------------------------------
# OPTIONAL — billing (multi-gateway: Razorpay / Stripe / Paddle)
# -----------------------------------------------------------------------------
# BILLING_MULTI_GATEWAY=1
# Razorpay (India)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Stripe (global cards)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# Paddle (subscriptions / merchant-of-record)
# PADDLE_ENVIRONMENT=live
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# PADDLE_CHECKOUT_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — observability
# -----------------------------------------------------------------------------
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL — captcha / bot protection
# -----------------------------------------------------------------------------
# TURNSTILE_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — OAuth (calendar / SSO integrations)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — SMS / WhatsApp (notifications)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_API_KEY=
# MSG91_SENDER_ID=

# -----------------------------------------------------------------------------
# Build metadata (set automatically by the deploy pipeline — leave blank)
# -----------------------------------------------------------------------------
# BUILD_COMMIT=
# BUILD_BRANCH=
# BUILD_TIME=
