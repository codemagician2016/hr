{
  "name": "sitepresso-backend",
  "version": "1.0.0",
  "description": "Sitepresso backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --testPathIgnorePatterns=auth-cookie-isolation",
    "test:auth-cookies": "node --test test/auth-cookie-isolation.test.js",
    "test:e2e": "DATABASE_URL=\"$(node -e \"process.stdout.write(require('fs').readFileSync('.env','utf8').match(/^DATABASE_URL=\\\"?(.+?)\\\"?\\s*$/m)[1]+'?schema=hr_test')\")\" node test/e2e/full-flow.test.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed:pricing": "node prisma/seeds/pricing.seed.js",
    "prisma:seed:hr": "node prisma/seed-hr.js",
    "seed:it-services": "node scripts/seed-it-services-websites.js",
    "smoke:billing-local": "node scripts/smoke-billing-local.js",
    "smoke:inbox-local": "node scripts/smoke-inbox-calendar-local.js",
    "lint": "eslint src/routes/appointment/ src/routes/shop/ src/web/routes/",
    "test:boot": "node test/boot.test.js"
  },
  "prisma": {
    "seed": "node prisma/seeds/pricing.seed.js && node prisma/seed-hr.js"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.29.2",
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/client-ses": "^3.600.0",
    "@aws-sdk/credential-providers": "^3.1061.0",
    "@hr/theme-engine": "file:../packages/theme-engine",
    "@node-saml/node-saml": "^5.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.15.0",
    "@sentry/node": "^10.50.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "onnxruntime-node": "^1.27.0",
    "openid-client": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "stripe": "^22.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.15.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
