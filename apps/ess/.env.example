# =============================================================================
# DriftHR ess (Employee Self-Service, <slug>.drifthr.com + custom domains)
# env template
# =============================================================================
# Copy to apps/ess/.env on the box. NEXT_PUBLIC_* are inlined at build time —
# set BEFORE `npm run build`. The ESS app is white-label and multi-tenant: the
# tenant is resolved per-request from the Host / X-Tenant-Host header forwarded
# by the router, NOT from env. Committed file — placeholders only.
# =============================================================================

PORT=3020                                          # fixed; matches ESS_PORT in the router
NODE_ENV=production

# Public API base. ESS is served on many hosts (subdomains + bound custom
# domains), so calls go same-origin to /api through the router; an absolute URL
# is only needed for cross-origin cases.
NEXT_PUBLIC_API_URL=/api

# Bare apex (used for any platform-level links rendered in the ESS shell).
NEXT_PUBLIC_PLATFORM_DOMAIN=drifthr.com

# assetPrefix MUST stay in sync with the router's ASSET_PREFIX_SUBAPP map
# (apps/router/index.js → 'ess-static'). Changing it breaks /_next chunk routing.
# NEXT_PUBLIC_ASSET_PREFIX=/ess-static
