# =============================================================================
# DriftHR platform (marketing + super-admin console) env template
# =============================================================================
# Copy to apps/platform/.env on the box. NEXT_PUBLIC_* are inlined into the
# client bundle at build time, so they must be set BEFORE `npm run build`.
# Committed file — placeholders only, no real values.
# =============================================================================

PORT=3000                                          # fixed; matches PLATFORM_PORT in the router
NODE_ENV=production

# Public API base. Same-origin /api works behind the router; an absolute URL is
# only needed for cross-origin calls.
NEXT_PUBLIC_API_URL=https://drifthr.com/api
# Bare apex used for building tenant/subdomain URLs in the UI.
NEXT_PUBLIC_PLATFORM_DOMAIN=drifthr.com
NEXT_PUBLIC_SITE_URL=https://drifthr.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://drifthr.com

# Tenant custom-domain hints shown in the admin "connect a domain" UI.
NEXT_PUBLIC_CUSTOM_DOMAIN_PROVIDER=cloudflare
NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET=origin.drifthr.com
# NEXT_PUBLIC_CUSTOM_DOMAIN_APEX_IPS=

# OAuth (Google sign-in button on the console).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Billing (Paddle client-side checkout).
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=production

# Product analytics.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
