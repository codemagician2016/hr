# =============================================================================
# DriftHR hr-admin (tenant HR console, app.drifthr.com) env template
# =============================================================================
# Copy to apps/hr-admin/.env on the box. NEXT_PUBLIC_* are inlined at build time
# — set BEFORE `npm run build`. Committed file — placeholders only.
# =============================================================================

PORT=3010                                          # fixed; matches HR_ADMIN_PORT in the router
NODE_ENV=production

# Public API base. Behind the router, same-origin /api works; an absolute URL is
# only needed for cross-origin/server-side fetches.
NEXT_PUBLIC_API_URL=https://app.drifthr.com/api
